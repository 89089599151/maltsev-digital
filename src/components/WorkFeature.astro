---
/**
 * Витрина кейса: слева — название, суть, три факта и вход в кейс; справа — настоящие скриншоты
 * в ровных рамках (десктоп и телефон) на светлой подложке. Без наклонов и декоративной графики:
 * показываем сам сайт.
 * На главной блок идёт с заголовком секции «Работы», на странице портфолио — без него.
 */
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import SectionHead from './SectionHead.astro';
import BrowserShot from './BrowserShot.astro';
import { url } from '@/lib/url';
import Icon from './Icon.astro';

interface Props {
  project: CollectionEntry<'projects'>;
  /** false — без заголовка секции (на странице портфолио заголовок уже в первом экране). */
  head?: boolean;
}

const { project, head = true } = Astro.props;
// Без заголовка секции название кейса становится заголовком второго уровня.
const Name = head ? 'h3' : 'h2';
const d = project.data;
const desktop = d.responsive.desktop ?? d.cover;
const mobile = d.responsive.mobile;
const caseUrl = url(`/portfolio/${project.id}/`);
---

<section class="wf section" id="work" data-island-section={head ? 'Работы' : undefined} aria-labelledby={head ? 'wf-title' : 'wf-name'}>
  {head && <SectionHead
    id="wf-title"
    title="Работы"
    text="Первый кейс — этот сайт: от задачи и дизайна до запуска."
    link={{ href: url('/portfolio/'), label: 'Все работы' }}
  />}

  <article class="wf__stage" aria-labelledby="wf-name" data-reveal>
    <div class="wf__info">
      <Name id="wf-name" class="wf__name">{d.title}</Name>
      <p class="wf__sum">{d.summary}</p>
      {
        d.results.length > 0 && (
          <dl class="wf__facts">
            {d.results.slice(0, 3).map((r) => (
              <div>
                <dt>{r.short ?? r.label}</dt>
                <dd>{r.value}</dd>
              </div>
            ))}
          </dl>
        )
      }
      <a class="btn btn--ink wf__cta" href={caseUrl}>
        Смотреть кейс <span class="arrow" aria-hidden="true"><Icon name="arrow" /></span>
      </a>
    </div>

    <a class="wf__visual" href={caseUrl} aria-label={`Открыть кейс ${d.title}`} tabindex="-1">
      <BrowserShot
        class="wf__desktop"
        src={desktop}
        alt={d.coverAlt}
        sizes="(max-width: 1023px) 86vw, 50vw"
        loading={head ? 'lazy' : 'eager'}
      />
      {
        mobile && (
          <div class="wf__phone">
            <Image src={mobile} alt="" widths={[240, 376, 560]} sizes="(max-width: 1023px) 24vw, 13vw" loading={head ? 'lazy' : 'eager'} />
          </div>
        )
      }
    </a>
  </article>
</section>

<style>
  .wf__stage {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: clamp(24px, 3vw, 48px);
    align-items: stretch;
    padding: clamp(12px, 1.2vw, 18px);
    padding-left: clamp(24px, 4vw, 64px);
    border-radius: var(--radius-lg);
    background: var(--paper);
  }

  .wf__info {
    display: grid;
    gap: clamp(16px, 1.6vw, 22px);
    justify-items: start;
    align-content: center;
    padding-block: clamp(16px, 3vw, 48px);
  }

  .wf__name {
    font-weight: 360;
    font-size: var(--fs-5);
    line-height: 1.02;
    letter-spacing: -0.05em;
  }

  .wf__sum {
    max-width: 36ch;
    font-size: var(--step-body);
    color: var(--ink-2);
  }

  /* Три факта списком под линиями: значение слева, пояснение справа. */
  .wf__facts {
    width: 100%;
    max-width: 440px;
    border-top: 1px solid var(--line);
  }

  .wf__facts div {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    gap: 16px;
    align-items: baseline;
    padding-block: 12px;
    border-bottom: 1px solid var(--line);
  }

  .wf__facts dd {
    grid-column: 1;
    grid-row: 1;
    font-family: var(--font-head);
    font-weight: 450;
    font-size: var(--fs-1);
    line-height: 1.1;
    letter-spacing: -0.035em;
  }

  .wf__facts dt {
    grid-column: 2;
    font-size: var(--step-small);
    line-height: 1.35;
    color: var(--muted);
  }

  .wf__cta {
    min-height: 56px;
    margin-top: 6px;
  }

  /* Скриншоты: светлая подложка, окно браузера и телефон поверх его правого нижнего угла. */
  .wf__visual {
    position: relative;
    display: grid;
    align-items: center;
    padding: clamp(20px, 4vw, 56px) clamp(28px, 6vw, 88px) clamp(28px, 5vw, 72px) clamp(20px, 3.4vw, 48px);
    border-radius: calc(var(--radius-lg) - 8px);
    background:
      radial-gradient(60% 70% at 70% 40%, var(--stage-glow) 0%, rgba(255, 255, 255, 0) 70%),
      linear-gradient(180deg, var(--stage-1), var(--stage-2));
    overflow: hidden;
  }

  .wf__visual :global(.wf__desktop) {
    transition: scale 700ms var(--ease-out);
  }

  .wf__visual:hover :global(.wf__desktop) {
    scale: 1.015;
  }

  .wf__phone {
    position: absolute;
    right: clamp(12px, 2.4vw, 36px);
    bottom: clamp(14px, 2.4vw, 36px);
    width: 21%;
    border-radius: 14px;
    background: var(--paper);
    box-shadow:
      0 0 0 1px rgba(10, 11, 20, 0.08),
      0 40px 70px -40px rgba(16, 32, 200, 0.45);
    overflow: hidden;
  }

  .wf__phone img {
    width: 100%;
    height: auto;
    aspect-ratio: 376 / 814;
    object-fit: cover;
    object-position: top;
  }

  @media (max-width: 1023px) {
    .wf__stage {
      grid-template-columns: 1fr;
      padding: clamp(10px, 1.6vw, 16px);
    }

    .wf__visual {
      order: -1;
    }

    .wf__info {
      padding: 8px clamp(8px, 2vw, 24px) 16px;
    }
  }

  @media (max-width: 767px) {
    .wf__stage {
      border-radius: 24px;
    }

    .wf__visual {
      border-radius: 16px;
    }

    .wf__phone {
      width: 24%;
      border-radius: 10px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .wf__visual:hover :global(.wf__desktop) {
      scale: none;
    }
  }
</style>
