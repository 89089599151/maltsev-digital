---
/**
 * Витрина кейса на главной: две отдельные части, а не одна карточка «со всем сразу».
 * Сверху — сцена со скриншотами (окно браузера и телефон на светлой подложке), она ведёт в кейс.
 * Под ней, прямо на фоне страницы, — подпись: что это и когда, название (оно и есть ссылка на кейс)
 * и одна фраза. Как и остальные разделы, витрина заканчивается содержимым; ссылка раздела
 * «Все работы» — в заголовке. На телефоне в сцене только окно браузера, без наложенного телефона,
 * название проекта мельче заголовков разделов.
 * При переходе скриншот и название перелетают на свои места на странице кейса (case-shot, case-title).
 */
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import SectionHead from './SectionHead.astro';
import BrowserShot from './BrowserShot.astro';
import { categoryLabel } from '@/config/portfolio';
import { url } from '@/lib/url';

interface Props {
  project: CollectionEntry<'projects'>;
  /** false — без заголовка секции. */
  head?: boolean;
}

const { project, head = true } = Astro.props;
const Name = head ? 'h3' : 'h2';
const d = project.data;
const desktop = d.responsive.desktop ?? d.cover;
const mobile = d.responsive.mobile;
const caseUrl = url(`/portfolio/${project.id}/`);
const kind = d.isConcept ? 'Концепт' : d.category === 'personal' ? 'Личный проект' : categoryLabel(d.category);
---

<section class="wf section" id="work" data-island-section={head ? 'Работы' : undefined} aria-labelledby={head ? 'wf-title' : 'wf-name'}>
  {head && <SectionHead id="wf-title" title="Работы" link={{ href: url('/portfolio/'), label: 'Все работы' }} />}

  <div class="wf__item" data-reveal>
    {/* Сцена — та же ссылка, что «Смотреть кейс», поэтому для клавиатуры и читалок её нет. */}
    <a class="wf__visual" href={caseUrl} tabindex="-1" aria-hidden="true">
      <BrowserShot
        class="wf__desktop"
        src={desktop}
        alt=""
        sizes="(max-width: 1023px) 86vw, 64vw"
        loading={head ? 'lazy' : 'eager'}
      />
      {
        mobile && (
          <span class="wf__phone">
            <Image src={mobile} alt="" widths={[240, 376, 560]} sizes="(max-width: 1023px) 24vw, 13vw" loading={head ? 'lazy' : 'eager'} />
          </span>
        )
      }
    </a>

    <div class="wf__caption">
      <div class="wf__text">
        <p class="wf__kind">{kind}, {d.year}</p>
        <Name id="wf-name" class="wf__name"><a class="wf__link" href={caseUrl}>{d.title}</a></Name>
      </div>
      <p class="wf__sum">{d.summary}</p>
    </div>
  </div>
</section>

<style>
  /* Непрерывный переход в кейс: скриншот и название перелетают на страницу кейса. */
  .wf__visual :global(.wf__desktop) {
    view-transition-name: case-shot;
  }

  .wf__name {
    view-transition-name: case-title;
  }

  /* Сцена со скриншотами: светлая подложка, окно браузера по центру, телефон у его правого края. */
  .wf__visual {
    position: relative;
    display: grid;
    place-items: center;
    padding: clamp(28px, 5vw, 72px) clamp(36px, 9vw, 160px) clamp(32px, 5vw, 80px);
    border-radius: var(--radius-lg);
    background: linear-gradient(180deg, var(--stage-1), var(--stage-2));
    overflow: hidden;
    -webkit-tap-highlight-color: transparent;
  }

  .wf__visual :global(.wf__desktop) {
    width: 100%;
    max-width: 880px;
    transition: transform 900ms var(--ease-out);
  }

  .wf__phone {
    position: absolute;
    right: clamp(18px, 6vw, 120px);
    bottom: clamp(14px, 2.6vw, 40px);
    width: clamp(64px, 13vw, 180px);
    border-radius: 14px;
    background: var(--paper);
    /* Телефон лежит поверх окна браузера — единственное, что здесь действительно «парит». */
    box-shadow:
      0 0 0 1px rgba(10, 11, 20, 0.08),
      var(--shadow-1);
    overflow: hidden;
    transition: transform 900ms var(--ease-out);
  }

  .wf__phone :global(img) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 376 / 814;
    object-fit: cover;
    object-position: top;
  }

  /* Наведение на сцену или на ссылку — скриншоты чуть приподнимаются. */
  @media (hover: hover) and (pointer: fine) {
    .wf__item:has(:is(.wf__visual, .wf__link):hover) .wf__visual :global(.wf__desktop) {
      transform: translateY(-6px);
    }

    .wf__item:has(:is(.wf__visual, .wf__link):hover) .wf__phone {
      transform: translateY(-12px);
    }
  }

  /* Подпись на фоне страницы: слева что это и название, справа фраза и ссылка. */
  .wf__caption {
    display: grid;
    /* Та же сетка 7:5, что у заголовков разделов: фраза стоит по одной вертикали с их ссылками. */
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: 16px clamp(24px, 4vw, 64px);
    align-items: end;
    padding-top: clamp(20px, 2.4vw, 32px);
  }

  .wf__text {
    display: grid;
    gap: 8px;
    min-width: 0;
  }

  .wf__kind {
    font-size: var(--step-small);
    color: var(--muted);
  }

  .wf__name {
    font-weight: 300;
    font-size: var(--fs-4);
    line-height: 1.02;
    letter-spacing: -0.045em;
  }

  .wf__sum {
    max-width: 52ch;
    font-size: var(--step-body);
    line-height: 1.5;
    color: var(--muted);
  }

  /* Название — ссылка на кейс: без подчёркивания, при наведении синеет, как вопросы и пункты меню. */
  .wf__link {
    color: inherit;
    text-decoration: none;
    transition: color var(--dur-fast) var(--ease-out);
  }

  /* На телефоне название — цель для пальца не ниже 44px. */
  @media (max-width: 767px) {
    .wf__link {
      display: inline-block;
      padding-block: 7px;
      margin-block: -7px;
    }
  }

  .wf__link:focus-visible {
    color: var(--accent-text);
  }

  @media (hover: hover) and (pointer: fine) {
    .wf__link:hover,
    .wf__item:has(.wf__visual:hover) .wf__link {
      color: var(--accent-text);
    }
  }

  @media (max-width: 767px) {
    .wf__visual {
      padding: 22px 18px 24px;
    }

    /* На узкой сцене телефон поверх окна браузера превращается в кашу — оставляем одно окно. */
    .wf__phone {
      display: none;
    }

    .wf__caption {
      grid-template-columns: minmax(0, 1fr);
      gap: 10px;
      padding-top: 18px;
    }

    .wf__text {
      gap: 4px;
    }

    /* Название проекта на шаг мельче заголовка раздела — подпись не читается как новый раздел. */
    .wf__name {
      font-weight: 400;
      font-size: var(--fs-3);
      letter-spacing: -0.035em;
    }


  }

  @media (prefers-reduced-motion: reduce) {
    .wf__item:has(:is(.wf__visual, .wf__link):hover) :is(.wf__phone, .wf__visual :global(.wf__desktop)) {
      transform: none;
    }
  }
</style>
