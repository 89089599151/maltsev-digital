---
/**
 * Витрина кейса на главной — одна карточка, как в App Store: крупно сам сайт (окно браузера и
 * телефон на светлой подложке), под ним одна строка — что это, название, одна фраза и круглая
 * стрелка. Вся карточка — ссылка на кейс. Цифры и подробности живут в самом кейсе.
 * При переходе скриншот и название перелетают на свои места на странице кейса (case-shot, case-title).
 */
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import SectionHead from './SectionHead.astro';
import BrowserShot from './BrowserShot.astro';
import { categoryLabel } from '@/config/portfolio';
import { url } from '@/lib/url';
import Icon from './Icon.astro';

interface Props {
  project: CollectionEntry<'projects'>;
  /** false — без заголовка секции. */
  head?: boolean;
}

const { project, head = true } = Astro.props;
const Name = head ? 'h3' : 'h2';
const d = project.data;
const desktop = d.responsive.desktop ?? d.cover;
const mobile = d.responsive.mobile;
const caseUrl = url(`/portfolio/${project.id}/`);
const kind = d.isConcept ? 'Концепт' : d.category === 'personal' ? 'Личный проект' : categoryLabel(d.category);
---

<section class="wf section" id="work" data-island-section={head ? 'Работы' : undefined} aria-labelledby={head ? 'wf-title' : 'wf-name'}>
  {head && <SectionHead id="wf-title" title="Работы" link={{ href: url('/portfolio/'), label: 'Все работы' }} />}

  <a class="wf__card" href={caseUrl} aria-labelledby="wf-name" data-reveal>
    <span class="wf__visual">
      <BrowserShot
        class="wf__desktop"
        src={desktop}
        alt={d.coverAlt}
        sizes="(max-width: 1023px) 86vw, 64vw"
        loading={head ? 'lazy' : 'eager'}
      />
      {
        mobile && (
          <span class="wf__phone">
            <Image src={mobile} alt="" widths={[240, 376, 560]} sizes="(max-width: 1023px) 24vw, 13vw" loading={head ? 'lazy' : 'eager'} />
          </span>
        )
      }
    </span>

    <span class="wf__caption">
      <span class="wf__text">
        <span class="wf__kind">Кейс · {kind} · {d.year}</span>
        <Name id="wf-name" class="wf__name">{d.title}</Name>
        <span class="wf__sum">{d.summary}</span>
      </span>
      <span class="wf__go" aria-hidden="true"><Icon name="arrow" /></span>
    </span>
  </a>
</section>

<style>
  /* Непрерывный переход в кейс: скриншот и название перелетают на страницу кейса. */
  .wf__visual :global(.wf__desktop) {
    view-transition-name: case-shot;
  }

  .wf__name {
    view-transition-name: case-title;
  }

  /* Одна карточка-ссылка: картинка сверху, подпись строкой снизу. */
  .wf__card {
    display: grid;
    padding: clamp(10px, 1vw, 14px);
    border-radius: var(--radius-lg);
    background: var(--paper);
    color: var(--ink);
    text-decoration: none;
    transition: box-shadow var(--dur) var(--ease-out);
    -webkit-tap-highlight-color: transparent;
  }

  .wf__card:hover {
    box-shadow: 0 40px 80px -48px rgba(16, 32, 200, 0.45);
  }

  /* Скриншоты: светлая подложка, окно браузера по центру и телефон у его правого края. */
  .wf__visual {
    position: relative;
    display: grid;
    place-items: center;
    padding: clamp(28px, 5vw, 72px) clamp(36px, 9vw, 160px) clamp(32px, 5vw, 80px);
    border-radius: calc(var(--radius-lg) - 12px);
    background:
      radial-gradient(60% 70% at 50% 40%, var(--stage-glow) 0%, rgba(255, 255, 255, 0) 70%),
      linear-gradient(180deg, var(--stage-1), var(--stage-2));
    overflow: hidden;
  }

  .wf__visual :global(.wf__desktop) {
    width: 100%;
    max-width: 880px;
    transition: transform 900ms var(--ease-out);
  }

  .wf__phone {
    position: absolute;
    right: clamp(18px, 6vw, 120px);
    bottom: clamp(14px, 2.6vw, 40px);
    width: clamp(64px, 13vw, 180px);
    border-radius: 14px;
    background: var(--paper);
    box-shadow:
      0 0 0 1px rgba(10, 11, 20, 0.08),
      0 40px 70px -40px rgba(16, 32, 200, 0.45);
    overflow: hidden;
    transition: transform 900ms var(--ease-out);
  }

  .wf__phone :global(img) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 376 / 814;
    object-fit: cover;
    object-position: top;
  }

  @media (hover: hover) and (pointer: fine) {
    .wf__card:hover .wf__visual :global(.wf__desktop) {
      transform: translateY(-6px);
    }

    .wf__card:hover .wf__phone {
      transform: translateY(-12px);
    }
  }

  .wf__card:active {
    transform: scale(0.99);
  }

  .wf__caption {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 16px 24px;
    align-items: center;
    padding: clamp(16px, 2vw, 24px) clamp(10px, 1.6vw, 22px) clamp(8px, 1vw, 12px);
  }

  .wf__text {
    display: grid;
    gap: 6px;
    min-width: 0;
  }

  .wf__kind {
    font-size: var(--fs-xs);
    font-weight: 500;
    color: var(--muted);
  }

  .wf__name {
    font-weight: 300;
    font-size: var(--fs-4);
    line-height: 1.02;
    letter-spacing: -0.045em;
  }

  .wf__sum {
    max-width: 56ch;
    font-size: var(--step-body);
    color: var(--muted);
  }

  .wf__go {
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    border-radius: 50%;
    background: var(--accent);
    color: var(--accent-ink);
    font-size: 1.15rem;
    transition: transform var(--dur) var(--ease-out);
  }

  .wf__card:hover .wf__go {
    transform: rotate(-45deg);
  }

  @media (max-width: 767px) {
    .wf__visual {
      padding: 24px 28px 30px 20px;
    }

    .wf__phone {
      right: 12px;
      bottom: 12px;
      width: 25%;
      border-radius: 10px;
    }

    /* На телефоне стрелка стоит рядом с названием, а фраза занимает всю ширину карточки. */
    .wf__caption {
      grid-template-areas:
        'kind go'
        'name go'
        'sum sum';
      gap: 4px 16px;
      padding: 16px 10px 8px;
    }

    .wf__text {
      display: contents;
    }

    .wf__kind {
      grid-area: kind;
    }

    .wf__name {
      grid-area: name;
    }

    .wf__sum {
      grid-area: sum;
      margin-top: 4px;
    }

    .wf__go {
      grid-area: go;
      width: 44px;
      height: 44px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .wf__card:hover :is(.wf__phone, .wf__go),
    .wf__card:hover .wf__visual :global(.wf__desktop),
    .wf__card:active {
      transform: none;
    }
  }
</style>
