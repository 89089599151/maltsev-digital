---
/**
 * Первый экран внутренних страниц — та же белая сцена, что на главной: крупный тонкий заголовок,
 * пояснение и действия. Справа — необязательный слот (фото, объект, факты, контакты).
 */
import { url } from '@/lib/url';

interface Props {
  id: string;
  title: string;
  lead?: string;
  crumbs?: { href: string; label: string }[];
  /** Для длинных заголовков: меньший кегль и ниже сцена. */
  compact?: boolean;
}
const { id, title, lead, crumbs, compact = false } = Astro.props;
const hasAside = Astro.slots.has('default');
---

<section class:list={['ph', { 'ph--aside': hasAside, 'ph--compact': compact }]} aria-labelledby={id}>
  <div class="ph__stage">
    <div class="ph__main">
      {
        crumbs && (
          <nav class="ph__crumbs" aria-label="Навигационная цепочка">
            <a href={url('/')}>Главная</a>
            {crumbs.map((c) => (
              <>
                <span aria-hidden="true">/</span>
                <a href={c.href}>{c.label}</a>
              </>
            ))}
          </nav>
        )
      }
      <h1 id={id} class="ph__title">{title}</h1>
      {lead && <p class="ph__lead">{lead}</p>}
      <slot name="actions" />
    </div>
    {
      hasAside && (
        <div class="ph__aside">
          <slot />
        </div>
      )
    }
  </div>
</section>

<style>
  .ph {
    margin-top: var(--margin);
  }

  .ph__stage {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(24px, 3vw, 48px);
    align-items: end;
    min-height: clamp(280px, 28vw, 420px);
    padding: clamp(28px, 4vw, 64px);
    border-radius: var(--radius-lg);
    background:
      radial-gradient(50% 70% at 82% 40%, rgba(26, 47, 251, 0.1) 0%, rgba(26, 47, 251, 0) 70%),
      var(--paper);
    overflow: hidden;
    isolation: isolate;
  }

  .ph--aside .ph__stage {
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    align-items: center;
    min-height: clamp(340px, 36vw, 520px);
  }

  .ph__main {
    display: grid;
    gap: clamp(16px, 2vw, 24px);
    justify-items: start;
  }

  .ph__crumbs {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    font-size: var(--step-small);
    color: var(--muted);
  }

  .ph__crumbs a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: inherit;
    text-decoration: none;
  }

  .ph__crumbs {
    align-items: center;
  }

  .ph__crumbs a:hover {
    color: var(--ink);
  }

  .ph__title {
    font-weight: 300;
    font-size: var(--step-display);
    line-height: 1;
    letter-spacing: -0.055em;
    max-width: 12ch;
    overflow-wrap: anywhere;
    hyphens: auto;
  }

  .ph--compact .ph__stage {
    min-height: clamp(280px, 28vw, 400px);
  }

  .ph--compact .ph__title {
    font-size: clamp(2rem, 1rem + 3.6vw, 4.5rem);
    max-width: 18ch;
  }

  .ph__lead {
    max-width: 46ch;
    font-size: var(--fs-1);
    line-height: 1.4;
    letter-spacing: -0.015em;
    color: var(--ink-2);
  }

  .ph__aside {
    display: grid;
    gap: 8px;
  }

  @media (prefers-reduced-motion: no-preference) {
    .ph__main {
      animation: ph-up 0.9s var(--ease-out) 0.05s backwards;
    }

    .ph__aside {
      animation: ph-up 0.9s var(--ease-out) 0.18s backwards;
    }
  }

  @keyframes ph-up {
    from {
      opacity: 0;
      transform: translateY(18px);
    }
  }

  @media (max-width: 1023px) {
    .ph--aside .ph__stage {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 767px) {
    .ph__stage {
      min-height: 0;
      padding: 24px 18px;
      border-radius: 24px;
    }


  }
</style>
