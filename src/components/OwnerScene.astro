---
/**
 * «Кто делает сайт»: единственная ночная сцена на светлом сайте — фото владельца во всю ширину
 * и стеклянная карточка поверх, как карточка профиля.
 */
import { Image } from 'astro:assets';
import { site } from '@/config/site';
import { url } from '@/lib/url';
import owner from '@/assets/photos/owner.webp';

const facts = [
  { k: 'Образование', v: 'в дизайне' },
  { k: 'Связь', v: 'напрямую' },
  { k: 'Формат', v: 'удалённо' },
];
---

<section class="own section" aria-labelledby="own-title">
  <div class="own__frame" data-reveal="rise">
    <div class="own__photo" data-speed="-1.2">
      <Image
        src={owner}
        alt={`${site.brand.owner.value} на ночной площади под снегом смотрит вверх, на свет фонаря`}
        widths={[640, 1024, 1600, 2000]}
        sizes="100vw"
        loading="lazy"
      />
    </div>

    <div class="own__card">
      <h2 id="own-title" class="own__title" data-split>Кто делает сайт</h2>
      <p class="own__name">{site.brand.owner.value}</p>
      <p class="own__role">Независимый веб-разработчик и дизайнер</p>
      <p class="own__text">
        Веду проект сам — от первого разговора до запуска. ИИ-инструменты ускоряют рутину, а решения о
        структуре, дизайне и качестве принимаю я.
      </p>
      <dl class="own__facts">
        {
          facts.map((f) => (
            <div>
              <dt>{f.k}</dt>
              <dd>{f.v}</dd>
            </div>
          ))
        }
      </dl>
      <div class="own__btns">
        <a class="btn btn--ink own__cta" href={url('/contacts/')} data-magnetic>
          Обсудить проект <span class="arrow" aria-hidden="true">→</span>
        </a>
        <a class="own__more" href={url('/about/')}>Подробнее обо мне</a>
      </div>
    </div>
  </div>
</section>

<style>
  .own__frame {
    position: relative;
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    align-items: center;
    min-height: clamp(560px, 64vw, 860px);
    border-radius: 36px;
    overflow: hidden;
    background: var(--night);
    color: var(--night-ink);
  }

  .own__photo {
    position: absolute;
    inset: -12% 0;
  }

  .own__photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 46% 40%;
  }

  .own__frame::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, rgba(10, 10, 10, 0) 30%, rgba(10, 10, 10, 0.55) 100%);
    pointer-events: none;
  }

  /* Стеклянная карточка: светлое матовое стекло поверх ночи. */
  .own__card {
    position: relative;
    z-index: 1;
    grid-column: 8 / 12;
    display: grid;
    gap: 14px;
    padding: clamp(24px, 2.6vw, 36px);
    border-radius: 30px;
    background: linear-gradient(160deg, rgba(255, 255, 255, 0.24), rgba(255, 255, 255, 0.1));
    -webkit-backdrop-filter: blur(24px) saturate(150%);
    backdrop-filter: blur(24px) saturate(150%);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.55),
      inset 0 0 0 1px rgba(255, 255, 255, 0.22),
      0 40px 80px -30px rgba(0, 0, 0, 0.6);
  }

  .own__title {
    font-size: clamp(1.75rem, 1.1rem + 1.8vw, 2.75rem);
    color: #ffffff;
  }

  .own__name {
    margin-top: 6px;
    font-family: var(--font-head);
    font-weight: 600;
    font-size: 1.25rem;
    letter-spacing: -0.02em;
  }

  .own__role {
    margin-top: -8px;
    color: #cfcdc5;
  }

  .own__text {
    color: #e9e7e0;
  }

  .own__facts {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 8px;
    margin-top: 4px;
  }

  .own__facts div {
    padding: 14px 12px;
    border-radius: 18px;
    background: rgba(255, 255, 255, 0.12);
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.16);
    text-align: center;
  }

  .own__facts dt {
    font-size: 0.8125rem;
    color: #cfcdc5;
  }

  .own__facts dd {
    margin-top: 2px;
    font-family: var(--font-display);
    font-weight: 600;
  }

  .own__btns {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 18px;
    margin-top: 10px;
  }

  .own__cta {
    min-height: 56px;
  }

  .own__more {
    font-family: var(--font-display);
    font-weight: 600;
    color: #ffffff;
    text-underline-offset: 0.3em;
  }

  .own__more:hover {
    color: #ffb37a;
  }

  @media (max-width: 1023px) {
    .own__card {
      grid-column: 6 / 13;
      margin-right: 24px;
    }
  }

  @media (max-width: 767px) {
    .own__frame {
      display: block;
      min-height: 0;
      padding: 62vw 12px 12px;
      border-radius: 28px;
    }

    .own__photo {
      inset: 0 0 auto;
      height: 86vw;
    }

    .own__photo img {
      object-position: 50% 30%;
    }

    .own__frame::after {
      background: linear-gradient(180deg, rgba(10, 10, 10, 0) 40%, rgba(10, 10, 10, 0.85) 75%);
    }

    .own__card {
      margin: 0;
      padding: 22px 18px;
    }

    .own__facts dd {
      font-size: 0.9375rem;
    }
  }
</style>
