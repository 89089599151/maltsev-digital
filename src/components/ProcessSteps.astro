---
/**
 * «Как идёт работа».
 * На главной (compact) — четыре укрупнённых шага в ряд и ссылка на подробный процесс.
 * На странице услуг — все семь этапов списком: срок, что происходит и что нужно от вас.
 * Секция статична: без закрепления и горизонтальной ленты, на любом экране читается сверху вниз.
 */
import PixelWord from './PixelWord.astro';
import SectionHead from './SectionHead.astro';
import { stages, stagesShort, type Stage } from '@/data/content';
import { url } from '@/lib/url';

interface Props {
  compact?: boolean;
}
const { compact = false } = Astro.props;
const list: (Pick<Stage, 'name' | 'text' | 'duration'> & { fromYou?: string })[] = compact ? stagesShort : stages;
---

<section class:list={['ps section', compact ? 'ps--compact' : 'ps--full']} id="process" aria-labelledby="ps-title">
  <SectionHead
    id="ps-title"
    title="Как идёт работа"
    text={compact
      ? 'Четыре шага от заявки до запуска. Каждый согласуем, прежде чем идти дальше.'
      : 'Семь шагов от заявки до запуска. На каждом вы знаете, что происходит, сколько это займёт и что нужно от вас.'}
    link={compact ? { href: url('/services/#process'), label: 'Все этапы подробно' } : { href: url('/contacts/'), label: 'Начать с заявки' }}
  />

  <ol class="ps__list" data-stagger>
    {
      list.map((s, i) => (
        <li class="ps__step">
          <PixelWord text={String(i + 1).padStart(2, '0')} class="ps__num" />
          <div class="ps__head">
            <h3 class="ps__name">{s.name}</h3>
            <p class="ps__dur">{s.duration}</p>
          </div>
          <p class="ps__text">{s.text}</p>
          {s.fromYou && (
            <p class="ps__you">
              <span>От вас</span>
              {s.fromYou}
            </p>
          )}
        </li>
      ))
    }
  </ol>
</section>

<style>
  .ps__list {
    list-style: none;
    padding: 0;
  }

  .ps__step :global(.ps__num) {
    width: 56px;
    height: auto;
    color: var(--accent-graphic);
  }

  .ps__head {
    display: grid;
    gap: 8px;
  }

  .ps__name {
    font-size: var(--fs-2);
    line-height: 1;
    letter-spacing: -0.03em;
    text-transform: uppercase;
  }

  .ps__dur {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--fs-xs);
    color: var(--accent-text);
  }

  .ps__text {
    font-size: var(--fs-0);
    line-height: 1.55;
    color: var(--muted);
  }

  .ps__you {
    display: grid;
    gap: 4px;
    font-size: var(--fs-0);
    line-height: 1.5;
  }

  .ps__you span {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--fs-xs);
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: var(--muted);
  }

  /* Главная: четыре колонки под общей чертой. */
  .ps--compact .ps__list {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(24px, 3vw, 48px);
  }

  .ps--compact .ps__step {
    display: grid;
    align-content: start;
    gap: 18px;
    padding-top: clamp(20px, 2vw, 28px);
    border-top: 2px solid var(--ink);
  }

  /* Услуги: строка на этап — номер, название и срок, описание, что нужно от вас. */
  .ps--full .ps__list {
    border-top: 1px solid var(--line);
  }

  .ps--full .ps__step {
    display: grid;
    grid-template-columns: 72px minmax(0, 3fr) minmax(0, 5fr) minmax(0, 4fr);
    gap: 16px clamp(20px, 3vw, 48px);
    align-items: start;
    padding-block: clamp(22px, 2.4vw, 32px);
    border-bottom: 1px solid var(--line);
  }

  @media (max-width: 1023px) {
    .ps--compact .ps__list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .ps--full .ps__step {
      grid-template-columns: 56px minmax(0, 1fr) minmax(0, 1fr);
    }

    .ps--full .ps__head {
      grid-column: 2 / -1;
    }

    .ps--full .ps__text {
      grid-column: 2;
    }

    .ps__step :global(.ps__num) {
      width: 48px;
    }
  }

  @media (max-width: 767px) {
    .ps--compact .ps__list {
      grid-template-columns: minmax(0, 1fr);
      gap: 28px;
    }

    .ps--compact .ps__step,
    .ps--full .ps__step {
      grid-template-columns: 40px minmax(0, 1fr);
      gap: 10px 16px;
    }

    .ps--compact .ps__step > :not(:global(.ps__num)),
    .ps--full .ps__step > :not(:global(.ps__num)) {
      grid-column: 2;
    }

    .ps--compact .ps__step :global(.ps__num),
    .ps--full .ps__step :global(.ps__num) {
      grid-row: 1 / 4;
    }

    .ps__step :global(.ps__num) {
      width: 40px;
    }
  }
</style>
