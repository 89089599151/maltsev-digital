---
/**
 * «Как идёт работа».
 * На главной (compact) — четыре укрупнённых шага в ряд и ссылка на подробный процесс.
 * На странице услуг — все семь этапов списком: срок, что происходит и что нужно от вас.
 * Секция статична: без закрепления и горизонтальной ленты, на любом экране читается сверху вниз.
 */
import SectionHead from './SectionHead.astro';
import { stages, stagesShort, type Stage } from '@/data/content';
import { url } from '@/lib/url';

interface Props {
  compact?: boolean;
}
const { compact = false } = Astro.props;
const list: (Pick<Stage, 'name' | 'text' | 'duration'> & { fromYou?: string })[] = compact ? stagesShort : stages;
---

<section class:list={['ps section', compact ? 'ps--compact' : 'ps--full']} id="process" data-island-section="Этапы" aria-labelledby="ps-title">
  <SectionHead
    id="ps-title"
    title="Как идёт работа"
    text={compact
      ? 'От заявки до запуска — четыре шага. Каждый согласуем с вами.'
      : 'Семь шагов. Срок пакета — от предоплаты до запуска: с четвёртого по седьмой.'}
    link={compact ? { href: url('/services/#process'), label: 'Все этапы подробно' } : { href: url('/contacts/'), label: 'Обсудить проект' }}
  />

  <ol class="ps__list" data-stagger>
    {
      list.map((s, i) => (
        <li class="ps__step">
          <span class="ps__num num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
          <div class="ps__head">
            <h3 class="ps__name">{s.name}</h3>
            {s.duration && <p class="ps__dur"><span class="chip chip--line">{s.duration}</span></p>}
          </div>
          <p class="ps__text">{s.text}</p>
          {s.fromYou && (
            <p class="ps__you">
              <span>От вас</span>
              {s.fromYou}
            </p>
          )}
        </li>
      ))
    }
  </ol>
</section>

<style>
  .ps__list {
    list-style: none;
    padding: 0;
  }

  /* Номер шага: тонкие крупные цифры акцентом. */
  .ps__num {
    font-family: var(--font-head);
    font-weight: 300;
    font-size: clamp(2.25rem, 1.4rem + 2vw, 3.25rem);
    line-height: 0.9;
    letter-spacing: -0.05em;
    color: var(--accent-text);
  }

  .ps__head {
    display: grid;
    gap: 8px;
  }

  .ps__name {
    font-weight: 500;
    font-size: var(--fs-2);
    line-height: 1.05;
    letter-spacing: -0.035em;
  }

  .ps__dur {
    display: flex;
  }

  .ps__text {
    font-size: var(--fs-0);
    line-height: 1.55;
    color: var(--muted);
  }

  .ps__you {
    display: grid;
    gap: 4px;
    font-size: var(--fs-0);
    line-height: 1.5;
  }

  .ps__you span {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--fs-xs);
    letter-spacing: 0;
    color: var(--muted);
  }

  /* Главная: четыре карточки в ряд; запуск выделен синим. */
  .ps--compact .ps__list {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--gap);
  }

  .ps--compact .ps__step {
    display: grid;
    align-content: start;
    gap: 18px;
    padding: clamp(20px, 1.8vw, 28px);
    border-radius: var(--radius-lg);
    background: var(--paper);
  }

  /* Единый небольшой отступ под номером сохраняет выравнивание названий без пустой полосы. */
  .ps--compact .ps__num {
    margin-bottom: clamp(20px, 2vw, 32px);
  }

  .ps--compact .ps__head {
    gap: 12px;
  }

  .ps--compact .ps__step:last-child {
    background: var(--accent);
    color: var(--accent-ink);
  }

  .ps--compact .ps__step:last-child .ps__num {
    color: var(--accent-ink);
  }

  .ps--compact .ps__step:last-child .ps__text {
    color: var(--on-accent-muted);
  }

  .ps--compact .ps__step:last-child :global(.chip) {
    color: var(--accent-ink);
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.5);
  }

  /* Услуги: строка на этап — номер, название и срок, описание, что нужно от вас. */
  .ps--full .ps__list {
    border-top: 1px solid var(--line);
  }

  .ps--full .ps__step {
    display: grid;
    grid-template-columns: 72px minmax(0, 3fr) minmax(0, 5fr) minmax(0, 4fr);
    gap: 16px clamp(20px, 3vw, 48px);
    align-items: start;
    padding-block: clamp(22px, 2.4vw, 32px);
    border-bottom: 1px solid var(--line);
  }

  @media (max-width: 1023px) {
    .ps--compact .ps__list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .ps--full .ps__step {
      grid-template-columns: 56px minmax(0, 1fr) minmax(0, 1fr);
    }

    .ps--full .ps__head {
      grid-column: 2 / -1;
    }

    .ps--full .ps__text {
      grid-column: 2;
    }

  }

  @media (max-width: 767px) {
    .ps--compact .ps__list {
      grid-template-columns: minmax(0, 1fr);
    }

    .ps--compact .ps__step {
      gap: 14px;
      border-radius: 22px;
    }

    .ps--compact .ps__num {
      margin-bottom: 12px;
    }

    .ps--full .ps__step {
      grid-template-columns: 40px minmax(0, 1fr);
      gap: 10px 16px;
    }

    .ps--full .ps__step > :not(.ps__num) {
      grid-column: 2;
    }

    .ps--full .ps__step .ps__num {
      grid-row: 1 / 4;
      font-size: 1.75rem;
      line-height: 1.1;
    }
  }
</style>
