---
/**
 * «Как идёт работа».
 * На главной (compact) — четыре этапа линией времени на одной белой сцене и ссылка на все семь
 * шагов на странице услуг. На планшете и телефоне линия
 * листается вбок, следующий этап выглядывает справа. На странице услуг — все семь шагов списком: срок, что происходит и что нужно от вас;
 * на телефоне они сворачиваются, как вопросы, — открыт первый (process-accordion.ts). Без скрипта
 * все этапы открыты.
 */
import Icon from './Icon.astro';
import SectionHead from './SectionHead.astro';
import { stages, stagesShort, type Stage } from '@/data/content';
import { url } from '@/lib/url';

interface Props {
  compact?: boolean;
}
const { compact = false } = Astro.props;
const list: (Pick<Stage, 'name' | 'text' | 'duration'> & { fromYou?: string })[] = compact ? stagesShort : stages;
---

<section class:list={['ps section', compact ? 'ps--compact' : 'ps--full']} id="process" data-island-section="Этапы" aria-labelledby="ps-title">
  <SectionHead
    id="ps-title"
    title="Как идёт работа"
    text={compact
      ? 'От заявки до запуска — четыре этапа, в них семь шагов. Каждый согласуем с вами.'
      : 'Семь шагов от заявки до запуска. Срок пакета считается от предоплаты до запуска — с четвёртого шага по седьмой.'}
    link={compact
      ? { href: url('/services/#process'), label: 'Все этапы подробно', short: 'Все этапы' }
      : { href: url('/contacts/'), label: 'Обсудить проект', short: 'Обсудить' }}
  />

  <ol class="ps__list" data-stagger>
    {
      list.map((s, i) => (
        <li class="ps__step">
          {compact ? (
            <p class="ps__mark">
              <span class="ps__num num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            </p>
          ) : (
            <span class="ps__num num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
          )}
          <div class="ps__head">
            <h3 class="ps__name">
              <span data-ps-name>{s.name}</span>
              {!compact && <span class="ps__name-i" aria-hidden="true" hidden><Icon name="plus" /></span>}
            </h3>
            {s.duration && <p class="ps__dur"><span class="chip chip--line">{s.duration}</span></p>}
          </div>
          <div class="ps__body" id={compact ? undefined : `ps-step-${i + 1}`} data-ps-body>
            <p class="ps__text">{s.text}</p>
            {s.fromYou && (
              <p class="ps__you">
                <span>От вас</span>
                {s.fromYou}
              </p>
            )}
          </div>
        </li>
      ))
    }
  </ol>
</section>

{!compact && (
  <script>
    import { initProcessAccordion } from '@/scripts/process-accordion';
    initProcessAccordion();
  </script>
)}

<style>
  /* Обёртка описания не участвует в раскладке: текст и «от вас» — ячейки сетки шага. */
  .ps__body {
    display: contents;
  }

  .ps__list {
    list-style: none;
    padding: 0;
  }

  /* Номер шага: тонкие крупные цифры акцентом. */
  .ps__num {
    font-family: var(--font-head);
    font-weight: 300;
    font-size: clamp(2.25rem, 1.4rem + 2vw, 3.25rem);
    line-height: 0.9;
    letter-spacing: -0.05em;
    color: var(--accent-text);
  }

  .ps__head {
    display: grid;
    gap: 8px;
  }

  .ps__name {
    font-weight: 500;
    font-size: var(--fs-2);
    line-height: 1.05;
    letter-spacing: -0.035em;
  }

  .ps__dur {
    display: flex;
  }

  .ps__text {
    font-size: var(--step-body);
    line-height: 1.55;
    color: var(--muted);
  }

  .ps__you {
    display: grid;
    gap: 4px;
    font-size: var(--step-body);
    line-height: 1.5;
  }

  .ps__you span {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--fs-xs);
    letter-spacing: 0;
    color: var(--muted);
  }

  /*
   * Главная: четыре этапа на одной белой сцене — линия времени, а не четыре отдельные карточки.
   * Точки этапов соединены тонкой линией; запуск, финал пути, отмечен синей точкой, без отдельной
   * синей плашки (синий на главной остаётся за рекомендуемым пакетом и кнопками).
   */
  .ps--compact .ps__list {
    --ps-pad: clamp(28px, 3.3vw, 52px);
    --ps-gap: clamp(24px, 2.6vw, 44px);
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0 var(--ps-gap);
    padding: var(--ps-pad);
    border-radius: var(--radius-lg);
    background: var(--paper);
  }

  .ps--compact .ps__step {
    position: relative;
    display: grid;
    grid-template-rows: auto auto 1fr;
    align-content: start;
    gap: 14px;
    padding-top: 32px;
  }

  /* Точка этапа. */
  .ps--compact .ps__step::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 11px;
    height: 11px;
    border-radius: 50%;
    background: var(--paper);
    box-shadow: inset 0 0 0 1.5px var(--accent);
  }

  .ps--compact .ps__step:last-child::before {
    background: var(--accent);
    box-shadow: 0 0 0 5px var(--accent-soft);
  }

  /* Отрезок линии от точки этапа до точки следующего. */
  .ps--compact .ps__step:not(:last-child)::after {
    content: '';
    position: absolute;
    top: 5px;
    left: 19px;
    right: calc(8px - var(--ps-gap));
    height: 1px;
    background: var(--line);
  }

  /* Когда этапы доходят до экрана, точки по очереди появляются, а линия прорисовывается к следующей
     точке — путь от заявки до запуска читается как движение. Уже видимое при загрузке не анимируется. */
  @media (prefers-reduced-motion: no-preference) {
    :global(.motion-ready) .ps--compact .ps__step.is-in:not(.is-static)::before {
      animation: ps-dot var(--dur-spring) var(--ease-pop) calc(var(--i, 0) * 140ms + 120ms) backwards;
    }

    :global(.motion-ready) .ps--compact .ps__step.is-in:not(.is-static)::after {
      transform-origin: left center;
      animation: ps-line 700ms var(--ease-out) calc(var(--i, 0) * 140ms + 260ms) backwards;
    }
  }

  @keyframes ps-dot {
    from {
      scale: 0;
    }
  }

  @keyframes ps-line {
    from {
      scale: 0 1;
    }
  }

  .ps__mark {
    display: flex;
    align-items: baseline;
    gap: 12px;
  }

  .ps--compact .ps__num {
    font-size: var(--fs-3);
    line-height: 1;
  }

  .ps--compact .ps__head {
    gap: 12px;
  }

  /* Услуги: строка на этап — номер, название и срок, описание, что нужно от вас. */
  .ps--full .ps__list {
    border-top: 1px solid var(--line);
  }

  .ps--full .ps__step {
    display: grid;
    grid-template-columns: 72px minmax(0, 3fr) minmax(0, 5fr) minmax(0, 4fr);
    gap: 16px clamp(20px, 3vw, 48px);
    align-items: start;
    padding-block: clamp(22px, 2.4vw, 32px);
    border-bottom: 1px solid var(--line);
  }

  @media (max-width: 1023px) {
    /* Уже компьютерной ширины линия времени листается вбок внутри сцены: следующий этап
       выглядывает справа, страница не растёт в высоту. */
    .ps--compact .ps__list {
      --ps-gap: 32px;
      --ps-pad: clamp(22px, 4vw, 36px);
      grid-template-columns: none;
      grid-auto-flow: column;
      grid-auto-columns: 44%;
      overflow-x: auto;
      overscroll-behavior-x: contain;
      scroll-snap-type: x mandatory;
      scroll-padding-inline: var(--ps-pad);
      scrollbar-width: none;
    }

    .ps--compact .ps__list::-webkit-scrollbar {
      display: none;
    }

    .ps--compact .ps__step {
      scroll-snap-align: start;
    }

    .ps--compact .ps__num {
      font-size: var(--fs-2);
    }

    .ps--full .ps__step {
      grid-template-columns: 56px minmax(0, 1fr) minmax(0, 1fr);
    }

    .ps--full .ps__head {
      grid-column: 2 / -1;
    }

    .ps--full .ps__text {
      grid-column: 2;
    }

  }

  @media (max-width: 767px) {
    .ps--compact .ps__list {
      grid-auto-columns: 80%;
      border-radius: var(--radius);
    }

    .ps--full .ps__step {
      grid-template-columns: 40px minmax(0, 1fr);
      gap: 10px 16px;
    }

    .ps--full .ps__step > :not(.ps__num) {
      grid-column: 2;
    }

    .ps--full .ps__step .ps__num {
      grid-row: 1 / 4;
      font-size: 1.75rem;
      line-height: 1.1;
    }

    /* Услуги: этапы — раскрывающийся список. Строка этапа целиком нажимается. */
    .ps--full.is-accordion .ps__step:not(.is-open) .ps__body {
      display: none;
    }

    /* Текст открытого этапа проявляется сверху вниз, а не появляется рывком. */
    @media (prefers-reduced-motion: no-preference) {
      .ps--full.is-accordion .ps__step.is-open :is(.ps__text, .ps__you) {
        animation: ps-open 360ms var(--ease-out) both;
      }

      .ps--full.is-accordion .ps__step.is-open .ps__you {
        animation-delay: 60ms;
      }
    }

    .ps--full.is-accordion .ps__step:not(.is-open) {
      row-gap: 0;
    }

    .ps--full.is-accordion .ps__step:not(.is-open) .ps__num {
      grid-row: auto;
    }

    .ps--full.is-accordion .ps__step {
      position: relative;
      padding-block: 18px;
    }

    .ps--full.is-accordion .ps__name {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 12px;
    }
  }

  /* Кнопку названия создаёт скрипт, поэтому её стили глобальные (без метки компонента). */
  :global(.ps__toggle) {
    all: unset;
    display: contents;
  }

  /* Значок «+» нужен только свёрнутому списку на телефоне. */
  .ps__name-i {
    display: none;
  }

  @media (max-width: 767px) {
    .ps--full.is-accordion :global(.ps__toggle) {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 12px;
      width: 100%;
      min-height: 44px;
      cursor: pointer;
      -webkit-tap-highlight-color: transparent;
    }

    /* Нажимается вся строка этапа, а не только название. */
    .ps--full.is-accordion :global(.ps__toggle::after) {
      content: '';
      position: absolute;
      inset: 0;
    }

    /* У открытого этапа нажимается только строка с названием: текст можно выделять и читать. */
    .ps--full.is-accordion .ps__step.is-open :global(.ps__toggle::after) {
      display: none;
    }

    .ps--full.is-accordion :global(.ps__toggle:focus-visible) {
      outline: 3px solid var(--accent);
      outline-offset: 4px;
      border-radius: 8px;
    }

    .ps--full.is-accordion .ps__name-i {
      display: grid;
      place-items: center;
      flex: none;
      width: 32px;
      height: 32px;
      border-radius: 50%;
      background: var(--paper);
      font-size: var(--fs-0);
      transition:
        rotate var(--dur) var(--ease-out),
        background-color var(--dur-fast) var(--ease-out),
        color var(--dur-fast) var(--ease-out);
    }

    .ps--full.is-accordion .ps__step.is-open .ps__name-i {
      rotate: 45deg;
      background: var(--accent);
      color: var(--accent-ink);
    }
  }

  @keyframes ps-open {
    from {
      opacity: 0;
      transform: translateY(-6px);
    }
  }
</style>
