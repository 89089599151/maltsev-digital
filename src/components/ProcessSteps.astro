---
/**
 * «Как идёт работа»: семь этапов лентой карточек.
 * На широком экране лента едет горизонтально, пока секция закреплена (GSAP, data-hscroll).
 * Без скрипта — горизонтальная прокрутка с прилипанием; на телефоне — вертикальный список.
 */
import PixelWord from './PixelWord.astro';
import SectionHead from './SectionHead.astro';
import { stages } from '@/data/content';
import { url } from '@/lib/url';
---

<section class="ps section" id="process" aria-labelledby="ps-title" data-hscroll>
  <SectionHead
    id="ps-title"
    title="Как идёт работа"
    text="Семь шагов от заявки до запуска. На каждом вы знаете, что происходит, сколько это займёт и что нужно от вас."
    link={{ href: url('/contacts/'), label: 'Начать с заявки' }}
  />

  <div class="ps__viewport" data-hscroll-viewport>
    <ol class="ps__track" data-hscroll-track>
      {
        stages.map((s, i) => (
          <li class:list={['ps__step', { 'ps__step--last': i === stages.length - 1 }]}>
            <div class="ps__top">
              <PixelWord text={String(i + 1).padStart(2, '0')} class="ps__num" />
              <p class="ps__dur">{s.duration}</p>
            </div>
            <div class="ps__body">
              <h3 class="ps__name">{s.name}</h3>
              <p class="ps__text">{s.text}</p>
            </div>
            <p class="ps__you">
              <span>От вас</span>
              {s.fromYou}
            </p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .ps__viewport {
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    border-radius: var(--radius-lg);
  }

  .ps__viewport::-webkit-scrollbar {
    display: none;
  }

  /* Когда работает GSAP, ленту двигает он, а не прокрутка. */
  .ps__viewport:global(.is-pinned) {
    overflow: hidden;
  }

  .ps__track {
    list-style: none;
    padding: 0;
    display: flex;
    gap: var(--gap);
    width: max-content;
  }

  .ps__step {
    display: flex;
    flex-direction: column;
    gap: clamp(24px, 2.4vw, 32px);
    width: clamp(310px, 29vw, 440px);
    min-height: 460px;
    padding: clamp(26px, 2.8vw, 40px);
    border-radius: var(--radius-lg);
    background: var(--surface);
    scroll-snap-align: start;
  }

  .ps__step:first-child {
    background: var(--night);
    color: var(--night-ink);
  }

  .ps__step--last {
    background: var(--accent);
  }

  .ps__step :global(.ps__num) {
    width: 72px;
    height: auto;
    color: var(--accent);
  }

  .ps__step--last :global(.ps__num) {
    color: var(--ink);
  }

  .ps__top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 16px;
  }

  .ps__body {
    display: grid;
    gap: 14px;
  }

  .ps__name {
    font-size: clamp(1.5rem, 1rem + 1.1vw, 2.125rem);
    line-height: 0.95;
    letter-spacing: -0.04em;
    text-transform: uppercase;
  }

  .ps__text {
    font-size: 1rem;
    line-height: 1.55;
    color: var(--muted);
  }

  .ps__step:first-child .ps__text {
    color: var(--night-muted);
  }

  .ps__step--last .ps__text {
    color: #3d1d06;
  }

  .ps__dur {
    flex: none;
    padding: 6px 10px;
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.6);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.875rem;
    color: var(--ink);
  }

  /* Что нужно от клиента — внизу карточки, отдельной короткой репликой. */
  .ps__you {
    display: grid;
    gap: 4px;
    margin-top: auto;
    font-size: 0.9375rem;
    line-height: 1.45;
    color: var(--ink);
  }

  .ps__you span {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.8125rem;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .ps__step:first-child .ps__you span {
    color: var(--night-muted);
  }

  .ps__step--last .ps__you span {
    color: #3d1d06;
  }

  .ps__step:first-child .ps__you {
    color: var(--night-ink);
  }

  @media (max-width: 767px) {
    .ps__viewport {
      overflow: visible;
    }

    .ps__track {
      flex-direction: column;
      width: auto;
    }

    .ps__step {
      width: auto;
      min-height: 0;
      border-radius: 22px;
    }

    .ps__step :global(.ps__num) {
      width: 54px;
    }
  }
</style>
