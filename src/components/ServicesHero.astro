---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import { genImage } from '@/lib/gen';
import { url } from '@/lib/url';
import { minPrice, formatPrice, paymentTerms, pricingConfirmed } from '@/config/pricing';

const sculpture = genImage('services-assembly');
---

<section class="sh" aria-labelledby="sv-title" data-tilt-area>
  <div class="sh__grid" aria-hidden="true"></div>
  <div class="sh__copy">
    <p class="sh__eyebrow"><span></span> Услуги и цены <i>01 — 03</i></p>
    <h1 id="sv-title">Хорошая идея.<br /><em>Сильный сайт.</em></h1>
    <p class="sh__lead">Превращаю вашу задачу в сайт, который понятно рассказывает о бизнесе и помогает получать заявки.</p>
    <div class="sh__actions">
      <a class="btn btn--ink" href="#plans" data-magnetic>Выбрать формат <span class="arrow" aria-hidden="true"><Icon name="arrow" /></span></a>
      <a class="sh__calc" href="#calculator">Рассчитать свой сайт <Icon name="arrow" /></a>
    </div>
    <p class="sh__signature">Дизайн, код и запуск.<br />Один человек отвечает за всё.</p>
  </div>
  <div class="sh__visual" aria-hidden="true">
    <div class="sh__orbit"></div>
    <span class="sh__coord sh__coord--top">ИДЕЯ → ИНТЕРФЕЙС</span>
    <span class="sh__cross sh__cross--one">+</span><span class="sh__cross sh__cross--two">+</span>
    <div class="sh__object" data-float="15">
      {sculpture && <Image src={sculpture.src} alt="" widths={[480, 768, 1100]} sizes="(max-width: 767px) 100vw, 60vw" quality={80} loading="eager" fetchpriority="high" />}
    </div>
    <div class="sh__price"><span>Сайт под ключ</span><strong><small>от</small> {formatPrice(minPrice)}</strong><i>Точная сумма — до начала работы</i></div>
  </div>
  <div class="sh__terms">
    <div><span class="sh__term-n">01</span><p><strong>Цена зафиксирована</strong>Меняется только вместе с задачей.{!pricingConfirmed && ' Цены предварительные.'}</p></div>
    <div><span class="sh__term-n">02</span><p><strong>Понятная оплата</strong>{paymentTerms}</p></div>
    <a href={url('/contacts/')}><span class="sh__term-n">↗</span><p><strong>Начнём с разговора</strong>Расскажите, что хотите сделать.</p></a>
  </div>
</section>

<style>
  .sh { position: relative; isolation: isolate; overflow: hidden; display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); margin-top: var(--margin); padding: clamp(28px, 4vw, 64px); border-radius: var(--radius-lg); background: var(--paper); }
  .sh__grid { position: absolute; z-index: -1; inset: 0 0 0 45%; background-image: linear-gradient(rgba(26,47,251,.055) 1px, transparent 1px), linear-gradient(90deg, rgba(26,47,251,.055) 1px, transparent 1px); background-size: 58px 58px; mask-image: linear-gradient(90deg,transparent,black); }
  .sh__copy { position: relative; z-index: 2; padding-block: 8px 42px; }
  .sh__eyebrow { display: flex; gap: 10px; align-items: center; margin-bottom: clamp(28px, 4vw, 58px); font-size: var(--fs-xs); }
  .sh__eyebrow > span { width: 7px; height: 7px; border-radius: 50%; background: var(--accent); }
  .sh__eyebrow i { margin-left: 28px; color: var(--muted); font-style: normal; }
  h1 { font-weight: 330; font-size: clamp(3rem, 5.5vw, 5.4rem); line-height: 1.01; letter-spacing: -.065em; }
  h1 em { color: var(--accent-text); font-style: normal; }
  .sh__lead { max-width: 36ch; margin-top: 26px; font-size: var(--fs-1); line-height: 1.5; color: var(--ink-2); }
  .sh__actions { display: flex; flex-wrap: wrap; align-items: center; gap: 20px; margin-top: 30px; }
  .sh__calc { display: inline-flex; gap: 10px; align-items: center; min-height: 44px; font-size: var(--fs-xs); text-decoration: none; }
  .sh__calc :global(svg) { width: 16px; transition: translate .35s var(--ease-out); }
  .sh__calc:hover :global(svg) { translate: 4px 0; }
  .sh__signature { margin-top: 34px; padding-left: 16px; border-left: 2px solid var(--accent); font-size: var(--fs-xs); line-height: 1.5; color: var(--muted); }
  .sh__visual { position: relative; align-self: stretch; min-height: 460px; }
  .sh__orbit { position: absolute; width: 82%; aspect-ratio: 1; top: 6%; left: 5%; border: 1px solid rgba(26,47,251,.2); border-radius: 50%; }
  .sh__orbit::before { content: ''; position: absolute; inset: 13%; border: 1px dashed rgba(26,47,251,.16); border-radius: 50%; }
  .sh__orbit::after { content: ''; position: absolute; width: 10px; height: 10px; background: var(--accent); border-radius: 50%; left: 12%; top: 12%; box-shadow: 0 0 0 8px var(--accent-soft); }
  .sh__coord { position: absolute; top: 4%; right: 0; font-size: 10px; letter-spacing: .15em; color: var(--accent-text); }
  .sh__cross { position: absolute; color: var(--accent); font-size: 24px; font-weight: 300; }
  .sh__cross--one { top: 6%; left: 7%; }.sh__cross--two { right: 0; bottom: 24%; }
  .sh__object { position: absolute; width: 122%; left: -10%; top: 7%; }
  .sh__object :global(img) { width: 100%; height: auto; }
  .sh__price { position: absolute; z-index: 2; bottom: 30px; right: -12px; display: grid; gap: 8px; padding: 24px 30px; border-radius: 24px; background: var(--accent); color: white; box-shadow: 0 26px 50px -30px rgba(26,47,251,.7); rotate: -4deg; }
  .sh__price > span { font-size: var(--fs-xs); }.sh__price strong { font-size: clamp(2rem, 3.3vw, 3.5rem); font-weight: 380; line-height: 1; letter-spacing: -.05em; white-space: nowrap; }.sh__price small { font-size: .4em; }.sh__price i { font-size: 11px; font-style: normal; color: var(--on-accent-muted); }
  .sh__terms { position: relative; z-index: 2; grid-column: 1 / -1; display: grid; grid-template-columns: 1fr 1.3fr 1fr; gap: 28px; border-top: 1px solid var(--line); padding-top: 25px; }
  .sh__terms > * { display: flex; gap: 16px; align-items: flex-start; color: inherit; text-decoration: none; }
  .sh__term-n { color: var(--accent-text); font-size: var(--fs-xs); line-height: 1.7; }
  .sh__terms p { display: grid; gap: 8px; max-width: 34ch; font-size: var(--fs-xs); line-height: 1.5; color: var(--muted); }.sh__terms strong { color: var(--ink); font-weight: 550; }.sh__terms a:hover strong { color: var(--accent-text); }
  @media (prefers-reduced-motion: no-preference) { .sh__copy { animation: sh-enter 1s var(--ease-out) both; }.sh__object { animation: sh-enter 1.4s var(--ease-out) .15s both; }.sh__price { animation: sh-enter 1.1s var(--ease-out) .35s both; } }
  @keyframes sh-enter { from { opacity: 0; transform: translateY(25px); } }
  @media (max-width: 1100px) { .sh__terms { grid-template-columns: 1fr 1fr; }.sh__terms > a { grid-column: 1 / -1; }.sh__visual { min-height: 410px; }.sh__price { right: -10px; padding: 20px; } }
  @media (max-width: 767px) { .sh { grid-template-columns: 1fr; padding: 26px 22px; border-radius: 24px; }.sh__copy { padding-bottom: 12px; }.sh__eyebrow { margin-bottom: 28px; }h1 { font-size: clamp(2.8rem, 12.5vw, 4.5rem); }.sh__lead { font-size: var(--step-body); }.sh__signature { display: none; }.sh__visual { min-height: 330px; margin-top: 10px; }.sh__object { width: 116%; left: -8%; top: 0; }.sh__price { bottom: 22px; right: 0; padding: 18px 22px; }.sh__terms { grid-template-columns: 1fr; gap: 20px; }.sh__terms > a { grid-column: auto; }.sh__grid { inset: 35% 0 0; }.sh__price strong { font-size: 2rem; } }
</style>
