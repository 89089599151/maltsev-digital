---
/**
 * «Авторский след» — выбранный знак Maltsev Digital.
 * Векторный мастер один для шапки и экспортируемых иконок; цвет задаёт родитель.
 */
import Fingerprint from '@/assets/brand/fingerprint.svg';

interface Props {
  class?: string;
}
const { class: cls } = Astro.props;
---

<Fingerprint class:list={['lm', cls]} aria-hidden="true" focusable="false" />

<style>
  .lm {
    display: block;
    flex: none;
  }
</style>
