---
/** Знак: буква M, собранная из трёх блоков разной высоты — как сайт из модулей. */
interface Props {
  size?: number;
  class?: string;
}
const { size = 28, class: cls } = Astro.props;
---

<svg
  class={cls}
  width={size}
  height={size}
  viewBox="0 0 32 32"
  aria-hidden="true"
  focusable="false"
>
  <rect x="2" y="4" width="8" height="24" rx="1.5" fill="currentColor"></rect>
  <rect x="12" y="4" width="8" height="13" rx="1.5" fill="currentColor"></rect>
  <rect x="22" y="4" width="8" height="24" rx="1.5" fill="currentColor"></rect>
</svg>
