---
/**
 * Скриншот сайта в ровном окне браузера: светлая рамка, три точки, без наклонов.
 * Один вид для витрины кейса на главной и для экранов на странице кейса.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  widths?: number[];
  sizes?: string;
  loading?: 'lazy' | 'eager';
  class?: string;
}
const { src, alt, widths = [640, 960, 1280, 1600], sizes = '100vw', loading = 'lazy', class: cls } = Astro.props;
---

<div class:list={['bs', cls]}>
  <span class="bs__bar" aria-hidden="true"><i></i><i></i><i></i></span>
  <Image src={src} alt={alt} widths={widths} sizes={sizes} loading={loading} />
</div>

<style>
  .bs {
    border-radius: 14px;
    background: var(--paper);
    box-shadow:
      0 0 0 1px rgba(10, 11, 20, 0.08),
      0 40px 70px -40px rgba(16, 32, 200, 0.45);
    overflow: hidden;
  }

  .bs__bar {
    display: flex;
    gap: 6px;
    padding: 10px 12px;
    border-bottom: 1px solid rgba(10, 11, 20, 0.08);
  }

  .bs__bar i {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--surface-3);
  }

  .bs img {
    width: 100%;
    height: auto;
    aspect-ratio: 1425 / 900;
    object-fit: cover;
    object-position: top;
  }

  @media (max-width: 767px) {
    .bs {
      border-radius: 10px;
    }

    .bs__bar {
      gap: 4px;
      padding: 7px 9px;
    }

    .bs__bar i {
      width: 6px;
      height: 6px;
    }
  }
</style>
