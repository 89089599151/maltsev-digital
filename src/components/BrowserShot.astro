---
/**
 * Скриншот сайта в ровном окне браузера: белая рамка с тонкой верхней полосой, без «светофора»,
 * наклонов и цветных теней. Один вид для витрины кейса на главной и для экранов на странице кейса.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  widths?: number[];
  sizes?: string;
  loading?: 'lazy' | 'eager';
  class?: string;
}
const { src, alt, widths = [640, 960, 1280, 1600], sizes = '100vw', loading = 'lazy', class: cls } = Astro.props;
---

<div class:list={['bs', cls]}>
  <span class="bs__bar" aria-hidden="true"></span>
  <Image src={src} alt={alt} widths={widths} sizes={sizes} loading={loading} />
</div>

<style>
  .bs {
    border-radius: 14px;
    background: var(--paper);
    box-shadow: 0 0 0 1px rgba(10, 11, 20, 0.08);
    overflow: hidden;
  }

  .bs__bar {
    display: block;
    height: 14px;
    border-bottom: 1px solid rgba(10, 11, 20, 0.08);
  }

  .bs img {
    width: 100%;
    height: auto;
    aspect-ratio: 1425 / 900;
    object-fit: cover;
    object-position: top;
  }

  @media (max-width: 767px) {
    .bs {
      border-radius: 10px;
    }

    .bs__bar {
      height: 10px;
    }
  }
</style>
