---
/** Сообщение, когда приём заявок ещё не подключён (нет ID Formspree). */
import ContactLink from './ContactLink.astro';

interface Props {
  tone?: 'dark' | 'accent';
}
const { tone = 'dark' } = Astro.props;
---

<div class={`fn fn--${tone}`} role="note">
  <p class="fn__title">Онлайн-форма ещё не подключена.</p>
  <p>Заявки через сайт заработают сразу после подключения сервиса. Сейчас удобнее написать напрямую:</p>
  <div class="fn__links">
    <ContactLink kind="telegram" />
    <ContactLink kind="email" />
  </div>
</div>

<style>
  .fn {
    display: grid;
    gap: 12px;
    padding: var(--pad);
    border-radius: var(--radius);
    background: var(--surface-2);
  }

  .fn--accent {
    background: var(--accent-deep);
    color: var(--accent-ink);
  }

  .fn--accent :global(.cl) {
    background: rgba(255, 255, 255, 0.92);
    color: var(--ink);
  }

  .fn--accent :global(.cl__label),
  .fn--accent :global(.cl--pending .cl__value) {
    color: var(--muted);
  }

  .fn__title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.25rem;
    letter-spacing: -0.02em;
  }

  .fn__links {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--gap);
    margin-top: 6px;
  }

  @media (max-width: 767px) {
    .fn__links {
      grid-template-columns: 1fr;
    }
  }
</style>
