---
/**
 * Финал главной: тёмная сцена. Слева — прямые контакты крупными кнопками,
 * справа — короткая форма заявки (Formspree; без подключённого сервиса форма честно отключена).
 */
import { Image } from 'astro:assets';
import ContactIcon from './ContactIcon.astro';
import ChannelSwitch from './ChannelSwitch.astro';
import { site, telegramUrl, emailUrl } from '@/config/site';
import { url } from '@/lib/url';
import avatar from '@/assets/photos/owner-avatar.webp';
import Icon from './Icon.astro';

const endpoint = site.forms.formspreeId ? `https://formspree.io/f/${site.forms.formspreeId}` : '';
const tg = telegramUrl();
const mail = emailUrl('Заявка на разработку сайта');
---

<section class="ct section" id="contact" data-island-section="Заявка" aria-labelledby="ct-title">
  <div class="ct__stage">
    <div class="ct__info">
      <h2 id="ct-title" class="ct__title" data-split>Расскажите о задаче</h2>
      <p class="ct__sub">
        Задам пару вопросов и пришлю план со сроками и ценой. Отвечаю {site.contacts.hours}.
      </p>

      <div class="ct__direct">
        {
          tg && (
            <a class="ct__link" href={tg} target="_blank" rel="noopener">
              <span class="ct__ico"><ContactIcon kind="telegram" /></span>
              <span class="ct__lt">
                <span class="ct__ll">Telegram</span>
                <span class="ct__lv">@{site.contacts.telegram.value}</span>
              </span>
              <span class="ct__arr" aria-hidden="true"><Icon name="arrow-ne" /></span>
            </a>
          )
        }
        {
          mail && (
            <a class="ct__link" href={mail}>
              <span class="ct__ico"><ContactIcon kind="email" /></span>
              <span class="ct__lt">
                <span class="ct__ll">Почта</span>
                <span class="ct__lv">{site.contacts.email.value}</span>
              </span>
              <span class="ct__arr" aria-hidden="true"><Icon name="arrow-ne" /></span>
            </a>
          )
        }
      </div>

      <div class="ct__person">
        <Image class="ct__avatar" src={avatar} alt="" width={56} height={56} loading="lazy" />
        <p>
          <strong>{site.brand.owner.value}</strong>
          <span>Пишете напрямую исполнителю</span>
        </p>
      </div>
    </div>

    <div class="ct__card">
      <p class="ct__card-t">Короткая заявка</p>

      <form class="ct__form" data-lead-form data-endpoint={endpoint} data-mailto={endpoint ? undefined : site.contacts.email.value} data-telegram={endpoint ? undefined : tg} method="post" action={endpoint || undefined}>
        <fieldset>
          <legend class="sr-only">Короткая заявка</legend>
          <input type="hidden" name="_subject" value="Короткая заявка с главной" />
          <input type="hidden" name="source" value="Главная, блок контактов" />
          <div class="hp" aria-hidden="true"><input type="text" name="_gotcha" tabindex="-1" autocomplete="off" /></div>

          <label class="ct__field">
            <span class="ct__label">Ваше имя</span>
            <input name="name" type="text" autocomplete="name" required minlength="2" data-error-id="ct-name-err" aria-describedby="ct-name-err" />
          </label>
          <span class="ct__err" id="ct-name-err"></span>

          <label class="ct__field">
            <span class="ct__label">Telegram, телефон или почта</span>
            <input name="contact" type="text" required minlength="4" data-error-id="ct-contact-err" aria-describedby="ct-contact-err" />
          </label>
          <span class="ct__err" id="ct-contact-err"></span>

          <label class="ct__field">
            <span class="ct__label">Коротко о задаче <span class="ct__opt">— необязательно</span></span>
            <textarea name="message" rows="3"></textarea>
          </label>

          <label class="ct__consent">
            <input type="checkbox" name="consent" value="Согласие получено" required data-error-id="ct-consent-err" aria-describedby="ct-consent-err" />
            <span>Согласен на обработку персональных данных по <a href={url('/privacy/')}>политике</a></span>
          </label>
          <span class="ct__err" id="ct-consent-err"></span>

          {!endpoint && <ChannelSwitch id="ct" />}

          <button class="ct__submit" type="submit">
            <span data-label>{endpoint ? 'Отправить заявку' : 'Отправить на почту'}</span>
          </button>
          <p class="ct__status" data-status role="status" aria-live="polite"></p>
        </fieldset>
      </form>
      <div class="ct__success" data-success hidden tabindex="-1">
        <p class="head-sm">Заявка получена</p>
        <p>Спасибо! Свяжусь с вами {site.contacts.responseTime.value} по указанному контакту.</p>
      </div>

      <a class="ct__brief" href={url('/contacts/')}>Заполнить подробный бриф <span aria-hidden="true"><Icon name="arrow" /></span></a>
    </div>
  </div>
</section>

<script>
  import { initLeadForms } from '@/scripts/forms';
  initLeadForms();
</script>

<style>
  /* Одна тёмная сцена на оба столбца: белая карточка формы вложена в неё, как скриншоты в блоке «Работы». */
  .ct__stage {
    display: grid;
    grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
    gap: clamp(24px, 3vw, 56px);
    align-items: stretch;
    padding: clamp(12px, 1.2vw, 18px);
    padding-left: clamp(24px, 4vw, 64px);
    border-radius: var(--radius-lg);
    background:
      radial-gradient(70% 90% at 0% 100%, rgba(26, 47, 251, 0.34) 0%, rgba(26, 47, 251, 0) 68%),
      var(--night);
    color: var(--night-ink);
  }

  .ct__info {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    padding-block: clamp(24px, 3.4vw, 56px);
  }

  .ct__title {
    font-size: clamp(2.5rem, 1rem + 4.4vw, 5.5rem);
    line-height: 1;
    letter-spacing: -0.045em;
    max-width: 10ch;
  }

  .ct__sub {
    max-width: 44ch;
    font-size: var(--step-body);
    color: var(--night-muted);
  }

  .ct__direct {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    max-width: 520px;
    gap: var(--space-3);
    margin-top: var(--space-2);
  }

  .ct__link {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    gap: var(--space-4);
    align-items: center;
    min-height: 76px;
    padding: 14px 18px;
    border-radius: var(--radius);
    background: rgba(241, 242, 250, 0.08);
    color: var(--night-ink);
    text-decoration: none;
    transition: background-color var(--dur-fast) var(--ease-out), color var(--dur-fast) var(--ease-out);
  }

  .ct__link:hover {
    background: var(--accent);
    color: var(--accent-ink);
  }

  .ct__ico {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--accent);
    color: var(--accent-ink);
  }

  .ct__link:hover .ct__ico {
    background: var(--paper);
    color: var(--accent-text);
  }

  .ct__lt {
    display: grid;
    gap: 2px;
    min-width: 0;
  }

  .ct__ll {
    font-size: var(--fs-xs);
    opacity: 0.8;
  }

  /* Адрес почты не рвётся посреди слова: на узком экране кегль чуть меньше. */
  .ct__lv {
    font-family: var(--font-display);
    font-weight: 560;
    font-size: clamp(0.875rem, 3.7vw, 1.0625rem);
    overflow-wrap: anywhere;
  }

  .ct__arr {
    font-size: var(--step-body);
  }

  /* Подпись исполнителя прижата к низу сцены — столбцы заканчиваются на одной линии. */
  .ct__person {
    display: flex;
    gap: 14px;
    align-items: center;
    margin-top: auto;
    padding-top: var(--space-6);
  }

  .ct__avatar {
    width: 56px;
    height: 56px;
    border-radius: 50%;
    box-shadow: 0 0 0 3px var(--accent);
  }

  .ct__person p {
    display: grid;
    font-size: var(--step-small);
    color: var(--night-muted);
  }

  .ct__person strong {
    font-family: var(--font-display);
    color: var(--night-ink);
  }

  /* Карточка формы */
  .ct__card {
    display: grid;
    gap: var(--space-4);
    align-content: start;
    padding: clamp(var(--space-6), 2.6vw, 40px);
    border-radius: calc(var(--radius-lg) - 8px);
    background: var(--paper);
    color: var(--ink);
  }

  .ct__card-t {
    font-family: var(--font-head);
    font-weight: 560;
    font-size: var(--fs-2);
    letter-spacing: -0.03em;
  }


  .ct__form {
    width: 100%;
  }

  fieldset {
    display: grid;
    gap: var(--space-4);
    min-width: 0;
    margin: 0;
    padding: 0;
    border: 0;
  }

  fieldset:disabled {
    opacity: 0.62;
  }

  .ct__field {
    display: grid;
    gap: var(--space-2);
  }

  .ct__label {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--step-small);
  }

  .ct__opt {
    font-weight: 400;
    color: var(--muted);
  }

  .ct__field input,
  .ct__field textarea {
    width: 100%;
    min-height: 52px;
    padding: 13px 16px;
    border: 2px solid transparent;
    border-radius: var(--radius-sm);
    background: var(--surface-2);
    color: var(--ink);
    font: inherit;
    font-family: var(--font-display);
    transition: border-color var(--dur-fast) var(--ease-out), background-color var(--dur-fast) var(--ease-out);
  }

  .ct__field textarea {
    resize: vertical;
    min-height: 92px;
  }

  .ct__field input:hover,
  .ct__field textarea:hover {
    background: var(--surface-3);
  }

  .ct__field input:focus,
  .ct__field textarea:focus {
    outline: none;
    background: var(--surface-solid);
    border-color: var(--ink);
  }

  .ct__field input[aria-invalid='true'] {
    border-color: var(--danger);
  }

  .ct__err {
    font-family: var(--font-display);
    font-size: var(--step-small);
    font-weight: 600;
    color: var(--danger);
  }

  .ct__err:empty {
    display: none;
  }

  .ct__consent {
    display: flex;
    gap: 10px;
    align-items: flex-start;
    margin-top: 6px;
    font-size: var(--step-small);
    color: var(--muted);
    cursor: pointer;
  }

  .ct__consent input {
    width: 20px;
    height: 20px;
    flex: none;
    accent-color: var(--accent);
  }

  .ct__submit {
    min-height: 58px;
    margin-top: 8px;
    border-radius: var(--radius-sm);
    background: var(--accent);
    color: var(--accent-ink);
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--step-body);
    transition: background-color var(--dur-fast) var(--ease-out), transform var(--dur-fast) var(--ease-out);
  }

  .ct__submit:hover:not(:disabled) {
    background: var(--accent-hover);
  }

  .ct__submit:active:not(:disabled) {
    transform: scale(0.98);
  }

  .ct__submit:disabled {
    cursor: not-allowed;
  }

  .ct__status {
    font-family: var(--font-display);
    font-weight: 600;
  }

  .ct__status:empty {
    display: none;
  }

  .ct__success {
    display: grid;
    gap: 8px;
    padding: 20px;
    border-radius: var(--radius);
    background: var(--accent-soft);
  }

  .ct__brief {
    justify-self: start;
    display: inline-flex;
    align-items: flex-end;
    gap: 6px;
    min-height: 44px;
    font-family: var(--font-display);
    font-weight: 560;
    text-decoration: none;
    border-bottom: 2px solid var(--accent);
    padding-bottom: 2px;
  }

  @media (max-width: 1023px) {
    .ct__stage {
      grid-template-columns: 1fr;
      gap: 0;
      padding: clamp(10px, 1.6vw, 16px);
    }

    .ct__info {
      padding: clamp(16px, 3vw, 32px) clamp(10px, 2.4vw, 28px) clamp(24px, 3.4vw, 40px);
    }

    .ct__person {
      margin-top: 0;
      padding-top: 0;
    }
  }

  @media (max-width: 767px) {
    .ct__stage {
      border-radius: 24px;
    }

    .ct__card {
      padding: 20px;
      border-radius: 16px;
    }
  }

  /* На телефоне адрес почты должен встать в одну строку: стрелка уходит, поля плашки меньше. */
  @media (max-width: 479px) {
    .ct__link {
      grid-template-columns: auto minmax(0, 1fr);
      gap: 8px;
      padding-inline: 8px;
    }

    .ct__ico {
      width: 32px;
      height: 32px;
    }

    .ct__arr {
      display: none;
    }
  }
</style>
