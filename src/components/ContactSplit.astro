---
/**
 * Финал главной: одна тёмная сцена. Слева — заголовок, пояснение и подпись исполнителя.
 * Справа — главное действие: белая кнопка «Написать в Telegram» (самый быстрый путь), под ней
 * строки почты и заявки с выбором пакета, в том же виде, что контакты в подвале.
 * Когда подключён сервис отправки заявок, справа появляется короткая форма (LeadForm),
 * а Telegram и почта переходят строками в левую колонку.
 */
import { Image } from 'astro:assets';
import LeadForm from './LeadForm.astro';
import Icon from './Icon.astro';
import { site, telegramUrl, emailUrl } from '@/config/site';
import { url } from '@/lib/url';
// Портрет шире обычного аватара: голова, плечи и огни города, а не одно крупное лицо.
import avatar from '@/assets/photos/owner-avatar-wide.webp';

const hasForm = Boolean(site.forms.formspreeId);
const tg = telegramUrl();
const mail = emailUrl('Заявка на разработку сайта');
---

<section class="ct section" id="contact" data-island-section="Заявка" aria-labelledby="ct-title">
  <div class:list={['ct__stage', { 'ct__stage--form': hasForm }]}>
    <div class="ct__info">
      <h2 id="ct-title" class="ct__title">Расскажите о задаче</h2>
      <p class="ct__sub">
        Задам пару вопросов и пришлю план со сроками и ценой. Отвечаю {site.contacts.hours}.
      </p>

      {hasForm && (
        <ul class="ct__rows">
          {tg && (
            <li>
              <a class="ct__row" href={tg} target="_blank" rel="noopener">
                <span class="ct__row-l">Telegram</span>
                <span class="ct__row-v">@{site.contacts.telegram.value}</span>
                <span class="ct__row-i" aria-hidden="true"><Icon name="arrow-ne" /></span>
              </a>
            </li>
          )}
          {mail && (
            <li>
              <a class="ct__row" href={mail}>
                <span class="ct__row-l">Почта</span>
                <span class="ct__row-v">{site.contacts.email.value}</span>
                <span class="ct__row-i" aria-hidden="true"><Icon name="arrow-ne" /></span>
              </a>
            </li>
          )}
        </ul>
      )}

      <div class="ct__person">
        <Image class="ct__avatar" src={avatar} alt="" width={56} height={56} loading="lazy" />
        <p>
          <strong>{site.brand.owner.value}</strong>
          <span>Пишете напрямую исполнителю</span>
        </p>
      </div>
    </div>

    {hasForm ? (
      <LeadForm />
    ) : (
      <div class="ct__actions">
        {tg && (
          <a class="btn ct__tg" href={tg} target="_blank" rel="noopener">Написать в Telegram</a>
        )}
        <ul class="ct__rows">
          {mail && (
            <li>
              <a class="ct__row" href={mail}>
                <span class="ct__row-l">Почта</span>
                <span class="ct__row-v">{site.contacts.email.value}</span>
                <span class="ct__row-i" aria-hidden="true"><Icon name="arrow-ne" /></span>
              </a>
            </li>
          )}
          <li>
            <a class="ct__row" href={url('/contacts/')}>
              <span class="ct__row-l">Заявка</span>
              <span class="ct__row-v">С выбором пакета и сроков</span>
              <span class="ct__row-i" aria-hidden="true"><Icon name="arrow" /></span>
            </a>
          </li>
        </ul>
      </div>
    )}
  </div>
</section>

<style>
  /* Одна тёмная сцена, плоская: без пятен и свечения. */
  .ct__stage {
    display: grid;
    grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
    gap: clamp(24px, 3vw, 56px);
    align-items: end;
    padding: clamp(32px, 4.4vw, 64px);
    border-radius: var(--radius-lg);
    background: var(--night);
    color: var(--night-ink);
  }

  /* С формой: белая карточка вложена с равным отступом 16px со всех сторон. */
  .ct__stage--form {
    align-items: stretch;
    padding: 16px;
    padding-left: clamp(24px, 4vw, 64px);
  }

  .ct__stage--form .ct__info {
    padding-block: clamp(24px, 3.4vw, 48px);
  }

  .ct__info {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    min-width: 0;
  }

  .ct__title {
    font-size: var(--fs-5);
    line-height: 1.02;
    letter-spacing: -0.045em;
    max-width: 12ch;
  }

  .ct__sub {
    max-width: 44ch;
    font-size: var(--step-body);
    color: var(--night-muted);
  }

  /* Подпись исполнителя прижата к низу сцены — столбцы заканчиваются на одной линии. */
  .ct__person {
    display: flex;
    gap: 14px;
    align-items: center;
    margin-top: auto;
    padding-top: var(--space-6);
  }

  .ct__avatar {
    width: 56px;
    height: 56px;
    border-radius: 50%;
    box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.16);
  }

  .ct__person p {
    display: grid;
    font-size: var(--step-small);
    color: var(--night-muted);
  }

  .ct__person strong {
    font-weight: 500;
    color: var(--night-ink);
  }

  /* Действия: белая кнопка на тёмном (обратный цвет поверхности), под ней строки. */
  .ct__actions {
    display: grid;
    gap: var(--space-4);
    min-width: 0;
  }

  .ct__tg {
    justify-self: stretch;
    background: var(--paper);
    color: var(--ink);
  }

  .ct__tg:is(:hover, :focus-visible) {
    background: var(--bg);
  }

  .ct__tg:focus-visible,
  .ct__row:focus-visible {
    outline-color: var(--paper);
  }

  /* Строки контактов — как в подвале: подпись мелко, значение крупнее, стрелка справа. */
  .ct__rows {
    list-style: none;
    padding: 0;
    border-top: 1px solid rgba(241, 242, 250, 0.14);
  }

  .ct__rows li {
    border-bottom: 1px solid rgba(241, 242, 250, 0.14);
  }

  .ct__row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    grid-template-areas:
      'label icon'
      'value icon';
    gap: 2px 16px;
    align-items: center;
    min-height: 68px;
    padding-block: 12px;
    color: var(--night-ink);
    text-decoration: none;
  }

  .ct__row-l {
    grid-area: label;
    font-size: var(--fs-xs);
    color: var(--night-muted);
  }

  /* Адрес почты не рвётся посреди слова: на узком экране кегль чуть меньше. */
  .ct__row-v {
    grid-area: value;
    font-weight: 500;
    font-size: clamp(0.9375rem, 3.9vw, 1.0625rem);
    overflow-wrap: anywhere;
    transition: color var(--dur-fast) var(--ease-out);
  }

  .ct__row-i {
    grid-area: icon;
    color: var(--night-muted);
    transition:
      color var(--dur-fast) var(--ease-out),
      transform var(--dur-fast) var(--ease-out);
  }

  .ct__row:is(:hover, :focus-visible) :is(.ct__row-v, .ct__row-i) {
    color: var(--paper);
  }

  @media (hover: hover) and (pointer: fine) {
    .ct__row:hover .ct__row-i {
      transform: translateX(3px);
    }
  }

  .ct__info .ct__rows {
    max-width: 440px;
  }

  @media (max-width: 1023px) {
    .ct__stage {
      grid-template-columns: minmax(0, 1fr);
      gap: 28px;
      padding: clamp(24px, 5vw, 40px);
    }

    .ct__stage--form {
      gap: 0;
      padding: 12px;
    }

    .ct__stage--form .ct__info {
      padding: 20px 12px 28px;
    }

    /* Подпись исполнителя уходит в конец блока, после кнопки и строк. */
    .ct__stage:not(.ct__stage--form) .ct__info {
      display: contents;
    }

    .ct__stage:not(.ct__stage--form) .ct__person {
      order: 3;
      margin-top: 0;
      padding-top: 0;
    }

    .ct__stage:not(.ct__stage--form) .ct__actions {
      order: 2;
    }

    .ct__stage--form .ct__person {
      margin-top: 0;
      padding-top: 0;
    }
  }

  @media (max-width: 767px) {
    .ct__stage:not(.ct__stage--form) {
      gap: 20px;
      padding: 28px 20px 24px;
    }
  }
</style>
