---
/**
 * «Пакеты и цены» на главной: одна секция вместо отдельных «Что я делаю» и «Цены».
 * Короткое пояснение к каждому пакету, срок и цена. На компьютере — ровные строки,
 * на телефоне — отдельные карточки с теми же акцентами, что и на странице услуг:
 * START — белый, BUSINESS — синий, PREMIUM — тёмный. Данные — src/config/pricing.ts.
 */
import SectionHead from './SectionHead.astro';
import Icon from './Icon.astro';
import { plans, formatPrice, pricingConfirmed } from '@/config/pricing';
import { url } from '@/lib/url';

/** Одно короткое пояснение вместо подзаголовка и повторяющего его абзаца. */
const types: Record<string, string> = {
  start: 'Лендинг или сайт специалиста',
  business: 'Сайт компании с разделами и каталогом',
  premium: 'Авторский дизайн и нестандартная логика',
};
const rows = plans.map((p) => ({ ...p, types: types[p.id] }));
---

<section class="pk section" id="pricing" data-island-section="Пакеты" aria-labelledby="pk-title">
  <SectionHead
    id="pk-title"
    title="Пакеты и цены"
    text={`Три пакета для разных задач. Точную цену фиксирую до начала работы.${pricingConfirmed ? '' : ' Цены предварительные.'}`}
    link={{ href: url('/services/'), label: 'Что входит и чего нет' }}
  />

  <ul class="pk__list" data-stagger>
    {
      rows.map((p) => (
        <li class:list={['pk__row', { 'pk__row--featured': p.id === 'business', 'pk__row--premium': p.id === 'premium' }]}>
          <div class="pk__head">
            <h3 class="pk__name">{p.name}</h3>
            <p class="pk__types">{p.types}</p>
          </div>
          <div class="pk__offer">
            <p class="pk__time"><span>Срок</span> {p.timeline}</p>
            <div class="pk__buy">
              <p class="pk__price">
                <span>от</span> {formatPrice(p.price)}
              </p>
              <a class:list={['btn', 'pk__cta', p.id === 'business' ? 'pk__cta--light' : p.id === 'premium' ? 'btn--accent' : 'btn--ink']} href={url(`/contacts/?plan=${p.id}`)} aria-label={`Заказать пакет ${p.name}`}>
                Заказать <span class="arrow" aria-hidden="true"><Icon name="arrow" /></span>
              </a>
            </div>
          </div>
        </li>
      ))
    }
  </ul>

  <a class="pk__calc" href={url('/services/#calculator')} data-reveal>
    <span class="pk__calc-t">Не знаете, какой пакет нужен?</span>
    <span class="pk__calc-d">Калькулятор подберёт его по типу сайта и числу страниц.</span>
    <span class="pk__calc-go" aria-hidden="true"><Icon name="arrow" /></span>
  </a>
</section>

<style>
  .pk__list {
    list-style: none;
    padding: 0;
    border-top: 1px solid var(--line);
  }

  .pk__row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 350px;
    gap: clamp(20px, 3vw, 48px);
    align-items: center;
    padding: clamp(24px, 2.6vw, 36px) clamp(16px, 2vw, 32px);
    border-bottom: 1px solid var(--line);
  }

  .pk__head {
    display: grid;
    gap: 10px;
  }

  .pk__row--featured {
    border-radius: var(--radius-lg);
    border-bottom-color: transparent;
    background: var(--accent-surface);
    color: var(--accent-ink);
  }

  .pk__row--featured :focus-visible {
    outline-color: var(--paper);
  }

  .pk__row--premium {
    margin-top: 8px;
    border-radius: var(--radius-lg);
    border-bottom-color: transparent;
    background: var(--night);
    color: var(--night-ink);
  }

  .pk__row--premium :is(.pk__types, .pk__time) {
    color: var(--night-muted);
  }

  .pk__row--premium .pk__price {
    color: var(--accent-on-dark);
  }

  .pk__row:has(+ .pk__row--featured) {
    border-bottom-color: transparent;
  }

  .pk__name {
    font-weight: 300;
    font-size: var(--fs-4);
    line-height: 1;
    letter-spacing: -0.05em;
  }

  .pk__types {
    max-width: 38ch;
    font-weight: 400;
    font-size: var(--fs-0);
    line-height: 1.45;
    color: var(--muted);
  }

  .pk__offer {
    display: grid;
    gap: 16px;
  }

  .pk__row--featured :is(.pk__types, .pk__time) {
    color: var(--on-accent-muted);
  }

  .pk__time {
    font-size: var(--step-small);
    line-height: 1.4;
    color: var(--muted);
  }

  .pk__time span {
    margin-right: 6px;
  }

  .pk__buy {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: clamp(16px, 2vw, 28px);
  }

  .pk__price {
    font-family: var(--font-head);
    font-weight: 400;
    font-size: var(--fs-3);
    letter-spacing: -0.045em;
    white-space: nowrap;
    line-height: 1;
  }

  .pk__price span {
    font-size: 0.55em;
    letter-spacing: 0;
  }

  .pk__cta {
    min-height: 52px;
  }

  /* Кнопка на синей полосе — белая, как в синей карточке BUSINESS на странице услуг. */
  .pk__cta--light {
    background: var(--paper);
    color: var(--ink);
  }

  .pk__cta--light:is(:hover, :focus-visible) {
    background: var(--bg);
  }

  .pk__calc {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    gap: 8px 28px;
    align-items: center;
    margin-top: clamp(24px, 3vw, 40px);
    padding: clamp(22px, 2.4vw, 32px) clamp(24px, 3vw, 40px);
    border-radius: var(--radius-lg);
    background: var(--paper);
    color: var(--ink);
    text-decoration: none;
    transition: background-color var(--dur-fast) var(--ease-out);
  }

  .pk__calc:hover {
    background: var(--surface-solid);
  }

  .pk__calc-t {
    font-family: var(--font-head);
    font-weight: 400;
    font-size: var(--fs-2);
    letter-spacing: -0.035em;
    line-height: 1.2;
  }

  .pk__calc-d {
    color: var(--muted);
  }

  .pk__calc-go {
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    border-radius: 50%;
    background: var(--accent);
    color: var(--accent-ink);
    font-size: var(--fs-1);
    transition: transform var(--dur) var(--ease-out);
  }

  .pk__calc:hover .pk__calc-go {
    transform: rotate(-45deg);
  }

  @media (max-width: 1023px) {
    .pk__list {
      display: grid;
      gap: 24px;
      border-top: 0;
    }

    .pk__row {
      grid-template-columns: minmax(0, 1fr);
      gap: 28px;
      align-items: start;
      margin-top: 0;
      padding: 28px 24px;
      border-bottom: 0;
      border-radius: var(--radius-lg);
    }

    .pk__row:not(.pk__row--featured):not(.pk__row--premium) {
      background: var(--paper);
    }

    .pk__offer {
      gap: 20px;
    }

    .pk__buy {
      justify-content: space-between;
    }

    .pk__calc {
      grid-template-columns: minmax(0, 1fr) auto;
    }

    .pk__calc-go {
      grid-row: 1 / 3;
      grid-column: 2;
    }
  }

  @media (max-width: 767px) {
    .pk__name {
      font-size: 2rem;
    }

    .pk__buy {
      flex-wrap: wrap;
      gap: 12px;
    }

    .pk__price {
      font-size: var(--fs-3);
    }

    .pk__cta {
      min-height: 44px;
      padding: 12px 16px;
      font-size: var(--step-small);
    }

    .pk__cta .arrow {
      display: none;
    }

    .pk__calc {
      border-radius: var(--radius);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .pk__calc:hover .pk__calc-go {
      transform: none;
    }
  }
</style>
