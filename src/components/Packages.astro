---
/**
 * «Пакеты и цены» на главной: одна секция вместо отдельных «Что я делаю» и «Цены».
 * Три строки — тип сайта, для кого, срок, цена «от», кнопка. Без карточек: строки разделены линиями,
 * средний пакет — тёмная полоса. Данные — src/config/pricing.ts.
 */
import { Image } from 'astro:assets';
import SectionHead from './SectionHead.astro';
import Icon from './Icon.astro';
import { plans, formatPrice, pricingConfirmed } from '@/config/pricing';
import { genImage } from '@/lib/gen';
import { url } from '@/lib/url';

/** Какие типы сайтов закрывает пакет и какой объект из ретро-набора его иллюстрирует. */
const extra: Record<string, { types: string; obj: string }> = {
  start: { types: 'Лендинг · Сайт специалиста', obj: 'svc-landing' },
  business: { types: 'Сайт компании · Каталог', obj: 'svc-business' },
  premium: { types: 'Индивидуальный проект', obj: 'float-gear' },
};
const rows = plans.map((p) => ({ ...p, ...extra[p.id], img: genImage(extra[p.id].obj) }));
---

<section class="pk section" id="pricing" aria-labelledby="pk-title">
  <SectionHead
    id="pk-title"
    title="Пакеты и цены"
    text={`Три пакета с понятным составом и сроком. Точная цена — в предложении до старта.${pricingConfirmed ? '' : ' Цены предварительные.'}`}
    link={{ href: url('/services/'), label: 'Что входит и чего нет' }}
  />

  <ul class="pk__list" data-stagger>
    {
      rows.map((p, i) => (
        <li class:list={['pk__row', { 'pk__row--dark': i === 1 }]}>
          {p.img && <Image class="pk__obj" src={p.img.src} alt="" widths={[120, 220]} sizes="96px" loading="lazy" />}
          <div class="pk__head">
            <h3 class="pk__name">{p.name}</h3>
            <p class="pk__types">{p.types}</p>
          </div>
          <div class="pk__body">
            <p class="pk__for">{p.forWhom}</p>
            <p class="pk__time">Срок: {p.timeline}</p>
          </div>
          <div class="pk__buy">
            <p class="pk__price">
              <span>от</span> {formatPrice(p.price)}
            </p>
            <a class:list={['btn', i === 1 ? 'btn--accent' : 'btn--ink', 'pk__cta']} href={url(`/contacts/?plan=${p.id}`)}>
              Выбрать <span class="arrow" aria-hidden="true"><Icon name="arrow" /></span>
            </a>
          </div>
        </li>
      ))
    }
  </ul>

  <a class="pk__calc" href={url('/services/#calculator')} data-reveal>
    <span class="pk__calc-t">Не знаете, какой пакет нужен?</span>
    <span class="pk__calc-d">Калькулятор подберёт его по типу сайта и числу страниц.</span>
    <span class="pk__calc-go" aria-hidden="true"><Icon name="arrow" /></span>
  </a>
</section>

<style>
  .pk__list {
    list-style: none;
    padding: 0;
    border-top: 1px solid var(--line);
  }

  .pk__row {
    display: grid;
    grid-template-columns: 96px minmax(0, 3fr) minmax(0, 4fr) auto;
    gap: clamp(20px, 3vw, 48px);
    align-items: center;
    padding: clamp(24px, 2.6vw, 36px) clamp(16px, 2vw, 32px);
    border-bottom: 1px solid var(--line);
  }

  .pk__row--dark {
    border-radius: var(--radius-lg);
    border-bottom-color: transparent;
    background: var(--night);
    color: var(--night-ink);
  }

  /* Линия над тёмной полосой не нужна. */
  .pk__row:has(+ .pk__row--dark) {
    border-bottom-color: transparent;
  }

  .pk__obj {
    width: 96px;
    height: auto;
    filter: drop-shadow(0 12px 14px rgba(21, 21, 21, 0.16));
    transition: transform 600ms var(--ease-out);
  }

  .pk__row:hover .pk__obj {
    transform: rotate(-8deg) scale(1.06);
  }

  .pk__head {
    display: grid;
    gap: 6px;
  }

  .pk__name {
    font-size: var(--fs-3);
    letter-spacing: -0.03em;
  }

  .pk__types {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--fs-0);
  }

  .pk__body {
    display: grid;
    gap: 8px;
  }

  .pk__for {
    max-width: 44ch;
    line-height: 1.5;
    color: var(--muted);
  }

  .pk__row--dark .pk__for {
    color: var(--night-muted);
  }

  .pk__time {
    font-size: var(--fs-xs);
    font-weight: 600;
    font-family: var(--font-display);
  }

  .pk__buy {
    display: flex;
    align-items: center;
    gap: clamp(16px, 2vw, 28px);
  }

  .pk__price {
    font-family: var(--font-head);
    font-weight: 650;
    font-size: var(--fs-3);
    letter-spacing: -0.04em;
    white-space: nowrap;
  }

  .pk__price span {
    font-size: 0.55em;
    letter-spacing: 0;
  }

  .pk__row--dark .pk__price {
    color: var(--accent);
  }

  .pk__cta {
    min-height: 52px;
  }

  .pk__calc {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    gap: 8px 28px;
    align-items: center;
    margin-top: clamp(24px, 3vw, 40px);
    padding: clamp(22px, 2.4vw, 32px) clamp(24px, 3vw, 40px);
    border-radius: var(--radius-lg);
    background: var(--accent);
    color: var(--accent-ink);
    text-decoration: none;
  }

  .pk__calc-t {
    font-family: var(--font-head);
    font-weight: 650;
    font-size: var(--fs-2);
    letter-spacing: -0.03em;
    text-transform: uppercase;
  }

  .pk__calc-d {
    color: var(--on-accent-muted);
  }

  .pk__calc-go {
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    border-radius: 12px;
    background: var(--ink);
    color: var(--bg);
    font-size: var(--fs-1);
    transition: transform var(--dur) var(--ease-out);
  }

  .pk__calc:hover .pk__calc-go {
    transform: rotate(-45deg);
  }

  @media (max-width: 1023px) {
    .pk__row {
      grid-template-columns: 72px minmax(0, 1fr);
      gap: 16px 20px;
      align-items: start;
    }

    .pk__obj {
      width: 72px;
      grid-row: 1 / 3;
    }

    .pk__body,
    .pk__buy {
      grid-column: 2;
    }

    .pk__buy {
      justify-content: space-between;
    }

    .pk__calc {
      grid-template-columns: minmax(0, 1fr) auto;
    }

    .pk__calc-go {
      grid-row: 1 / 3;
      grid-column: 2;
    }
  }

  @media (max-width: 767px) {
    .pk__row {
      grid-template-columns: 56px minmax(0, 1fr);
      padding-inline: 16px;
    }

    .pk__row--dark {
      border-radius: 22px;
    }

    .pk__obj {
      width: 56px;
      grid-row: 1;
    }

    .pk__body,
    .pk__buy {
      grid-column: 1 / -1;
    }

    .pk__calc {
      border-radius: 22px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .pk__row:hover .pk__obj,
    .pk__calc:hover .pk__calc-go {
      transform: none;
    }
  }
</style>
