---
/**
 * «Пакеты и цены» на главной: одна секция вместо отдельных «Что я делаю» и «Цены».
 * Три строки — название пакета, для кого, срок, цена «от», кнопка. Без карточек и картинок: строки
 * разделены линиями, средний пакет выделен тёмной акцентной полосой. Данные — src/config/pricing.ts.
 */
import SectionHead from './SectionHead.astro';
import Icon from './Icon.astro';
import { plans, formatPrice, pricingConfirmed } from '@/config/pricing';
import { url } from '@/lib/url';

/** Какие типы сайтов закрывает пакет. */
const types: Record<string, string> = {
  start: 'Лендинг, сайт специалиста',
  business: 'Сайт компании, каталог',
  premium: 'Индивидуальный проект',
};
const rows = plans.map((p) => ({ ...p, types: types[p.id] }));
---

<section class="pk section" id="pricing" aria-labelledby="pk-title">
  <SectionHead
    id="pk-title"
    title="Пакеты и цены"
    text={`Три пакета с понятным составом и сроком. Точная цена — в предложении до старта.${pricingConfirmed ? '' : ' Цены предварительные.'}`}
    link={{ href: url('/services/'), label: 'Что входит и чего нет' }}
  />

  <ul class="pk__list" data-stagger>
    {
      rows.map((p, i) => (
        <li class:list={['pk__row', { 'pk__row--featured': i === 1 }]}>
          <div class="pk__head">
            <h3 class="pk__name">{p.name}</h3>
            <p class="pk__types">{p.types}</p>
          </div>
          <div class="pk__body">
            <p class="pk__for">{p.forWhom}</p>
            <p class="pk__time">Срок: {p.timeline}</p>
          </div>
          <div class="pk__buy">
            <p class="pk__price">
              <span>от</span> {formatPrice(p.price)}
            </p>
            <a class:list={['btn', i === 1 ? 'btn--accent' : 'btn--ink', 'pk__cta']} href={url(`/contacts/?plan=${p.id}`)}>
              Выбрать <span class="arrow" aria-hidden="true"><Icon name="arrow" /></span>
            </a>
          </div>
        </li>
      ))
    }
  </ul>

  <a class="pk__calc" href={url('/services/#calculator')} data-reveal>
    <span class="pk__calc-t">Не знаете, какой пакет нужен?</span>
    <span class="pk__calc-d">Калькулятор подберёт его по типу сайта и числу страниц.</span>
    <span class="pk__calc-go" aria-hidden="true"><Icon name="arrow" /></span>
  </a>
</section>

<style>
  .pk__list {
    list-style: none;
    padding: 0;
    border-top: 1px solid var(--line);
  }

  .pk__row {
    display: grid;
    /* Последняя колонка фиксированная: описания во всех строках начинаются на одной вертикали. */
    grid-template-columns: minmax(0, 4fr) minmax(0, 4fr) 350px;
    gap: clamp(20px, 3vw, 48px);
    align-items: center;
    padding: clamp(24px, 2.6vw, 36px) clamp(16px, 2vw, 32px);
    border-bottom: 1px solid var(--line);
  }

  .pk__row--featured {
    border-radius: var(--radius-lg);
    border-bottom-color: transparent;
    background: var(--night);
    color: var(--night-ink);
  }

  /* Линия над акцентной полосой не нужна. */
  .pk__row:has(+ .pk__row--featured) {
    border-bottom-color: transparent;
  }

  .pk__head {
    display: grid;
    gap: 6px;
  }

  .pk__name {
    font-weight: 340;
    font-size: var(--fs-4);
    line-height: 1;
    letter-spacing: -0.05em;
  }

  .pk__types {
    font-family: var(--font-display);
    font-weight: 550;
    font-size: var(--fs-0);
  }

  .pk__body {
    display: grid;
    gap: 8px;
  }

  .pk__for {
    max-width: 44ch;
    line-height: 1.5;
    color: var(--muted);
  }

  .pk__row--featured .pk__for {
    color: var(--night-muted);
  }

  .pk__time {
    font-size: var(--fs-xs);
    font-weight: 600;
    font-family: var(--font-display);
  }

  .pk__buy {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: clamp(16px, 2vw, 28px);
  }

  .pk__price {
    font-family: var(--font-head);
    font-weight: 400;
    font-size: var(--fs-3);
    letter-spacing: -0.045em;
    white-space: nowrap;
  }

  .pk__price span {
    font-size: 0.55em;
    letter-spacing: 0;
  }

  .pk__row--featured .pk__price {
    color: var(--accent-on-dark);
  }

  .pk__cta {
    min-height: 52px;
  }

  .pk__calc {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    gap: 8px 28px;
    align-items: center;
    margin-top: clamp(24px, 3vw, 40px);
    padding: clamp(22px, 2.4vw, 32px) clamp(24px, 3vw, 40px);
    border-radius: var(--radius-lg);
    background: var(--accent);
    color: var(--accent-ink);
    text-decoration: none;
  }

  .pk__calc-t {
    font-family: var(--font-head);
    font-weight: 450;
    font-size: var(--fs-2);
    letter-spacing: -0.035em;
  }

  .pk__calc-d {
    color: var(--on-accent-muted);
  }

  .pk__calc-go {
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    border-radius: 50%;
    background: var(--paper);
    color: var(--accent-text);
    font-size: var(--fs-1);
    transition: transform var(--dur) var(--ease-out);
  }

  .pk__calc:hover .pk__calc-go {
    transform: rotate(-45deg);
  }

  @media (max-width: 1023px) {
    .pk__row {
      grid-template-columns: minmax(0, 1fr);
      gap: 16px 20px;
      align-items: start;
    }

    .pk__buy {
      justify-content: space-between;
    }

    .pk__calc {
      grid-template-columns: minmax(0, 1fr) auto;
    }

    .pk__calc-go {
      grid-row: 1 / 3;
      grid-column: 2;
    }
  }

  @media (max-width: 767px) {
    .pk__row {
      padding-inline: 16px;
    }

    .pk__row--featured {
      border-radius: 22px;
    }

    .pk__calc {
      border-radius: 22px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .pk__calc:hover .pk__calc-go {
      transform: none;
    }
  }
</style>
