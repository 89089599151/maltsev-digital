---
/**
 * «Пакеты и цены» на главной: одна секция вместо отдельных «Что я делаю» и «Цены».
 * Короткое пояснение к каждому пакету, срок и цена. На компьютере — три равные карточки,
 * на телефоне — отдельные карточки с теми же акцентами, что и на странице услуг:
 * START — белый, BUSINESS — синий, PREMIUM — тёмный. Данные — src/config/pricing.ts.
 */
import Icon from './Icon.astro';
import { plans, formatPrice, pricingConfirmed } from '@/config/pricing';
import { url } from '@/lib/url';

/** Одно короткое пояснение вместо подзаголовка и повторяющего его абзаца. */
const types: Record<string, string> = {
  start: 'Лендинг или сайт специалиста',
  business: 'Сайт компании с разделами и каталогом',
  premium: 'Авторский дизайн и нестандартная логика',
};
const rows = plans.map((p) => ({ ...p, types: types[p.id] }));
---

<section class="pk section" id="pricing" data-island-section="Пакеты" aria-labelledby="pk-title">
  <header class="pk__intro">
    <h2 id="pk-title" class="pk__title" data-split>Пакеты и цены</h2>
    <a class="pk__details" href={url('/services/')} data-reveal>
      Состав пакетов <span class="arrow" aria-hidden="true"><Icon name="arrow" /></span>
    </a>
  </header>

  <ul class="pk__list" data-stagger>
    {
      rows.map((p) => (
        <li class:list={['pk__row', { 'pk__row--featured': p.id === 'business', 'pk__row--premium': p.id === 'premium' }]}>
          <div class="pk__head">
            <h3 class="pk__name">{p.name}</h3>
            <p class="pk__types">{p.types}</p>
          </div>
          <div class="pk__offer">
            <p class="pk__time"><span>Срок</span> {p.timeline}</p>
            <div class="pk__buy">
              <p class="pk__price">
                <span>от</span> {formatPrice(p.price)}
              </p>
              <a class:list={['btn', 'pk__cta', p.id === 'business' ? 'pk__cta--light' : p.id === 'premium' ? 'btn--accent' : 'btn--ink']} href={url(`/contacts/?plan=${p.id}`)} aria-label={`Заказать пакет ${p.name}`}>
                Заказать <span class="arrow" aria-hidden="true"><Icon name="arrow" /></span>
              </a>
            </div>
          </div>
        </li>
      ))
    }
  </ul>

  <div class="pk__footer" data-reveal>
    <p class="pk__text">Точную цену фиксирую до начала работы.{pricingConfirmed ? '' : ' Цены предварительные.'}</p>
    <a class="pk__calc" href={url('/services/#calculator')}>
      Рассчитать стоимость <span class="arrow" aria-hidden="true"><Icon name="arrow" /></span>
    </a>
  </div>
</section>

<style>
  .pk__intro {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 16px 28px;
    margin-bottom: clamp(24px, 3vw, 40px);
  }

  .pk__title {
    font-size: var(--fs-5);
    line-height: 1.02;
    letter-spacing: -0.045em;
  }

  .pk__text {
    max-width: 46ch;
    color: var(--muted);
  }

  .pk__details,
  .pk__calc {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    border-bottom: 1.5px solid var(--accent);
    font-weight: 500;
    text-decoration: none;
  }

  .pk__details .arrow,
  .pk__calc .arrow {
    transition: transform var(--dur-fast) var(--ease-out);
  }

  .pk__details:hover .arrow,
  .pk__calc:hover .arrow {
    transform: translateX(4px);
  }

  .pk__list {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--gap);
    list-style: none;
    padding: 0;
  }

  .pk__row {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    min-width: 0;
    gap: 32px;
    padding: clamp(24px, 2.4vw, 36px);
    border-radius: var(--radius-lg);
    background: var(--paper);
  }

  .pk__head {
    display: grid;
    gap: 10px;
  }

  .pk__row--featured {
    background: var(--accent-surface);
    color: var(--accent-ink);
  }

  .pk__row--featured :focus-visible {
    outline-color: var(--paper);
  }

  .pk__row--premium {
    background: var(--night);
    color: var(--night-ink);
  }

  .pk__row--premium :is(.pk__types, .pk__time) {
    color: var(--night-muted);
  }

  .pk__row--premium .pk__price {
    color: var(--accent-on-dark);
  }

  .pk__name {
    font-weight: 300;
    font-size: var(--fs-4);
    line-height: 1;
    letter-spacing: -0.05em;
  }

  .pk__types {
    max-width: 38ch;
    font-weight: 400;
    font-size: var(--fs-0);
    line-height: 1.45;
    color: var(--muted);
  }

  .pk__offer {
    display: grid;
    gap: 16px;
  }

  .pk__row--featured :is(.pk__types, .pk__time) {
    color: var(--on-accent-muted);
  }

  .pk__time {
    font-size: var(--step-small);
    line-height: 1.4;
    color: var(--muted);
  }

  .pk__time span {
    margin-right: 6px;
  }

  .pk__buy {
    display: grid;
    gap: 24px;
  }

  .pk__price {
    font-family: var(--font-head);
    font-weight: 400;
    font-size: var(--fs-4);
    letter-spacing: -0.045em;
    white-space: nowrap;
    line-height: 1;
  }

  .pk__price span {
    font-size: 0.55em;
    letter-spacing: 0;
  }

  .pk__cta {
    min-height: 52px;
  }

  /* Кнопка BUSINESS — белая, как на странице услуг. */
  .pk__cta--light {
    background: var(--paper);
    color: var(--ink);
  }

  .pk__cta--light:is(:hover, :focus-visible) {
    background: var(--bg);
  }

  .pk__footer {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 12px 28px;
    align-items: center;
    margin-top: 24px;
  }

  @media (min-width: 1024px) and (max-width: 1279px) {
    .pk__price {
      font-size: var(--fs-3);
    }
  }

  @media (max-width: 1023px) {
    .pk__list {
      grid-template-columns: minmax(0, 1fr);
      gap: 24px;
    }

    .pk__row {
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      gap: 28px;
      align-items: start;
      padding: 28px 24px;
    }

    .pk__offer {
      gap: 20px;
    }

    .pk__buy {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 24px;
    }

    .pk__price {
      font-size: var(--fs-3);
    }
  }

  @media (max-width: 767px) {
    .pk__name {
      font-size: 2rem;
    }

    .pk__buy {
      flex-wrap: wrap;
      gap: 12px;
    }

    .pk__price {
      font-size: var(--fs-3);
    }

    .pk__cta {
      min-height: 44px;
      padding: 12px 16px;
      font-size: var(--step-small);
    }

    .pk__cta .arrow {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .pk__details:hover .arrow,
    .pk__calc:hover .arrow {
      transform: none;
    }
  }
</style>
