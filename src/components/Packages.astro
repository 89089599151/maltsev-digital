---
/**
 * «Пакеты и цены» на главной — линейка, как витрина моделей у Apple: одна белая сцена, на ней три
 * пакета рядом, у каждого свой стеклянный предмет. Предметы растут слева направо — один лист
 * (одна страница), стопка листов (сайт с разделами), линза (авторский проект): размер сайта видно
 * до того, как прочитаешь цифры. BUSINESS отмечен как рекомендуемый — синей кнопкой и свечением.
 * На телефоне сверху переключатель, как в iOS, под ним один пакет на всю ширину. Пакеты листаются
 * свайпом, подсветка в переключателе едет вслед за пальцем; открывается на BUSINESS.
 * Данные — src/config/pricing.ts, предметы — src/assets/gen/obj-*.png.
 */
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import { plans, formatPrice, pricingConfirmed } from '@/config/pricing';
import { genImage } from '@/lib/gen';
import { url } from '@/lib/url';

const meta: Record<string, { text: string; scope: string; object: string }> = {
  start: { text: 'Лендинг или сайт специалиста', scope: 'Одна страница', object: 'obj-landing' },
  business: { text: 'Сайт компании с разделами и каталогом', scope: 'До 8 страниц', object: 'obj-business' },
  premium: { text: 'Авторский дизайн и нестандартная логика', scope: 'До 15 страниц', object: 'obj-personal' },
};
const lineup = plans.map((p) => ({ ...p, ...meta[p.id], img: genImage(meta[p.id].object) }));
const featured = lineup.findIndex((p) => p.id === 'business');
---

<section class="pk section" id="pricing" data-island-section="Пакеты" aria-labelledby="pk-title">
  <header class="pk__intro">
    <h2 id="pk-title" class="pk__title" data-split>Пакеты и цены</h2>
    <p class="pk__lead" data-reveal>
      От одной страницы до авторского проекта. Цену фиксирую в договоре до начала работы.{pricingConfirmed ? '' : ' Цены предварительные.'}
    </p>
  </header>

  <div class="pk__stage" data-lineup data-start={featured}>
    <div class="pk__seg" role="group" aria-label="Выбор пакета" data-lineup-seg hidden>
      <span class="pk__seg-thumb" aria-hidden="true"></span>
      {lineup.map((p, i) => (
        <button type="button" aria-current={i === featured ? 'true' : undefined} data-lineup-dot={i}>
          {p.name}
        </button>
      ))}
    </div>

    <ul class="pk__list" data-lineup-track>
      {
        lineup.map((p) => (
          <li class:list={['pk__item', `pk__item--${p.id}`]} data-lineup-item>
            {p.id === 'business' ? <p class="pk__badge">Рекомендую</p> : <p class="pk__badge pk__badge--empty" aria-hidden="true" />}
            <div class="pk__object" aria-hidden="true">
              {p.img && (
                <Image src={p.img.src} alt="" widths={[200, 320, 480]} sizes="(max-width: 767px) 44vw, 220px" loading="lazy" />
              )}
            </div>
            <p class="pk__scope">{p.scope}</p>
            <h3 class="pk__name">{p.name}</h3>
            <p class="pk__text">{p.text}</p>
            <p class="pk__price"><span>от</span> {formatPrice(p.price)}</p>
            <p class="pk__time">Срок — {p.timeline}</p>
            <div class="pk__actions">
              <a class:list={['btn', 'pk__cta', p.id === 'business' ? 'btn--accent' : 'btn--ink']} href={url(`/contacts/?plan=${p.id}`)} aria-label={`Заказать пакет ${p.name}`}>
                Заказать <span class="arrow" aria-hidden="true"><Icon name="arrow" /></span>
              </a>
              <a class="pk__more" href={url(`/services/#plan-${p.id}`)} aria-label={`Что входит в пакет ${p.name}`}>
                Что входит
              </a>
            </div>
          </li>
        ))
      }
    </ul>
  </div>

  <div class="pk__footer" data-reveal>
    <p class="pk__note">Не знаете, какой пакет нужен? Калькулятор подберёт его по типу сайта и числу страниц.</p>
    <a class="pk__calc" href={url('/services/#calculator')}>
      Рассчитать стоимость <span class="arrow" aria-hidden="true"><Icon name="arrow" /></span>
    </a>
  </div>
</section>

<script>
  // Телефон: пакеты листаются вбок, открывается рекомендуемый. Переключатель сверху показывает, какой
  // пакет на экране, а его подсветка движется вместе со свайпом.
  const stage = document.querySelector<HTMLElement>('[data-lineup]');
  const track = stage?.querySelector<HTMLElement>('[data-lineup-track]');
  const seg = stage?.querySelector<HTMLElement>('[data-lineup-seg]');
  if (stage && track && seg) {
    const items = Array.from(track.querySelectorAll<HTMLElement>('[data-lineup-item]'));
    const dots = Array.from(seg.querySelectorAll<HTMLButtonElement>('[data-lineup-dot]'));
    const phone = window.matchMedia('(max-width: 767px)');
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
    const scrollTo = (index: number, smooth: boolean) => {
      const item = items[index];
      if (!item) return;
      const left = item.offsetLeft - (track.clientWidth - item.offsetWidth) / 2;
      track.scrollTo({ left, behavior: smooth && !reduced.matches ? 'smooth' : 'auto' });
    };
    const current = () => {
      const middle = track.scrollLeft + track.clientWidth / 2;
      let best = 0;
      let distance = Infinity;
      items.forEach((item, i) => {
        const d = Math.abs(item.offsetLeft + item.offsetWidth / 2 - middle);
        if (d < distance) {
          distance = d;
          best = i;
        }
      });
      return best;
    };
    const mark = () => {
      const active = current();
      const max = track.scrollWidth - track.clientWidth;
      // Подсветка стоит между сегментами так же, как пакет между соседями: 0 — первый, 2 — третий.
      const x = max > 0 ? (track.scrollLeft / max) * (items.length - 1) : active;
      seg.style.setProperty('--seg-x', String(x));
      dots.forEach((dot, i) => dot.toggleAttribute('aria-current', i === active));
      items.forEach((item, i) => item.classList.toggle('is-current', i === active));
    };
    let ticking = false;
    track.addEventListener('scroll', () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => {
        ticking = false;
        mark();
      });
    }, { passive: true });
    dots.forEach((dot, i) => dot.addEventListener('click', () => scrollTo(i, true)));
    const setup = () => {
      seg.hidden = !phone.matches;
      if (phone.matches) scrollTo(Number(stage.dataset.start) || 0, false);
      mark();
    };
    phone.addEventListener('change', setup);
    setup();
  }
</script>

<style>
  .pk__intro {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: 16px clamp(24px, 4vw, 64px);
    align-items: end;
    margin-bottom: clamp(24px, 3vw, 40px);
  }

  .pk__title {
    font-size: var(--fs-5);
    line-height: 1.02;
    letter-spacing: -0.045em;
  }

  .pk__lead {
    max-width: 40ch;
    color: var(--muted);
  }

  /* --- Сцена-линейка -------------------------------------------------------- */

  .pk__stage {
    position: relative;
    padding: clamp(24px, 3vw, 48px) clamp(12px, 2vw, 32px) clamp(28px, 3vw, 44px);
    border-radius: var(--radius-lg);
    background:
      radial-gradient(34% 60% at 50% 30%, rgba(26, 47, 251, 0.1) 0%, rgba(26, 47, 251, 0) 70%),
      var(--paper);
    overflow: hidden;
  }

  .pk__list {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    list-style: none;
    padding: 0;
  }

  .pk__item {
    display: flex;
    flex-direction: column;
    align-items: center;
    min-width: 0;
    padding: 0 clamp(16px, 2vw, 36px);
    text-align: center;
  }

  /* Волосяные линии между пакетами — как разделители в витрине, без отдельных карточек. */
  .pk__item + .pk__item {
    box-shadow: inset 1px 0 0 var(--line);
  }

  .pk__badge {
    display: inline-flex;
    align-items: center;
    min-height: 28px;
    padding: 4px 12px;
    border-radius: 999px;
    background: var(--accent-soft);
    color: var(--accent-text);
    font-size: var(--fs-xs);
    font-weight: 500;
    line-height: 1.2;
  }

  .pk__badge--empty {
    visibility: hidden;
  }

  /* Предметы растут слева направо: стоят на одной линии снизу, как модели на полке. */
  .pk__object {
    display: flex;
    align-items: flex-end;
    justify-content: center;
    width: 100%;
    height: clamp(150px, 15vw, 220px);
    margin-top: clamp(8px, 1.4vw, 20px);
  }

  .pk__object :global(img) {
    width: auto;
    height: var(--obj-h);
    max-width: 100%;
    object-fit: contain;
    filter: drop-shadow(0 22px 24px rgba(26, 47, 251, 0.18));
    transition: transform 700ms var(--ease-out);
  }

  .pk__item--start {
    --obj-h: 64%;
  }

  .pk__item--business {
    --obj-h: 84%;
  }

  .pk__item--premium {
    --obj-h: 100%;
  }

  @media (hover: hover) and (pointer: fine) {
    .pk__item:hover .pk__object :global(img) {
      transform: translateY(-8px) scale(1.04);
    }
  }

  .pk__scope {
    margin-top: 18px;
    font-size: var(--fs-xs);
    font-weight: 500;
    letter-spacing: 0.02em;
    color: var(--muted);
  }

  .pk__name {
    margin-top: 6px;
    font-weight: 300;
    font-size: clamp(1.75rem, 0.9rem + 2.2vw, 3rem);
    line-height: 1;
    letter-spacing: -0.05em;
  }

  .pk__text {
    max-width: 24ch;
    min-height: 2.9em;
    margin-top: 10px;
    font-size: var(--step-small);
    line-height: 1.45;
    color: var(--muted);
  }

  .pk__price {
    margin-top: clamp(18px, 2vw, 28px);
    font-family: var(--font-head);
    font-weight: 300;
    font-size: clamp(1.75rem, 1rem + 1.6vw, 2.5rem);
    line-height: 1;
    letter-spacing: -0.045em;
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }

  .pk__price span {
    font-size: 0.5em;
    letter-spacing: 0;
  }

  .pk__item--business .pk__price {
    color: var(--accent-text);
  }

  .pk__time {
    margin-top: 8px;
    font-size: var(--step-small);
    color: var(--muted);
  }

  .pk__actions {
    display: grid;
    justify-items: center;
    gap: 6px;
    margin-top: clamp(18px, 2vw, 26px);
  }

  .pk__cta {
    min-height: 48px;
    padding-inline: 22px;
  }

  .pk__more {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding-inline: 8px;
    font-size: var(--step-small);
    font-weight: 500;
    color: var(--accent-text);
    text-decoration: none;
  }

  .pk__more:hover {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  /* Переключатель пакетов на телефоне — сегменты, как в iOS: серая дорожка и белая плашка,
     которая едет к выбранному пакету. Позицию плашки задаёт скрипт через --seg-x (0…2). */
  .pk__seg {
    --seg-pad: 3px;
    position: relative;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin: 0 16px 8px;
    padding: var(--seg-pad);
    border-radius: 999px;
    background: var(--paper-2);
    box-shadow: inset 0 0 0 1px rgba(10, 11, 20, 0.04);
  }

  .pk__seg[hidden] {
    display: none;
  }

  .pk__seg-thumb {
    position: absolute;
    top: var(--seg-pad);
    bottom: var(--seg-pad);
    left: var(--seg-pad);
    width: calc((100% - var(--seg-pad) * 2) / 3);
    border-radius: 999px;
    background: var(--paper);
    box-shadow:
      0 0 0 0.5px rgba(10, 11, 20, 0.06),
      0 3px 10px rgba(16, 32, 200, 0.12),
      0 1px 2px rgba(10, 11, 20, 0.08);
    transform: translateX(calc(var(--seg-x, 1) * 100%));
    pointer-events: none;
  }

  .pk__seg button {
    position: relative;
    min-height: 40px;
    padding: 0 6px;
    border-radius: 999px;
    background: none;
    font-size: var(--fs-xs);
    font-weight: 500;
    letter-spacing: 0.03em;
    color: var(--muted);
    transition: color var(--dur-fast) var(--ease-out);
    -webkit-tap-highlight-color: transparent;
  }

  .pk__seg button[aria-current] {
    color: var(--ink);
  }

  .pk__seg button:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: -2px;
  }

  .pk__footer {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 12px 28px;
    align-items: center;
    margin-top: 24px;
  }

  .pk__note {
    max-width: 52ch;
    color: var(--muted);
  }

  .pk__calc {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    border-bottom: 1.5px solid var(--accent);
    font-weight: 500;
    text-decoration: none;
  }

  .pk__calc .arrow {
    transition: transform var(--dur-fast) var(--ease-out);
  }

  .pk__calc:hover .arrow {
    transform: translateX(4px);
  }

  @media (max-width: 1023px) {
    .pk__intro {
      grid-template-columns: 1fr;
    }
  }

  /* --- Телефон: переключатель сверху, один пакет на всю ширину ------------------ */

  @media (max-width: 767px) {
    .pk__stage {
      padding: 16px 0 28px;
    }

    .pk__list {
      grid-template-columns: none;
      grid-auto-flow: column;
      grid-auto-columns: 100%;
      overflow-x: auto;
      overscroll-behavior-x: contain;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
    }

    .pk__list::-webkit-scrollbar {
      display: none;
    }

    .pk__item {
      scroll-snap-align: center;
      scroll-snap-stop: always;
      padding: 0 24px;
    }

    .pk__item + .pk__item {
      box-shadow: none;
    }

    .pk__badge {
      margin-top: 12px;
    }

    .pk__object {
      height: 170px;
    }

    .pk__name {
      font-size: 2.25rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .pk__item:hover .pk__object :global(img),
    .pk__calc:hover .arrow {
      transform: none;
    }

  }
</style>
