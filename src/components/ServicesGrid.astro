---
/**
 * «Что я делаю»: четыре направления карточками 2×2 — задача, что входит, цена «от».
 * Объекты: svc-* из src/assets/gen; пока их нет — временные, перекрашенные.
 */
import { Image } from 'astro:assets';
import SectionHead from './SectionHead.astro';
import { plans, formatPrice } from '@/config/pricing';
import { genImage } from '@/lib/gen';
import { url } from '@/lib/url';
import Icon from './Icon.astro';

/** Временные замены из ретро-набора, пока нет svc-landing и svc-catalog. */
const stand: Record<string, string> = { landing: 'float-window', catalog: 'float-cubes', business: 'svc-business', personal: 'svc-personal' };

const items = [
  {
    key: 'landing',
    name: 'Лендинг',
    task: 'Продать одну услугу, акцию или запуск',
    points: ['Структура, которая ведёт к заявке', 'Форма с отправкой в почту или Telegram', 'Готов за 7–10 рабочих дней'],
    plan: plans[0],
  },
  {
    key: 'business',
    name: 'Сайт компании',
    task: 'Рассказать о бизнесе и вызвать доверие',
    points: ['До 8 уникальных страниц', 'Услуги, портфолио, блог', 'Аналитика и SEO-структура'],
    plan: plans[1],
  },
  {
    key: 'catalog',
    name: 'Каталог',
    task: 'Показать товары и принимать заказы',
    points: ['Карточки и фильтры', 'Форма заказа без корзины', 'До 50 позиций в тарифе'],
    plan: plans[1],
  },
  {
    key: 'personal',
    name: 'Сайт специалиста',
    task: 'Сделать имя узнаваемым и получать записи',
    points: ['Личный бренд и кейсы', 'Онлайн-запись или заявка', 'Быстрый запуск'],
    plan: plans[0],
  },
].map((it) => {
  // Свой объект услуги; пока его нет — подходящий объект из того же ретро-набора; в крайнем случае — старый перекрашенный.
  const own = genImage(`svc-${it.key}`) ?? genImage(stand[it.key]);
  return { ...it, img: own ?? genImage(`obj-${it.key}`), tinted: !own };
});
---

<section class="sv section" id="services" aria-labelledby="sv-title">
  <SectionHead
    id="sv-title"
    title="Что я делаю"
    text="Каждый сайт проектируется под задачу: структура, тексты и дизайн ведут посетителя к заявке. Код, домен и доступы остаются у вас."
    link={{ href: url('/services/'), label: 'Все тарифы и что входит' }}
  />

  <ul class="sv__grid" data-stagger>
    {
      items.map((it) => (
        <li>
          <a class="sv__card" href={url(`/services/#plan-${it.plan.id}`)}>
            <div class="sv__top">
              <h3 class="sv__name">{it.name}</h3>
              {it.img && (
                <Image
                  class:list={['sv__obj', { 'is-tinted': it.tinted }]}
                  src={it.img.src}
                  alt=""
                  widths={[240, 400]}
                  sizes="180px"
                  loading="lazy"
                />
              )}
            </div>
            <p class="sv__task">{it.task}</p>
            <ul class="sv__points">
              {it.points.map((p) => (
                <li>{p}</li>
              ))}
            </ul>
            <span class="sv__foot">
              <span class="sv__price">от {formatPrice(it.plan.price)}</span>
              <span class="sv__go" aria-hidden="true"><Icon name="arrow" /></span>
            </span>
          </a>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .sv__grid {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--gap);
  }

  .sv__grid > li {
    display: flex;
  }

  .sv__card {
    flex: 1;
    display: grid;
    grid-template-rows: auto auto 1fr auto;
    gap: 20px;
    min-height: 380px;
    padding: clamp(24px, 2.6vw, 36px);
    border-radius: var(--radius-lg);
    background: var(--surface);
    text-decoration: none;
    transition:
      background-color var(--dur) var(--ease-out),
      transform var(--dur) var(--ease-out),
      box-shadow var(--dur) var(--ease-out);
  }

  .sv__card:hover,
  .sv__card:focus-visible {
    background: var(--paper);
    transform: translateY(-4px);
    box-shadow: var(--shadow-lift);
  }

  .sv__top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 16px;
  }

  .sv__name {
    font-size: clamp(1.75rem, 1.1rem + 1.8vw, 2.75rem);
    line-height: 0.95;
    letter-spacing: -0.04em;
    text-transform: uppercase;
  }

  .sv__obj {
    width: clamp(96px, 10vw, 150px);
    height: auto;
    margin: -12px -8px -24px 0;
    transition: transform 700ms var(--ease-out);
  }

  .sv__card:hover .sv__obj {
    transform: rotate(-10deg) scale(1.08);
  }

  .sv__task {
    max-width: 30ch;
    font-size: 1.0625rem;
    line-height: 1.45;
    color: var(--muted);
  }

  .sv__points {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 12px;
    align-content: start;
    color: var(--ink);
  }

  .sv__points li {
    display: grid;
    grid-template-columns: 14px 1fr;
    gap: 10px;
    align-items: baseline;
  }

  .sv__points li::before {
    content: '';
    width: 8px;
    height: 8px;
    background: var(--accent);
    transform: translateY(-1px);
  }

  .sv__foot {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 18px;
    border-top: 1px solid rgba(21, 21, 21, 0.1);
  }

  .sv__price {
    font-family: var(--font-head);
    font-weight: 650;
    font-size: 1.375rem;
    letter-spacing: -0.03em;
  }

  .sv__go {
    display: grid;
    place-items: center;
    width: 46px;
    height: 46px;
    border-radius: 12px;
    background: var(--ink);
    color: var(--bg);
    font-family: var(--font-display);
    font-size: 1.125rem;
    transition:
      background-color var(--dur-fast) var(--ease-out),
      transform var(--dur) var(--ease-out);
  }

  .sv__card:hover .sv__go {
    background: var(--accent);
    color: var(--accent-ink);
    transform: rotate(-45deg);
  }

  @media (max-width: 767px) {
    .sv__grid {
      grid-template-columns: 1fr;
    }

    .sv__card {
      min-height: 0;
      border-radius: 22px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .sv__card:hover,
    .sv__card:hover .sv__obj {
      transform: none;
    }
  }
</style>
