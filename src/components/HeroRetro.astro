---
/**
 * Первый экран — серая сцена, на широком экране вместе с шапкой (она лежит внутри сцены).
 * Слева сверху — заголовок «лесенкой» со счётчиком секций, справа — цена. В центре — ретро-машина
 * с парящими курсором, окном и кубиками поверх огромных белых пиксельных слов MALTSEV и DIGITAL.
 * Снизу — оффер с кнопками слева и короткая реплика справа; контакты — колонкой у правого края.
 * Изображения — src/assets/gen (IMAGE_GENERATION_PROMPTS.md).
 */
import { Image } from 'astro:assets';
import ContactIcon from './ContactIcon.astro';
import PixelWord from './PixelWord.astro';
import { minPrice, formatPrice, pricingConfirmed } from '@/config/pricing';
import { site, telegramUrl, emailUrl } from '@/config/site';
import { genImage } from '@/lib/gen';
import { url } from '@/lib/url';
import Icon from './Icon.astro';

const machine = genImage('hero-machine');
const object = machine ?? genImage('hero-sculpture');
const tinted = !machine;
// Парящие элементы: свои, если сгенерированы; иначе — временные, перекрашенные.
const floats = [
  { img: genImage('float-cursor') ?? genImage('obj-plane'), cls: 'f1', amp: 46, tint: !genImage('float-cursor') },
  { img: genImage('float-window') ?? genImage('obj-landing'), cls: 'f2', amp: 30, tint: !genImage('float-window') },
  { img: genImage('float-cubes') ?? genImage('obj-catalog'), cls: 'f3', amp: 60, tint: !genImage('float-cubes') },
].filter((f) => f.img);
const tg = telegramUrl();
const mail = emailUrl('Заявка на разработку сайта');

/** Пиксельная стрелка ↗ у цены, 7×7 клеток. */
const arrow = ['...####', '.....##', '....#.#', '...#..#', '..#....', '.#.....', '#......'].flatMap((row, y) =>
  [...row].flatMap((c, x) => (c === '#' ? [{ x, y }] : [])),
);
---

<section class="hr" aria-labelledby="hr-title" data-tilt-area>
  <div class="hr__stage">
    <div class="hr__head">
      <span class="hr__count" aria-hidden="true">[1/8]</span>
      <h1 id="hr-title" class="hr__title">
        <span class="hr__line hr__line--1"><span>Сайты</span></span>
        <span class="hr__line hr__line--2"><span>для бизнеса</span></span>
        <span class="hr__line hr__line--3"><span><i class="hr__dot" aria-hidden="true"></i>и экспертов</span></span>
        <span class="hr__line hr__line--4"><span>под ключ</span></span>
      </h1>
    </div>

    <div class="hr__stat">
      <p class="hr__stat-v">
        <svg class="hr__arrow" viewBox="0 0 7 7" shape-rendering="crispEdges" aria-hidden="true" focusable="false">
          {arrow.map((c) => <rect x={c.x} y={c.y} width="1.02" height="1.02" />)}
        </svg>
        <span class="hr__stat-pre">от</span>
        {formatPrice(minPrice)}
      </p>
      <p class="hr__stat-l">
        Срок — от 7 рабочих дней. Точная цена — в предложении до старта.{!pricingConfirmed && ' Цены предварительные.'}
      </p>
    </div>

    <PixelWord text={site.brand.short} appear="intro" delay={0.35} class="hr__px hr__px--a" />
    <PixelWord text={site.brand.second} appear="intro" delay={0.55} class="hr__px hr__px--b" />

    <div class="hr__object" aria-hidden="true">
      <div class="hr__float" data-float="22">
        {
          object && (
            <Image
              class:list={['hr__machine', { 'is-tinted': tinted }]}
              src={object.src}
              alt=""
              widths={[480, 720, 958]}
              sizes="(max-width: 767px) 80vw, (max-width: 1023px) 70vw, 48vw"
              quality={80}
              loading="eager"
              fetchpriority="high"
            />
          )
        }
      </div>
      {
        floats.map((f) => (
          <div class={`hr__bit hr__bit--${f.cls}`} data-float={f.amp}>
            <Image class:list={{ 'is-tinted': f.tint }} src={f.img!.src} alt="" widths={[160, 300]} sizes="150px" loading="eager" />
          </div>
        ))
      }
    </div>

    <ul class="hr__social" aria-label="Связаться напрямую">
      {
        tg && (
          <li>
            <a href={tg} target="_blank" rel="noopener" aria-label={`Telegram: @${site.contacts.telegram.value}`}>
              <ContactIcon kind="telegram" />
            </a>
          </li>
        )
      }
      {
        mail && (
          <li>
            <a href={mail} aria-label={`Почта: ${site.contacts.email.value}`}>
              <ContactIcon kind="email" />
            </a>
          </li>
        )
      }
    </ul>

    <p class="hr__note">От первой идеи до запуска — один исполнитель на связи.</p>

    <div class="hr__offer">
      <p class="hr__lead">
        Дизайн, код и запуск в одних руках. ИИ берёт рутину, а решения и качество — на мне.
      </p>
      <div class="hr__btns">
        <a class="btn btn--accent hr__btn hr__btn--main" href={url('/contacts/')} data-magnetic>
          Обсудить проект <span class="arrow" aria-hidden="true"><Icon name="arrow" /></span>
        </a>
        <a class="btn hr__btn hr__btn--alt" href={url('/#work')}>Смотреть кейс</a>
      </div>
    </div>

    <a class="hr__scroll" href="#manifest">
      <span class="hr__mouse" aria-hidden="true"><i></i></span>
      <span>Листайте<br />дальше</span>
    </a>
  </div>
</section>

<style>
  .hr {
    padding-top: 4px;
  }

  .hr__stage {
    position: relative;
    isolation: isolate;
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    grid-template-rows: auto 1fr auto auto;
    column-gap: var(--gap);
    padding: 76px 18px 96px;
    border-radius: 24px;
    /* Сцена темнее страницы — на ней читаются белые пиксельные слова; светлое пятно — за машиной. */
    background:
      radial-gradient(52% 58% at 56% 46%, rgba(244, 243, 239, 0.95) 0%, rgba(244, 243, 239, 0) 72%),
      linear-gradient(180deg, #dcdbd6 0%, #cbcac5 100%);
    overflow: hidden;
  }

  /* --- Заголовок «лесенкой» со счётчиком ------------------------------------ */
  .hr__head {
    position: relative;
    z-index: 2;
  }

  .hr__count {
    position: absolute;
    top: 0.35em;
    left: 0;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: var(--fs-0);
    letter-spacing: 0.14em;
    color: var(--ink-2);
  }

  .hr__title {
    display: grid;
    font-family: var(--font-head);
    font-weight: 560;
    line-height: 0.94;
    white-space: nowrap;
    letter-spacing: -0.035em;
    text-transform: uppercase;
  }

  /* Отступ сверху — место для бревиса Й и точек Ё, которые иначе срезает overflow. */
  .hr__line {
    display: block;
    overflow: hidden;
    padding-top: 0.16em;
    margin-top: -0.16em;
    padding-bottom: 0.04em;
  }

  .hr__line > span {
    position: relative;
    display: inline-block;
  }

  .hr__line--1 {
    padding-left: 2.9em;
  }

  .hr__line--3 {
    padding-left: 1.05em;
  }

  /* Точка перед третьей строкой — оранжевый пиксель на линии шрифта. */
  .hr__dot {
    position: absolute;
    left: -0.62em;
    bottom: 0.14em;
    width: 0.16em;
    height: 0.16em;
    background: var(--accent);
  }

  /* --- Цена ------------------------------------------------------------------ */
  .hr__stat {
    position: relative;
    z-index: 2;
  }

  .hr__stat-v {
    display: flex;
    align-items: baseline;
    gap: 0.22em;
    font-family: var(--font-head);
    font-weight: 560;
    font-size: clamp(2.25rem, 1rem + 3.2vw, 4.25rem);
    line-height: 1;
    letter-spacing: -0.04em;
    white-space: nowrap;
  }

  .hr__arrow {
    align-self: center;
    width: 0.62em;
    height: 0.62em;
    margin-right: 0.12em;
    fill: var(--ink-2);
    opacity: 0.55;
  }

  .hr__stat-pre {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.42em;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--ink-2);
  }

  .hr__stat-l {
    max-width: 32ch;
    margin-top: 12px;
    font-size: var(--step-small);
    line-height: 1.45;
    color: var(--ink-2);
  }

  /* --- Пиксельные слова: огромные, белые, за машиной ------------------------ */
  .hr__stage :global(.hr__px) {
    position: relative;
    z-index: 0;
    width: 100%;
    height: auto;
    color: var(--paper);
    opacity: 0.94;
    pointer-events: none;
  }

  /* --- Машина и парящие элементы --------------------------------------------- */
  .hr__object {
    position: relative;
    z-index: 1;
    aspect-ratio: 3 / 2;
    pointer-events: none;
  }

  .hr__float {
    position: absolute;
    inset: 0;
    animation: hr-bob 7s ease-in-out infinite;
  }

  .hr__machine {
    width: 100%;
    height: 100%;
    object-fit: contain;
    filter: drop-shadow(0 40px 36px rgba(21, 21, 21, 0.22));
  }

  /* Временная перекраска (если своего изображения нет) перебивает собственную тень. */
  .hr__machine:global(.is-tinted),
  .hr__bit img:global(.is-tinted) {
    filter: hue-rotate(178deg) saturate(1.45) brightness(1.04) drop-shadow(0 40px 40px rgba(21, 21, 21, 0.22));
  }

  .hr__bit {
    position: absolute;
  }

  .hr__bit img {
    width: 100%;
    height: auto;
    filter: drop-shadow(0 18px 20px rgba(21, 21, 21, 0.2));
  }

  .hr__bit--f1 {
    top: 20%;
    right: -8%;
    width: 19%;
    animation: hr-bob 6s ease-in-out -2s infinite;
  }

  .hr__bit--f2 {
    top: 58%;
    left: -10%;
    width: 19%;
    animation: hr-bob 8s ease-in-out -4s infinite;
  }

  .hr__bit--f3 {
    bottom: -10%;
    right: -2%;
    width: 15%;
    animation: hr-bob 7.5s ease-in-out -1s infinite;
  }

  @keyframes hr-bob {
    0%,
    100% {
      translate: 0 0;
      rotate: 0deg;
    }

    50% {
      translate: 0 -12px;
      rotate: 1.5deg;
    }
  }

  /* --- Контакты --------------------------------------------------------------- */
  .hr__social {
    position: absolute;
    z-index: 2;
    top: 16px;
    right: 16px;
    list-style: none;
    padding: 6px;
    display: flex;
    gap: 6px;
    border-radius: 14px;
    background: rgba(255, 255, 255, 0.45);
  }

  .hr__social a {
    display: grid;
    place-items: center;
    width: 46px;
    height: 46px;
    border-radius: 10px;
    color: var(--ink-2);
    transition:
      background-color var(--dur-fast) var(--ease-out),
      color var(--dur-fast) var(--ease-out),
      transform var(--dur-fast) var(--ease-out);
  }

  .hr__social a:hover {
    background: var(--ink);
    color: var(--bg);
  }

  .hr__social a:active {
    transform: scale(0.94);
  }

  /* --- Реплика справа и оффер ----------------------------------------------- */
  .hr__note {
    position: relative;
    z-index: 2;
    max-width: 30ch;
    font-size: var(--step-small);
    line-height: 1.45;
    color: var(--ink-2);
  }

  .hr__offer {
    position: relative;
    z-index: 2;
    display: grid;
    gap: 22px;
  }

  .hr__lead {
    max-width: 46ch;
    font-size: var(--step-body);
    line-height: 1.5;
    color: var(--ink);
  }

  .hr__btns {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .hr__btn {
    min-height: 58px;
    padding-inline: 28px;
  }

  .hr__btn--main {
    background: linear-gradient(180deg, var(--accent-hover), var(--accent-deep));
  }

  .hr__btn--main:hover {
    background: linear-gradient(180deg, #ff8f42, var(--accent));
  }

  .hr__btn--alt {
    justify-content: center;
    background: rgba(21, 21, 21, 0.1);
    color: var(--ink);
  }

  .hr__btn--alt:hover {
    background: rgba(21, 21, 21, 0.16);
  }

  /* --- Подсказка о прокрутке: «выемка» снизу по центру ---------------------- */
  .hr__scroll {
    position: absolute;
    left: 50%;
    bottom: 0;
    z-index: 2;
    transform: translateX(-50%);
    display: grid;
    justify-items: center;
    gap: 6px;
    padding: 14px 34px 10px;
    border-radius: 26px 26px 0 0;
    background: var(--bg);
    font-size: var(--fs-xs);
    line-height: 1.2;
    text-align: center;
    text-decoration: none;
    color: var(--muted);
  }

  .hr__scroll:hover {
    color: var(--ink);
  }

  .hr__mouse {
    display: grid;
    justify-items: center;
    width: 18px;
    height: 26px;
    padding-top: 5px;
    border: 2px solid currentColor;
    border-radius: 10px;
  }

  .hr__mouse i {
    width: 2px;
    height: 6px;
    border-radius: 2px;
    background: currentColor;
    animation: hr-wheel 1.8s ease-in-out infinite;
  }

  @keyframes hr-wheel {
    0% {
      opacity: 0;
      transform: translateY(-2px);
    }

    40% {
      opacity: 1;
    }

    100% {
      opacity: 0;
      transform: translateY(6px);
    }
  }

  /* --- Сборка первого экрана: CSS, стартует с первой отрисовки, не ждёт скриптов. */
  @media (prefers-reduced-motion: no-preference) {
    .hr__line > span {
      animation: hr-line 1s var(--ease-out) backwards;
    }

    .hr__line--1 > span { animation-delay: 0.1s; }
    .hr__line--2 > span { animation-delay: 0.18s; }
    .hr__line--3 > span { animation-delay: 0.26s; }
    .hr__line--4 > span { animation-delay: 0.34s; }

    .hr__object {
      animation: hr-object 1.4s var(--ease-out) 0.15s backwards;
    }

    .hr__count,
    .hr__stat,
    .hr__note,
    .hr__offer,
    .hr__social {
      animation: hr-up 0.9s var(--ease-out) 0.55s backwards;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hr__float,
    .hr__bit,
    .hr__mouse i {
      animation: none;
    }
  }

  @keyframes hr-line {
    from {
      transform: translateY(105%);
    }
  }

  /* Без затухания: машина — LCP-элемент, она должна быть видна с первой отрисовки. */
  @keyframes hr-object {
    from {
      scale: 0.86;
      rotate: -4deg;
    }
  }

  @keyframes hr-up {
    from {
      opacity: 0;
      transform: translateY(18px);
    }
  }

  /* --- Телефон и планшет: одна колонка; пиксельные слова — за машиной -------- */
  @media (max-width: 1023px) {
    .hr__stage {
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: none;
      row-gap: 20px;
    }

    .hr__head,
    .hr__object,
    .hr__offer,
    .hr__stat,
    .hr__note {
      grid-column: 1;
    }

    .hr__head {
      grid-row: 1;
    }

    /* Машина и два слова делят одну ячейку: MALTSEV сверху, DIGITAL снизу, машина поверх. */
    .hr__object,
    .hr__stage :global(.hr__px) {
      grid-row: 2;
      grid-column: 1;
    }

    .hr__object {
      justify-self: center;
      width: min(78%, 560px);
    }

    .hr__stage :global(.hr__px--a) {
      align-self: start;
      margin-top: 4%;
    }

    .hr__stage :global(.hr__px--b) {
      align-self: end;
      margin-bottom: 2%;
    }

    .hr__offer {
      grid-row: 3;
    }

    .hr__stat {
      grid-row: 4;
      margin-top: 8px;
    }

    .hr__note {
      grid-row: 5;
    }

    .hr__title {
      font-size: clamp(2.125rem, 10.4vw, 4.25rem);
    }

    .hr__line--1 {
      padding-left: 2.6em;
    }

    .hr__line--3 {
      padding-left: 0.7em;
    }

    .hr__dot {
      left: -0.44em;
    }

    .hr__count {
      top: 0.25em;
      font-size: var(--fs-xs);
    }
  }

  @media (max-width: 767px) {
    .hr__btn {
      flex: 1 1 100%;
      justify-content: space-between;
    }

    .hr__btn--alt {
      justify-content: center;
    }
  }

  /* Маленькие телефоны (375×667 и уже): объект меньше, чтобы кнопка попадала в первый экран. */
  @media (max-width: 420px) {
    .hr__stage {
      row-gap: 14px;
      padding-top: 68px;
    }

    .hr__object {
      width: 64%;
    }

    .hr__lead {
      font-size: var(--fs-0);
    }

    .hr__btn {
      min-height: 52px;
    }
  }

  /* --- Широкий экран: композиция как в референсе, шапка внутри сцены --------- */
  @media (min-width: 1024px) {
    /* Сцена поднимается под шапку и почти до краёв окна; контент выровнен по полям шапки. */
    :global(.page:not(:has(.pv))) .hr {
      margin-top: calc(-1 * (var(--hdr-inset) + 68px));
    }

    .hr {
      padding-top: 0;
      margin-inline: calc(var(--margin) - var(--page-pad));
    }

    .hr__stage {
      --pad-x: calc(var(--page-pad) - var(--margin));
      container-type: inline-size;
      min-height: min(calc(100svh - var(--margin) * 2), 1060px);
      padding: calc(var(--hdr-inset) + 56px + clamp(16px, 4vh, 72px)) var(--pad-x) clamp(24px, 4vh, 64px);
      border-radius: var(--radius-lg);
    }

    .hr__head {
      grid-column: 1 / 7;
      grid-row: 1;
    }

    /* На низких экранах (ноутбуки 1280×720, 1366×768) заголовок ограничен высотой окна. */
    .hr__title {
      font-size: min(clamp(2.5rem, 0.6rem + 3.6vw, 4.75rem), 7.2vh);
    }

    .hr__stat {
      grid-column: 9 / 13;
      grid-row: 1;
      justify-self: end;
      text-align: right;
    }

    .hr__stat-v {
      justify-content: flex-end;
    }

    .hr__stat-l {
      margin-left: auto;
    }

    /* Оба слова одного размера; DIGITAL начинается правее «выемки» с подсказкой о прокрутке. */
    .hr__stage :global(.hr__px--a),
    .hr__stage :global(.hr__px--b) {
      width: 41cqw;
    }

    .hr__stage :global(.hr__px--a) {
      grid-column: 1 / 8;
      grid-row: 3;
      align-self: end;
      margin-bottom: clamp(12px, 2.4vh, 40px);
    }

    .hr__note {
      grid-column: 9 / 13;
      grid-row: 3;
      align-self: end;
      justify-self: end;
      margin-bottom: clamp(12px, 2.4vh, 40px);
      text-align: right;
    }

    .hr__offer {
      grid-column: 1 / 6;
      grid-row: 4;
    }

    .hr__stage :global(.hr__px--b) {
      grid-column: 7 / 13;
      grid-row: 4;
      align-self: end;
      justify-self: end;
    }

    /* Машина — по центру сцены, поверх обоих слов. */
    .hr__object {
      position: absolute;
      left: 55%;
      top: 50%;
      width: clamp(460px, 46%, 760px);
      translate: -50% -46%;
    }

    /* Контакты — отдельной ячейкой у правого края, между ценой и репликой: не наезжают на текст. */
    .hr__social {
      position: relative;
      top: auto;
      right: auto;
      grid-column: 12 / 13;
      grid-row: 2;
      align-self: center;
      justify-self: end;
      flex-direction: column;
    }
  }

  /* Узкий десктоп: кнопки в одну строку. */
  @media (min-width: 1024px) and (max-width: 1199px) {
    .hr__btn {
      min-height: 52px;
      padding-inline: 20px;
    }

    .hr__lead {
      font-size: var(--fs-0);
    }
  }
</style>
