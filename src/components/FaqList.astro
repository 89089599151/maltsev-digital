---
import type { Faq } from '@/data/content';

interface Props {
  items: Faq[];
  heading?: string;
  headingId?: string;
  /** Имя группы: открыт только один вопрос. */
  group?: string;
  headingLevel?: 'h2' | 'h3';
}
const { items, heading = 'Частые вопросы', headingId = 'faq-title', group = 'faq', headingLevel = 'h2' } = Astro.props;
const H = headingLevel;
---

<section class="faq" aria-labelledby={headingId}>
  <div class="faq__side">
    <H id={headingId} class="head">{heading}</H>
    <slot name="side" />
  </div>
  <div class="faq__list" data-stagger>
    {
      items.map((item, i) => (
        <details class="faq__item" name={group} open={i === 0 ? true : undefined}>
          <summary>
            <span class="faq__q">{item.q}</span>
            <span class="faq__icon" aria-hidden="true">
              <i />
              <i />
            </span>
          </summary>
          <p class="faq__a">{item.a}</p>
        </details>
      ))
    }
  </div>
</section>

<style>
  .faq {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: var(--gap);
    align-items: start;
  }

  .faq__side {
    grid-column: 1 / 5;
    position: sticky;
    top: calc(var(--header-h) + 36px);
    display: grid;
    gap: 24px;
    padding-right: 24px;
  }

  .faq__list {
    grid-column: 5 / 13;
    display: grid;
    gap: var(--gap);
  }

  .faq__item {
    border-radius: var(--radius);
    background: var(--surface);
    -webkit-backdrop-filter: var(--glass-blur);
    backdrop-filter: var(--glass-blur);
    box-shadow: inset 0 0 0 1px var(--glass-edge);
    transition: background-color var(--dur) var(--ease-out);
  }

  .faq__item[open] {
    background: var(--accent);
    color: var(--accent-ink);
  }

  summary {
    display: grid;
    grid-template-columns: 1fr 24px;
    gap: 20px;
    align-items: center;
    min-height: 72px;
    padding: 18px 24px;
    cursor: pointer;
    list-style: none;
    border-radius: var(--radius);
  }

  summary::-webkit-details-marker {
    display: none;
  }

  .faq__item:not([open]) summary:hover {
    background: rgba(255, 255, 255, 0.5);
  }

  .faq__q {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.25rem;
    line-height: 1.25;
    letter-spacing: -0.015em;
  }

  .faq__icon {
    position: relative;
    width: 16px;
    height: 16px;
    justify-self: end;
  }

  .faq__icon i {
    position: absolute;
    left: 0;
    top: 6.5px;
    width: 16px;
    height: 3px;
    border-radius: 2px;
    background: currentColor;
    transition: transform var(--dur) var(--ease-out);
  }

  .faq__icon i:last-child {
    transform: rotate(90deg);
  }

  .faq__item[open] .faq__icon i:last-child {
    transform: rotate(0deg);
  }

  .faq__a {
    max-width: 58ch;
    padding: 0 24px 24px;
    font-size: 1.0625rem;
  }

  @media (max-width: 1023px) {
    .faq__side,
    .faq__list {
      grid-column: 1 / -1;
    }

    .faq__side {
      position: static;
      margin-bottom: 24px;
      padding-right: 0;
    }
  }

  @media (max-width: 767px) {
    .faq {
      grid-template-columns: 1fr;
    }

    summary {
      min-height: 64px;
      padding: 16px 20px;
    }

    .faq__q {
      font-size: 1.125rem;
    }

    .faq__a {
      padding: 0 20px 20px;
      font-size: 1rem;
    }
  }
</style>
