---
import type { Faq } from '@/data/content';

interface Props {
  items: Faq[];
  heading?: string;
  headingId?: string;
  /** Имя группы: открыт только один вопрос. */
  group?: string;
  headingLevel?: 'h2' | 'h3';
  /** Заголовок списка остаётся только для скринридеров — когда над списком уже есть заголовок страницы. */
  headingHidden?: boolean;
  /** Открыть первый вопрос сразу. На главной — нет: там короткий список, все строки одинаковые. */
  openFirst?: boolean;
}
const { items, heading = 'Частые вопросы', headingId = 'faq-title', group = 'faq', headingLevel = 'h2', headingHidden = false, openFirst = true } = Astro.props;
const H = headingLevel;
---

<section class="faq" aria-labelledby={headingId}>
  <div class="faq__side">
    {headingHidden ? <H id={headingId} class="sr-only">{heading}</H> : <H id={headingId} class="head" data-split>{heading}</H>}
    <slot name="side" />
  </div>
  <div class="faq__list" data-stagger>
    {
      items.map((item, i) => (
        <details class="faq__item" name={group} open={openFirst && i === 0 ? true : undefined}>
          <summary>
            <span class="faq__q">{item.q}</span>
            <span class="faq__icon" aria-hidden="true">
              <i />
              <i />
            </span>
          </summary>
          <p class="faq__a">{item.a}</p>
        </details>
      ))
    }
    <slot name="after" />
  </div>
</section>

<style>
  .faq {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: var(--gap);
    align-items: start;
  }

  .faq__side {
    grid-column: 1 / 5;
    position: sticky;
    top: calc(var(--header-h) + 36px);
    display: grid;
    gap: 24px;
    padding-right: 24px;
  }

  /* Вопросы — список под линиями, без плашек: меньше серых карточек подряд. */
  .faq__list {
    grid-column: 5 / 13;
    display: grid;
    border-top: 1px solid var(--line);
  }

  .faq__item {
    border-bottom: 1px solid var(--line);
  }

  /* Строка-ссылка в конце короткого списка: «ещё N вопросов» — в том же ритме, что и вопросы. */
  /* «Ещё N вопросов» — последняя строка того же списка: шрифт и цвет как у вопросов, подпись
     серым, справа такой же белый кружок, только со стрелкой. При наведении текст синеет,
     кружок заливается синим, стрелка подаётся вперёд. */
  .faq__list :global(.faq__more) {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 36px;
    gap: 20px;
    align-items: center;
    min-height: 72px;
    padding: 18px 0;
    color: var(--ink);
    text-decoration: none;
    -webkit-tap-highlight-color: transparent;
  }

  .faq__list :global(.faq__more-t) {
    display: grid;
    gap: 4px;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: var(--fs-1);
    line-height: 1.25;
    letter-spacing: -0.015em;
    transition: color var(--dur-fast) var(--ease-out);
  }

  .faq__list :global(.faq__more-t small) {
    font-family: var(--font-text);
    font-weight: 400;
    font-size: var(--step-small);
    letter-spacing: 0;
    color: var(--muted);
  }

  .faq__list :global(.faq__more-i) {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    justify-self: end;
    border-radius: 50%;
    background: var(--paper);
    color: var(--ink);
    transition:
      background-color var(--dur) var(--ease-out),
      color var(--dur) var(--ease-out);
  }

  .faq__list :global(.faq__more-i .icon) {
    transition: translate var(--dur-spring) var(--ease-spring);
  }

  .faq__list :global(.faq__more:is(:hover, :focus-visible) .faq__more-t) {
    color: var(--accent-text);
  }

  .faq__list :global(.faq__more:is(:hover, :focus-visible) .faq__more-i) {
    background: var(--accent);
    color: var(--accent-ink);
  }

  .faq__list :global(.faq__more:is(:hover, :focus-visible) .faq__more-i .icon) {
    translate: 3px 0;
  }

  .faq__list :global(.faq__more:active .faq__more-i) {
    scale: 0.92;
  }

  .faq__side :global(.head) {
    font-weight: 300;
    font-size: var(--fs-5);
    line-height: 1.02;
    letter-spacing: -0.05em;
  }

  summary {
    display: grid;
    grid-template-columns: 1fr 36px;
    gap: 20px;
    align-items: center;
    min-height: 72px;
    padding: 18px 0;
    cursor: pointer;
    list-style: none;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  .faq__q {
    transition: color var(--dur-fast) var(--ease-out);
  }

  summary:hover .faq__q {
    color: var(--accent-text);
  }

  /* Вопрос — как заголовки других списков сайта: 500, а не жирный 600. */
  .faq__q {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: var(--fs-1);
    line-height: 1.25;
    letter-spacing: -0.015em;
  }

  .faq__icon {
    position: relative;
    width: 36px;
    height: 36px;
    justify-self: end;
    border-radius: 50%;
    background: var(--paper);
    color: var(--ink);
    transition:
      background-color var(--dur) var(--ease-out),
      color var(--dur) var(--ease-out),
      rotate var(--dur-spring) var(--ease-spring);
  }

  summary:hover .faq__icon {
    background: var(--surface-2);
  }

  /* Открытый вопрос: плюс поворачивается в крестик — так же, как у этапов и состава пакета. */
  .faq__item[open] .faq__icon {
    background: var(--accent);
    color: var(--accent-ink);
    rotate: 45deg;
  }

  .faq__icon i {
    position: absolute;
    left: 11px;
    top: 16.5px;
    width: 14px;
    height: 3px;
    border-radius: 1px;
    background: currentColor;
    transition: transform var(--dur) var(--ease-out);
  }

  .faq__icon i:last-child {
    transform: rotate(90deg);
  }

  .faq__a {
    max-width: 58ch;
    padding: 0 56px 24px 0;
    font-size: var(--step-body);
  }

  @media (max-width: 1023px) {
    .faq {
      row-gap: 28px;
    }

    .faq__side,
    .faq__list {
      grid-column: 1 / -1;
    }

    .faq__side {
      position: static;
      gap: 18px;
      padding-right: 0;
    }

    /* Без видимого заголовка (страница «Вопросы») подсказка «если ответа нет» идёт после списка. */
    .faq__side:has(> .sr-only:first-child) {
      order: 2;
    }
  }

  @media (max-width: 767px) {
    .faq {
      grid-template-columns: 1fr;
    }

    summary {
      min-height: 64px;
      padding: 16px 0;
    }

    .faq__q {
      font-size: var(--step-body);
    }

    .faq__a {
      padding: 0 0 24px;
      font-size: var(--step-body);
      line-height: 1.6;
    }
  }
</style>
