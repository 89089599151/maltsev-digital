---
/** Иконки связи: одна толщина линии (2px), сетка 24px, currentColor. */
interface Props {
  kind: 'telegram' | 'email';
  size?: number;
}
const { kind, size = 22 } = Astro.props;
---

<svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  {
    kind === 'telegram' ? (
      <path d="M21 4 3 11l6 2.5L19 7l-7.5 8.2V20l3.3-3.6L18 19z" />
    ) : (
      <>
        <rect x="3" y="5" width="18" height="14" rx="2.5" />
        <path d="m4 7 8 6 8-6" />
      </>
    )
  }
</svg>
