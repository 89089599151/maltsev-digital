---
/**
 * Стрелки интерфейса: одна сетка 24px, одна толщина линии (2px), currentColor.
 * Размер — 1em, поэтому иконка подстраивается под кегль кнопки или ссылки.
 */
interface Props {
  name: 'arrow' | 'arrow-ne' | 'arrow-up';
}
const { name } = Astro.props;
const paths = {
  arrow: 'M5 12h14M13 6l6 6-6 6',
  'arrow-ne': 'M7 17 17 7M8 7h9v9',
  'arrow-up': 'M12 19V5M6 11l6-6 6 6',
};
---

<svg class="icon" width="1em" height="1em" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  <path d={paths[name]} />
</svg>

<style>
  .icon {
    display: inline-block;
    flex: none;
    vertical-align: -0.125em;
  }
</style>
