---
/** Подход через результат для клиента: автор, три результата и реальный кейс. */
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import SectionHead from './SectionHead.astro';
import { site } from '@/config/site';
import { url } from '@/lib/url';
import photo from '@/assets/photos/owner.webp';

interface Props {
  owner?: boolean;
}
const { owner = false } = Astro.props;
const outcomes = [
  {
    title: 'Структура под вашу задачу',
    text: 'У страниц есть цель: объяснить услугу, показать работу или привести к обращению.',
  },
  {
    title: 'Цельный дизайн на любом экране',
    text: 'Продумываю тексты, изображения и управление вместе. Проверяю сайт на телефоне и компьютере.',
  },
  {
    title: 'Готовый сайт остаётся у вас',
    text: 'Публикую на вашем домене, передаю исходный код и доступы.',
  },
];
---

<section class="mf section" id="manifest" data-island-section="Подход" aria-labelledby="mf-title">
  <SectionHead
    id="mf-title"
    title="Лично веду ваш проект."
    text="Проектирую, рисую и разрабатываю ваш сайт. Ключевые решения обсуждаю с вами и довожу до запуска."
  />

  <div class:list={['mf__body', { 'mf__body--owner': owner }]}>
    {owner && (
      <figure class="mf__author">
        <div class="mf__portrait">
          <Image
            src={photo}
            alt={`${site.brand.owner.value} смотрит на свет фонаря под снегом`}
            widths={[240, 480, 720, 960]}
            sizes="(max-width: 899px) 104px, 36vw"
            loading="lazy"
          />
        </div>
        <figcaption class="mf__caption">
          <p class="mf__name">{site.brand.owner.value}</p>
          <p class="mf__role">Дизайнер и разработчик</p>
          <a class="mf__about" href={url('/about/')}>
            Обо мне <span class="arrow" aria-hidden="true"><Icon name="arrow" /></span>
          </a>
        </figcaption>
      </figure>
    )}

    <div class="mf__content">
      <dl class="mf__outcomes">
        {outcomes.map(({ title, text }) => (
          <div class="mf__outcome">
            <dt>{title}</dt>
            <dd>{text}</dd>
          </div>
        ))}
      </dl>

      <a class="mf__case" href={url('/portfolio/maltsev-digital/')}>
        Как сделан этот сайт <span class="arrow" aria-hidden="true"><Icon name="arrow" /></span>
      </a>

      <p class="mf__tools">
        ИИ помогает с черновиками, кодом и поиском ошибок. Я проверяю результат и принимаю решения.
      </p>
    </div>
  </div>
</section>

<style>
  .mf__body {
    display: grid;
    overflow: hidden;
    border-radius: var(--radius-lg);
    background: var(--paper);
  }

  .mf__body--owner {
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
  }

  .mf__author {
    position: relative;
    display: grid;
    align-items: end;
    min-width: 0;
    min-height: 420px;
    isolation: isolate;
    background: var(--night);
    color: var(--night-ink);
  }

  .mf__portrait {
    position: absolute;
    inset: 0;
    z-index: -1;
  }

  .mf__portrait img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 54% 50%;
  }

  .mf__caption {
    display: grid;
    gap: 8px;
    padding: 112px clamp(24px, 3vw, 40px) 32px;
    background: linear-gradient(180deg, rgba(10, 11, 20, 0), rgba(10, 11, 20, .88) 66%);
  }

  .mf__name {
    font-weight: 400;
    font-size: var(--fs-3);
    line-height: 1.15;
    letter-spacing: -.035em;
  }

  .mf__role {
    font-size: var(--step-small);
    line-height: 1.4;
    color: var(--night-muted);
  }

  .mf__about,
  .mf__case {
    display: inline-flex;
    align-items: center;
    justify-self: start;
    gap: 12px;
    min-height: 44px;
    font-weight: 500;
    font-size: var(--fs-0);
    line-height: 1.3;
    text-decoration: none;
  }

  .mf__about {
    margin-top: 4px;
    color: inherit;
  }

  .mf__about:focus-visible {
    outline-color: var(--paper);
  }

  .mf__content {
    min-width: 0;
    padding: clamp(28px, 3.4vw, 48px);
  }

  .mf__outcomes {
    margin: 0;
  }

  .mf__outcome + .mf__outcome {
    margin-top: 24px;
    padding-top: 24px;
    border-top: 1px solid var(--line);
  }

  .mf__outcome dt {
    max-width: 32ch;
    font-weight: 500;
    font-size: var(--fs-2);
    line-height: 1.25;
    letter-spacing: -.025em;
  }

  .mf__outcome dd {
    max-width: 56ch;
    margin: 10px 0 0;
    font-size: var(--step-body);
    line-height: 1.55;
    color: var(--muted);
  }

  .mf__case {
    margin-top: 24px;
    padding-bottom: 8px;
    border-bottom: 1px solid var(--accent);
    color: var(--ink);
    transition: color var(--dur-fast) var(--ease-out);
  }

  .mf__case:hover {
    color: var(--accent-text);
  }

  .mf__tools {
    max-width: 64ch;
    margin-top: 28px;
    padding-top: 20px;
    border-top: 1px solid var(--line);
    font-size: var(--step-small);
    line-height: 1.5;
    color: var(--muted);
  }

  @media (max-width: 899px) {
    .mf__body--owner {
      grid-template-columns: minmax(0, 1fr);
    }

    .mf__author {
      grid-template-columns: 104px minmax(0, 1fr);
      align-items: center;
      gap: 24px;
      min-height: 0;
      padding: 28px 28px 0;
      background: none;
      color: var(--ink);
    }

    .mf__portrait {
      position: relative;
      z-index: auto;
      height: 132px;
      overflow: hidden;
      border-radius: var(--radius-sm);
    }

    .mf__caption {
      gap: 4px;
      padding: 0;
      background: none;
    }

    .mf__name {
      font-size: 1.5rem;
    }

    .mf__role {
      color: var(--muted);
    }

    .mf__about {
      margin-top: 0;
      font-size: var(--step-small);
    }

    .mf__about:focus-visible {
      outline-color: var(--accent);
    }
  }

  @media (max-width: 599px) {
    .mf__body {
      border-radius: var(--radius);
    }

    .mf__author {
      grid-template-columns: 88px minmax(0, 1fr);
      gap: 18px;
      padding: 24px 24px 0;
    }

    .mf__portrait {
      height: 116px;
    }

    .mf__content {
      padding: 28px 24px;
    }

    .mf__outcome dt {
      font-size: 1.25rem;
    }
  }

  @media (max-width: 359px) {
    .mf__author {
      grid-template-columns: 76px minmax(0, 1fr);
      gap: 16px;
      padding-inline: 20px;
    }

    .mf__content {
      padding-inline: 20px;
    }

    .mf__name {
      font-size: 1.375rem;
    }
  }
</style>
