---
/**
 * Интерактивный объект первого экрана: эта же страница, разобранная на слои —
 * сетка, модули, текст, готовый экран. Слои следуют за курсором и раздвигаются;
 * кнопка позволяет собрать и разобрать сайт без мыши.
 */
---

<div class="ss" data-stack data-state="open">
  <p class="ss__legend">Эта страница, разобранная на слои: сетка, модули, текст, готовый экран.</p>
  <div class="ss__scene" role="img" aria-label="Схема: страница сайта, разобранная на четыре слоя — сетка, модули, текст и готовый экран">
    <div class="ss__stack" data-stack-inner>
      <div class="ss__layer ss__layer--grid" style="--z:0">
        {Array.from({ length: 12 }).map(() => <i />)}
        <span class="ss__tag">Сетка</span>
      </div>
      <div class="ss__layer ss__layer--blocks" style="--z:1">
        <b class="b-nav"></b>
        <b class="b-name"></b>
        <b class="b-media"></b>
        <b class="b-photo"></b>
        <b class="b-text"></b>
        <b class="b-cta"></b>
        <span class="ss__tag">Модули</span>
      </div>
      <div class="ss__layer ss__layer--type" style="--z:2">
        <span class="t-name">MALTSEV</span>
        <span class="t-line">Сайты под задачу бизнеса</span>
        <span class="t-line t-line--short">Дизайн · код · запуск</span>
        <span class="ss__tag">Текст</span>
      </div>
      <div class="ss__layer ss__layer--done" style="--z:3">
        <span class="d-nav"><i></i><i></i><i></i></span>
        <span class="d-name">MALTSEV</span>
        <span class="d-media"></span>
        <span class="d-photo"></span>
        <span class="d-text"><i></i><i></i><i></i></span>
        <span class="d-cta"></span>
        <span class="ss__tag">Готово</span>
      </div>
    </div>
  </div>
  <button class="ss__toggle" type="button" aria-pressed="false" data-stack-toggle>
    <span data-label-open>Собрать слои</span>
    <span data-label-closed hidden>Разобрать на слои</span>
  </button>
</div>

<script>
  import { initSiteStack } from '@/scripts/site-stack';
  initSiteStack();
</script>

<style>
  .ss {
    position: relative;
    height: 100%;
    min-height: 300px;
    display: grid;
    place-items: center;
    overflow: hidden;
    --rx: 56deg;
    --rz: -38deg;
    --spread: 1;
  }

  .ss__scene {
    perspective: 1400px;
    width: min(62%, 420px);
    aspect-ratio: 16 / 10;
  }

  .ss__stack {
    position: relative;
    width: 100%;
    height: 100%;
    transform-style: preserve-3d;
    transform: rotateX(var(--rx)) rotateZ(var(--rz)) translateZ(-40px);
    transition: transform 600ms var(--ease-out);
  }

  .ss__layer {
    position: absolute;
    inset: 0;
    border-radius: 6px;
    transform: translateZ(calc(var(--z) * 54px * var(--spread)));
    transition: transform 700ms var(--ease-out);
    transform-style: preserve-3d;
  }

  .ss__tag {
    display: none;
  }

  .ss__legend {
    position: absolute;
    left: var(--pad);
    top: var(--pad);
    max-width: 30ch;
    font-family: var(--font-display);
    font-size: var(--step-small);
    line-height: 1.35;
    color: var(--night-muted);
    z-index: 1;
  }

  /* Сетка */
  .ss__layer--grid {
    background: rgba(255, 255, 255, 0.08);
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: 3px;
    padding: 6px;
  }

  .ss__layer--grid i {
    background: rgba(255, 255, 255, 0.12);
    border-radius: 2px;
  }

  /* Модули */
  .ss__layer--blocks {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    grid-template-rows: 12% 1fr 1fr;
    gap: 4px;
    padding: 6px;
  }

  .ss__layer--blocks b {
    border-radius: 3px;
    background: rgba(255, 255, 255, 0.24);
  }

  .b-nav { grid-column: 1 / -1; }
  .b-name { grid-column: 1 / 7; }
  .b-media { grid-column: 7 / 13; }
  .b-photo { grid-column: 1 / 7; }
  .b-text { grid-column: 7 / 10; }
  .b-cta { grid-column: 10 / 13; background: rgba(84, 132, 255, 0.75) !important; }

  /* Текст */
  .ss__layer--type {
    padding: 18% 8% 0 6%;
    display: flex;
    flex-direction: column;
    gap: 6px;
    font-family: var(--font-display);
    color: var(--night-ink);
  }

  .t-name {
    font-weight: 800;
    font-size: clamp(22px, 2.4vw, 38px);
    letter-spacing: -0.05em;
    line-height: 0.9;
  }

  .t-line {
    font-size: 11px;
    font-weight: 500;
    color: var(--night-ink);
  }

  .t-line--short {
    color: var(--night-muted);
  }

  /* Готовый экран */
  .ss__layer--done {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    grid-template-rows: 12% 1fr 1fr;
    gap: 4px;
    padding: 6px;
    background: #eaf0fa;
    font-family: var(--font-display);
  }

  .ss__layer--done > span:not(.ss__tag) {
    border-radius: 3px;
    overflow: hidden;
  }

  .d-nav {
    grid-column: 1 / -1;
    background: #ffffff;
    display: flex;
    gap: 6px;
    align-items: center;
    justify-content: flex-end;
    padding-inline: 6px;
  }

  .d-nav i {
    width: 14%;
    height: 3px;
    border-radius: 2px;
    background: #9aa8c2;
  }

  .d-name {
    grid-column: 1 / 7;
    background: #ffffff;
    color: var(--paper-ink);
    font-weight: 800;
    font-size: clamp(14px, 1.6vw, 24px);
    letter-spacing: -0.05em;
    display: flex;
    align-items: flex-end;
    padding: 6px;
    line-height: 0.85;
  }

  .d-media {
    grid-column: 7 / 13;
    background: var(--night);
  }

  .d-photo {
    grid-column: 1 / 7;
    background: #a9bcd9;
  }

  .d-text {
    grid-column: 7 / 10;
    background: #ffffff;
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 6px;
  }

  .d-text i {
    height: 3px;
    border-radius: 2px;
    background: #9aa8c2;
  }

  .d-text i:last-child {
    width: 60%;
  }

  .d-cta {
    grid-column: 10 / 13;
    background: var(--accent);
  }

  .ss__toggle {
    position: absolute;
    left: var(--pad);
    bottom: var(--pad);
    min-height: 44px;
    padding: 10px 16px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.14);
    color: var(--night-ink);
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.9375rem;
    transition:
      background-color var(--dur-fast) var(--ease-out),
      transform var(--dur-fast) var(--ease-out);
  }

  .ss__toggle:hover {
    background: var(--accent);
    color: var(--accent-ink);
  }

  .ss__toggle:active {
    transform: scale(0.97);
  }

  @media (max-width: 767px) {
    .ss {
      padding-top: 64px;
      padding-bottom: 56px;
    }

    .ss__scene {
      width: 62%;
    }

    .ss__tag {
      font-size: 11px;
      padding: 2px 6px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ss__stack,
    .ss__layer {
      transition: none;
    }
  }
</style>
