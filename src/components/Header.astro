---
import LogoMark from './LogoMark.astro';
import { url, isActive } from '@/lib/url';
import { site } from '@/config/site';
import Icon from './Icon.astro';
import AvailabilityLine from './AvailabilityLine.astro';
import WriteSheet from './WriteSheet.astro';

const nav = [
  { href: '/', label: 'Главная' },
  { href: '/portfolio/', label: 'Работы' },
  { href: '/services/', label: 'Услуги и цены' },
  { href: '/about/', label: 'Обо мне' },
  { href: '/faq/', label: 'Вопросы' },
];
const current = Astro.url.pathname;
const onHome = isActive(current, '/');
const onContacts = isActive(current, '/contacts/');
// На странице контактов переходим к брифу, сохраняя уже заполненные поля.
const contactHref = onContacts ? url('/contacts/#brief-title') : url('/contacts/');

// Остров: подпись кнопки меню — раздел, в котором находится посетитель.
const section = nav.find((item) => isActive(current, item.href))?.label ?? (onContacts ? 'Контакты' : null);
const menuLabel = section ?? 'Меню';
const menuAria = section ? `Меню сайта. Сейчас открыт раздел «${section}»` : 'Меню сайта';
---

<header class="hdr" data-header>
  <div class="hdr__row">
    <a class="hdr__brand" href={url('/')} aria-label={`${site.brand.name.value} — на главную`}>
      <LogoMark class="hdr__mark" />
      <span class="hdr__name">{site.brand.short}<span> {site.brand.second}</span></span>
    </a>
    <nav class="hdr__nav" aria-label="Основная навигация">
      <ul>
        {
          nav.map((item) => (
            <li>
              <a href={url(item.href)} aria-current={isActive(current, item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <a class="hdr__cta btn btn--accent" href={contactHref} aria-current={onContacts ? 'page' : undefined}>
      Обсудить проект
    </a>
  </div>

  <noscript>
    <nav class="hdr__fallback" aria-label="Разделы сайта">
      <ul>{nav.map((item) => <li><a href={url(item.href)} aria-current={isActive(current, item.href) ? 'page' : undefined}>{item.label}</a></li>)}</ul>
    </nav>
  </noscript>
</header>

<!-- Остров: навигация телефона под большим пальцем. Кнопка меню видна, когда работает скрипт
     (без него меню не открыть — остаётся «Написать»). Подписи меняет island.ts: раздел страницы
     под взглядом читателя и расчёт из калькулятора.
     На главной остров сначала спрятан (is-held): на первом экране он лёг бы на цифры под заголовком.
     Он выезжает, как только читатель чуть прокрутит страницу и цифры уйдут из нижней зоны экрана. -->
<div class:list={['isl', { 'is-held': onHome }]} data-island>
  <button class="isl__menu" type="button" aria-label={menuAria} aria-haspopup="dialog" aria-controls="site-menu" aria-expanded="false" data-menu-open>
    <Icon name="menu" />
    <span class="isl__fold"><span class="isl__label" data-island-menu-label>{menuLabel}</span></span>
  </button>
  <a class="isl__write" href={contactHref} aria-label="Написать" aria-current={onContacts ? 'page' : undefined} data-write-open>
    <span class="isl__fold"><span class="isl__label" data-island-write-label>Написать</span></span>
    <Icon name="arrow-ne" />
  </a>
</div>

<dialog class="sheet menu" id="site-menu" aria-labelledby="site-menu-title" data-menu>
  <div class="sheet__board" data-sheet-board>
    <h2 class="sr-only" id="site-menu-title">Разделы сайта</h2>
    <span class="sheet__grip" aria-hidden="true"></span>
    <nav class="menu__nav sheet__in" aria-label="Разделы сайта" data-sheet-scroll>
      <ul class="menu__list">
        {nav.map((item) => (
          <li>
            <a href={url(item.href)} aria-current={isActive(current, item.href) ? 'page' : undefined} data-menu-item>
              {item.label}
              <Icon name={isActive(current, item.href) ? 'check' : 'arrow-ne'} />
            </a>
          </li>
        ))}
      </ul>
    </nav>
    <AvailabilityLine class="menu__status sheet__in" />
    <div class="sheet__foot">
      <button class="sheet__close" type="button" aria-label="Закрыть меню" data-sheet-close autofocus><Icon name="close" /></button>
      <a class="menu__cta" href={contactHref} aria-current={onContacts ? 'page' : undefined} data-menu-item>Обсудить проект <Icon name="arrow-ne" /></a>
    </div>
  </div>
</dialog>

<!-- На странице контактов бриф уже на экране: «Написать» ведёт к нему, лист не нужен. -->
{!onContacts && <WriteSheet />}

<script>
  import { initMobileMenu } from '@/scripts/mobile-menu';
  import { initIsland } from '@/scripts/island';
  import { initWriteSheet } from '@/scripts/write-sheet';
  initMobileMenu();
  initWriteSheet();
  initIsland();

  // Десктопная шапка прячется при прокрутке вниз; на телефоне она обычная часть страницы.
  const header = document.querySelector<HTMLElement>('[data-header]');
  const desktop = window.matchMedia('(min-width: 1024px)');
  if (header) {
    let lastY = window.scrollY;
    let ticking = false;
    const update = () => {
      ticking = false;
      const y = window.scrollY;
      const hide = desktop.matches && y > lastY && y > 240 && !header.contains(document.activeElement);
      header.classList.toggle('is-hidden', hide);
      header.classList.toggle('is-scrolled', y > 8);
      lastY = y;
    };
    update();
    window.addEventListener('scroll', () => {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(update);
      }
    }, { passive: true });
    header.addEventListener('focusin', () => header.classList.remove('is-hidden'));
    desktop.addEventListener('change', () => {
      lastY = window.scrollY;
      update();
    });
  }
</script>

<style>
  .hdr {
    position: sticky;
    top: 0;
    z-index: 50;
    padding-block: var(--margin) 12px;
    background: linear-gradient(var(--bg) 70%, rgba(241, 242, 250, 0));
    transition: transform var(--dur) var(--ease-out);
  }

  .hdr.is-hidden {
    transform: translateY(-110%);
  }

  @media (prefers-reduced-motion: reduce) {
    .hdr {
      transition: none;
    }
  }

  :global(.js) .hdr:not(.is-scrolled) {
    background: none;
  }

  /* Главная, широкий экран: шапка внутри белой сцены первого экрана (HeroNova) — с отступом от её края. */
  @media (min-width: 1024px) {
    :global(body:has(.hn)) .hdr {
      padding-top: calc(var(--margin) + var(--hdr-inset));
    }
  }

  /* При смене страницы строка шапки не гаснет вместе со страницей, а переезжает на своё место
     (на главной она ниже) — одинакового размера на всех страницах, без двойного изображения. */
  .hdr__row {
    view-transition-name: site-header;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: var(--gap);
    min-height: 56px;
  }

  .hdr__brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    justify-self: start;
    min-height: 44px;
    text-decoration: none;
  }

  .hdr__brand :global(.hdr__mark) {
    width: 32px;
    height: 32px;
    color: var(--accent);
  }

  .hdr__name {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: var(--step-body);
    letter-spacing: -0.03em;
    white-space: nowrap;
  }

  .hdr__name span {
    color: var(--muted);
    font-weight: 500;
  }

  /* Плашка-навигация: белая пилюля с тонкой линией, активный раздел — тёмная пилюля внутри.
     Пункты и кнопка справа одной высоты — 44px: строка шапки ровная. */
  .hdr__nav ul {
    list-style: none;
    display: flex;
    gap: 2px;
    padding: 4px;
    border-radius: var(--radius-pill);
    background: var(--paper);
    box-shadow: inset 0 0 0 1px var(--line);
  }

  .hdr__nav a {
    display: flex;
    align-items: center;
    min-height: 36px;
    padding: 0 18px;
    border-radius: var(--radius-pill);
    font-family: var(--font-display);
    font-weight: 500;
    font-size: var(--step-small);
    text-decoration: none;
    white-space: nowrap;
    color: var(--ink-2);
    transition:
      background-color var(--dur-fast) var(--ease-out),
      color var(--dur-fast) var(--ease-out);
  }

  .hdr__nav a:hover {
    background: rgba(10, 11, 20, 0.07);
    color: var(--ink);
  }

  /* Тёмная плашка текущего раздела при переходе переезжает к новому пункту, как в сегментах iOS. */
  .hdr__nav a[aria-current='page'] {
    background: var(--ink);
    color: var(--bg);
    view-transition-name: nav-current;
  }

  .hdr__cta {
    justify-self: end;
    min-height: 44px;
    padding-block: 10px;
    white-space: nowrap;
  }

  /* Узкий десктоп: пункты навигации плотнее, чтобы логотип и кнопка остались в одну строку. */
  @media (min-width: 1024px) and (max-width: 1199px) {
    .hdr__nav a {
      padding-inline: 12px;
    }
  }

  .hdr__fallback,
  .isl {
    display: none;
  }

  /* --- Меню: содержимое листа (оболочка — src/styles/sheet.css) ------------ */

  /* Жест «зажал — провёл — отпустил» идёт по карточке: текст под пальцем не выделяется. */
  .menu :global(.sheet__board) {
    -webkit-user-select: none;
    user-select: none;
  }

  .menu__nav {
    min-height: 0;
    overflow-y: auto;
    overscroll-behavior: contain;
  }

  .menu__list {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 2px;
  }

  .menu__list a {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    min-height: 56px;
    padding: 8px 18px;
    border-radius: var(--radius);
    font-family: var(--font-display);
    font-weight: 400;
    font-size: var(--fs-1);
    line-height: 1.2;
    letter-spacing: -0.03em;
    text-decoration: none;
    transition:
      background-color var(--dur-fast) var(--ease-out),
      color var(--dur-fast) var(--ease-out);
  }

  .menu__list a :global(.icon) {
    font-size: var(--fs-0);
    color: var(--muted);
  }

  .menu__list a:hover {
    background: var(--bg);
  }

  .menu__list a[aria-current='page'] {
    background: var(--accent-soft);
    color: var(--accent-text);
  }

  .menu__list a[aria-current='page'] :global(.icon) {
    color: inherit;
  }

  /* Раздел под пальцем во время жеста «зажал — провёл — отпустил». */
  .menu__list a.is-target {
    background: var(--ink);
    color: var(--bg);
  }

  .menu__list a.is-target :global(.icon) {
    color: inherit;
  }

  .menu :global(.menu__status) {
    padding-inline: 18px;
  }

  .menu__cta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 10px;
    flex: 1;
    min-width: 0;
    min-height: 56px;
    padding: 12px 20px;
    white-space: nowrap;
    border-radius: var(--radius-pill);
    background: var(--accent);
    color: var(--accent-ink);
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--step-body);
    text-decoration: none;
    transition: background-color var(--dur-fast) var(--ease-out);
  }

  .menu__cta:hover,
  .menu__cta.is-target {
    background: var(--accent-deep);
  }

  /* --- Телефон и планшет: логотип сверху, остров снизу -------------------- */

  @media (max-width: 1023px) {
    /* Шапка — обычная часть страницы: навигация живёт в острове. */
    .hdr {
      position: static;
      padding-block: max(12px, env(safe-area-inset-top)) 4px;
      background: none;
    }

    .hdr__row {
      grid-template-columns: 1fr;
      min-height: 48px;
    }

    .hdr__nav,
    .hdr__cta {
      display: none;
    }

    /* Запас внизу страницы, чтобы остров не закрывал конец подвала. */
    :global(body) {
      padding-bottom: calc(62px + 12px + max(12px, env(safe-area-inset-bottom)));
    }

    .isl {
      position: fixed;
      z-index: 60;
      inset-inline: 0;
      bottom: max(12px, env(safe-area-inset-bottom));
      display: flex;
      align-items: center;
      gap: 6px;
      width: fit-content;
      max-width: calc(100% - 24px);
      margin-inline: auto;
      padding: 6px;
      border: 1px solid rgba(10, 11, 20, 0.08);
      border-radius: var(--radius-pill);
      background: var(--paper);
      box-shadow: var(--shadow-2);
      /* При переходе между страницами остров остаётся на месте, меняется только подпись. */
      view-transition-name: site-island;
    }

    /* Без скрипта меню не открыть — кнопку не показываем. Со скриптом она видна с первого кадра,
       и остров не меняет ширину после загрузки. */
    :global(html:not(.js)) .isl__menu {
      display: none;
    }

    /* Главная: остров ждёт, пока цифры первого экрана уйдут из нижней зоны (island.ts).
       Без скрипта он виден сразу. */
    :global(html.js) .isl.is-held {
      transform: translateY(calc(100% + 32px));
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
      view-transition-name: none;
    }

    /* Пока открыто меню, остров «стал» карточкой. */
    :global(html.site-menu-open) .isl {
      visibility: hidden;
    }

    /* Открыта клавиатура — остров уходит вниз и не закрывает поля формы. */
    .isl.is-away {
      transform: translateY(calc(100% + 32px));
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
    }

    .isl__menu,
    .isl__write {
      display: inline-flex;
      align-items: center;
      min-width: 48px;
      height: 48px;
      padding: 0 15px;
      border-radius: var(--radius-pill);
      font-family: var(--font-display);
      font-size: var(--step-small);
      line-height: 1.2;
      font-weight: 600;
      letter-spacing: -0.01em;
      white-space: nowrap;
      text-decoration: none;
    }

    .isl__menu :global(.icon),
    .isl__write :global(.icon) {
      font-size: 18px;
    }

    .isl__menu {
      min-width: 0;
      background: var(--bg);
      color: var(--ink);
      /* Жест начинается на кнопке: страница под пальцем не прокручивается, текст не выделяется. */
      touch-action: none;
      -webkit-touch-callout: none;
      -webkit-user-select: none;
      user-select: none;
    }

    .isl__menu:hover {
      background: var(--surface-2);
    }

    .isl__write {
      flex: none;
      background: var(--accent);
      color: var(--accent-ink);
    }

    .isl__write:hover {
      background: var(--accent-deep);
    }

    /* Подпись складывается до нуля, когда остров сжат: остаются две круглые кнопки. */
    .isl__fold {
      display: grid;
      grid-template-columns: 1fr;
      min-width: 0;
      overflow: hidden;
    }

    .isl__label {
      min-width: 0;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .isl__menu .isl__label {
      padding-inline: 8px 3px;
    }

    .isl__write .isl__label {
      padding-inline: 3px 6px;
    }

    .isl.is-compact .isl__fold {
      grid-template-columns: 0fr;
      opacity: 0;
    }

    .isl.is-compact .isl__label {
      padding-inline: 0;
      /* Пока подпись складывается, многоточие не мелькает. */
      text-overflow: clip;
    }

    /* Расчёт из калькулятора: подпись меню становится суммой, синяя кнопка — «Отправить». */
    .isl.is-live .isl__menu {
      background: var(--accent-soft);
      color: var(--accent-text);
      font-variant-numeric: tabular-nums;
    }

    .isl.is-live .isl__write :global(.icon) {
      display: none;
    }

    .isl.is-live .isl__write .isl__label {
      padding-inline: 5px;
    }

    @media (max-width: 399px) {
      .isl.is-live .isl__menu,
      .isl.is-live .isl__write {
        font-size: var(--fs-xs);
      }
    }

    /* Самые узкие телефоны: подпись «Услуги и цены» помещается целиком. */
    @media (max-width: 359px) {
      .isl__menu,
      .isl__write {
        padding-inline: 13px;
        font-size: var(--fs-xs);
      }
    }

    .hdr__fallback {
      display: block;
      padding-top: 10px;
    }

    .hdr__fallback ul {
      display: flex;
      flex-wrap: wrap;
      list-style: none;
      gap: 6px;
      padding: 0;
    }

    .hdr__fallback a {
      display: inline-flex;
      align-items: center;
      min-height: 44px;
      padding: 8px 12px;
      border-radius: var(--radius-pill);
      background: var(--paper);
      font-size: var(--fs-xs);
      text-decoration: none;
    }
  }

  @media (max-width: 1023px) and (prefers-reduced-motion: no-preference) {
    .isl {
      transition:
        transform var(--dur) var(--ease-out),
        opacity var(--dur-fast) var(--ease-out),
        visibility 0s;
    }

    .isl.is-away,
    .isl.is-held {
      transition:
        transform var(--dur) var(--ease-out),
        opacity var(--dur-fast) var(--ease-out),
        visibility 0s var(--dur);
    }

    .isl__fold {
      transition:
        grid-template-columns var(--dur) var(--ease-out),
        opacity var(--dur-fast) var(--ease-out);
    }

    .isl__label {
      transition: padding var(--dur) var(--ease-out);
    }

    .isl__menu,
    .isl__write {
      transition:
        background-color var(--dur-fast) var(--ease-out),
        transform var(--dur-fast) var(--ease-out);
    }

    .isl__menu:active,
    .isl__write:active {
      transform: scale(0.96);
    }
  }
</style>
