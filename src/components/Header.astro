---
import LogoMark from './LogoMark.astro';
import { url, isActive } from '@/lib/url';
import { site } from '@/config/site';
import Icon from './Icon.astro';

const nav = [
  { href: '/', label: 'Главная' },
  { href: '/portfolio/', label: 'Работы' },
  { href: '/services/', label: 'Услуги и цены' },
  { href: '/about/', label: 'Обо мне' },
  { href: '/faq/', label: 'Вопросы' },
];
const current = Astro.url.pathname;
const onContacts = isActive(current, '/contacts/');
// На странице контактов переходим к брифу, сохраняя уже заполненные поля.
const contactHref = onContacts ? url('/contacts/#brief-title') : url('/contacts/');

// Остров: подпись кнопки меню — раздел, в котором находится посетитель.
const section = nav.find((item) => isActive(current, item.href))?.label ?? (onContacts ? 'Контакты' : null);
const menuLabel = section ?? 'Меню';
const menuAria = section ? `Меню сайта. Сейчас открыт раздел «${section}»` : 'Меню сайта';

// Статус в меню: до запуска скрипта — нейтральная строка с часами, дальше её уточняет mobile-menu.ts.
const { workHours, responseMinutes, hours } = site.contacts;
const hoursText = hours.charAt(0).toUpperCase() + hours.slice(1);
const onlineText = `На связи · отвечу за ${responseMinutes} минут`;
const offlineText = `Отвечу после ${workHours.from}:00 по Москве`;
---

<header class="hdr" data-header>
  <div class="hdr__row">
    <a class="hdr__brand" href={url('/')} aria-label={`${site.brand.name.value} — на главную`}>
      <LogoMark class="hdr__mark" />
      <span class="hdr__name">{site.brand.short}<span> {site.brand.second}</span></span>
    </a>
    <nav class="hdr__nav" aria-label="Основная навигация">
      <ul>
        {
          nav.map((item) => (
            <li>
              <a href={url(item.href)} aria-current={isActive(current, item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <a class="hdr__cta btn btn--accent" href={url('/contacts/')}>
      Обсудить проект <span class="arrow" aria-hidden="true"><Icon name="arrow" /></span>
    </a>
  </div>

  <noscript>
    <nav class="hdr__fallback" aria-label="Разделы сайта">
      <ul>{nav.map((item) => <li><a href={url(item.href)} aria-current={isActive(current, item.href) ? 'page' : undefined}>{item.label}</a></li>)}</ul>
    </nav>
  </noscript>
</header>

<!-- Остров: навигация телефона под большим пальцем. Кнопка меню появляется после запуска скрипта. -->
<div class="isl" data-island>
  <button class="isl__menu" type="button" aria-label={menuAria} aria-haspopup="dialog" aria-controls="site-menu" aria-expanded="false" data-menu-open hidden>
    <Icon name="menu" />
    <span class="isl__fold"><span class="isl__label">{menuLabel}</span></span>
  </button>
  <a class="isl__write" href={contactHref} aria-label="Написать" aria-current={onContacts ? 'page' : undefined}>
    <span class="isl__fold"><span class="isl__label">Написать</span></span>
    <Icon name="arrow-ne" />
  </a>
</div>

<dialog class="menu" id="site-menu" aria-labelledby="site-menu-title" data-menu>
  <div class="menu__board" data-menu-board>
    <h2 class="sr-only" id="site-menu-title">Разделы сайта</h2>
    <span class="menu__grip" aria-hidden="true"></span>
    <nav class="menu__nav" aria-label="Разделы сайта" data-menu-scroll>
      <ul class="menu__list">
        {nav.map((item) => (
          <li>
            <a href={url(item.href)} aria-current={isActive(current, item.href) ? 'page' : undefined} data-menu-item>
              {item.label}
              <Icon name={isActive(current, item.href) ? 'check' : 'arrow-ne'} />
            </a>
          </li>
        ))}
      </ul>
    </nav>
    <p
      class="menu__status"
      data-status
      data-from={workHours.from}
      data-to={workHours.to}
      data-tz={workHours.timeZone}
      data-online-text={onlineText}
      data-offline-text={offlineText}
    >
      <span class="menu__dot" aria-hidden="true"></span>
      <span data-status-text>{hoursText}</span>
    </p>
    <div class="menu__foot">
      <button class="menu__close" type="button" aria-label="Закрыть меню" data-menu-close autofocus><Icon name="close" /></button>
      <a class="menu__cta" href={contactHref} aria-current={onContacts ? 'page' : undefined} data-menu-item>Обсудить проект <Icon name="arrow-ne" /></a>
    </div>
  </div>
</dialog>

<script>
  import { initMobileMenu } from '@/scripts/mobile-menu';
  import { initIsland } from '@/scripts/island';
  initMobileMenu();
  initIsland();

  // Десктопная шапка прячется при прокрутке вниз; на телефоне она обычная часть страницы.
  const header = document.querySelector<HTMLElement>('[data-header]');
  const dialog = document.querySelector<HTMLDialogElement>('[data-menu]');
  const desktop = window.matchMedia('(min-width: 1024px)');
  if (header) {
    let lastY = window.scrollY;
    let ticking = false;
    const update = () => {
      ticking = false;
      const y = window.scrollY;
      const hide = desktop.matches && !dialog?.open && y > lastY && y > 240 && !header.contains(document.activeElement);
      header.classList.toggle('is-hidden', hide);
      header.classList.toggle('is-scrolled', y > 8);
      lastY = y;
    };
    update();
    window.addEventListener('scroll', () => {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(update);
      }
    }, { passive: true });
    header.addEventListener('focusin', () => header.classList.remove('is-hidden'));
    desktop.addEventListener('change', () => {
      lastY = window.scrollY;
      update();
    });
  }
</script>

<style>
  .hdr {
    position: sticky;
    top: 0;
    z-index: 50;
    padding-block: var(--margin) 12px;
    background: linear-gradient(var(--bg) 70%, rgba(241, 242, 250, 0));
    transition: transform var(--dur) var(--ease-out);
  }

  .hdr.is-hidden {
    transform: translateY(-110%);
  }

  :global(.js) .hdr:not(.is-scrolled) {
    background: none;
  }

  /* Главная, широкий экран: шапка внутри белой сцены первого экрана (HeroNova) — с отступом от её края. */
  @media (min-width: 1024px) {
    :global(body:has(.hn)) .hdr {
      padding-top: calc(var(--margin) + var(--hdr-inset));
    }
  }

  .hdr__row {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: var(--gap);
    min-height: 56px;
  }

  .hdr__brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    justify-self: start;
    min-height: 44px;
    text-decoration: none;
  }

  .hdr__brand :global(.hdr__mark) {
    width: 32px;
    height: 32px;
    color: var(--accent);
    transition: transform var(--dur) var(--ease-out);
  }

  .hdr__brand:hover :global(.hdr__mark) {
    transform: rotate(-8deg) scale(1.08);
  }

  .hdr__name {
    font-family: var(--font-display);
    font-weight: 560;
    font-size: var(--step-body);
    letter-spacing: -0.03em;
    white-space: nowrap;
  }

  .hdr__name span {
    color: var(--muted);
    font-weight: 500;
  }

  /* Плашка-навигация: контурная пилюля, активный раздел — тёмная пилюля внутри. */
  .hdr__nav ul {
    list-style: none;
    display: flex;
    gap: 2px;
    padding: 5px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.7);
    box-shadow: inset 0 0 0 1px var(--line);
    backdrop-filter: blur(14px);
  }

  .hdr__nav a {
    display: block;
    padding: 10px 18px;
    border-radius: 999px;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: var(--step-small);
    text-decoration: none;
    white-space: nowrap;
    color: var(--ink-2);
    transition:
      background-color var(--dur-fast) var(--ease-out),
      color var(--dur-fast) var(--ease-out);
  }

  .hdr__nav a:hover {
    background: rgba(10, 11, 20, 0.07);
    color: var(--ink);
  }

  .hdr__nav a[aria-current='page'] {
    background: var(--ink);
    color: var(--bg);
  }

  .hdr__cta {
    justify-self: end;
    min-height: 50px;
    white-space: nowrap;
  }

  /* Узкий десктоп: пункты навигации плотнее, чтобы логотип и кнопка остались в одну строку. */
  @media (min-width: 1024px) and (max-width: 1199px) {
    .hdr__nav a {
      padding-inline: 12px;
    }
  }

  .hdr__fallback,
  .isl {
    display: none;
  }

  /* --- Меню: карточка, вырастающая из острова ---------------------------- */

  /* Модальный диалог расположен отдельно от шапки и её преобразований при прокрутке. */
  .menu {
    position: fixed;
    inset: 0;
    width: 100%;
    max-width: none;
    height: 100%;
    height: 100dvh;
    max-height: none;
    margin: 0;
    /* Нижний и боковые отступы совпадают с островом: карточка растёт ровно из его места. */
    padding: max(12px, env(safe-area-inset-top)) 12px max(12px, env(safe-area-inset-bottom));
    border: 0;
    background: transparent;
    color: var(--ink);
    overflow: hidden;
  }

  .menu[open] {
    display: flex;
    align-items: flex-end;
    justify-content: center;
  }

  .menu::backdrop {
    background: rgba(10, 11, 20, 0.28);
    -webkit-backdrop-filter: blur(4px);
    backdrop-filter: blur(4px);
  }

  .menu__board {
    display: flex;
    flex-direction: column;
    gap: 6px;
    width: min(100%, 560px);
    max-height: 100%;
    padding: 8px 10px 10px;
    border-radius: 32px;
    background: var(--paper);
    box-shadow: 0 -8px 48px rgba(10, 11, 20, 0.12);
    overflow: hidden;
    /* Смахивание вниз: карточка следует за пальцем. */
    transform: translateY(var(--menu-drag, 0px));
    -webkit-user-select: none;
    user-select: none;
  }

  .menu__grip {
    align-self: center;
    width: 36px;
    height: 4px;
    margin-block: 2px 4px;
    border-radius: 999px;
    background: var(--surface-3);
    flex: none;
  }

  .menu__nav {
    min-height: 0;
    overflow-y: auto;
    overscroll-behavior: contain;
  }

  .menu__list {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 2px;
  }

  .menu__list a {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    min-height: 56px;
    padding: 8px 18px;
    border-radius: 20px;
    font-family: var(--font-display);
    font-weight: 450;
    font-size: var(--fs-1);
    line-height: 1.2;
    letter-spacing: -0.03em;
    text-decoration: none;
    transition:
      background-color var(--dur-fast) var(--ease-out),
      color var(--dur-fast) var(--ease-out);
  }

  .menu__list a :global(.icon) {
    font-size: var(--fs-0);
    color: var(--muted);
  }

  .menu__list a:hover {
    background: var(--bg);
  }

  .menu__list a[aria-current='page'] {
    background: var(--accent-soft);
    color: var(--accent-text);
  }

  .menu__list a[aria-current='page'] :global(.icon) {
    color: inherit;
  }

  /* Раздел под пальцем во время жеста «зажал — провёл — отпустил». */
  .menu__list a.is-target {
    background: var(--ink);
    color: var(--bg);
  }

  .menu__list a.is-target :global(.icon) {
    color: inherit;
  }

  .menu__status {
    display: flex;
    align-items: center;
    gap: 10px;
    min-height: 36px;
    padding-inline: 18px;
    font-size: var(--fs-xs);
    line-height: 1.3;
    color: var(--muted);
    flex: none;
  }

  .menu__dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--surface-3);
    flex: none;
  }

  .menu__status[data-online='true'] {
    color: var(--ink-2);
  }

  .menu__status[data-online='true'] .menu__dot {
    background: var(--success);
    box-shadow: 0 0 0 4px rgba(31, 122, 58, 0.16);
  }

  /* Низ карточки повторяет остров: слева круглая кнопка, справа синяя — палец остаётся на месте. */
  .menu__foot {
    display: flex;
    gap: 6px;
    flex: none;
  }

  .menu__close {
    display: grid;
    place-items: center;
    width: 56px;
    height: 56px;
    flex: none;
    border-radius: 50%;
    background: var(--bg);
    font-size: var(--fs-1);
  }

  .menu__close:hover {
    background: var(--surface-2);
  }

  .menu__cta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 10px;
    flex: 1;
    min-width: 0;
    min-height: 56px;
    padding: 12px 20px;
    white-space: nowrap;
    border-radius: 999px;
    background: var(--accent);
    color: var(--accent-ink);
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--step-body);
    text-decoration: none;
    transition: background-color var(--dur-fast) var(--ease-out);
  }

  .menu__cta:hover,
  .menu__cta.is-target {
    background: var(--accent-deep);
  }

  :global(html.site-menu-open) {
    overflow: hidden;
    scroll-behavior: auto;
  }

  :global(html.site-menu-open body) {
    position: fixed;
    top: var(--site-menu-scroll-y, 0px);
    inset-inline: 0;
    width: 100%;
    overflow: hidden;
  }

  @media (prefers-reduced-motion: no-preference) {
    .menu__board {
      transition: transform 240ms var(--ease-out);
    }

    .menu__board.is-dragging {
      transition: none;
    }

    /* Пока скрипт измеряет остров, анимация не стартует — иначе она началась бы без координат. */
    .menu[open]:not(.is-measuring) .menu__board {
      animation: menu-grow 360ms var(--ease-out) both;
    }

    .menu[open]:not(.is-measuring) :is(.menu__grip, .menu__nav, .menu__status) {
      animation: menu-content-in 280ms 70ms var(--ease-out) both;
    }

    .menu[open]:not(.is-measuring)::backdrop {
      animation: menu-veil-in 220ms ease-out both;
    }

    .menu.is-closing .menu__board {
      animation: menu-shrink 220ms var(--ease-inout) both;
    }

    .menu.is-closing :is(.menu__grip, .menu__nav, .menu__status) {
      animation: menu-content-out 120ms ease-in both;
    }

    .menu.is-closing.is-dropping .menu__board {
      animation: menu-drop 220ms ease-in both;
    }

    .menu.is-closing.is-dropping :is(.menu__grip, .menu__nav, .menu__status) {
      animation: none;
    }

    .menu.is-closing::backdrop {
      animation: menu-veil-out 220ms ease-in both;
    }
  }

  /* Координаты острова относительно карточки записывает mobile-menu.ts перед открытием. */
  @keyframes menu-grow {
    from { clip-path: inset(var(--isl-t, 0px) var(--isl-r, 0px) var(--isl-b, 0px) var(--isl-l, 0px) round 32px); }
    to { clip-path: inset(0px 0px 0px 0px round 32px); }
  }

  @keyframes menu-shrink {
    from { clip-path: inset(0px 0px 0px 0px round 32px); }
    to { clip-path: inset(var(--isl-t, 0px) var(--isl-r, 0px) var(--isl-b, 0px) var(--isl-l, 0px) round 32px); }
  }

  @keyframes menu-drop {
    from { transform: translateY(var(--menu-drag, 0px)); }
    to { transform: translateY(calc(100% + 24px)); }
  }

  @keyframes menu-content-in {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: translateY(0); }
  }

  @keyframes menu-content-out {
    from { opacity: 1; }
    to { opacity: 0; }
  }

  @keyframes menu-veil-in {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  @keyframes menu-veil-out {
    from { opacity: 1; }
    to { opacity: 0; }
  }

  /* --- Телефон и планшет: логотип сверху, остров снизу -------------------- */

  @media (max-width: 1023px) {
    /* Шапка — обычная часть страницы: навигация живёт в острове. */
    .hdr {
      position: static;
      padding-block: max(12px, env(safe-area-inset-top)) 4px;
      background: none;
    }

    .hdr__row {
      grid-template-columns: 1fr;
      min-height: 48px;
    }

    .hdr__nav,
    .hdr__cta {
      display: none;
    }

    /* Запас внизу страницы, чтобы остров не закрывал конец подвала. */
    :global(body) {
      padding-bottom: calc(62px + 12px + max(12px, env(safe-area-inset-bottom)));
    }

    .isl {
      position: fixed;
      z-index: 60;
      inset-inline: 0;
      bottom: max(12px, env(safe-area-inset-bottom));
      display: flex;
      align-items: center;
      gap: 6px;
      width: fit-content;
      max-width: calc(100% - 24px);
      margin-inline: auto;
      padding: 6px;
      border: 1px solid rgba(10, 11, 20, 0.08);
      border-radius: 999px;
      background: rgba(255, 255, 255, 0.94);
      -webkit-backdrop-filter: blur(18px);
      backdrop-filter: blur(18px);
      box-shadow:
        0 2px 6px rgba(10, 11, 20, 0.06),
        0 16px 36px -12px rgba(30, 40, 100, 0.3);
      /* При переходе между страницами остров остаётся на месте, меняется только подпись. */
      view-transition-name: site-island;
    }

    /* Пока открыто меню, остров «стал» карточкой. */
    :global(html.site-menu-open) .isl {
      visibility: hidden;
    }

    /* Открыта клавиатура — остров уходит вниз и не закрывает поля формы. */
    .isl.is-away {
      transform: translateY(calc(100% + 32px));
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
    }

    .isl__menu,
    .isl__write {
      display: inline-flex;
      align-items: center;
      min-width: 48px;
      height: 48px;
      padding: 0 15px;
      border-radius: 999px;
      font-family: var(--font-display);
      font-size: var(--step-small);
      line-height: 1.2;
      font-weight: 550;
      letter-spacing: -0.01em;
      white-space: nowrap;
      text-decoration: none;
    }

    .isl__menu :global(.icon),
    .isl__write :global(.icon) {
      font-size: 18px;
    }

    .isl__menu {
      min-width: 0;
      background: var(--bg);
      color: var(--ink);
      /* Жест начинается на кнопке: страница под пальцем не прокручивается, текст не выделяется. */
      touch-action: none;
      -webkit-touch-callout: none;
      -webkit-user-select: none;
      user-select: none;
    }

    .isl__menu:hover {
      background: var(--surface-2);
    }

    .isl__write {
      flex: none;
      background: var(--accent);
      color: var(--accent-ink);
    }

    .isl__write:hover {
      background: var(--accent-deep);
    }

    /* Подпись складывается до нуля, когда остров сжат: остаются две круглые кнопки. */
    .isl__fold {
      display: grid;
      grid-template-columns: 1fr;
      min-width: 0;
      overflow: hidden;
    }

    .isl__label {
      min-width: 0;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .isl__menu .isl__label {
      padding-inline: 8px 3px;
    }

    .isl__write .isl__label {
      padding-inline: 3px 6px;
    }

    .isl.is-compact .isl__fold {
      grid-template-columns: 0fr;
      opacity: 0;
    }

    .isl.is-compact .isl__label {
      padding-inline: 0;
      /* Пока подпись складывается, многоточие не мелькает. */
      text-overflow: clip;
    }

    /* Самые узкие телефоны: подпись «Услуги и цены» помещается целиком. */
    @media (max-width: 359px) {
      .isl__menu,
      .isl__write {
        padding-inline: 13px;
        font-size: var(--fs-xs);
      }
    }

    .hdr__fallback {
      display: block;
      padding-top: 10px;
    }

    .hdr__fallback ul {
      display: flex;
      flex-wrap: wrap;
      list-style: none;
      gap: 6px;
      padding: 0;
    }

    .hdr__fallback a {
      display: inline-flex;
      align-items: center;
      min-height: 44px;
      padding: 8px 12px;
      border-radius: 999px;
      background: var(--paper);
      font-size: var(--fs-xs);
      text-decoration: none;
    }
  }

  @media (max-width: 1023px) and (prefers-reduced-motion: no-preference) {
    .isl {
      transition:
        transform var(--dur) var(--ease-out),
        opacity var(--dur-fast) var(--ease-out),
        visibility 0s;
    }

    .isl.is-away {
      transition:
        transform var(--dur) var(--ease-out),
        opacity var(--dur-fast) var(--ease-out),
        visibility 0s var(--dur);
    }

    .isl__fold {
      transition:
        grid-template-columns var(--dur) var(--ease-out),
        opacity var(--dur-fast) var(--ease-out);
    }

    .isl__label {
