---
import PixelWord from './PixelWord.astro';
import { url, isActive } from '@/lib/url';
import { site } from '@/config/site';

const nav = [
  { href: '/portfolio/', label: 'Работы' },
  { href: '/services/', label: 'Услуги и цены' },
  { href: '/about/', label: 'Обо мне' },
  { href: '/faq/', label: 'Вопросы' },
];
const current = Astro.url.pathname;
---

<header class="hdr" data-header>
  <div class="hdr__row">
    <a class="hdr__brand" href={url('/')} aria-label={`${site.brand.name.value} — на главную`}>
      <PixelWord text="M" appear="none" class="hdr__mark" />
      <span class="hdr__name">{site.brand.short}<span> {site.brand.second}</span></span>
    </a>
    <nav class="hdr__nav" aria-label="Основная навигация">
      <ul>
        {
          nav.map((item) => (
            <li>
              <a href={url(item.href)} aria-current={isActive(current, item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <a class="hdr__cta btn btn--ink" href={url('/contacts/')} data-magnetic>
      Обсудить проект <span class="arrow" aria-hidden="true">→</span>
    </a>
    <button class="hdr__menu" type="button" aria-haspopup="dialog" aria-controls="site-menu" data-menu-open>
      Меню
    </button>
  </div>

  <dialog class="menu" id="site-menu" aria-label="Меню сайта" data-menu>
    <div class="menu__board">
      <div class="menu__top">
        <a class="hdr__brand" href={url('/')} aria-label="На главную">
          <PixelWord text="M" appear="none" class="hdr__mark" />
          <span class="hdr__name">{site.brand.short}<span> {site.brand.second}</span></span>
        </a>
        <button class="menu__close" type="button" data-menu-close>Закрыть</button>
      </div>
      <ul class="menu__list">
        <li><a href={url('/')}>Главная</a></li>
        {nav.map((item) => (
          <li>
            <a href={url(item.href)} aria-current={isActive(current, item.href) ? 'page' : undefined}>
              {item.label}
            </a>
          </li>
        ))}
      </ul>
      <a class="menu__cta" href={url('/contacts/')}>Обсудить проект <span aria-hidden="true">→</span></a>
    </div>
  </dialog>
</header>

<script>
  // Шапка прячется при прокрутке вниз и возвращается при прокрутке вверх.
  const header = document.querySelector<HTMLElement>('[data-header]');
  if (header) {
    let lastY = window.scrollY;
    let ticking = false;
    const update = () => {
      ticking = false;
      const y = window.scrollY;
      const hide = y > lastY && y > 240 && !header.contains(document.activeElement);
      header.classList.toggle('is-hidden', hide);
      lastY = y;
    };
    window.addEventListener('scroll', () => {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(update);
      }
    }, { passive: true });
    header.addEventListener('focusin', () => header.classList.remove('is-hidden'));
  }

  const dialog = document.querySelector<HTMLDialogElement>('[data-menu]');
  const openBtn = document.querySelector<HTMLButtonElement>('[data-menu-open]');
  const closeBtn = document.querySelector<HTMLButtonElement>('[data-menu-close]');
  if (dialog && openBtn && closeBtn) {
    openBtn.addEventListener('click', () => {
      dialog.showModal();
      openBtn.setAttribute('aria-expanded', 'true');
    });
    closeBtn.addEventListener('click', () => dialog.close());
    dialog.addEventListener('close', () => {
      openBtn.setAttribute('aria-expanded', 'false');
      openBtn.focus();
    });
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog) dialog.close();
    });
    window.matchMedia('(min-width: 1024px)').addEventListener('change', (e) => {
      if (e.matches && dialog.open) dialog.close();
    });
  }
</script>

<style>
  .hdr {
    position: sticky;
    top: 0;
    z-index: 50;
    padding-block: var(--margin) 12px;
    background: linear-gradient(var(--bg) 70%, rgba(246, 245, 241, 0));
    transition: transform var(--dur) var(--ease-out);
  }

  .hdr.is-hidden {
    transform: translateY(-110%);
  }

  .hdr__row {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: var(--gap);
    min-height: 56px;
  }

  .hdr__brand {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    justify-self: start;
    min-height: 44px;
    text-decoration: none;
  }

  .hdr__brand :global(.hdr__mark) {
    width: 30px;
    height: auto;
    color: var(--accent);
    transition: transform var(--dur) var(--ease-out);
  }

  .hdr__brand:hover :global(.hdr__mark) {
    transform: rotate(-8deg) scale(1.08);
  }

  .hdr__name {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.0625rem;
    letter-spacing: -0.02em;
  }

  .hdr__name span {
    color: var(--muted);
    font-weight: 500;
  }

  .hdr__nav ul {
    list-style: none;
    display: flex;
    gap: 2px;
    padding: 5px;
    border-radius: 14px;
    background: var(--surface-2);
  }

  .hdr__nav a {
    display: block;
    padding: 10px 16px;
    border-radius: 10px;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 0.9688rem;
    text-decoration: none;
    white-space: nowrap;
    color: #3b3a36;
    transition:
      background-color var(--dur-fast) var(--ease-out),
      color var(--dur-fast) var(--ease-out);
  }

  .hdr__nav a:hover {
    background: var(--surface-3);
    color: var(--ink);
  }

  .hdr__nav a[aria-current='page'] {
    background: var(--paper);
    color: var(--ink);
    box-shadow: 0 1px 2px rgba(21, 21, 21, 0.1);
  }

  .hdr__cta {
    justify-self: end;
    min-height: 50px;
  }

  .hdr__menu {
    display: none;
    justify-self: end;
    min-height: 46px;
    padding-inline: 18px;
    border-radius: var(--radius-sm);
    background: var(--ink);
    color: var(--bg);
    font-family: var(--font-display);
    font-weight: 600;
  }

  /* Меню для телефона и планшета */
  .menu {
    width: 100%;
    max-width: none;
    height: 100%;
    max-height: none;
    margin: 0;
    padding: var(--margin);
    border: 0;
    background: var(--bg);
    color: var(--ink);
  }

  .menu::backdrop {
    background: rgba(21, 21, 21, 0.4);
  }

  .menu__board {
    display: grid;
    gap: var(--gap);
    grid-template-rows: auto 1fr auto;
    height: 100%;
  }

  .menu__top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    min-height: 56px;
  }

  .menu__close {
    min-height: 46px;
    padding-inline: 18px;
    border-radius: var(--radius-sm);
    background: var(--surface-2);
    font-family: var(--font-display);
    font-weight: 600;
  }

  .menu__list {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 6px;
    align-content: start;
    margin-top: 12px;
  }

  .menu__list a {
    display: block;
    padding: 16px 18px;
    border-radius: var(--radius);
    background: var(--surface);
    font-family: var(--font-display);
    font-weight: 650;
    font-size: clamp(1.625rem, 7vw, 2.25rem);
    letter-spacing: -0.035em;
    text-transform: uppercase;
    text-decoration: none;
  }

  .menu__list a[aria-current='page'] {
    background: var(--accent);
  }

  .menu__cta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    min-height: 64px;
    padding-inline: 20px;
    border-radius: var(--radius);
    background: var(--ink);
    color: var(--bg);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.125rem;
    text-decoration: none;
  }

  @media (max-width: 1023px) {
    .hdr__row {
      grid-template-columns: 1fr auto;
    }

    .hdr__nav,
    .hdr__cta {
      display: none;
    }

    .hdr__menu {
      display: inline-flex;
      align-items: center;
    }
  }
</style>
