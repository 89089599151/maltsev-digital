---
/**
 * Три пакета на странице услуг: название, цена, для кого, объём и срок, главное в составе, кнопка.
 * Полный состав, исключения и правки — в раскрывающемся блоке внутри карточки, чтобы не держать
 * на экране таблицу сравнения. Цвета пакетов те же, что на главной: START — белый с чёрной кнопкой,
 * BUSINESS — синий с белой, PREMIUM — тёмный с синей. Данные — src/config/pricing.ts.
 */
import SectionHead from './SectionHead.astro';
import Icon from './Icon.astro';
import { plans, formatPrice, pricingConfirmed } from '@/config/pricing';
import { url } from '@/lib/url';

const scopes: Record<string, string> = { start: 'Одна страница', business: 'До 8 страниц', premium: 'До 15 страниц' };
---

<section class="pl section" id="plans" data-island-section="Пакеты" aria-labelledby="detail-title">
  <SectionHead
    id="detail-title"
    title="Три пакета"
    text={`Цена записывается в договоре и меняется, только если меняется задача. Оплата, сроки и возврат — в условиях ниже.${pricingConfirmed ? '' : ' Цены предварительные.'}`}
  />

  <div class="pl__grid" data-stagger>
    {
      plans.map((p) => (
        <article class={`pl__card pl__card--${p.id}`} id={`plan-${p.id}`} aria-labelledby={`col-${p.id}`}>
          <header class="pl__head">
            <h3 id={`col-${p.id}`} class="pl__name">{p.name}</h3>
            <p class="pl__for">{p.forWhom}</p>
          </header>

          <p class="pl__price"><span>от</span> {formatPrice(p.price)}</p>

          <dl class="pl__facts">
            <div><dt>Объём</dt><dd>{scopes[p.id]}</dd></div>
            <div><dt>Срок</dt><dd>{p.timeline}</dd></div>
          </dl>

          <ul class="pl__list">
            {p.highlights.map((item) => (
              <li><Icon name="check" /><span>{item}</span></li>
            ))}
            <li class="pl__need"><Icon name="minus" /><span>Тексты и фото — от вас</span></li>
          </ul>

          <a class="btn pl__btn" href={url(`/contacts/?plan=${p.id}`)}>
            Заказать {p.name} <span class="arrow" aria-hidden="true"><Icon name="arrow" /></span>
          </a>

          <details class="pl__more">
            <summary>Полный состав и условия <span class="pl__more-i" aria-hidden="true"><Icon name="plus" /></span></summary>
            <div class="pl__full">
              <h4>Входит в стоимость</h4>
              <ul>{p.includes.map((item) => <li>{item}</li>)}</ul>
              <h4>Не входит</h4>
              <ul>{p.excludes.map((item) => <li>{item}</li>)}</ul>
              <h4>Правки</h4>
              <p>{p.revisions}</p>
              <h4>Что получите</h4>
              <p>{p.result}</p>
            </div>
          </details>
        </article>
      ))
    }
  </div>
</section>

<style>
  .pl__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--gap);
  }

  .pl__card {
    --pl-muted: var(--muted);
    --pl-line: var(--line);
    display: grid;
    /* Список растягивается: кнопки во всех карточках стоят на одной линии. */
    grid-template-rows: auto auto auto 1fr auto auto;
    gap: clamp(18px, 1.8vw, 26px);
    padding: clamp(22px, 2.4vw, 36px);
    border-radius: var(--radius-lg);
    background: var(--paper);
    color: var(--ink);
  }

  .pl__card--business {
    --pl-muted: var(--on-accent-muted);
    --pl-line: rgba(255, 255, 255, 0.24);
    background: var(--accent);
    color: var(--accent-ink);
  }

  .pl__card--premium {
    --pl-muted: var(--night-muted);
    --pl-line: rgba(241, 242, 250, 0.16);
    background: var(--night);
    color: var(--night-ink);
  }

  .pl__head {
    display: grid;
    gap: 10px;
  }

  .pl__name {
    font-weight: 340;
    font-size: var(--fs-4);
    line-height: 1;
    letter-spacing: -0.05em;
  }

  /* Три строки под описание: цены во всех карточках стоят на одной линии. */
  .pl__for {
    min-height: 4.5em;
    line-height: 1.5;
    color: var(--pl-muted);
  }

  .pl__price {
    font-family: var(--font-head);
    font-weight: 400;
    font-size: var(--fs-4);
    line-height: 1;
    letter-spacing: -0.05em;
    white-space: nowrap;
  }

  .pl__price span {
    font-size: 0.45em;
    letter-spacing: -0.01em;
  }

  .pl__facts {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
    padding-block: 16px;
    border-block: 1px solid var(--pl-line);
  }

  .pl__facts div {
    display: grid;
    gap: 2px;
  }

  .pl__facts dt {
    font-size: var(--fs-xs);
    color: var(--pl-muted);
  }

  .pl__facts dd {
    font-family: var(--font-display);
    font-weight: 550;
    font-size: var(--fs-0);
  }

  .pl__list {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 10px;
    align-content: start;
  }

  .pl__list li {
    display: grid;
    grid-template-columns: 18px minmax(0, 1fr);
    gap: 10px;
    align-items: start;
    font-size: var(--fs-0);
    line-height: 1.4;
  }

  .pl__list :global(.icon) {
    margin-top: 0.2em;
    color: var(--accent-text);
  }

  .pl__card--business .pl__list :global(.icon) {
    color: inherit;
  }

  .pl__card--premium .pl__list :global(.icon) {
    color: var(--accent-on-dark);
  }

  /* То, чего в пакете нет, — тем же списком, но приглушённо. */
  .pl__list .pl__need,
  .pl__list .pl__need :global(.icon) {
    color: var(--pl-muted);
  }

  .pl__btn {
    background: var(--ink);
    color: var(--bg);
  }

  .pl__btn:is(:hover, :focus-visible) {
    background: var(--ink-hover);
  }

  .pl__card--business .pl__btn {
    background: var(--paper);
    color: var(--ink);
  }

  .pl__card--business .pl__btn:is(:hover, :focus-visible) {
    background: var(--bg);
  }

  .pl__card--premium .pl__btn {
    background: var(--accent);
    color: var(--accent-ink);
  }

  .pl__card--premium .pl__btn:is(:hover, :focus-visible) {
    background: var(--accent-hover);
  }

  .pl__card--business :global(:focus-visible) {
    outline-color: var(--paper);
  }

  /* Полный состав: раскрывается на месте, карточка растёт вниз. */
  .pl__more summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    min-height: 44px;
    font-family: var(--font-display);
    font-weight: 550;
    font-size: var(--step-small);
    cursor: pointer;
    list-style: none;
  }

  .pl__more summary::-webkit-details-marker {
    display: none;
  }

  .pl__more-i {
    display: grid;
    transition: rotate var(--dur) var(--ease-out);
  }

  .pl__more[open] .pl__more-i {
    rotate: 45deg;
  }

  .pl__full {
    display: grid;
    gap: 8px;
    padding-top: 8px;
    font-size: var(--step-small);
    line-height: 1.45;
  }

  .pl__full h4 {
    margin-top: 12px;
    font-size: var(--fs-xs);
    font-weight: 500;
    letter-spacing: 0;
    color: var(--pl-muted);
  }

  .pl__full ul {
    display: grid;
    gap: 6px;
    padding-left: 1.1em;
  }

  @media (max-width: 1023px) {
    .pl__grid {
      grid-template-columns: 1fr;
    }

    .pl__for {
      min-height: 0;
    }
  }

  @media (max-width: 767px) {
    .pl__card {
      border-radius: 24px;
    }
  }
</style>
