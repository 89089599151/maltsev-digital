---
/**
 * Тарифы на главной: три равные карточки с ценой, сроком и составом.
 * Цены берутся из src/config/pricing.ts; пока они не подтверждены — пометка «предварительные».
 */
import SectionHead from './SectionHead.astro';
import { plans, formatPrice, pricingConfirmed, extraPagePrice } from '@/config/pricing';
import { url } from '@/lib/url';
---

<section class="pc section" id="pricing" aria-labelledby="pc-title">
  <SectionHead
    id="pc-title"
    title="Цена известна до старта"
    text={`Три пакета с фиксированной стоимостью. Состав, сроки и правки прописаны заранее.${pricingConfirmed ? '' : ' Цены предварительные.'}`}
    link={{ href: url('/services/'), label: 'Что входит и чего нет' }}
  />

  <div class="pc__grid" data-stagger>
    {
      plans.map((p, i) => (
        <article class:list={['pc__card', { 'pc__card--dark': i === 1 }]} aria-labelledby={`pc-${p.id}`}>
          <div class="pc__top">
            <h3 id={`pc-${p.id}`} class="pc__name">{p.name}</h3>
            <p class="pc__time">{p.timeline}</p>
          </div>
          <p class="pc__price">
            <span class="pc__from">от</span> {formatPrice(p.price)}
          </p>
          <p class="pc__for">{p.forWhom}</p>
          <ul class="pc__list">
            {p.highlights.map((h) => (
              <li>{h}</li>
            ))}
          </ul>
          <a class:list={['btn', i === 1 ? 'btn--accent' : 'btn--ink', 'pc__cta']} href={url(`/contacts/?plan=${p.id}`)}>
            Выбрать {p.name} <span class="arrow" aria-hidden="true">→</span>
          </a>
        </article>
      ))
    }
  </div>

  <a class="pc__calc" href={url('/services/#calculator')} data-reveal>
    <span class="pc__calc-t">Не знаете, какой пакет нужен?</span>
    <span class="pc__calc-d">
      Калькулятор посчитает стоимость под ваш тип сайта и число страниц. Страница сверх тарифа — {formatPrice(extraPagePrice)}.
    </span>
    <span class="pc__calc-go" aria-hidden="true">→</span>
  </a>
</section>

<style>
  .pc__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--gap);
  }

  .pc__card {
    display: flex;
    flex-direction: column;
    gap: 18px;
    padding: clamp(24px, 2.6vw, 36px);
    border-radius: var(--radius-lg);
    background: var(--surface);
  }

  .pc__card--dark {
    background: var(--night);
    color: var(--night-ink);
  }

  .pc__top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
  }

  .pc__name {
    font-size: 1.5rem;
    letter-spacing: -0.03em;
  }

  .pc__time {
    padding: 6px 10px;
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.65);
    font-family: var(--font-display);
    font-weight: 650;
    font-size: 0.875rem;
    color: var(--ink);
    white-space: nowrap;
  }

  .pc__card--dark .pc__time {
    background: rgba(246, 245, 241, 0.12);
    color: var(--night-ink);
  }

  .pc__price {
    padding-block: 18px;
    border-block: 1px solid rgba(21, 21, 21, 0.1);
    font-family: var(--font-head);
    font-weight: 650;
    font-size: clamp(2.25rem, 1.6rem + 1.6vw, 3.25rem);
    line-height: 1;
    letter-spacing: -0.05em;
    white-space: nowrap;
  }

  .pc__card--dark .pc__price {
    border-color: rgba(246, 245, 241, 0.14);
    color: var(--accent);
  }

  .pc__from {
    font-size: 0.45em;
    letter-spacing: -0.01em;
    vertical-align: 0.5em;
  }

  .pc__for {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.0625rem;
    line-height: 1.35;
  }

  .pc__list {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 10px;
    margin-bottom: 8px;
    color: #3b3a36;
  }

  .pc__card--dark .pc__list {
    color: var(--night-muted);
  }

  .pc__list li {
    display: grid;
    grid-template-columns: 14px 1fr;
    gap: 10px;
    align-items: baseline;
  }

  .pc__list li::before {
    content: '';
    width: 8px;
    height: 8px;
    background: var(--accent);
    transform: translateY(-1px);
  }

  .pc__cta {
    margin-top: auto;
    width: 100%;
    min-height: 56px;
    justify-content: center;
  }

  .pc__calc {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    gap: 8px 28px;
    align-items: center;
    margin-top: var(--gap);
    padding: 22px clamp(22px, 2.6vw, 36px);
    border-radius: var(--radius-lg);
    background: var(--accent);
    color: var(--accent-ink);
    text-decoration: none;
  }

  .pc__calc-t {
    font-family: var(--font-head);
    font-weight: 650;
    font-size: clamp(1.25rem, 1rem + 0.6vw, 1.625rem);
    letter-spacing: -0.03em;
    text-transform: uppercase;
  }

  .pc__calc-d {
    max-width: 60ch;
    color: #3d1d06;
  }

  .pc__calc-go {
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    border-radius: 12px;
    background: var(--ink);
    color: var(--bg);
    font-size: 1.25rem;
    transition: transform var(--dur) var(--ease-out);
  }

  .pc__calc:hover .pc__calc-go {
    transform: rotate(-45deg);
  }

  @media (max-width: 1023px) {
    .pc__grid {
      grid-template-columns: 1fr;
      max-width: 640px;
    }

    .pc__calc {
      grid-template-columns: minmax(0, 1fr) auto;
    }

    .pc__calc-d {
      grid-column: 1;
    }

    .pc__calc-go {
      grid-row: 1 / 3;
      grid-column: 2;
    }
  }

  @media (max-width: 767px) {
    .pc__card,
    .pc__calc {
      border-radius: 22px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .pc__calc:hover .pc__calc-go {
      transform: none;
    }
  }
</style>
