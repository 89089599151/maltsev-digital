---
/**
 * «Этот сайт — первый кейс». Подача как у кейсов на Behance: гигантское слово за ноутбуком
 * и телефоном, затем карточки процесса — прототип, цвета, шрифты, внутренние страницы.
 * Скриншоты — настоящие экраны этого сайта (src/assets/case/). Обновить: см. README.
 */
import { Image } from 'astro:assets';
import { url } from '@/lib/url';
import PixelWord from './PixelWord.astro';
import homeDesktop from '@/assets/case/home-desktop.png';
import homeMobile from '@/assets/case/home-mobile.png';
import homeWire from '@/assets/case/home-wire.png';
import servicesDesktop from '@/assets/case/services-desktop.png';

const swatches = [
  { name: 'Поле', hex: '#F6F5F1', ink: '#151515' },
  { name: 'Серый', hex: '#E6E5E1', ink: '#151515' },
  { name: 'Графит', hex: '#202020', ink: '#F6F5F1' },
  { name: 'Оранжевый', hex: '#FF6700', ink: '#151515' },
];
const inside = [
  '7 страниц и шаблон кейса',
  'Калькулятор стоимости с передачей расчёта в заявку',
  'Форма заявки с проверкой полей и честными статусами',
  'Отдельная композиция для телефона',
  'SEO: разметка, sitemap, llms.txt, Open Graph',
  'Публикация через GitHub Actions',
];
---

<section class="cs section" id="work" aria-labelledby="cs-title">
  <div class="cs__stage" data-case-stage>
    <div class="cs__top">
      <div class="cs__intro">
        <h2 id="cs-title" class="head" data-split>Этот сайт — первый кейс</h2>
        <p class="cs__lead">
          Проверьте подход на том, что уже открыто перед вами: структура, дизайн-система, анимации,
          калькулятор и форма заявки сделаны тем же процессом, что и ваш будущий сайт.
        </p>
      </div>
      <ul class="cs__tags" aria-label="Технологии">
        <li>Astro</li>
        <li>TypeScript</li>
        <li>CSS 3D</li>
      </ul>
    </div>
    <PixelWord text="САЙТ" class="cs__giant" />

    <div class="cs__devices" aria-hidden="true">
      <div class="laptop" data-speed="0.6">
        <div class="laptop__screen">
          <Image src={homeDesktop} alt="" widths={[640, 960, 1280]} sizes="(max-width: 767px) 90vw, 56vw" loading="lazy" />
        </div>
        <div class="laptop__base"></div>
      </div>
      <div class="phone" data-speed="1.6">
        <div class="phone__screen">
          <Image src={homeMobile} alt="" widths={[240, 376]} sizes="(max-width: 767px) 34vw, 14vw" loading="lazy" />
        </div>
      </div>
    </div>
    <p class="sr-only">Главная страница этого сайта на ноутбуке и на телефоне.</p>
  </div>

  <div class="cs__cards">
    <figure class="cs__card cs__card--wire tile tile--paper" data-reveal>
      <figcaption>
        <span class="cs__card-t">Прототип</span>
        <span class="cs__card-d">Сначала — сетка и порядок блоков, без цвета и картинок.</span>
      </figcaption>
      <div class="cs__wire">
        <Image src={homeWire} alt="Вайрфрейм первого экрана: серые блоки на месте текста и картинок" widths={[480, 800]} sizes="(max-width: 767px) 90vw, 30vw" loading="lazy" />
      </div>
    </figure>

    <div class="cs__card cs__card--color tile tile--raised" data-reveal style="--i:1">
      <p class="cs__card-t">Цвета</p>
      <ul class="sw">
        {
          swatches.map((s) => (
            <li class="sw__item" style={`--c:${s.hex}; --t:${s.ink}`}>
              <span class="sw__name">{s.name}</span>
              <span class="sw__hex">{s.hex}</span>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="cs__card cs__card--type tile" data-reveal style="--i:2">
      <p class="cs__card-t">Шрифты</p>
      <div class="ty">
        <div class="ty__row">
          <span class="ty__aa ty__aa--d" aria-hidden="true">Аа</span>
          <span><b>Unbounded</b><br />Заголовки и цифры</span>
        </div>
        <div class="ty__row">
          <span class="ty__aa ty__aa--t" aria-hidden="true">Аа</span>
          <span><b>Onest</b><br />Текст и интерфейс</span>
        </div>
      </div>
    </div>

    <figure class="cs__card cs__card--page tile tile--photo" data-reveal style="--i:3">
      <div class="browser" aria-hidden="true"><i></i><i></i><i></i></div>
      <Image src={servicesDesktop} alt="Страница «Услуги и цены» этого сайта" widths={[640, 960, 1280]} sizes="(max-width: 1023px) 100vw, 60vw" loading="lazy" />
    </figure>

    <div class="cs__card cs__card--inside tile tile--accent" data-reveal style="--i:4">
      <p class="cs__card-t">Что внутри</p>
      <ul class="cs__list">
        {inside.map((x) => <li>{x}</li>)}
      </ul>
      <a class="btn btn--dark" href={url('/services/#calculator')}>
        Попробовать калькулятор <span class="arrow" aria-hidden="true">→</span>
      </a>
    </div>
  </div>
</section>


<style>
  .cs__stage {
    position: relative;
    border-radius: var(--radius);
    background: var(--accent);
    color: var(--accent-ink);
    overflow: hidden;
    padding: clamp(24px, 3vw, 48px) clamp(24px, 3vw, 48px) 0;
  }

  .cs__top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 24px;
  }

  .cs__intro {
    display: grid;
    gap: 18px;
    max-width: 46ch;
  }

  .cs__lead {
    font-size: var(--step-body);
  }

  .cs__tags {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 6px;
  }

  .cs__tags li {
    padding: 8px 16px;
    border-radius: 999px;
    background: var(--accent-ink);
    color: var(--accent);
    font-family: var(--font-display);
    font-size: 0.875rem;
    font-weight: 600;
  }

  /* Гигантское слово: верхняя половина видна, нижнюю перекрывают устройства. */
  .cs__stage :global(.cs__giant) {
    width: min(78%, 1100px);
    height: auto;
    margin: clamp(24px, 4vw, 56px) auto 0;
    color: rgba(255, 255, 255, 0.5);
  }

  .cs__devices {
    position: relative;
    width: min(70%, 980px);
    margin: -14% auto 0;
  }

  .laptop__screen {
    position: relative;
    aspect-ratio: 1425 / 900;
    padding: 1.6%;
    border-radius: 18px 18px 0 0;
    background: #0b0b09;
    overflow: hidden;
  }

  .laptop__screen img,
  .phone__screen img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
    border-radius: 4px;
  }

  .laptop__base {
    height: clamp(10px, 1.4vw, 20px);
    margin-inline: -7%;
    border-radius: 0 0 14px 14px;
    background: #2a2a25;
  }

  .phone {
    position: absolute;
    right: -9%;
    bottom: 4%;
    width: 22%;
  }

  .phone__screen {
    aspect-ratio: 376 / 814;
    padding: 6%;
    border-radius: 28px;
    background: #0b0b09;
    overflow: hidden;
  }

  .phone__screen img {
    border-radius: 18px;
  }

  /* Карточки процесса */
  .cs__cards {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: var(--gap);
    margin-top: var(--gap);
  }

  .cs__card {
    display: flex;
    flex-direction: column;
    gap: 18px;
    min-height: 340px;
  }

  .cs__card-t {
    display: block;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.375rem;
    letter-spacing: -0.02em;
  }

  .cs__card-d {
    display: block;
    margin-top: 6px;
    font-size: 1rem;
    color: var(--paper-muted);
  }

  .cs__card--wire { grid-column: 1 / 5; }
  .cs__card--color { grid-column: 5 / 9; }
  .cs__card--type { grid-column: 9 / 13; }
  .cs__card--page { grid-column: 1 / 9; min-height: 0; }
  .cs__card--inside { grid-column: 9 / 13; }

  .cs__wire {
    margin-top: auto;
    border-radius: 6px;
    overflow: hidden;
  }

  .cs__wire img {
    width: 100%;
  }

  .sw {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 6px;
    flex: 1;
  }

  .sw__item {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    min-height: 96px;
    padding: 12px;
    border-radius: 6px;
    background: var(--c);
    color: var(--t);
    font-family: var(--font-display);
  }

  .sw__item:nth-child(-n + 2) {
    box-shadow: inset 0 0 0 1px rgba(21, 21, 21, 0.12);
  }

  .sw__name {
    font-weight: 600;
  }

  .sw__hex {
    font-size: 0.875rem;
    font-variant-numeric: tabular-nums;
  }

  .ty {
    display: grid;
    gap: 14px;
    flex: 1;
    align-content: end;
  }

  .ty__row {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 18px;
    align-items: end;
    font-size: 1rem;
  }

  .ty__row b {
    font-family: var(--font-display);
    font-weight: 650;
  }

  .ty__aa {
    font-size: clamp(4rem, 2rem + 4vw, 6rem);
    line-height: 0.8;
  }

  .ty__aa--d {
    font-family: var(--font-head);
    font-weight: 800;
    letter-spacing: -0.04em;
  }

  .ty__aa--t {
    font-family: var(--font-text);
    font-weight: 500;
    color: var(--accent);
  }

  .cs__card--page {
    gap: 0;
    background: rgba(255, 255, 255, 0.85);
    padding: 0;
  }

  .browser {
    display: flex;
    gap: 6px;
    padding: 12px 14px;
  }

  .browser i {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: #cfcdc5;
  }

  .cs__card--page img {
    width: 100%;
    height: auto;
  }

  .cs__list {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 8px;
    font-family: var(--font-display);
    font-size: 1.0625rem;
  }

  .cs__list li {
    display: grid;
    grid-template-columns: 14px 1fr;
    gap: 10px;
    align-items: baseline;
  }

  .cs__list li::before {
    content: '';
    width: 8px;
    height: 8px;
    border-radius: 2px;
    background: currentColor;
    transform: translateY(-2px);
  }

  .cs__card--inside .btn {
    margin-top: auto;
    align-self: flex-start;
  }

  @media (max-width: 1023px) {
    .cs__top {
      flex-direction: column;
    }

    .cs__tags {
      justify-content: flex-start;
    }

    .cs__devices {
      width: 82%;
    }

    .cs__card--wire { grid-column: 1 / 7; }
    .cs__card--color { grid-column: 7 / 13; }
    .cs__card--type { grid-column: 1 / -1; min-height: 0; }
    .cs__card--page { grid-column: 1 / -1; }
    .cs__card--inside { grid-column: 1 / -1; }
  }

  @media (max-width: 767px) {

    .cs__devices {
      width: 84%;
      margin-top: -12%;
      margin-left: 0;
    }

    .phone {
      right: -14%;
      width: 30%;
    }

    .cs__cards {
      grid-template-columns: 1fr;
    }

    .cs__card--wire,
    .cs__card--color,
    .cs__card--type,
    .cs__card--page,
    .cs__card--inside {
      grid-column: 1 / -1;
      min-height: 0;
    }
  }
</style>
