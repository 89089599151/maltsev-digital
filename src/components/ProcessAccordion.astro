---
/**
 * Этапы работы: горизонтальный аккордеон, от тёмного к светлому.
 * На телефоне — вертикальный список; без скрипта все этапы раскрыты.
 */
import { stages } from '@/data/content';

interface Props {
  headingId?: string;
  intro?: boolean;
}
const { headingId = 'process-title', intro = true } = Astro.props;
const fills = ['--tone-1', '--tone-2', '--tone-3', '--tone-4', '--tone-5', '--tone-6', '--tone-7'];
const darkText = (i: number) => i >= 5;
---

<section class="proc section" id="process" aria-labelledby={headingId}>
  {
    intro && (
      <div class="proc__intro" data-stagger>
        <h2 id={headingId} class="head" data-split>Как идёт работа</h2>
        <p class="lead">
          Семь шагов от заявки до запуска. На каждом вы знаете, что происходит, сколько это займёт и что
          нужно от вас.
        </p>
      </div>
    )
  }
  {!intro && <h2 id={headingId} class="sr-only">Этапы работы</h2>}

  <ol class="proc__row" data-accordion data-reveal="wipe">
    {
      stages.map((s, i) => (
        <li
          class:list={['stage', { 'is-open': i === 0, 'stage--dark-text': darkText(i) }]}
          style={`--fill: var(${fills[i]})`}
        >
          <h3 class="stage__h">
            <button
              type="button"
              class="stage__btn"
              aria-expanded={i === 0 ? 'true' : 'false'}
              aria-controls={`stage-${i}`}
              id={`stage-btn-${i}`}
            >
              <span class="stage__name">{s.name}</span>
            </button>
          </h3>
          <div class="stage__body" id={`stage-${i}`} role="region" aria-labelledby={`stage-btn-${i}`}>
            <p class="stage__title">{s.name}</p>
            <p class="stage__text">{s.text}</p>
            <p class="stage__dur">{s.duration}</p>
            <div class="stage__you">
              <p class="stage__you-label">От вас</p>
              <p>{s.fromYou}</p>
            </div>
          </div>
        </li>
      ))
    }
  </ol>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-accordion]').forEach((row) => {
    const items = Array.from(row.querySelectorAll<HTMLElement>('.stage'));
    row.classList.add('is-ready');
    const open = (target: HTMLElement) => {
      items.forEach((it) => {
        const on = it === target;
        it.classList.toggle('is-open', on);
        it.querySelector('.stage__btn')?.setAttribute('aria-expanded', String(on));
      });
    };
    items.forEach((it, i) => {
      const btn = it.querySelector<HTMLButtonElement>('.stage__btn');
      btn?.addEventListener('click', () => open(it));
      btn?.addEventListener('keydown', (e) => {
        const dir = e.key === 'ArrowRight' || e.key === 'ArrowDown' ? 1 : e.key === 'ArrowLeft' || e.key === 'ArrowUp' ? -1 : 0;
        if (!dir) return;
        e.preventDefault();
        const next = items[(i + dir + items.length) % items.length];
        next.querySelector<HTMLButtonElement>('.stage__btn')?.focus();
        open(next);
      });
    });
  });
</script>

<style>
  .proc__intro {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: var(--gap);
    align-items: end;
    margin-bottom: 64px;
  }

  .proc__intro h2 {
    grid-column: 1 / 6;
  }

  .proc__intro .lead {
    grid-column: 7 / 12;
  }

  .proc__row {
    list-style: none;
    padding: 0;
    display: flex;
    height: 520px;
    border-radius: var(--radius);
    overflow: hidden;
  }

  .stage {
    position: relative;
    flex: 1 1 0;
    min-width: 0;
    background: var(--fill);
    color: var(--night-ink);
    transition: flex-grow var(--dur) var(--ease-out);
  }

  .stage--dark-text {
    color: var(--paper-ink);
  }

  .stage.is-open {
    flex-grow: 7.5;
  }

  .stage__h {
    position: absolute;
    inset: 0;
    font: inherit;
    letter-spacing: normal;
  }

  .stage__btn {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: flex-end;
    justify-content: flex-start;
    padding: 20px;
    text-align: left;
  }

  .stage__btn:focus-visible {
    outline-offset: -6px;
  }

  .stage__name {
    writing-mode: vertical-rl;
    transform: rotate(180deg);
    font-family: var(--font-head);
    font-weight: 700;
    font-size: 1.25rem;
    letter-spacing: -0.02em;
    white-space: nowrap;
    transition: opacity var(--dur-fast);
  }

  .stage.is-open .stage__h {
    pointer-events: none;
  }

  .stage.is-open .stage__name {
    opacity: 0;
  }

  .stage__body {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    padding: 28px;
    opacity: 0;
    visibility: hidden;
    transition:
      opacity var(--dur) var(--ease-out) 120ms,
      visibility 0s linear var(--dur);
    min-width: 420px;
  }

  .stage.is-open .stage__body {
    opacity: 1;
    visibility: visible;
    transition:
      opacity var(--dur) var(--ease-out) 160ms,
      visibility 0s;
  }

  .stage__title {
    font-family: var(--font-head);
    font-weight: 700;
    font-size: clamp(2rem, 1.4rem + 1.6vw, 2.75rem);
    line-height: 1;
    letter-spacing: -0.035em;
  }

  .stage__text {
    margin-top: auto;
    max-width: min(38ch, 52%);
    font-size: 1.125rem;
  }

  .stage__dur {
    margin-top: 18px;
    font-family: var(--font-display);
    font-weight: 600;
  }

  .stage__you {
    position: absolute;
    right: 28px;
    bottom: 28px;
    width: min(32ch, 36%);
    padding: 20px;
    border-radius: 6px;
    background: rgba(0, 0, 0, 0.22);
    font-size: 1.0625rem;
  }

  .stage--dark-text .stage__you {
    background: rgba(255, 255, 255, 0.32);
  }

  .stage__you-label {
    margin-bottom: 6px;
    font-family: var(--font-display);
    font-weight: 700;
  }

  /* Без скрипта: все этапы раскрыты списком. */
  .proc__row:not(.is-ready) {
    flex-direction: column;
    height: auto;
  }

  .proc__row:not(.is-ready) .stage__h {
    display: none;
  }

  .proc__row:not(.is-ready) .stage__body {
    position: static;
    opacity: 1;
    visibility: visible;
    min-width: 0;
  }

  @media (max-width: 1023px) {
    .proc__intro h2,
    .proc__intro .lead {
      grid-column: 1 / -1;
    }

    .proc__intro {
      margin-bottom: 32px;
    }

    .proc__row {
      flex-direction: column;
      height: auto;
    }

    .stage {
      flex: 0 0 auto;
    }

    .stage__h {
      position: static;
    }

    .stage__btn {
      min-height: 64px;
      align-items: center;
      padding: 0 20px;
    }

    .stage__name {
      writing-mode: horizontal-tb;
      transform: none;
      font-size: 1.125rem;
    }

    .stage.is-open .stage__h {
      pointer-events: auto;
    }

    .stage.is-open .stage__name {
      opacity: 1;
    }

    .stage__title {
      display: none;
    }

    .stage__body {
      position: static;
      display: none;
      min-width: 0;
      padding: 0 20px 22px;
    }

    .stage.is-open .stage__body {
      display: flex;
    }

    .stage__text {
      margin-top: 0;
      font-size: 1.0625rem;
    }

    .stage__body {
      flex-direction: column;
    }

    .stage__you {
      position: static;
      width: auto;
      margin-top: 16px;
      padding: 14px 16px;
    }
  }
</style>
