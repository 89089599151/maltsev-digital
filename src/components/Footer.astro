---
import { url } from '@/lib/url';
import { site } from '@/config/site';
import ContactLink from './ContactLink.astro';
import Icon from './Icon.astro';


const year = new Date().getFullYear();
---

<footer class="ftr" aria-labelledby="ftr-title">
  <h2 id="ftr-title" class="sr-only">{site.brand.name.value}</h2>
  <div class="ftr__mark">
    <p class="ftr__word" aria-hidden="true">
      <span class="tone-mute">Maltsev</span> Digital
    </p>
  </div>

  <div class="ftr__grid">
    <nav class="ftr__cols" aria-label="Разделы сайта">
      <ul>
        <li><a href={url('/')}>Главная</a></li>
        <li><a href={url('/portfolio/')}>Работы</a></li>
        <li><a href={url('/services/')}>Услуги и цены</a></li>
      </ul>
      <ul>
        <li><a href={url('/services/#process')}>Как я работаю</a></li>
        <li><a href={url('/services/#calculator')}>Расчёт стоимости</a></li>
        <li><a href={url('/about/')}>Обо мне</a></li>
      </ul>
      <ul>
        <li><a href={url('/faq/')}>Вопросы и ответы</a></li>
        <li><a href={url('/contacts/')}>Контакты</a></li>
        <li><a href={url('/privacy/')}>Политика конфиденциальности</a></li>
      </ul>
    </nav>
    <div class="ftr__contacts">
      <p class="ftr__lead">Напишите о задаче — предложу план, срок и цену.</p>
      <ContactLink kind="telegram" />
      <ContactLink kind="email" />
    </div>
  </div>

  <div class="ftr__bottom small">
    <p>© {year} {site.brand.name.value}. {site.contacts.workFormat}.</p>
    <a class="btn btn--ghost ftr__top" href="#top">Наверх <span class="arrow" aria-hidden="true"><Icon name="arrow-up" /></span></a>
  </div>
</footer>

<style>
  .ftr {
    margin-top: var(--section-gap);
    padding-bottom: var(--margin);
  }

  /* Название во всю ширину: тонкий крупный набор, первое слово приглушено. */
  .ftr__mark {
    container-type: inline-size;
    padding: clamp(20px, 3vw, 44px) clamp(20px, 3.4vw, 56px);
    border-radius: var(--radius-lg);
    background: var(--paper);
  }

  .ftr__word {
    font-family: var(--font-head);
    font-weight: 300;
    font-size: 17cqw;
    line-height: 1.1;
    letter-spacing: -0.06em;
    white-space: nowrap;
  }

  .ftr__grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: var(--gap);
    margin-top: 56px;
  }

  .ftr__cols {
    grid-column: 1 / 9;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--gap);
  }

  .ftr__cols ul {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 10px;
    align-content: start;
  }

  .ftr__cols a {
    font-family: var(--font-display);
    font-size: var(--step-small);
    text-decoration: none;
    color: var(--ink);
    transition: color var(--dur-fast) var(--ease-out);
  }

  .ftr__cols a:hover {
    color: var(--accent-deep);
  }

  .ftr__contacts {
    grid-column: 9 / 13;
    display: grid;
    gap: var(--gap);
    align-content: start;
  }

  .ftr__lead {
    font-size: var(--step-body);
    margin-bottom: 8px;
  }

  .ftr__bottom {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 24px;
    align-items: center;
    margin-top: 56px;
  }

  .ftr__bottom p:nth-child(2) {
    max-width: 70ch;
  }

  .ftr__top {
    min-height: 44px;
  }

  @media (max-width: 1023px) {
    .ftr__cols {
      grid-column: 1 / -1;
    }

    .ftr__contacts {
      grid-column: 1 / -1;
      margin-top: 32px;
    }
  }

  @media (max-width: 767px) {

    .ftr__grid {
      grid-template-columns: 1fr;
    }

    .ftr__cols {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      row-gap: 8px;
    }

    /* Ссылки высотой с палец: по 44px, а не по строке текста. */
    .ftr__cols ul {
      gap: 0;
    }

    .ftr__cols a {
      display: flex;
      align-items: center;
      min-height: 44px;
    }

    .ftr__bottom {
      grid-template-columns: 1fr auto;
    }

    .ftr__bottom p:nth-child(2) {
      grid-column: 1 / -1;
      order: 3;
    }
  }
</style>
