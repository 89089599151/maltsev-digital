---
import { url } from '@/lib/url';
import { site } from '@/config/site';
import ContactLink from './ContactLink.astro';

const letters = site.brand.short.split('');
// Высота блока каждой буквы (в % от полосы) и его цвет: сайт, собранный из модулей.
const heights = [100, 78, 92, 64, 100, 84, 72, 96];
const fills = ['paper', 'raised', 'accent', 'raised', 'paper', 'deep', 'raised', 'paper'];

const year = new Date().getFullYear();
---

<footer class="ftr" aria-labelledby="ftr-title">
  <h2 id="ftr-title" class="sr-only">{site.brand.name.value}</h2>
  <div class="ftr__mark" aria-hidden="true" data-blocks>
    {
      letters.map((ch, i) => (
        <span class={`blk blk--${fills[i % fills.length]}`} style={`--h:${heights[i % heights.length]}%; --i:${i}`}>
          <span>{ch}</span>
        </span>
      ))
    }
  </div>

  <div class="ftr__grid">
    <nav class="ftr__cols" aria-label="Разделы сайта">
      <ul>
        <li><a href={url('/')}>Главная</a></li>
        <li><a href={url('/portfolio/')}>Работы</a></li>
        <li><a href={url('/services/')}>Услуги и цены</a></li>
      </ul>
      <ul>
        <li><a href={url('/services/#process')}>Как я работаю</a></li>
        <li><a href={url('/services/#calculator')}>Расчёт стоимости</a></li>
        <li><a href={url('/about/')}>Обо мне</a></li>
      </ul>
      <ul>
        <li><a href={url('/faq/')}>Вопросы и ответы</a></li>
        <li><a href={url('/contacts/')}>Контакты</a></li>
        <li><a href={url('/privacy/')}>Политика конфиденциальности</a></li>
      </ul>
    </nav>
    <div class="ftr__contacts">
      <p class="ftr__lead">Напишите о задаче — отвечу {site.contacts.responseTime.value} и предложу план.</p>
      <ContactLink kind="telegram" />
      <ContactLink kind="email" />
    </div>
  </div>

  <div class="ftr__bottom small">
    <p>© {year} {site.brand.name.value}. {site.contacts.workFormat}.</p>
    <a class="btn btn--ghost ftr__top" href="#top">Наверх <span class="arrow" aria-hidden="true">↑</span></a>
  </div>
</footer>

<style>
  .ftr {
    margin-top: var(--section-gap);
    padding-bottom: var(--margin);
  }

  .ftr__mark {
    display: flex;
    align-items: flex-end;
    gap: 4px;
    height: clamp(180px, 34svh, 360px);
  }

  .blk {
    flex: 1 1 0;
    height: var(--h);
    border-radius: var(--radius);
    display: flex;
    align-items: flex-end;
    justify-content: center;
    overflow: hidden;
    -webkit-backdrop-filter: var(--glass-blur);
    backdrop-filter: var(--glass-blur);
    box-shadow: inset 0 0 0 1px var(--glass-edge);
    font-family: var(--font-head);
    font-weight: 700;
    font-size: clamp(3rem, 11vw, 12rem);
    line-height: 0.74;
    letter-spacing: -0.04em;
  }

  .blk span {
    transform: translateY(0.02em);
  }

  .blk--paper {
    background: var(--paper);
    color: var(--paper-ink);
  }

  .blk--raised {
    background: var(--surface-2);
    color: var(--ink);
  }

  .blk--accent {
    background: var(--accent);
    color: var(--accent-ink);
  }

  .blk--deep {
    background: var(--night);
    color: var(--tone-6);
  }

  .ftr__grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: var(--gap);
    margin-top: 56px;
  }

  .ftr__cols {
    grid-column: 1 / 9;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--gap);
  }

  .ftr__cols ul {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 10px;
    align-content: start;
  }

  .ftr__cols a {
    font-family: var(--font-display);
    font-size: 0.975rem;
    text-decoration: none;
    color: var(--ink);
    transition: color var(--dur-fast) var(--ease-out);
  }

  .ftr__cols a:hover {
    color: var(--accent-deep);
  }

  .ftr__contacts {
    grid-column: 9 / 13;
    display: grid;
    gap: var(--gap);
    align-content: start;
  }

  .ftr__lead {
    font-size: var(--step-body);
    margin-bottom: 8px;
  }

  .ftr__bottom {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 24px;
    align-items: center;
    margin-top: 56px;
  }

  .ftr__bottom p:nth-child(2) {
    max-width: 70ch;
  }

  .ftr__top {
    min-height: 44px;
  }

  @media (max-width: 1023px) {
    .ftr__cols {
      grid-column: 1 / -1;
    }

    .ftr__contacts {
      grid-column: 1 / -1;
      margin-top: 32px;
    }
  }

  @media (max-width: 767px) {
    .ftr__mark {
      height: 22svh;
      min-height: 140px;
    }

    .blk {
      font-size: 17vw;
    }

    .ftr__grid {
      grid-template-columns: 1fr;
    }

    .ftr__cols {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      row-gap: 24px;
    }

    .ftr__bottom {
      grid-template-columns: 1fr auto;
    }

    .ftr__bottom p:nth-child(2) {
      grid-column: 1 / -1;
      order: 3;
    }
  }
</style>
