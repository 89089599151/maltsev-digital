---
/**
 * Общий компактный подвал: навигация, прямые контакты и служебные ссылки
 * на фоне страницы. Тонкие разделители связывают его с остальным сайтом.
 */
import { url, isActive } from '@/lib/url';
import { site, telegramUrl, emailUrl } from '@/config/site';
import Icon from './Icon.astro';

const year = new Date().getFullYear();
const current = Astro.url.pathname;
const telegram = telegramUrl();
const email = emailUrl('Заявка на разработку сайта');
const columns = [
  [
    { href: '/portfolio/', label: 'Работы' },
    { href: '/services/', label: 'Услуги и цены' },
    { href: '/about/', label: 'Обо мне' },
    { href: '/contacts/', label: 'Контакты' },
  ],
  [
    { href: '/services/#process', label: 'Как я работаю' },
    { href: '/services/#calculator', label: 'Расчёт стоимости' },
    { href: '/faq/', label: 'Вопросы и ответы' },
  ],
];
---

<footer class="ftr" aria-labelledby="ftr-title">
  <h2 id="ftr-title" class="sr-only">{site.brand.name.value} — контакты и навигация</h2>
  <div class="ftr__panel">
    <div class="ftr__top">
      <nav class="ftr__nav" aria-label="Разделы сайта">
        {columns.map((links) => (
          <ul>{links.map((link) => <li><a href={url(link.href)} aria-current={!link.href.includes('#') && isActive(current, link.href) ? 'page' : undefined}>{link.label}</a></li>)}</ul>
        ))}
      </nav>

      <div class="ftr__contacts">
        {telegram && (
          <a class="ftr__row" href={telegram} target="_blank" rel="noopener">
            <span class="ftr__k">Telegram</span>
            <span class="ftr__v">@{site.contacts.telegram.value}</span>
            <span class="ftr__go" aria-hidden="true"><Icon name="arrow-ne" /></span>
          </a>
        )}
        {email && (
          <div class="ftr__row ftr__row--mail">
            <a class="ftr__mail" href={email}>
              <span class="ftr__k">Почта</span>
              <span class="ftr__v">{site.contacts.email.value}</span>
            </a>
            <button class="ftr__copy" type="button" data-footer-copy data-email={site.contacts.email.value} aria-label="Скопировать адрес почты" title="Скопировать адрес" hidden>
              <svg data-copy-icon width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="8" y="8" width="12" height="12" rx="3" /><path d="M15 8V6a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v7a2 2 0 0 0 2 2h2" /></svg>
              <span data-copy-done hidden><Icon name="check" /></span>
              <span class="ftr__copy-feedback" data-copy-feedback aria-hidden="true" hidden></span>
            </button>
          </div>
        )}
        {!telegram && !email && <p class="ftr__hours">Контакты будут указаны перед запуском.</p>}
        <p class="sr-only" data-copy-status role="status" aria-live="polite"></p>
      </div>
    </div>

    <a class="ftr__word" href={url('/')} aria-label={`${site.brand.name.value} — на главную`}>
      <span aria-hidden="true">Maltsev Digital</span>
    </a>

    <div class="ftr__bottom">
      <p>© {year} {site.brand.owner.value}</p>
      <p class="ftr__format">{site.contacts.workFormat}</p>
      <a class="ftr__policy" href={url('/privacy/')}>Политика конфиденциальности</a>
      <a class="ftr__up" href="#top" aria-label="Вернуться наверх"><span>Наверх</span><span class="ftr__up-icon"><Icon name="arrow-up" /></span></a>
    </div>
  </div>
</footer>

<script>
  const button = document.querySelector<HTMLButtonElement>('[data-footer-copy]');
  const icon = button?.querySelector<SVGElement>('[data-copy-icon]');
  const done = button?.querySelector<HTMLElement>('[data-copy-done]');
  const feedback = button?.querySelector<HTMLElement>('[data-copy-feedback]');
  const status = document.querySelector<HTMLElement>('[data-copy-status]');
  if (button && icon && done && feedback && status && navigator.clipboard?.writeText) {
    button.hidden = false;
    let reset: ReturnType<typeof setTimeout> | undefined;
    button.addEventListener('click', async () => {
      clearTimeout(reset);
      button.disabled = true;
      icon.style.display = '';
      done.hidden = true;
      feedback.hidden = true;
      status.textContent = '';
      try {
        await navigator.clipboard.writeText(button.dataset.email ?? '');
        icon.style.display = 'none';
        done.hidden = false;
        feedback.textContent = 'Адрес скопирован';
        status.textContent = 'Адрес электронной почты скопирован';
      } catch {
        feedback.textContent = 'Не удалось скопировать';
        status.textContent = 'Не получилось скопировать. Выделите адрес электронной почты.';
      } finally {
        button.disabled = false;
        feedback.hidden = false;
      }
      reset = setTimeout(() => {
        icon.style.display = '';
        done.hidden = true;
        feedback.hidden = true;
        status.textContent = '';
      }, 3000);
    });
  }
</script>

<style>
  .ftr {
    margin-top: 32px;
    padding-bottom: var(--margin);
  }

  .ftr__panel {
    container-type: inline-size;
    padding: 32px 0 16px;
    border-top: 1px solid var(--line);
  }

  .ftr__top {
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr);
    gap: clamp(32px, 8vw, 128px);
    align-items: start;
  }

  .ftr__hours {
    margin-top: 20px;
    font-size: var(--step-small);
    line-height: 1.5;
    color: var(--muted);
  }

  .ftr__nav {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 24px;
  }

  .ftr__nav ul {
    display: grid;
    align-content: start;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .ftr__nav a {
    display: flex;
    align-items: center;
    min-height: 44px;
    width: fit-content;
    font-family: var(--font-display);
    font-size: var(--step-small);
    line-height: 1.3;
    color: var(--ink);
    text-decoration: none;
    transition: color var(--dur-fast) var(--ease-out);
  }

  .ftr__nav a:hover {
    color: var(--accent-text);
  }

  /* Текущая страница: синяя точка перед названием. */
  .ftr__nav a[aria-current='page'] {
    gap: 8px;
    font-weight: 500;
  }

  .ftr__nav a[aria-current='page']::before {
    content: '';
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent);
  }

  /* Контакты — те же строки под линиями, что и списки на страницах. */
  .ftr__contacts {
    border-top: 1px solid var(--line);
  }

  .ftr__row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 2px 16px;
    align-items: center;
    min-height: 76px;
    padding-block: 14px;
    border-bottom: 1px solid var(--line);
    color: var(--ink);
    text-decoration: none;
  }

  .ftr__mail {
    display: grid;
    gap: 2px;
    min-width: 0;
    min-height: 44px;
    align-content: center;
    color: inherit;
    text-decoration: none;
  }

  .ftr__k {
    grid-column: 1;
    font-size: var(--fs-xs);
    line-height: 1.4;
    color: var(--muted);
  }

  .ftr__v {
    grid-column: 1;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(1rem, 4.4cqi, 1.1875rem);
    line-height: 1.3;
    letter-spacing: -0.02em;
    white-space: nowrap;
    transition: color var(--dur-fast) var(--ease-out);
  }

  .ftr__row--mail .ftr__v {
    font-size: clamp(0.875rem, 1.05vw, 1rem);
    white-space: normal;
    overflow-wrap: anywhere;
  }

  a.ftr__row:hover .ftr__v,
  .ftr__mail:hover .ftr__v {
    color: var(--accent-text);
  }

  .ftr__go,
  .ftr__copy {
    grid-column: 2;
    grid-row: 1 / 3;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--bg);
    color: var(--ink);
    font-size: var(--fs-1);
    transition:
      background-color var(--dur-fast) var(--ease-out),
      color var(--dur-fast) var(--ease-out);
  }

  .ftr__copy[hidden] {
    display: none;
  }

  .ftr__copy {
    position: relative;
  }

  .ftr__copy-feedback {
    position: absolute;
    right: 0;
    bottom: calc(100% + 8px);
    z-index: 2;
    width: max-content;
    max-width: min(240px, calc(100vw - 64px));
    padding: 8px 12px;
    border-radius: 8px;
    background: var(--night);
    color: var(--night-ink);
    font-size: var(--fs-xs);
    line-height: 1.4;
    text-align: left;
    pointer-events: none;
  }

  .ftr__copy-feedback[hidden] {
    display: none;
  }

  .ftr__copy [data-copy-done] {
    display: grid;
    color: var(--accent-text);
  }

  .ftr__copy [data-copy-done][hidden] {
    display: none;
  }

  a.ftr__row:hover .ftr__go,
  .ftr__copy:hover {
    background: var(--accent);
    color: var(--accent-ink);
  }

  .ftr__copy:hover [data-copy-done] {
    color: inherit;
  }

  .ftr__word {
    display: flex;
    align-items: center;
    min-height: 44px;
    margin-top: 28px;
    font-family: var(--font-head);
    font-weight: 400;
    font-size: 26px;
    line-height: 1.1;
    letter-spacing: -0.04em;
    white-space: nowrap;
    color: var(--ink);
    text-decoration: none;
    transition: color 400ms var(--ease-out);
  }

  /* Оптическая поправка: левый край буквы «M» встаёт на одну вертикаль с текстом над ней. */
  .ftr__word span {
    display: block;
    margin-left: -0.045em;
  }

  .ftr__word:hover {
    color: var(--accent-text);
  }

  .ftr__bottom {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto auto;
    gap: 8px clamp(20px, 3vw, 48px);
    align-items: center;
    margin-top: 20px;
    padding-top: clamp(12px, 1.4vw, 20px);
    border-top: 1px solid var(--line);
    font-size: var(--fs-xs);
    line-height: 1.5;
    color: var(--muted);
  }

  .ftr__policy {
    display: flex;
    align-items: center;
    min-height: 44px;
    color: inherit;
    text-decoration: none;
    transition: color var(--dur-fast) var(--ease-out);
  }

  .ftr__policy:hover {
    color: var(--accent-text);
  }

  .ftr__up {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    min-height: 44px;
    color: var(--ink);
    text-decoration: none;
  }

  .ftr__up-icon {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--bg);
    font-size: var(--fs-1);
    transition:
      background-color var(--dur-fast) var(--ease-out),
      color var(--dur-fast) var(--ease-out);
  }

  .ftr__up:hover .ftr__up-icon {
    background: var(--accent);
    color: var(--accent-ink);
  }

  /* На главной блок заявки с Telegram и почтой стоит прямо над подвалом, на странице контактов они
     в первом экране — подвал их не повторяет. */
  :global(body:has(#contact, .ct-direct)) .ftr__contacts {
    display: none;
  }

  :global(body:has(#contact, .ct-direct)) .ftr__top {
    grid-template-columns: minmax(0, 1fr);
  }

  @media (max-width: 699px) {
    .ftr__top {
      grid-template-columns: minmax(0, 1fr);
      gap: 24px;
    }

    .ftr__bottom {
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 0 12px;
    }

    .ftr__format {
      grid-column: 1;
    }

    .ftr__policy {
      grid-column: 1;
    }

    .ftr__up {
      grid-column: 2;
      grid-row: 1 / 4;
      align-self: end;
    }

    .ftr__up > span:first-child {
      display: none;
    }
  }

</style>
