---
/**
 * Калькулятор: тип сайта и число страниц → подходящий пакет, ориентировочная сумма и срок.
 * Лендинг — всегда одна страница; страницы сверх пакета считаются доплатой за каждую.
 * Дополнительные работы — последняя строка доски: кнопки «+» добавляют их в расчёт (data-addon).
 * Без скрипта кнопки скрыты, и строка остаётся обычным прайсом.
 * Кнопка переносит расчёт в форму заявки.
 * Число страниц меняется кнопками «−» и «+», как степпер в iOS; ползунок остаётся только без скрипта.
 */
import { plans, addons, extraPagePrice, formatPrice, pricingConfirmed } from '@/config/pricing';
import { url } from '@/lib/url';
import Icon from './Icon.astro';
import SectionHead from './SectionHead.astro';

const types = [
  { id: 'start', label: 'Лендинг', note: 'Одна страница', pages: 1 },
  { id: 'business', label: 'Сайт компании', note: 'Несколько разделов', pages: 6 },
  { id: 'premium', label: 'Индивидуальный проект', note: 'Сложный дизайн и логика', pages: 10 },
];
// В PREMIUM уже входят анимации, 3D и интеграции.
const includedIn: Record<string, string[]> = { premium: ['motion', 'crm'] };

const data = {
  plans: plans.map((p) => ({ id: p.id, name: p.name, price: p.price, maxPages: p.maxPages, timeline: p.timeline })),
  addons: addons.map((a) => ({ id: a.id, name: a.name, price: a.price })),
  extraPagePrice,
  includedIn,
  contactUrl: url('/contacts/'),
};
const start = plans[1];
---

<section class="est section" id="calculator" data-island-section="Расчёт" aria-labelledby="est-title">
  <SectionHead
    id="est-title"
    title="Посчитайте свой сайт"
    text="Выберите тип сайта и число страниц — калькулятор подберёт пакет и покажет ориентир. Точную сумму подтвержу после короткого разговора."
  />

  <form class="est__board" data-estimator data-config={JSON.stringify(data)}>
    <fieldset class="est__types tile">
      <legend class="est__legend">Тип сайта</legend>
      <div class="est__options">
        {
          types.map((t, i) => (
            <label class="opt">
              <input type="radio" name="type" value={t.id} data-pages={t.pages} checked={i === 1} />
              <span class="opt__box">
                <span class="opt__name">{t.label}</span>
                <span class="opt__note">{t.note}</span>
              </span>
            </label>
          ))
        }
      </div>
    </fieldset>

    <div class="est__pages tile">
      <label class="est__legend" for="est-pages">Страниц</label>
      <div class="est__count">
        <button class="est__step" type="button" data-step="-1" aria-label="Меньше страниц" aria-controls="est-pages" hidden><Icon name="minus" /></button>
        <output class="est__pages-val" for="est-pages" data-pages-out>6</output>
        <button class="est__step" type="button" data-step="1" aria-label="Больше страниц" aria-controls="est-pages" hidden><Icon name="plus" /></button>
      </div>
      <input id="est-pages" type="range" name="pages" min="1" max="15" value="6" step="1" aria-describedby="est-pages-note" />
      <p class="est__pages-note small" id="est-pages-note" data-pages-note>Главная, услуги, о компании, контакты и так далее. Больше 15 страниц — посчитаю отдельно.</p>
    </div>

    <div class="est__result tile" aria-live="polite">
      <p class="est__res-label">Подходит пакет</p>
      <p class="est__res-plan" data-out-plan>{start.name}</p>
      <p class="est__res-sum" data-out-sum>{formatPrice(start.price)}</p>
      <p class="est__res-time">Срок: <span data-out-time>{start.timeline}</span></p>
      <p class="est__res-extra small" data-out-extra></p>
      {!pricingConfirmed && <p class="est__res-note small">Цены предварительные и требуют подтверждения.</p>}
      <a class="btn btn--accent est__go" href={url(`/contacts/?plan=${start.id}`)} data-out-link>
        Оставить заявку с расчётом
      </a>
    </div>

    <fieldset class="est__addons tile">
      <legend class="est__legend">Дополнительно</legend>
      <p class="est__addons-note">К любому пакету. Страница сверх лимита — {formatPrice(extraPagePrice)}.</p>
      <ul class="extras__list">
        {
          addons.map((a) => (
            <li class="extras__item" data-addon-row={a.id}>
              <span class="extras__name">{a.name}</span>
              <span class="extras__note">{a.note}</span>
              <span class="extras__price" data-addon-price>{formatPrice(a.price)}</span>
              <button class="extras__toggle" type="button" data-addon={a.id} aria-pressed="false" aria-label={`Добавить в расчёт: ${a.name}`} hidden>
                <span data-icon-plus><Icon name="plus" /></span>
                <span data-icon-minus hidden><Icon name="minus" /></span>
                <span data-icon-check hidden><Icon name="check" /></span>
              </button>
            </li>
          ))
        }
      </ul>
    </fieldset>

    <p class="est__shop">
      Интернет-магазин с корзиной и онлайн-оплатой в калькулятор не входит — <a href={url('/contacts/')}>считаю отдельно</a>.
    </p>
  </form>
</section>

<script>
  import { initEstimator } from '@/scripts/estimator';
  initEstimator();
</script>

<style>
  .est__board {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    grid-template-rows: auto auto;
    gap: var(--gap);
  }

  fieldset {
    border: 0;
    margin: 0;
    min-width: 0;
  }

  /* float кладёт legend внутрь fieldset, а не на его верхнюю границу. */
  .est__legend {
    float: left;
    width: 100%;
    display: block;
    padding: 0;
    margin-bottom: 18px;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: var(--fs-1);
    letter-spacing: -0.02em;
    line-height: 1.2;
  }

  .est__types {
    grid-column: 1 / 6;
  }

  .est__pages {
    grid-column: 6 / 9;
    display: flex;
    flex-direction: column;
  }

  /* Итог справа на всю высоту доски и остаётся на виду, пока добавляют работы. */
  .est__result {
    grid-column: 9 / 13;
    grid-row: 1 / 3;
    align-self: start;
    position: sticky;
    top: calc(var(--header-h) + 36px);
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .est__addons {
    grid-column: 1 / 9;
    grid-row: 2;
  }

  .est__addons-note {
    clear: both;
    margin-bottom: 4px;
    font-size: var(--step-small);
    color: var(--muted);
  }

  .extras__list {
    list-style: none;
    padding: 0;
    display: grid;
  }

  /* Строки под тонкими линиями: название, пояснение, цена и кнопка «+». */
  .extras__item {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr) auto auto;
    gap: 24px;
    align-items: center;
    padding-block: 16px;
  }

  .extras__item + .extras__item {
    border-top: 1px solid var(--line);
  }

  .extras__name {
    font-weight: 500;
    font-size: var(--step-body);
  }

  .extras__note {
    color: var(--muted);
    font-size: var(--step-small);
  }

  .extras__price {
    font-weight: 500;
    font-size: var(--step-body);
    white-space: nowrap;
  }

  .extras__item.is-included .extras__price {
    font-weight: 400;
    font-size: var(--step-small);
    color: var(--muted);
  }

  /* «+» — добавить, «−» на тёмном кружке — добавлено, галочка — уже входит в пакет. */
  .extras__toggle {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--bg);
    color: var(--ink);
    font-size: var(--fs-1);
    transition:
      background-color var(--dur-fast) var(--ease-out),
      color var(--dur-fast) var(--ease-out),
      scale var(--dur-fast) var(--ease-out);
  }

  .extras__toggle > span {
    display: grid;
  }

  .extras__toggle:hover:not(:disabled) {
    background: var(--surface-2);
  }

  .extras__toggle:active:not(:disabled) {
    scale: 0.92;
  }

  .extras__toggle[aria-pressed='true'],
  .extras__toggle[aria-pressed='true']:hover {
    background: var(--ink);
    color: var(--paper);
  }

  .extras__toggle:disabled {
    background: transparent;
    color: var(--muted);
    box-shadow: inset 0 0 0 1px var(--line);
    cursor: default;
  }

  .est__options {
    clear: both;
    display: grid;
    gap: var(--gap);
  }

  .opt {
    position: relative;
    display: block;
    cursor: pointer;
  }

  .opt input {
    position: absolute;
    opacity: 0;
    inset: 0;
    margin: 0;
    cursor: pointer;
  }

  .opt__box {
    display: grid;
    gap: 2px;
    padding: 14px 16px;
    border-radius: var(--radius-sm);
    background: var(--field);
    box-shadow: inset 0 0 0 1px var(--field-line);
    transition:
      background-color var(--dur-fast) var(--ease-out),
      color var(--dur-fast) var(--ease-out);
  }

  .opt:hover .opt__box {
    box-shadow: inset 0 0 0 1px var(--field-line-hover);
  }

  @media (prefers-reduced-motion: no-preference) {
    .opt input:checked + .opt__box {
      animation: choice-pop var(--dur-spring) var(--ease-pop);
    }
  }

  .opt input:checked + .opt__box {
    background: var(--surface-solid);
    box-shadow: inset 0 0 0 2px var(--accent);
    color: var(--accent-text);
  }

  .opt input:focus-visible + .opt__box {
    outline: 3px solid var(--accent);
    outline-offset: 2px;
  }

  .opt__name {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: var(--step-body);
  }

  .opt__note {
    font-size: var(--step-small);
    color: var(--muted);
  }

  .opt input:checked + .opt__box .opt__note {
    color: var(--muted);
  }

  /* Главная цифра калькулятора — сумма. Число страниц на шаг тише, пакет — подпись. */
  .est__pages-val {
    font-family: var(--font-head);
    font-weight: 300;
    font-size: var(--fs-4);
    line-height: 1;
    letter-spacing: -0.04em;
  }

  .est__count {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }

  .est__step {
    display: grid;
    place-items: center;
    flex: none;
    width: 52px;
    height: 52px;
    border-radius: 50%;
    background: var(--bg);
    color: var(--ink);
    font-size: var(--fs-1);
    transition:
      background-color var(--dur-fast) var(--ease-out),
      scale var(--dur-fast) var(--ease-out);
  }

  .est__step[hidden] {
    display: none;
  }

  .est__step:hover:not(:disabled) {
    background: var(--surface-2);
  }

  .est__step:active:not(:disabled) {
    scale: 0.92;
  }

  .est__step:disabled {
    opacity: 0.35;
    cursor: not-allowed;
  }

  /* Со скриптом число страниц меняют кнопки; ползунок остаётся в форме, но не виден. */
  :global(.is-stepper) input[type='range'] {
    display: none;
  }

  :global(.is-stepper) .est__pages-note {
    margin-top: var(--space-6);
  }

  input[type='range'] {
    width: 100%;
    margin-top: var(--space-6);
    accent-color: var(--accent);
    height: 44px;
    cursor: pointer;
  }

  .est__pages-note {
    margin-top: 10px;
    color: var(--muted);
  }

  .est__res-label {
    font-size: var(--step-small);
    color: var(--muted);
  }

  .est__res-plan {
    font-family: var(--font-head);
    font-weight: 500;
    font-size: var(--fs-1);
    line-height: 1.2;
    letter-spacing: -0.02em;
  }

  @media (prefers-reduced-motion: no-preference) {
    .est__res-sum:global(.is-bumped) {
      animation: est-bump 420ms var(--ease-out);
    }
  }

  @keyframes est-bump {
    40% {
      scale: 1.06;
    }
  }

  .est__res-sum {
    transform-origin: left center;
    margin-block: 12px 4px;
    font-family: var(--font-head);
    font-weight: 300;
    font-size: var(--fs-5);
    letter-spacing: -0.045em;
    line-height: 1;
    white-space: nowrap;
  }

  .est__res-time {
    font-size: var(--step-small);
  }

  .est__res-extra,
  .est__res-note {
    color: var(--muted);
  }

  .est__res-extra:empty {
    display: none;
  }

  .est__shop {
    grid-column: 1 / -1;
    font-size: var(--step-small);
    color: var(--muted);
  }

  input[type='range']:disabled {
    opacity: 0.35;
    cursor: not-allowed;
  }

  .est__go {
    margin-top: 12px;
  }

  @media (max-width: 1023px) {
    .est__head h2,
    .est__head p {
      grid-column: 1 / -1;
    }

    .est__head {
      gap: 20px;
    }

    .est__types {
      grid-column: 1 / 8;
    }

    .est__pages {
      grid-column: 8 / 13;
    }

    .est__addons {
      grid-column: 1 / -1;
      grid-row: auto;
    }

    .est__result {
      position: static;
      grid-column: 1 / -1;
      grid-row: auto;
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 10px clamp(24px, 4vw, 40px);
      align-items: start;
    }

    .est__res-label {
      grid-column: 1;
      grid-row: 1;
    }

    .est__res-plan {
      grid-column: 1;
      grid-row: 2;
    }

    .est__res-sum {
      grid-column: 2;
      grid-row: 1 / 3;
      align-self: center;
      margin-top: 0;
    }

    .est__res-time {
      grid-column: 1;
      grid-row: 3;
    }

    .est__res-extra,
    .est__res-note,
    .est__go {
      grid-column: 1 / -1;
    }

    .est__go {
      justify-self: start;
    }
  }

  @media (max-width: 767px) {
    .est__board,
    .est__head {
      grid-template-columns: 1fr;
    }

    .est__types,
    .est__pages {
      grid-column: 1 / -1;
    }

    .est__pages-val {
      font-size: var(--fs-4);
    }

    /* Название, цена и пояснение — одной колонкой слева, кнопка — по центру справа. */
    .extras__item {
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 4px 16px;
    }

    .extras__name,
    .extras__price,
    .extras__note {
      grid-column: 1;
    }

    .extras__price {
      grid-row: 2;
      font-size: var(--fs-0);
    }

    .extras__note {
      grid-row: 3;
    }

    .extras__toggle {
      grid-row: 1 / 4;
      grid-column: 2;
    }

    .est__result {
      display: flex;
      gap: 12px;
    }

    .est__res-sum {
      align-self: auto;
      margin-top: 8px;
    }
  }
</style>
