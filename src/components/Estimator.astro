---
/**
 * Калькулятор: тип сайта и число страниц → подходящий пакет, ориентировочная сумма и срок.
 * Лендинг — всегда одна страница; страницы сверх пакета считаются доплатой за каждую.
 * Дополнительные работы добавляются кнопками «+» в списке «Дополнительно» ниже (data-addon).
 * Кнопка переносит расчёт в форму заявки.
 */
import { plans, addons, extraPagePrice, formatPrice, pricingConfirmed } from '@/config/pricing';
import { url } from '@/lib/url';
import Icon from './Icon.astro';
import SectionHead from './SectionHead.astro';

const types = [
  { id: 'start', label: 'Лендинг', note: 'Одна страница', pages: 1 },
  { id: 'business', label: 'Сайт компании', note: 'Несколько разделов', pages: 6 },
  { id: 'premium', label: 'Индивидуальный проект', note: 'Сложный дизайн и логика', pages: 10 },
];
// В PREMIUM уже входят анимации, 3D и интеграции.
const includedIn: Record<string, string[]> = { premium: ['motion', 'crm'] };

const data = {
  plans: plans.map((p) => ({ id: p.id, name: p.name, price: p.price, maxPages: p.maxPages, timeline: p.timeline })),
  addons: addons.map((a) => ({ id: a.id, name: a.name, price: a.price })),
  extraPagePrice,
  includedIn,
  contactUrl: url('/contacts/'),
};
const start = plans[1];
---

<section class="est section" id="calculator" aria-labelledby="est-title">
  <SectionHead
    id="est-title"
    title="Посчитайте свой сайт"
    text="Выберите тип сайта и число страниц — калькулятор подберёт пакет и покажет ориентир. Точную сумму подтвержу после короткого разговора."
  />

  <form class="est__board" data-estimator data-config={JSON.stringify(data)}>
    <fieldset class="est__types tile">
      <legend class="est__legend">Тип сайта</legend>
      <div class="est__options">
        {
          types.map((t, i) => (
            <label class="opt">
              <input type="radio" name="type" value={t.id} data-pages={t.pages} checked={i === 1} />
              <span class="opt__box">
                <span class="opt__name">{t.label}</span>
                <span class="opt__note">{t.note}</span>
              </span>
            </label>
          ))
        }
      </div>
    </fieldset>

    <div class="est__pages tile">
      <label class="est__legend" for="est-pages">Страниц</label>
      <output class="est__pages-val" for="est-pages" data-pages-out>6</output>
      <input id="est-pages" type="range" name="pages" min="1" max="15" value="6" step="1" aria-describedby="est-pages-note" />
      <p class="est__pages-note small" id="est-pages-note" data-pages-note>Главная, услуги, о компании, контакты и так далее. Больше 15 страниц — посчитаю отдельно.</p>
    </div>

    <div class="est__result tile" aria-live="polite">
      <p class="est__res-label">Подходит пакет</p>
      <p class="est__res-plan" data-out-plan>{start.name}</p>
      <p class="est__res-sum" data-out-sum>{formatPrice(start.price)}</p>
      <p class="est__res-time">Срок: <span data-out-time>{start.timeline}</span></p>
      <p class="est__res-extra small" data-out-extra></p>
      {!pricingConfirmed && <p class="est__res-note small">Цены предварительные и требуют подтверждения.</p>}
      <a class="btn btn--accent est__go" href={url(`/contacts/?plan=${start.id}`)} data-out-link>
        Отправить заявку с расчётом <span class="arrow" aria-hidden="true"><Icon name="arrow" /></span>
      </a>
    </div>

    <p class="est__shop">
      Интернет-магазин с корзиной и онлайн-оплатой в калькулятор не входит — <a href={url('/contacts/')}>считаю отдельно</a>.
    </p>
  </form>
</section>

<script>
  import { initEstimator } from '@/scripts/estimator';
  initEstimator();
</script>

<style>
  .est__board {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    grid-template-rows: auto auto;
    gap: var(--gap);
  }

  fieldset {
    border: 0;
    margin: 0;
    min-width: 0;
  }

  /* float кладёт legend внутрь fieldset, а не на его верхнюю границу. */
  .est__legend {
    float: left;
    width: 100%;
    display: block;
    padding: 0;
    margin-bottom: 18px;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--fs-1);
    letter-spacing: -0.02em;
  }

  .est__types {
    grid-column: 1 / 6;
  }

  .est__pages {
    grid-column: 6 / 9;
    display: flex;
    flex-direction: column;
  }

  .est__result {
    grid-column: 9 / 13;
    grid-row: 1;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .est__options {
    clear: both;
    display: grid;
    gap: var(--gap);
  }

  .opt {
    position: relative;
    display: block;
    cursor: pointer;
  }

  .opt input {
    position: absolute;
    opacity: 0;
    inset: 0;
    margin: 0;
    cursor: pointer;
  }

  .opt__box {
    display: grid;
    gap: 2px;
    padding: 14px 16px;
    border-radius: 14px;
    background: var(--bg);
    transition:
      background-color var(--dur-fast) var(--ease-out),
      color var(--dur-fast) var(--ease-out);
  }

  .opt:hover .opt__box {
    background: var(--accent-soft);
  }

  .opt input:checked + .opt__box {
    background: var(--night);
    color: var(--night-ink);
  }

  .opt input:focus-visible + .opt__box {
    outline: 3px solid var(--accent);
    outline-offset: 2px;
  }

  .opt__name {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--step-body);
  }

  .opt__note {
    font-size: var(--step-small);
    color: var(--muted);
  }

  .opt input:checked + .opt__box .opt__note {
    color: var(--night-muted);
  }

  .est__pages-val {
    font-family: var(--font-head);
    font-weight: 420;
    font-size: clamp(4rem, 2rem + 4vw, 6.5rem);
    line-height: 0.9;
    letter-spacing: -0.04em;
  }

  input[type='range'] {
    width: 100%;
    margin-top: var(--space-6);
    accent-color: var(--accent);
    height: 44px;
    cursor: pointer;
  }

  .est__pages-note {
    margin-top: 10px;
    color: var(--muted);
  }

  .est__res-label {
    font-family: var(--font-display);
    font-weight: 500;
  }

  .est__res-plan {
    font-family: var(--font-head);
    font-weight: 420;
    font-size: clamp(2.5rem, 1.6rem + 2vw, 3.5rem);
    line-height: 0.9;
    letter-spacing: -0.04em;
  }

  @media (prefers-reduced-motion: no-preference) {
    .est__res-sum:global(.is-bumped) {
      animation: est-bump 420ms var(--ease-out);
    }
  }

  @keyframes est-bump {
    40% {
      scale: 1.06;
    }
  }

  .est__res-sum {
    transform-origin: left center;
    margin-top: auto;
    color: var(--accent-text);
    font-family: var(--font-head);
    font-weight: 400;
    font-size: clamp(2.25rem, 1.5rem + 2vw, 3.25rem);
    letter-spacing: -0.04em;
    line-height: 1;
  }

  .est__res-time {
    font-family: var(--font-display);
    font-weight: 600;
  }

  .est__res-extra,
  .est__res-note {
    color: var(--muted);
  }

  .est__res-extra:empty {
    display: none;
  }

  .est__shop {
    grid-column: 1 / -1;
    font-size: var(--step-small);
    color: var(--muted);
  }

  input[type='range']:disabled {
    opacity: 0.35;
    cursor: not-allowed;
  }

  .est__go {
    margin-top: 12px;
  }

  @media (max-width: 1023px) {
    .est__head h2,
    .est__head p {
      grid-column: 1 / -1;
    }

    .est__head {
      gap: 20px;
    }

    .est__types {
      grid-column: 1 / 8;
    }

    .est__pages {
      grid-column: 8 / 13;
    }

    .est__result {
      grid-column: 1 / -1;
      grid-row: auto;
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 10px clamp(24px, 4vw, 40px);
      align-items: start;
    }

    .est__res-label {
      grid-column: 1;
      grid-row: 1;
    }

    .est__res-plan {
      grid-column: 1;
      grid-row: 2;
    }

    .est__res-sum {
      grid-column: 2;
      grid-row: 1 / 3;
      align-self: center;
      margin-top: 0;
    }

    .est__res-time {
      grid-column: 1;
      grid-row: 3;
    }

    .est__res-extra,
    .est__res-note,
    .est__go {
      grid-column: 1 / -1;
    }

    .est__go {
      justify-self: start;
    }
  }

  @media (max-width: 767px) {
    .est__board,
    .est__head {
      grid-template-columns: 1fr;
    }

    .est__types,
    .est__pages {
      grid-column: 1 / -1;
    }

    .est__pages-val {
      font-size: 4rem;
    }

    .est__result {
      display: flex;
      gap: 12px;
    }

    .est__res-sum {
      align-self: auto;
      margin-top: 8px;
    }
  }
</style>
