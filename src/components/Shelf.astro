---
/**
 * Полка работ: проекты стоят корешками, как книги. Пока проектов нет,
 * на полке стоят направления, а рядом — честное пустое состояние.
 */
import type { CollectionEntry } from 'astro:content';
import { categories, categoryLabel } from '@/config/portfolio';
import { url } from '@/lib/url';

interface Props {
  projects: CollectionEntry<'projects'>[];
  headingId?: string;
}
const { projects, headingId = 'work-title' } = Astro.props;

const tone: Record<string, string> = {
  landing: '#c4d5ff',
  business: '#ffffff',
  catalog: '#9dbaff',
  personal: '#e3ebfa',
  concept: '#dbe5ff',
};
const empty = projects.length === 0;
---

<section class="shelf section" aria-labelledby={headingId}>
  <div class="shelf__head" data-stagger>
    <h2 id={headingId} class="head" data-split>Работы</h2>
    <p class="shelf__note">
      {
        empty
          ? 'Кейсы с разбором задачи, решений и ссылкой на живой сайт появятся здесь.'
          : 'Каждый проект — с разбором задачи и ссылкой на работающий сайт.'
      }
    </p>
  </div>

  {
    empty ? (
      <div class="shelf__row">
        <ul class="spines" aria-label="Направления, которые появятся на полке">
          {categories.map((c, i) => (
            <li class="spine spine--idle" style={`--tone:${tone[c.id]}; --i:${i}`} data-reveal>
              <span class="spine__name">{c.label}</span>
              <span class="spine__tag">готовится</span>
            </li>
          ))}
        </ul>
        <div class="shelf__empty" data-reveal style="--i:3">
          <p class="statement">
            Полка наполняется. Пока мой подход лучше покажет разговор о вашей задаче.
          </p>
          <p class="muted">
            Пришлите ссылку на текущий сайт или опишите идею — отвечу с планом, сроками и стоимостью.
          </p>
          <div class="shelf__actions">
            <a class="btn btn--accent" href={url('/contacts/')}>
              Описать задачу <span class="arrow" aria-hidden="true">→</span>
            </a>
            <a class="btn btn--ghost" href={url('/services/')}>
              Тарифы <span class="arrow" aria-hidden="true">→</span>
            </a>
          </div>
        </div>
      </div>
    ) : (
      <ul class="spines spines--full" aria-label="Проекты">
        {projects.map((p, i) => (
          <li data-reveal style={`--i:${i % 10}`}>
            <a class="spine" href={url(`/portfolio/${p.id}/`)} style={`--tone:${tone[p.data.category]}`}>
              <span class="spine__name">{p.data.title}</span>
              <span class="spine__tag">{p.data.isConcept ? 'Концепт' : categoryLabel(p.data.category)}</span>
            </a>
          </li>
        ))}
      </ul>
    )
  }
</section>

<style>
  .shelf__head {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: var(--gap);
    align-items: end;
    margin-bottom: 32px;
  }

  .shelf__head h2 {
    grid-column: 1 / 6;
  }

  .shelf__note {
    grid-column: 6 / 11;
    font-size: var(--step-body);
  }

  .shelf__row {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: var(--gap);
  }

  .spines {
    list-style: none;
    padding: 0;
    display: flex;
    gap: 6px;
    min-height: 440px;
  }

  .shelf__row .spines {
    grid-column: 1 / 7;
  }

  .spines--full {
    flex-wrap: nowrap;
    overflow-x: auto;
  }

  .spines > li {
    display: flex;
  }

  .spine,
  .spines > .spine {
    writing-mode: vertical-rl;
    display: flex;
    gap: 12px;
    align-items: center;
    flex: 1 1 0;
    min-width: 44px;
    padding: 18px 10px;
    border-radius: var(--radius);
    background: var(--surface);
    -webkit-backdrop-filter: var(--glass-blur);
    backdrop-filter: var(--glass-blur);
    box-shadow: inset 0 0 0 1px var(--glass-edge);
    text-decoration: none;
    transition:
      background-color var(--dur) var(--ease-out),
      color var(--dur) var(--ease-out),
      transform var(--dur) var(--ease-out);
  }

  .spines--full > li {
    flex: 0 0 auto;
  }

  .spines--full .spine {
    height: 440px;
    min-width: 64px;
  }

  .spine__name {
    font-family: var(--font-head);
    font-weight: 700;
    font-size: clamp(1.125rem, 0.9rem + 0.7vw, 1.5rem);
    letter-spacing: -0.02em;
  }

  .spine__tag {
    padding: 8px 4px;
    border-radius: 4px;
    background: var(--tone);
    color: var(--paper-ink);
    font-family: var(--font-display);
    font-size: 0.875rem;
    font-weight: 500;
  }

  .spine--idle .spine__tag {
    background: var(--surface-3);
    color: var(--ink);
  }

  .spine--idle:nth-child(odd) {
    background: var(--surface-2);
  }

  a.spine:hover,
  a.spine:focus-visible {
    background: var(--night);
    color: var(--night-ink);
    transform: translateY(-8px);
  }

  .shelf__empty {
    grid-column: 7 / 13;
    display: flex;
    flex-direction: column;
    gap: 18px;
    justify-content: flex-end;
    padding: var(--pad);
    border-radius: var(--radius);
    background: var(--surface-2);
    -webkit-backdrop-filter: var(--glass-blur);
    backdrop-filter: var(--glass-blur);
    box-shadow: inset 0 0 0 1px var(--glass-edge), var(--glass-shadow);
  }

  .shelf__empty .statement {
    font-size: clamp(1.5rem, 1.1rem + 1.2vw, 2.25rem);
    max-width: 22ch;
  }

  .shelf__empty .muted {
    max-width: 48ch;
  }

  .shelf__empty .btn--ghost {
    background: var(--surface-3);
  }

  .shelf__empty .btn--ghost:hover {
    background: #ffffff;
  }

  .shelf__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--gap);
    margin-top: 8px;
  }

  @media (max-width: 1023px) {
    .shelf__head h2 {
      grid-column: 1 / -1;
    }

    .shelf__note {
      grid-column: 1 / -1;
    }

    .shelf__row .spines,
    .shelf__empty {
      grid-column: 1 / -1;
    }

    .shelf__row .spines {
      min-height: 320px;
    }
  }

  @media (max-width: 767px) {
    .shelf__head,
    .shelf__row {
      grid-template-columns: 1fr;
    }

    .spines,
    .spines--full {
      writing-mode: horizontal-tb;
      flex-wrap: wrap;
      min-height: 0;
      gap: 6px;
    }

    .spine,
    .spines > .spine,
    .spines--full .spine {
      writing-mode: horizontal-tb;
      height: auto;
      flex: 1 1 auto;
      min-height: 56px;
      padding: 12px 14px;
      justify-content: space-between;
    }

    .spines--full > li {
      flex: 1 1 100%;
    }

    .spine__tag {
      padding: 4px 8px;
    }
  }
</style>
