---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import Base from '@/layouts/Base.astro';
import SiteStack from '@/components/SiteStack.astro';
import Shelf from '@/components/Shelf.astro';
import ProcessAccordion from '@/components/ProcessAccordion.astro';
import PlanTiles from '@/components/PlanTiles.astro';
import FaqList from '@/components/FaqList.astro';
import ContactBand from '@/components/ContactBand.astro';
import LogoMark from '@/components/LogoMark.astro';
import CaseSelf from '@/components/CaseSelf.astro';
import { site } from '@/config/site';
import { minPrice, formatPrice } from '@/config/pricing';
import { directions, faq } from '@/data/content';
import { url } from '@/lib/url';
import lattice from '@/assets/photos/facade-lattice.jpg';
import concrete from '@/assets/photos/concrete-angle.jpg';
import stepped from '@/assets/photos/stepped-corner.jpg';
import wedge from '@/assets/photos/wedge.jpg';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const homeFaq = faq.filter((f) => f.home);
---

<Base>
  <!-- Первый экран: доска два на два -->
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero__name tile tile--paper">
      <h1 id="hero-title" class="hero__h1">
        <span class="hero__kicker">{site.brand.second}: сайты для бизнеса под ключ — дизайн, код и&nbsp;запуск</span>
        <span class="display hero__word">{site.brand.short}</span>
      </h1>
    </div>

    <div class="hero__stack tile tile--deep tile--bare" data-stack-area>
      <SiteStack />
    </div>

    <div class="hero__photo tile tile--photo" data-shutter>
      <Image
        src={lattice}
        alt="Изогнутый решётчатый фасад здания, чёрно-белая фотография"
        widths={[480, 800, 1200]}
        sizes="(max-width: 767px) 100vw, 50vw"
        loading="eager"
        fetchpriority="high"
      />
      <ul class="hero__tags" aria-label="Что входит в работу">
        <li>Дизайн</li>
        <li>Код</li>
        <li>Запуск</li>
      </ul>
      <span class="hero__ghost" aria-hidden="true">digital</span>
    </div>

    <div class="hero__say tile">
      <p class="statement">
        Проектирую и делаю сайты для бизнеса и специалистов — от лендинга до сложного проекта с 3D и
        анимацией.
      </p>
      <a class="btn btn--accent" href={url('/contacts/')}>
        Обсудить проект <span class="arrow" aria-hidden="true">→</span>
      </a>
    </div>

    <a class="hero__price tile tile--accent" href={url('/services/')}>
      <span class="statement">Цена фиксируется до старта: от&nbsp;{formatPrice(minPrice)}</span>
      <span class="hero__price-link">Смотреть тарифы <span class="arrow" aria-hidden="true">→</span></span>
    </a>
  </section>

  <!-- Подход: плитки-утверждения -->
  <section class="intro section" aria-labelledby="intro-title">
    <div class="intro__slogan tile tile--deep" data-reveal>
      <h2 id="intro-title" class="intro__h">ИИ ускоряет.<br />Решаю я.</h2>
    </div>
    <div class="intro__figure tile tile--paper" data-reveal style="--i:1">
      <p class="intro__num" aria-hidden="true">1:1</p>
      <p class="intro__cap">Вы говорите напрямую с тем, кто делает сайт. Без менеджеров и испорченного телефона.</p>
    </div>
    <div class="intro__photo tile tile--photo" data-reveal style="--i:2">
      <Image src={concrete} alt="Угловатое бетонное здание на фоне чёрного неба" widths={[400, 700]} sizes="(max-width: 767px) 50vw, 33vw" loading="lazy" />
    </div>
    <div class="intro__text">
      <p class="intro__body" data-reveal>
        Нейросети забирают у разработки рутину: черновики, варианты композиции, проверку кода, тесты.
        Освободившееся время уходит на то, что определяет результат: понять ваш бизнес, продумать путь
        клиента от первого экрана до заявки, собрать дизайн, который не спутаешь с шаблоном, и довести
        каждую страницу до быстрой и аккуратной работы на любом экране. Вы получаете не сгенерированную
        страницу, а сайт, спроектированный под вашу задачу, с понятной структурой, чистым кодом и всеми
        доступами. Для вас это значит короче сроки и честную фиксированную цену.
      </p>
    </div>
  </section>

  <Shelf projects={projects} />

  {projects.length === 0 && <CaseSelf />}

  <!-- Направления: мозаика разных плиток -->
  <section class="mosaic section" aria-labelledby="dir-title">
    <div class="mz mz--h tile tile--raised" data-reveal>
      <h2 id="dir-title" class="head">Что я делаю</h2>
      <p class="mz__sub">Сайты, которые объясняют, убеждают и ведут посетителя к заявке.</p>
    </div>
    <div class="mz mz--p tile tile--photo" data-reveal style="--i:1">
      <Image src={stepped} alt="Ступенчатый угол белого здания на фоне неба" widths={[600, 900, 1300]} sizes="(max-width: 767px) 100vw, 50vw" loading="lazy" />
    </div>
    <div class="mz mz--f tile tile--accent" data-reveal style="--i:2">
      <p class="mz__num num">90+</p>
      <p class="mz__cap">баллов Lighthouse по скорости, доступности и SEO — планка, с которой я сдаю сайт.</p>
    </div>
    <div class="mz mz--l tile tile--paper" data-reveal style="--i:3">
      <ul class="mz__list">
        {directions.map((d) => (
          <li>
            <span class="mz__li-name">{d.name}</span>
            <span class="mz__li-text">{d.text}</span>
          </li>
        ))}
      </ul>
    </div>
    <div class="mz mz--a tile tile--deep" data-reveal style="--i:4">
      <p class="mz__say">Версия для телефона — отдельная композиция, а не сжатая копия.</p>
    </div>
    <div class="mz mz--b tile tile--raised" data-reveal style="--i:5">
      <p class="mz__say mz__say--sm">Сайт понятен поисковикам и ИИ-ассистентам.</p>
    </div>
    <div class="mz mz--c tile" data-reveal style="--i:6">
      <p class="mz__say mz__say--sm">Код, домен и доступы остаются у вас.</p>
    </div>
  </section>

  <ProcessAccordion />

  <PlanTiles />

  <!-- Обо мне: широкое фото, цветная плитка, факты -->
  <section class="who section" aria-labelledby="who-title">
    <div class="who__head" data-stagger>
      <h2 id="who-title" class="head">Кто делает сайт</h2>
      <p class="lead">
        Я независимый разработчик, а не агентство с отделами. Проект от первого разговора до запуска веду
        лично, а ИИ-инструменты помогают делать это быстрее и аккуратнее.
      </p>
    </div>
    <div class="who__board">
      <figure class="who__photo" data-reveal>
        <Image src={wedge} alt="Клиновидный угол здания снизу на фоне неба" widths={[700, 1100, 1500]} sizes="(max-width: 1023px) 100vw, 66vw" loading="lazy" />
        <figcaption class="who__note">
          Отвечаю за весь результат: от структуры и текстов до скорости загрузки и того, как сайт выглядит на
          старом телефоне. <a href={url('/about/')}>Подробнее обо мне</a>
        </figcaption>
      </figure>
      <div class="who__side">
        <div class="who__mark tile tile--accent" data-reveal style="--i:1">
          <LogoMark size={120} />
        </div>
        <dl class="who__facts" data-stagger>
          <div><dt>Формат</dt><dd>Удалённо, по всей России</dd></div>
          <div><dt>Связь</dt><dd>Напрямую с разработчиком</dd></div>
          <div><dt>Технологии</dt><dd>Astro, TypeScript, WebGL</dd></div>
          <div><dt>Передача</dt><dd>Код, доступы, инструкция</dd></div>
        </dl>
      </div>
    </div>
  </section>

  <div class="section">
    <FaqList items={homeFaq} headingId="home-faq-title">
      <Fragment slot="side">
        <p>Не нашли ответ? Задайте вопрос в заявке — отвечу лично.</p>
        <a class="btn btn--ghost" href={url('/faq/')} style="justify-self:start">
          Все вопросы <span class="arrow" aria-hidden="true">→</span>
        </a>
      </Fragment>
    </FaqList>
  </div>

  <ContactBand />
</Base>

<style>
  /* --- Первый экран --- */
  .hero {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    grid-template-rows: minmax(300px, 1fr) minmax(260px, 1fr);
    gap: var(--gap);
    margin-top: var(--gap);
    height: calc(100svh - var(--header-h) - var(--margin) * 2 - var(--gap) - var(--banner-h, 0px));
    min-height: 620px;
    max-height: 1000px;
  }

  :global(.page:has(.pv)) {
    --banner-h: 43px;
  }

  .hero .statement {
    font-size: clamp(1.125rem, 0.85rem + 0.65vw, 1.5rem);
  }

  .hero__name {
    grid-column: 1 / 7;
    grid-row: 1;
    display: flex;
  }

  .hero__h1 {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    width: 100%;
    font-weight: inherit;
  }

  .hero__kicker {
    font-family: var(--font-display);
    font-weight: 560;
    font-size: clamp(1.375rem, 0.9rem + 1.2vw, 2.125rem);
    line-height: 1.12;
    letter-spacing: -0.025em;
    max-width: 20ch;
  }

  .hero__word {
    font-size: clamp(4.25rem, 0.5rem + 9.2vw, 10rem);
    margin-left: -0.04em;
  }

  .hero__stack {
    grid-column: 7 / 13;
    grid-row: 1;
  }

  .hero__photo {
    grid-column: 1 / 7;
    grid-row: 2;
  }

  .hero__tags {
    position: absolute;
    top: var(--pad);
    left: var(--pad);
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .hero__tags li {
    padding: 7px 16px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.82);
    color: var(--ink);
    font-family: var(--font-display);
    font-size: 0.875rem;
    font-weight: 600;
  }

  /* Гигантское слово, срезанное нижним краем фото. */
  .hero__ghost {
    position: absolute;
    left: -0.04em;
    bottom: -0.3em;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(6rem, 2rem + 12vw, 15rem);
    line-height: 1;
    letter-spacing: -0.06em;
    color: rgba(235, 235, 232, 0.6);
    mix-blend-mode: overlay;
    pointer-events: none;
    white-space: nowrap;
  }

  .js .hero__photo .hero__ghost {
    transform: translateY(30%);
    transition: transform 1400ms var(--ease-out) 300ms;
  }

  .js .hero__photo.is-in .hero__ghost {
    transform: none;
  }

  .hero__say {
    grid-column: 7 / 10;
    grid-row: 2;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 20px;
  }

  .hero__say .btn {
    align-self: flex-start;
  }

  .hero__price {
    grid-column: 10 / 13;
    grid-row: 2;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 20px;
    text-decoration: none;
    transition: background-color var(--dur-fast) var(--ease-out);
  }

  .hero__price:hover {
    background: var(--accent-hover);
  }

  .hero__price-link {
    font-family: var(--font-display);
    font-weight: 700;
  }

  .hero__price-link .arrow {
    display: inline-block;
    transition: transform var(--dur-fast) var(--ease-out);
  }

  .hero__price:hover .arrow {
    transform: translateX(4px);
  }

  /* --- Подход --- */
  .intro {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    grid-template-rows: minmax(300px, 38svh) minmax(300px, 38svh) auto;
    gap: var(--gap);
  }

  .intro__slogan {
    grid-column: 1 / 9;
    grid-row: 1 / 3;
    display: flex;
    align-items: flex-end;
  }

  .intro__h {
    font-size: clamp(3.5rem, 0.8rem + 7.4vw, 8.25rem);
    line-height: 0.88;
    letter-spacing: -0.05em;
    text-transform: uppercase;
  }

  .intro__figure {
    grid-column: 9 / 13;
    grid-row: 1;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .intro__num {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(4rem, 1rem + 7vw, 8.25rem);
    line-height: 0.85;
    letter-spacing: -0.05em;
  }

  .intro__cap {
    max-width: 30ch;
    font-size: 1.0625rem;
  }

  .intro__photo {
    grid-column: 9 / 13;
    grid-row: 2;
  }

  .intro__text {
    grid-column: 1 / -1;
    grid-row: 3;
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    padding: 40px;
    background: transparent;
  }

  .intro__body {
    grid-column: 6 / 13;
    font-size: clamp(1.1875rem, 1rem + 0.5vw, 1.4375rem);
    line-height: 1.45;
  }

  /* --- Мозаика направлений --- */
  .mosaic {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    grid-auto-rows: 96px;
    gap: var(--gap);
    grid-template-areas:
      'h h h h h h p p p p p p'
      'h h h h h h p p p p p p'
      'h h h h h h p p p p p p'
      'f f f l l l p p p p p p'
      'f f f l l l p p p p p p'
      'f f f l l l a a a a a a'
      'b b b c c c a a a a a a'
      'b b b c c c a a a a a a';
  }

  .mz--h { grid-area: h; display: flex; flex-direction: column; justify-content: space-between; }
  .mz--p { grid-area: p; }
  .mz--f { grid-area: f; display: flex; flex-direction: column; justify-content: space-between; }
  .mz--l { grid-area: l; }
  .mz--a { grid-area: a; }
  .mz--b { grid-area: b; }
  .mz--c { grid-area: c; }

  .mz__sub {
    font-size: var(--step-lead);
    line-height: 1.3;
    max-width: 26ch;
  }

  .mz__num {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(3.5rem, 1rem + 5vw, 6rem);
    line-height: 0.85;
    letter-spacing: -0.05em;
  }

  .mz__cap {
    font-size: 1rem;
    line-height: 1.4;
  }

  .mz__list {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 14px;
  }

  .mz__list li {
    display: grid;
    gap: 2px;
  }

  .mz__li-name {
    font-family: var(--font-display);
    font-weight: 650;
    font-size: clamp(1.0625rem, 0.95rem + 0.4vw, 1.3125rem);
    letter-spacing: -0.02em;
  }

  .mz__li-text {
    font-size: 0.9375rem;
    line-height: 1.35;
    color: var(--paper-muted);
  }

  .mz__say {
    font-family: var(--font-display);
    font-weight: 560;
    font-size: clamp(1.375rem, 1rem + 1vw, 2rem);
    line-height: 1.15;
    letter-spacing: -0.025em;
    max-width: 24ch;
  }

  .mz__say--sm {
    font-size: clamp(1.25rem, 1rem + 0.6vw, 1.625rem);
  }

  /* --- Кто делает сайт --- */
  .who__head {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: var(--gap);
    align-items: end;
  }

  .who__head h2 {
    grid-column: 1 / 6;
  }

  .who__head .lead {
    grid-column: 6 / 13;
  }

  .who__board {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 16px;
    margin-top: 72px;
  }

  .who__photo {
    position: relative;
    grid-column: 1 / 9;
    aspect-ratio: 16 / 10;
    border-radius: var(--radius);
    overflow: hidden;
  }

  .who__photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .who__note {
    position: absolute;
    top: 0;
    right: 0;
    width: 340px;
    padding: 22px;
    background: var(--paper);
    color: var(--paper-ink);
    font-size: 1rem;
    border-bottom-left-radius: var(--radius);
  }

  .who__note a {
    font-family: var(--font-display);
    font-weight: 600;
  }

  .who__side {
    grid-column: 9 / 13;
    display: grid;
    gap: 24px;
    align-content: start;
  }

  .who__mark {
    aspect-ratio: 4 / 3;
    display: grid;
    place-items: center;
  }

  .who__facts {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px 16px;
  }

  .who__facts dt {
    font-size: var(--step-small);
    color: var(--muted);
  }

  .who__facts dd {
    margin-top: 4px;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.0625rem;
    line-height: 1.25;
  }

  /* --- Планшет --- */
  @media (max-width: 1023px) {
    .hero {
      height: auto;
      max-height: none;
      grid-template-rows: 340px 320px auto;
    }

    .hero__name { grid-column: 1 / -1; grid-row: 1; }
    .hero__stack { grid-column: 1 / 7; grid-row: 2; }
    .hero__photo { grid-column: 7 / 13; grid-row: 2; }
    .hero__say { grid-column: 1 / 7; grid-row: 3; min-height: 260px; }
    .hero__price { grid-column: 7 / 13; grid-row: 3; }

    .intro__body {
      grid-column: 1 / -1;
    }

    .intro__slogan {
      grid-column: 1 / -1;
      grid-row: 1;
    }

    .intro__figure {
      grid-column: 1 / 7;
      grid-row: 2;
    }

    .intro__photo {
      grid-column: 7 / 13;
      grid-row: 2;
    }

    .intro__h {
      font-size: clamp(3rem, 9vw, 5.5rem);
    }

    .mosaic {
      grid-auto-rows: auto;
      grid-template-areas:
        'h h h h h h h h h h h h'
        'p p p p p p p p p p p p'
        'f f f f f f l l l l l l'
        'a a a a a a a a a a a a'
        'b b b b b b c c c c c c';
    }

    .mz--h { min-height: 260px; gap: 32px; }
    .mz--p { aspect-ratio: 16 / 9; }
    .mz--f, .mz--l { min-height: 260px; }
    .mz--a { min-height: 200px; }
    .mz--b, .mz--c { min-height: 180px; }

    .who__photo,
    .who__side,
    .who__head h2,
    .who__head .lead {
      grid-column: 1 / -1;
    }

    .who__head {
      gap: 20px;
    }

    .who__side {
      grid-template-columns: 1fr 1fr;
      align-items: start;
    }
  }

  /* --- Телефон --- */
  @media (max-width: 767px) {
    .hero {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-template-rows: auto;
      min-height: 0;
    }

    .hero__name {
      grid-column: 1 / -1;
      grid-row: auto;
      min-height: 46svh;
    }

    .hero__word {
      font-size: 17.5vw;
    }

    .hero__stack {
      grid-column: 1 / -1;
      grid-row: auto;
      min-height: 380px;
    }

    .hero__say {
      grid-column: 1 / -1;
      grid-row: auto;
      min-height: 0;
    }

    .hero__price {
      grid-column: 1 / -1;
      grid-row: auto;
      min-height: 160px;
    }

    .hero__photo {
      grid-column: 1 / -1;
      grid-row: auto;
      aspect-ratio: 4 / 3;
    }

    .intro {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-template-rows: 46svh auto auto;
    }

    .intro__slogan { grid-column: 1 / -1; grid-row: 1; }
    .intro__h { font-size: 9.6vw; }
    .intro__figure { grid-column: 1; grid-row: 2; aspect-ratio: 1; }
    .intro__num { font-size: 18vw; }
    .intro__cap { font-size: 0.9375rem; }
    .intro__photo { grid-column: 2; grid-row: 2; aspect-ratio: 1; }
    .intro__text { grid-column: 1 / -1; grid-row: 3; padding: 20px 4px; display: block; }
    .intro__body { font-size: 1.125rem; }

    .mosaic {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-template-areas:
        'h h'
        'p p'
        'f f'
        'l l'
        'a a'
        'b b'
        'c c';
    }

    .mz--h { min-height: 0; }
    .mz--p { aspect-ratio: 4 / 3; }
    .mz--f, .mz--l { min-height: 0; aspect-ratio: 1; }
    .mz__num { font-size: 15vw; }
    .mz__cap { font-size: 0.875rem; }
    .mz--l { aspect-ratio: auto; }
    .mz--f { aspect-ratio: 2 / 1; }
    .mz__li-text { font-size: 0.875rem; }
