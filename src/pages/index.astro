---
import { getCollection } from 'astro:content';
import Base from '@/layouts/Base.astro';
import HeroNova from '@/components/HeroNova.astro';
import ManifestSplit from '@/components/ManifestSplit.astro';
import WorkFeature from '@/components/WorkFeature.astro';
import ProcessSteps from '@/components/ProcessSteps.astro';
import Packages from '@/components/Packages.astro';
import FaqList from '@/components/FaqList.astro';
import ContactSplit from '@/components/ContactSplit.astro';
import { faq } from '@/data/content';
import { url } from '@/lib/url';
import Icon from '@/components/Icon.astro';

const [featured] = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
// На главной — три главных вопроса, остальные в разделе «Вопросы».
const homeFaq = faq.filter((f) => f.home).slice(0, 3);
const moreFaq = faq.length - homeFaq.length;
const plural = (n: number) =>
  n % 10 === 1 && n % 100 !== 11 ? 'вопрос' : [2, 3, 4].includes(n % 10) && ![12, 13, 14].includes(n % 100) ? 'вопроса' : 'вопросов';
---

<Base>
  <HeroNova />
  {featured && <WorkFeature project={featured} />}
  <Packages />
  <ProcessSteps compact />
  <ManifestSplit owner />

  <div class="section" id="faq" data-island-section="Вопросы">
    <FaqList items={homeFaq} headingId="home-faq-title" openFirst={false}>
      <a slot="after" class="faq__more" href={url('/faq/')}>
        <span class="faq__more-t">
          Ещё {moreFaq} {plural(moreFaq)}
          <small>О договоре, правках, домене и поддержке</small>
        </span>
        <span class="faq__more-i" aria-hidden="true"><Icon name="arrow" /></span>
      </a>
    </FaqList>
  </div>

  <ContactSplit />
</Base>
