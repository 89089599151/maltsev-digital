---
import { getCollection } from 'astro:content';
import Base from '@/layouts/Base.astro';
import HeroRetro from '@/components/HeroRetro.astro';
import ManifestSplit from '@/components/ManifestSplit.astro';
import WorkFeature from '@/components/WorkFeature.astro';
import ServicesGrid from '@/components/ServicesGrid.astro';
import ProcessSteps from '@/components/ProcessSteps.astro';
import PricingCards from '@/components/PricingCards.astro';
import OwnerSplit from '@/components/OwnerSplit.astro';
import FaqList from '@/components/FaqList.astro';
import ContactSplit from '@/components/ContactSplit.astro';
import { faq } from '@/data/content';
import { url } from '@/lib/url';
import Icon from '@/components/Icon.astro';

const [featured] = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const homeFaq = faq.filter((f) => f.home);
---

<Base>
  <HeroRetro />
  <ManifestSplit />
  {featured && <WorkFeature project={featured} />}
  <ServicesGrid />
  <ProcessSteps />
  <PricingCards />
  <OwnerSplit />

  <div class="section" id="faq">
    <FaqList items={homeFaq} headingId="home-faq-title">
      <Fragment slot="side">
        <p>Не нашли ответ? Задайте вопрос в заявке — отвечу лично.</p>
        <a class="btn btn--ghost" href={url('/faq/')} style="justify-self:start">
          Все вопросы <span class="arrow" aria-hidden="true"><Icon name="arrow" /></span>
        </a>
      </Fragment>
    </FaqList>
  </div>

  <ContactSplit />
</Base>
