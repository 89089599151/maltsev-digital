---
import { Image } from 'astro:assets';
import Base from '@/layouts/Base.astro';
import { genImage } from '@/lib/gen';
import ContactLink from '@/components/ContactLink.astro';
import PageHero from '@/components/PageHero.astro';
import ChannelSwitch from '@/components/ChannelSwitch.astro';
import { site, telegramUrl } from '@/config/site';
import { plans, formatPrice } from '@/config/pricing';
import { url } from '@/lib/url';

const endpoint = site.forms.formspreeId ? `https://formspree.io/f/${site.forms.formspreeId}` : '';
// Стеклянная бутылка с посланием: «напишите мне».
const bottle = genImage('contacts-bottle');
---

<Base
  title="Контакты и заявка на разработку сайта"
  description="Оставьте заявку на разработку сайта: пакет и пара слов о задаче. Или напишите напрямую в Telegram или на почту."
>
  <PageHero
    id="ct-title"
    title="Обсудим ваш сайт"
    lead={`Напишите в Telegram или на почту либо оставьте заявку ниже. Отвечу ${site.contacts.responseTime.value} — ${site.contacts.hours}.`}
  >
    <Fragment slot="actions">
      <div class="ct-direct">
        <ContactLink kind="telegram" variant="tile" />
        <ContactLink kind="email" variant="tile" />
      </div>
    </Fragment>
    {bottle && (
      <Image class="ct-object" src={bottle.src} alt="" widths={[320, 480, 640, 900]} sizes="(max-width: 1023px) 60vw, 34vw" quality={80} loading="eager" fetchpriority="high" />
    )}
  </PageHero>

  <div class="ct section section--tight">
    <section class="ct__intro" aria-labelledby="next-title">
      <h2 id="next-title" class="ct__next-title">Что будет после заявки</h2>
      <ol class="ct__steps">
        <li><span class="num" aria-hidden="true">01</span><p><strong>Отвечу</strong> и уточню детали.</p></li>
        <li><span class="num" aria-hidden="true">02</span><p><strong>Пришлю предложение и договор</strong>: состав работ, срок, цена, число правок.</p></li>
        <li><span class="num" aria-hidden="true">03</span><p><strong>Начнём</strong> после подписания и предоплаты. До этого заявка ни к чему не обязывает.</p></li>
      </ol>
    </section>

    <section class="ct__form-wrap tile" aria-labelledby="brief-title">
      <h2 id="brief-title" class="ct__form-title">Заявка</h2>
      <p class="ct__form-sub muted">Обязательны имя, контакт и пара слов о задаче.</p>

      <form class="brief" data-lead-form data-endpoint={endpoint} data-mailto={endpoint ? undefined : site.contacts.email.value} data-telegram={endpoint ? undefined : (telegramUrl() ?? undefined)} method="post" action={endpoint || undefined} novalidate>
        <fieldset class="brief__set">
          <legend class="sr-only">Заявка на разработку сайта</legend>
          <input type="hidden" name="_subject" value="Заявка на разработку сайта" />
          <input type="hidden" name="source" value="Страница контактов" />
          <input type="hidden" name="estimate" value="" data-estimate-field />
          <div class="hp" aria-hidden="true"><input type="text" name="_gotcha" tabindex="-1" autocomplete="off" /></div>

          <div class="row row--2">
            <div class="field fl">
              <label for="f-name" class="fl-label">Имя *</label>
              <input id="f-name" name="name" type="text" autocomplete="name" required minlength="2" placeholder=" " data-error-id="f-name-err" aria-describedby="f-name-err" />
              <span class="field__err" id="f-name-err"></span>
            </div>
            <div class="field fl">
              <label for="f-contact" class="fl-label">Как с вами связаться *</label>
              <input id="f-contact" name="contact" type="text" autocapitalize="off" autocorrect="off" spellcheck="false" required minlength="4" placeholder="Telegram, телефон или почта" data-error-id="f-contact-err" aria-describedby="f-contact-err" />
              <span class="field__err" id="f-contact-err"></span>
            </div>
          </div>

          <fieldset class="field group">
            <legend>Пакет</legend>
            <div class="plans-pick">
              {
                plans.map((p) => (
                  <label class="pick pick--plan">
                    <input type="radio" name="plan" value={p.name} data-plan-id={p.id} />
                    <span>
                      <b>{p.name}</b>
                      <em>{formatPrice(p.price)}</em>
                    </span>
                  </label>
                ))
              }
              <label class="pick pick--plan">
                <input type="radio" name="plan" value="Пока не знаю" data-plan-id="unknown" checked />
                <span>
                  <b>Не знаю</b>
                  <em>Подскажу</em>
                </span>
              </label>
            </div>
          </fieldset>

          <div class="field fl">
            <label for="f-task" class="fl-label">Опишите задачу *</label>
            <textarea id="f-task" name="message" rows="6" required minlength="20" data-error-id="f-task-err" aria-describedby="f-task-hint f-task-err" placeholder="Чем занимаетесь, какой сайт нужен, новый или редизайн. Ссылки на сайты, которые нравятся"></textarea>
            <span class="field__hint" id="f-task-hint" data-count-hint>Хотя бы пара предложений — от 20 символов.</span>
            <span class="field__err" id="f-task-err"></span>
          </div>


          <div class="field">
            <label class="consent">
              <input type="checkbox" name="consent" value="Согласие получено" required data-error-id="f-consent-err" aria-describedby="f-consent-err" />
              <span>Согласен на обработку персональных данных в соответствии с <a href={url('/privacy/')}>политикой конфиденциальности</a> *</span>
            </label>
            <span class="field__err" id="f-consent-err"></span>
          </div>

          {!endpoint && <ChannelSwitch id="brief" />}

          <div class="brief__submit">
            <button class="btn btn--accent" type="submit">
              <span data-label>{endpoint ? 'Отправить заявку' : 'Отправить на почту'}</span>
            </button>
            <p class="brief__status" data-status role="status" aria-live="polite"></p>
            <p class="brief__note">Заявка ни к чему не обязывает. Работу начинаем после договора и предоплаты.</p>
          </div>
        </fieldset>
      </form>

      <div class="brief__success" data-success hidden tabindex="-1">
        <p class="head-sm">Заявка отправлена.</p>
        <p>Спасибо! Я прочитаю заявку и свяжусь с вами {site.contacts.responseTime.value}. Если вопрос срочный — напишите напрямую.</p>
        <a class="btn btn--ghost" href={url('/portfolio/')}>Пока посмотреть работы</a>
      </div>
    </section>
  </div>
</Base>

<script>
  import { initLeadForms } from '@/scripts/forms';
  import { applyBriefParams } from '@/scripts/brief-params';
  applyBriefParams();
  initLeadForms();
</script>

<style>
  .ct {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: clamp(24px, 3vw, 40px);
    margin-top: clamp(48px, 5vw, 72px);
    align-items: start;
  }

  /* Прямые контакты — сразу под текстом первого экрана, две плашки в ряд. */
  .ct-direct {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
    width: min(100%, 680px);
  }

  /* В половинной плашке адрес почты набран мельче, чтобы не переносился. */
  .ct-direct :global(.cl.cl--tile .cl__value) {
    font-size: clamp(0.875rem, 3.7vw, 1.0625rem);
  }

  /* На узком десктопе и планшете плашки встают друг под другом. */
  @media (max-width: 1279px) {
    .ct-direct {
      grid-template-columns: 1fr;
      width: min(100%, 420px);
    }
  }

  .ct-object {
    width: min(100%, 480px);
    height: auto;
    justify-self: center;
    filter: var(--object-shadow);
  }

  /* Слева — три шага после заявки (прилипают при прокрутке длинной формы), справа — сама форма. */
  .ct__intro {
    grid-column: 1 / 5;
    display: grid;
    gap: clamp(20px, 2vw, 28px);
    position: sticky;
    top: calc(var(--header-h) + var(--margin) + var(--gap));
    padding-top: clamp(8px, 1.4vw, 20px);
    padding-right: clamp(0px, 2vw, 32px);
  }

  .ct__next-title,
  .ct__form-title {
    font-weight: 300;
    font-size: var(--fs-4);
    line-height: 1.02;
    letter-spacing: -0.045em;
  }

  .ct__steps {
    list-style: none;
    padding: 0;
    border-top: 1px solid var(--line);
  }

  .ct__steps li {
    display: grid;
    grid-template-columns: 2.4em minmax(0, 1fr);
    gap: 12px;
    align-items: baseline;
    padding-block: 16px;
    border-bottom: 1px solid var(--line);
  }

  .ct__steps .num {
    font-family: var(--font-head);
    font-size: var(--fs-1);
    letter-spacing: -0.04em;
    color: var(--muted);
  }

  .ct__steps strong {
    font-family: var(--font-display);
    font-weight: 500;
  }

  .ct__form-wrap {
    grid-column: 5 / 13;
    padding: clamp(22px, 2.8vw, 44px);
    border-radius: var(--radius-lg);
  }

  .ct__form-sub {
    margin-top: 8px;
  }

  .brief {
    margin-top: 28px;
  }

  .brief__set {
    border: 0;
    padding: 0;
    margin: 0;
    min-width: 0;
    display: grid;
    gap: 22px;
  }

  .brief__set:disabled {
    opacity: 0.6;
  }

  .row--2 {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }

  .field {
    display: grid;
    gap: 8px;
    border: 0;
    padding: 0;
    margin: 0;
    min-width: 0;
  }

  .group legend {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: var(--fs-0);
    padding: 0;
  }

  .group legend {
    margin-bottom: 10px;
  }

  input[type='text'],
  textarea,
  select {
    width: 100%;
    min-height: 60px;
    padding: 26px 22px 8px;
    border: 1.5px solid var(--field-line);
    border-radius: var(--radius-pill);
    background: var(--field);
    color: var(--ink);
    font-family: var(--font-display);
    font-size: var(--fs-0);
    transition:
      border-color var(--dur-fast) var(--ease-out),
      background-color var(--dur-fast) var(--ease-out);
  }

  textarea {
    resize: vertical;
    line-height: 1.5;
    border-radius: var(--radius-sm);
  }

  input[type='text']:hover,
  textarea:hover,
  select:hover {
    border-color: var(--field-line-hover);
  }

  input[type='text']:focus,
  textarea:focus,
  select:focus {
    outline: none;
    border-color: var(--accent);
    background: var(--surface-solid);
    box-shadow: 0 0 0 4px var(--accent-soft);
  }

  [aria-invalid='true'] {
    border-color: var(--danger) !important;
  }

  .field__hint {
    font-size: var(--step-small);
    color: var(--muted);
    transition: color var(--dur-fast) var(--ease-out);
  }

  .field__hint.is-done {
    color: var(--success);
  }

  .field__err {
    font-family: var(--font-display);
    font-size: var(--step-small);
    font-weight: 500;
    color: var(--danger);
  }

  .field__err:empty {
    display: none;
  }

  .plans-pick {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 8px;
  }

  .pick {
    position: relative;
    cursor: pointer;
  }

  .pick input {
    position: absolute;
    inset: 0;
    opacity: 0;
    margin: 0;
    cursor: pointer;
  }

  .pick span {
    display: block;
    min-height: 44px;
    padding: 11px 16px;
    border-radius: var(--radius-pill);
    background: var(--field);
    box-shadow: inset 0 0 0 1px var(--field-line);
    font-family: var(--font-display);
    font-size: var(--step-small);
    font-weight: 500;
    transition: background-color var(--dur-fast) var(--ease-out);
  }

  .pick:hover span {
    box-shadow: inset 0 0 0 1px var(--field-line-hover);
  }

  @media (prefers-reduced-motion: no-preference) {
    .pick input:checked + span {
      animation: choice-pop var(--dur-spring) var(--ease-pop);
    }
  }

  .pick input:checked + span {
    background: var(--surface-solid);
    box-shadow: inset 0 0 0 2px var(--accent);
    color: var(--accent-text);
  }

  .pick input:focus-visible + span {
    outline: 3px solid var(--accent);
    outline-offset: 2px;
  }

  .pick--plan span {
    border-radius: var(--radius-sm);
    display: grid;
    gap: 2px;
    height: 100%;
  }

  .pick--plan b {
    font-weight: 500;
    font-size: var(--step-body);
  }

  .pick--plan em {
    font-style: normal;
    font-size: var(--step-small);
    opacity: 0.8;
  }

  .consent {
    display: flex;
    gap: 12px;
    align-items: flex-start;
    font-family: var(--font-text) !important;
    font-weight: 400 !important;
    cursor: pointer;
  }

  .consent input {
    width: 24px;
    height: 24px;
    flex: none;
    margin-top: 1px;
    accent-color: var(--accent);
  }

  .brief__submit {
    display: grid;
    gap: 12px;
    justify-items: start;
  }

  .brief__submit .btn {
    min-width: 260px;
  }

  .brief__status {
    font-weight: 500;
  }

  .brief__status:empty {
    display: none;
  }

  /* Сразу под кнопкой: на телефоне список «Что будет после заявки» стоит ниже формы. */
  .brief__note {
    max-width: 52ch;
    font-size: var(--step-small);
    color: var(--muted);
  }

  .brief__success {
    margin-top: 28px;
    display: grid;
    gap: 14px;
    justify-items: start;
    padding: var(--pad);
    border-radius: var(--radius);
    background: var(--accent-soft);
    color: var(--ink);
  }

  @media (max-width: 1023px) {
    .ct {
      row-gap: 36px;
    }

    .ct__intro,
    .ct__form-wrap {
      grid-column: 1 / -1;
      position: static;
    }

    /* Без второй колонки бриф — главное на странице — идёт сразу после первого экрана,
       а «Что будет после заявки» — под ним, как ответ на вопрос «а дальше что». */
    .ct__form-wrap {
      order: -1;
    }
  }

  @media (max-width: 767px) {
    .ct {
      grid-template-columns: 1fr;
    }

    .ct-direct,
    .row--2 {
      grid-template-columns: 1fr;
    }

    /* Флакон меньше: на телефоне он не должен отодвигать бриф за второй экран. */
    .ct-object {
      width: min(40vw, 160px);
    }

    .ct-direct :global(.cl.cl--tile) {
      min-height: 80px;
      padding: 16px;
    }

    .plans-pick {
      grid-template-columns: 1fr 1fr;
    }

    .brief__submit .btn {
      width: 100%;
      min-width: 0;
    }
  }
</style>
