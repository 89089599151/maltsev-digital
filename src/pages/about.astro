---
import { Image } from 'astro:assets';
import Base from '@/layouts/Base.astro';
import { site } from '@/config/site';
import { url } from '@/lib/url';
import owner from '@/assets/photos/owner.webp';
import Icon from '@/components/Icon.astro';

const principles = [
  { t: 'Честность вместо витрины', d: 'Только то, что можно проверить. Без выдуманных отзывов, логотипов и цифр.' },
  { t: 'Цена до старта', d: 'Состав работ и сумма фиксируются письменно до начала.' },
  { t: 'Сайт ваш', d: 'Код, домен и доступы передаются вам. Без привязки к конструктору.' },
  { t: 'Скорость — часть дизайна', d: 'Проверяю скорость на каждом этапе: пользоваться сайтом должно быть удобно.' },
  { t: 'Понятный язык', d: 'Объясняю решения без жаргона, чтобы вы понимали, за что платите.' },
];

const aiTasks = [
  'Черновики текстов и заголовков',
  'Варианты структуры и композиции',
  'Рутинный код и рефакторинг',
  'Поиск ошибок и черновые тесты',
  'Варианты изображений',
];

const responsibilities = [
  { t: 'Смысл и дизайн', d: 'Выбираю концепцию, принимаю каждое дизайн-решение и довожу тексты до нужного смысла и тона.' },
  { t: 'Код и проверка', d: 'Продумываю архитектуру, проверяю каждое изменение, тестирую сайт в настоящих браузерах и на телефонах.' },
  { t: 'Изображения', d: 'Отбираю и обрабатываю материалы, проверяю законность их использования.' },
];

const tools = [
  { name: 'Основа сайта', list: 'Astro, TypeScript, HTML и современный CSS', detail: 'Для структуры, быстрого кода и удобной работы на любом экране.' },
  { name: 'Движение', list: 'WebGL и анимации', detail: 'Когда эффект помогает показать идею или объяснить действие.' },
  { name: 'Проверка и запуск', list: 'Playwright, GitHub и автоматическая публикация', detail: 'Для проверки сценариев и предсказуемого обновления сайта.' },
  { name: 'Рабочие задачи', list: 'ИИ-ассистенты, Formspree, Яндекс Метрика', detail: 'Для рутины, приёма заявок и анализа — по задаче проекта.' },
];
---

<Base
  title="Обо мне — независимый веб-разработчик"
  description={`Меня зовут ${site.brand.owner.value}. Я дизайнер по образованию и независимый веб-разработчик: лично веду проект от первого разговора до запуска.`}
>
  <section class="ab-hero" aria-labelledby="ab-title">
    <div class="ab-hero__intro">
      <p class="ab-eyebrow" data-reveal>Обо мне <span aria-hidden="true">/</span> Личный подход</p>
      <h1 id="ab-title" class="ab-hero__name" data-split>
        {site.brand.owner.value.split(' ').map((part, index) => <span class:list={['ab-name-part', { 'ab-accent': index > 0 }]}>{part}{' '}</span>)}
      </h1>
      <p class="ab-hero__role" data-reveal>Дизайнер по образованию.<br />Делаю сайты целиком.</p>
      <p class="ab-hero__lead" data-reveal>
        Разговариваю с вами, проектирую, рисую дизайн, пишу код и запускаю.
        На каждом этапе вы общаетесь со мной напрямую.
      </p>
      <div class="ab-actions" data-reveal>
        <a class="btn btn--accent" href={url('/contacts/')}>
          Обсудить ваш сайт <span class="arrow" aria-hidden="true"><Icon name="arrow" /></span>
        </a>
        <a class="ab-text-link" href={url('/portfolio/')}>
          Посмотреть работу <Icon name="arrow-ne" />
        </a>
      </div>

      <div class="ab-signature" data-reveal="wipe">
        <svg class="ab-signature__drawing" viewBox="0 0 600 240" fill="none" aria-hidden="true" focusable="false">
          <ellipse cx="452" cy="78" rx="183" ry="126" transform="rotate(-31 452 78)" />
          <ellipse cx="452" cy="78" rx="141" ry="88" transform="rotate(-31 452 78)" />
          <path d="M260 170 547 0M349 214 590 69" />
          <circle cx="323" cy="129" r="8" class="ab-signature__point" />
          <circle cx="529" cy="32" r="5" class="ab-signature__point" />
        </svg>
        <p class="ab-signature__note">Один проект. Весь контекст.</p>
        <p class="ab-signature__title">Дизайн + код</p>
        <div class="ab-signature__route">
          <span>Идея</span><span aria-hidden="true">↗</span><span>Дизайн</span><span aria-hidden="true">↗</span><span>Код</span><span aria-hidden="true">↗</span><span>Запуск</span>
        </div>
      </div>
    </div>

    <figure class="ab-portrait" data-reveal="rise">
      <Image
        src={owner}
        alt={`${site.brand.owner.value} смотрит вверх на свет фонаря, вокруг идёт снег`}
        widths={[480, 800, 1200]}
        sizes="(max-width: 767px) calc(100vw - 32px), (max-width: 1023px) 46vw, 44vw"
        loading="eager"
        fetchpriority="high"
      />
      <span class="ab-portrait__mark" aria-hidden="true">MALTSEV DIGITAL <span>↗</span></span>
      <figcaption class="ab-portrait__caption">
        <span class="ab-portrait__caption-label">Без отделов и посредников</span>
        <p>На связи — тот,<br />кто делает сайт.</p>
      </figcaption>
    </figure>
  </section>

  <section class="section ab-method" aria-labelledby="ab-method-title">
    <div class="ab-method__orb" aria-hidden="true"></div>
    <div class="ab-method__heading" data-reveal>
      <p class="ab-eyebrow">01 <span aria-hidden="true">/</span> Как я работаю</p>
      <h2 id="ab-method-title">От разговора<br />до запуска —<br /><span>со мной.</span></h2>
    </div>
    <div class="ab-method__body" data-stagger>
      <p class="ab-method__lead">Один человек помнит всю историю проекта.</p>
      <p>
        Вы рассказываете о бизнесе тому, кто потом собирает сайт. Я сохраняю контекст от первой задачи
        до последней проверки — и могу объяснить, почему решение выглядит и работает именно так.
      </p>
      <p>
        Меньше передач между людьми и согласований. Часть рутины берут на себя ИИ-инструменты,
        а у меня остаётся больше внимания к вашему проекту.
      </p>
    </div>
    <ol class="ab-method__route" data-stagger>
      <li><span class="ab-method__number">01</span><span>Разобраться<br />в задаче</span></li>
      <li><span class="ab-method__number">02</span><span>Найти форму<br />и структуру</span></li>
      <li><span class="ab-method__number">03</span><span>Собрать<br />и проверить</span></li>
      <li><span class="ab-method__number">04</span><span>Запустить<br />и передать</span></li>
    </ol>
  </section>

  <section class="section ab-ai" aria-labelledby="ab-ai-title">
    <div class="ab-section-head">
      <div>
        <p class="ab-eyebrow" data-reveal>02 <span aria-hidden="true">/</span> ИИ в работе</p>
        <h2 id="ab-ai-title" class="ab-section-title" data-split>ИИ ускоряет работу.<br /><span class="ab-accent">Решения принимаю я.</span></h2>
      </div>
      <p data-reveal>Не скрываю инструменты. И не перекладываю на них ответственность за ваш сайт.</p>
    </div>

    <div class="ab-ai__roles">
      <div class="ab-ai__assistant" data-reveal>
        <svg class="ab-ai__symbol" viewBox="0 0 80 80" fill="none" aria-hidden="true" focusable="false">
          <path d="M40 5v70M5 40h70M15 15l50 50M15 65l50-50" />
        </svg>
        <p class="ab-eyebrow">Инструмент</p>
        <h3>Помогает<br />с рутиной</h3>
        <p class="ab-ai__intro">ИИ готовит материал, с которым можно работать дальше:</p>
        <ul>
          {aiTasks.map((task) => <li>{task}</li>)}
        </ul>
      </div>

      <div class="ab-ai__author" data-reveal>
        <p class="ab-eyebrow">Автор и исполнитель</p>
        <h3>Я отвечаю<br />за результат</h3>
        <div class="ab-ai__responsibilities">
          {responsibilities.map((item) => (
            <div>
              <h4>{item.t}</h4>
              <p>{item.d}</p>
            </div>
          ))}
        </div>
        <p class="ab-ai__conclusion"><span aria-hidden="true"><Icon name="check" /></span> Любой результат ИИ проходит мой отбор и проверку.</p>
      </div>
    </div>
  </section>

  <section class="section ab-principles" aria-labelledby="ab-principles-title">
    <div class="ab-section-head">
      <div>
        <p class="ab-eyebrow" data-reveal>03 <span aria-hidden="true">/</span> Принципы</p>
        <h2 id="ab-principles-title" class="ab-section-title" data-split>Работа, в которой<br />всё понятно.</h2>
      </div>
      <p data-reveal>Пять вещей, на которые можно опереться с первого разговора.</p>
    </div>
    <ol class="ab-principles__list" data-stagger>
      {principles.map((principle, index) => (
        <li>
          <span class="ab-principles__number" aria-hidden="true">0{index + 1}</span>
          <h3>{principle.t}</h3>
          <p>{principle.d}</p>
        </li>
      ))}
    </ol>
  </section>

  <section class="section ab-evidence" aria-labelledby="ab-proof-title">
    <div class="ab-proof" data-reveal>
      <p class="ab-eyebrow">04 <span aria-hidden="true">/</span> Честно о портфолио</p>
      <div class="ab-proof__graphic" aria-hidden="true"><span>↗</span></div>
      <h2 id="ab-proof-title">Первый кейс —<br />прямо перед вами.</h2>
      <p>
        Здесь пока нет отзывов, логотипов клиентов и больших цифр. Я не стану их выдумывать.
        Каждый новый проект появится с разбором и ссылкой на живой сайт.
      </p>
      <p>А пока судите по этому сайту: он сделан тем же способом, каким я сделаю ваш.</p>
      <a class="ab-proof__link" href={url('/portfolio/maltsev-digital/')}>
        Как сделан этот сайт <span aria-hidden="true"><Icon name="arrow-ne" /></span>
      </a>
    </div>
    <div class="ab-tools">
      <p class="ab-eyebrow" data-reveal>Мой рабочий набор</p>
      <h2 class="ab-tools__title" data-reveal>Инструменты<br />под задачу.</h2>
      <dl class="ab-tools__list" data-stagger>
        {tools.map((tool) => (
          <div>
            <dt>{tool.name}</dt>
            <dd><strong>{tool.list}</strong><p>{tool.detail}</p></dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <section class="section ab-cta" aria-labelledby="ab-cta-title">
    <div>
      <p class="ab-eyebrow" data-reveal>Следующий шаг</p>
      <h2 id="ab-cta-title" data-split>Теперь —<br /><span class="ab-accent">о вашем проекте.</span></h2>
    </div>
    <div class="ab-cta__body" data-reveal>
      <p>Расскажите о бизнесе и о том, какой сайт нужен. Начнём с разговора — он ни к чему не обязывает.</p>
      <div class="ab-actions">
        <a class="btn btn--accent" href={url('/contacts/')}>
          Давайте познакомимся <span class="arrow" aria-hidden="true"><Icon name="arrow" /></span>
        </a>
        <a class="ab-text-link" href={url('/services/')}>
          Тарифы и сроки <Icon name="arrow-ne" />
        </a>
      </div>
    </div>
  </section>
</Base>

<style>
  .ab-eyebrow {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 10px;
    color: var(--muted);
    font-size: var(--fs-xs);
    font-weight: 550;
    letter-spacing: 0.04em;
    line-height: 1.4;
    text-transform: uppercase;
  }
  .ab-eyebrow > span { color: var(--accent-text); }

  .ab-hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 0.96fr);
    gap: clamp(24px, 3.8vw, 60px);
    margin-top: clamp(24px, 3vw, 48px);
  }
  .ab-hero__intro { display: flex; flex-direction: column; align-items: flex-start; min-width: 0; padding-top: clamp(8px, 1.8vw, 28px); }
  .ab-hero__name { margin-top: 28px; font-size: var(--fs-6); font-weight: 390; line-height: 0.96; letter-spacing: -0.065em; }
  .ab-name-part { display: block; }
  .ab-accent { color: var(--accent-text); }
  .ab-hero__role { margin-top: 28px; font-size: var(--fs-2); line-height: 1.25; letter-spacing: -0.025em; }
  .ab-hero__lead { max-width: 40ch; margin-top: 16px; color: var(--ink-2); font-size: var(--fs-0); line-height: 1.55; }
  .ab-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 24px; margin-top: 26px; }
  .ab-text-link { display: inline-flex; align-items: center; gap: 12px; min-height: 48px; font-size: var(--step-small); font-weight: 550; text-decoration: none; transition: color var(--dur-fast) var(--ease-out); }
  .ab-text-link:hover { color: var(--accent-text); }

  .ab-signature {
    position: relative;
    isolation: isolate;
    width: 100%;
    min-height: 172px;
    margin-top: 36px;
    padding: 24px;
    overflow: hidden;
    border-radius: var(--radius);
    background-color: var(--accent-soft);
    background-image:
      linear-gradient(rgba(26, 47, 251, 0.08) 1px, transparent 1px),
      linear-gradient(90deg, rgba(26, 47, 251, 0.08) 1px, transparent 1px);
    background-size: 36px 36px;
    color: var(--accent-text);
  }
  .ab-signature__drawing { position: absolute; z-index: -1; inset: 0; width: 100%; height: 100%; max-width: none; stroke: rgba(26, 47, 251, 0.45); stroke-width: 1; transition: transform var(--dur-slow) var(--ease-out); }
  .ab-signature__point { fill: var(--accent); stroke: var(--accent-soft); stroke-width: 4; }
  .ab-signature__note { font-size: var(--fs-xs); color: var(--ink-2); }
  .ab-signature__title { margin-top: 18px; font-size: var(--fs-3); letter-spacing: -0.035em; line-height: 1.1; }
  .ab-signature__route { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 14px; font-size: var(--fs-xs); }
  .ab-signature__route > span:nth-child(even) { color: var(--accent-text); }

  .ab-portrait { position: relative; min-height: 670px; overflow: hidden; isolation: isolate; border-radius: var(--radius-lg); background: var(--surface-2); }
  .ab-portrait img { position: absolute; z-index: -2; width: 100%; height: 100%; object-fit: cover; object-position: 51% 50%; transition: transform 1200ms var(--ease-out); }
  .ab-portrait__mark { position: absolute; inset: 24px 24px auto; display: flex; justify-content: space-between; gap: 20px; padding: 10px 14px; border-radius: 12px; background: var(--paper); color: var(--ink); font-size: var(--fs-xs); font-weight: 550; letter-spacing: 0.06em; }
  .ab-portrait__caption { position: absolute; right: 24px; bottom: 24px; left: 24px; padding: 24px; border-radius: var(--radius); background: var(--paper); color: var(--paper-ink); box-shadow: var(--glass-shadow); }
  .ab-portrait__caption-label { font-size: var(--fs-xs); color: var(--paper-muted); }
  .ab-portrait__caption p { margin-top: 12px; font-size: var(--fs-3); line-height: 1.12; letter-spacing: -0.035em; }

  .ab-method {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 44px clamp(32px, 6vw, 96px);
    padding: clamp(28px, 4.2vw, 64px);
    overflow: hidden;
    isolation: isolate;
    border-radius: var(--radius-lg);
    background: radial-gradient(ellipse at 100% 0%, var(--paper), transparent 60%), var(--surface);
    color: var(--ink);
  }
  .ab-method__orb { position: absolute; z-index: -1; top: -240px; right: -120px; width: 550px; aspect-ratio: 1; border: 1px solid rgba(26, 47, 251, 0.15); border-radius: 50%; box-shadow: 0 0 0 70px rgba(26, 47, 251, 0.025), 0 0 0 140px rgba(26, 47, 251, 0.02); }
  .ab-method h2 { margin-top: 32px; font-size: var(--fs-5); line-height: 1.04; }
  .ab-method h2 > span { color: var(--accent-text); }
  .ab-method__body { align-self: end; color: var(--muted); font-size: var(--fs-0); }
  .ab-method__body > p + p { margin-top: 18px; }
  .ab-method__body .ab-method__lead { color: var(--ink); font-size: var(--fs-2); line-height: 1.3; letter-spacing: -0.025em; }
  .ab-method__route { display: grid; grid-column: 1 / -1; grid-template-columns: repeat(4, minmax(0, 1fr)); padding: 0; list-style: none; }
  .ab-method__route > li { position: relative; display: grid; gap: 14px; padding-top: 22px; padding-right: 18px; border-top: 1px solid var(--line); font-size: var(--fs-0); line-height: 1.35; }
  .ab-method__route > li::before { position: absolute; top: -4px; width: 7px; height: 7px; border-radius: 50%; background: var(--accent); content: ''; }
  .ab-method__number { color: var(--accent-text); font-size: var(--fs-xs); }

  .ab-section-head { display: grid; grid-template-columns: minmax(0, 1.45fr) minmax(0, 0.7fr); align-items: end; gap: 28px clamp(32px, 5vw, 80px); margin-bottom: 36px; }
  .ab-section-title { margin-top: 24px; font-size: var(--fs-5); line-height: 1.06; }
  .ab-section-head > p { max-width: 32ch; color: var(--muted); font-size: var(--fs-0); }

  .ab-ai__roles { display: grid; grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr); gap: var(--gap); }
  .ab-ai__assistant, .ab-ai__author { padding: clamp(28px, 3.2vw, 48px); border-radius: var(--radius-lg); }
  .ab-ai__assistant { position: relative; overflow: hidden; background: var(--accent-soft); }
  .ab-ai__assistant .ab-eyebrow { position: relative; color: var(--accent-text); }
  .ab-ai__symbol { position: absolute; top: 12px; right: 22px; width: var(--fs-6); height: var(--fs-6); color: var(--accent); stroke: currentColor; stroke-width: 1.5; }
  .ab-ai h3 { margin-top: 28px; font-size: var(--fs-4); font-weight: 420; line-height: 1.05; }
  .ab-ai__intro { max-width: 28ch; margin-top: 24px; color: var(--ink-2); font-size: var(--fs-0); }
  .ab-ai__assistant ul { display: grid; gap: 14px; margin-top: 28px; padding: 0; list-style: none; }
  .ab-ai__assistant li { position: relative; padding-left: 21px; color: var(--ink-2); font-size: var(--step-small); line-height: 1.4; }
  .ab-ai__assistant li::before { position: absolute; top: 0.52em; left: 0; width: 5px; height: 5px; border-radius: 50%; background: var(--accent); content: ''; }
  .ab-ai__author { background: var(--night); color: var(--night-ink); }
  .ab-ai__author .ab-eyebrow { color: var(--night-muted); }
  .ab-ai__responsibilities { display: grid; gap: 22px; margin-top: 32px; }
  .ab-ai__responsibilities > div { display: grid; grid-template-columns: minmax(0, 0.65fr) minmax(0, 1.35fr); gap: 18px; padding-top: 18px; border-top: 1px solid rgba(255,255,255,.18); }
  .ab-ai__responsibilities h4 { font-size: var(--fs-0); font-weight: 550; line-height: 1.35; letter-spacing: -0.015em; }
  .ab-ai__responsibilities p { color: var(--night-muted); font-size: var(--step-small); line-height: 1.5; }
  .ab-ai__conclusion { display: flex; align-items: flex-start; gap: 12px; margin-top: 28px; color: var(--accent-on-dark); font-size: var(--step-small); line-height: 1.4; }
  .ab-ai__conclusion > span { flex: none; padding-top: 2px; }

  .ab-principles__list { padding: 0; list-style: none; border-top: 1px solid var(--line); }
  .ab-principles__list > li { display: grid; grid-template-columns: 52px minmax(0, 0.95fr) minmax(0, 1fr); gap: 28px; align-items: baseline; padding: 28px 0; border-bottom: 1px solid var(--line); }
  .ab-principles__number { color: var(--accent-text); font-size: var(--fs-xs); font-variant-numeric: tabular-nums; }
  .ab-principles__list h3 { font-size: var(--fs-2); font-weight: 450; line-height: 1.2; }
  .ab-principles__list p { max-width: 48ch; color: var(--muted); font-size: var(--fs-0); }

  .ab-evidence { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 0.94fr); gap: clamp(32px, 5vw, 80px); align-items: start; }
  .ab-proof { position: relative; display: flex; flex-direction: column; align-items: flex-start; padding: clamp(28px, 3.6vw, 54px); overflow: hidden; isolation: isolate; border: 1px solid var(--line); border-radius: var(--radius-lg); background: var(--paper); color: var(--paper-ink); }
  .ab-proof__graphic { position: relative; display: grid; width: 150px; height: 100px; place-items: center; margin-top: 28px; }
  .ab-proof__graphic::before, .ab-proof__graphic::after { position: absolute; inset: 6px -2px; border: 1px solid rgba(26, 47, 251, 0.3); border-radius: 50%; transform: rotate(-25deg); content: ''; }
  .ab-proof__graphic::after { inset: 6px 22px; transform: rotate(25deg); }
  .ab-proof__graphic > span { color: var(--accent-text); font-size: var(--fs-5); line-height: 1; }
