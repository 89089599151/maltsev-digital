---
/**
 * «Обо мне»: кто делает сайт и почему один, три принципа, честная оговорка о портфолио и инструменты.
 * Все блоки — обычные разделы сайта: заголовок слева, текст или строки под линиями справа.
 */
import { Image } from 'astro:assets';
import Base from '@/layouts/Base.astro';
import PageHero from '@/components/PageHero.astro';
import CtaBand from '@/components/CtaBand.astro';
import Icon from '@/components/Icon.astro';
import { site } from '@/config/site';
import { url } from '@/lib/url';
import owner from '@/assets/photos/owner.webp';

const principles = [
  { t: 'Только проверяемые факты', d: 'Без выдуманных отзывов, логотипов и цифр.' },
  { t: 'Цена до старта', d: 'Состав работ и сумма фиксируются письменно до начала.' },
  { t: 'Быстрая загрузка', d: 'Проверяю скорость на телефоне на каждом этапе, цель — 90+ в тесте Google.' },
];

const tools = [
  { name: 'Основа сайта', list: 'Astro, TypeScript, HTML и современный CSS' },
  { name: 'Проверка и запуск', list: 'Playwright, GitHub и автоматическая публикация' },
  { name: 'Рабочие задачи', list: 'ИИ-ассистенты, Яндекс Метрика' },
];
---

<Base
  title="Обо мне — независимый веб-разработчик"
  description={`Меня зовут ${site.brand.owner.value}. Я дизайнер по образованию и независимый веб-разработчик: лично веду проект от первого разговора до запуска.`}
>
  <PageHero
    id="ab-title"
    title={site.brand.owner.value}
    lead="Дизайнер по образованию. Делаю сайты целиком: разговариваю с вами, проектирую, рисую, пишу код и запускаю."
  >
    <Fragment slot="actions">
      <div class="ab-actions">
        <a class="btn btn--ink" href={url('/contacts/')}>
          Обсудить проект
        </a>
        <a class="btn btn--ghost" href={url('/portfolio/maltsev-digital/')}>Смотреть кейс</a>
      </div>
    </Fragment>
    <Image
      class="ab-photo"
      src={owner}
      alt={`${site.brand.owner.value} смотрит вверх на свет фонаря, вокруг идёт снег`}
      widths={[480, 800, 1200]}
      sizes="(max-width: 1023px) calc(100vw - 72px), 36vw"
      loading="eager"
      fetchpriority="high"
    />
  </PageHero>

  <section class="section split" data-island-section="Почему один" aria-labelledby="ab-why">
    <h2 id="ab-why" class="head">Почему один</h2>
    <div class="ab-prose">
      <p class="ab-prose__lead">Один человек помнит всю историю проекта.</p>
      <p>
        В агентстве между вами и тем, кто делает сайт, стоят менеджер, дизайнер, верстальщик и тестировщик.
        Каждый передаёт задачу следующему, и часть смысла теряется по дороге.
      </p>
      <p>
        Я веду проект сам и могу объяснить каждое решение. Лендинг занимает 7–10 рабочих дней,
        индивидуальный проект — 5–7 недель.
      </p>
    </div>
  </section>

  <section class="section split" data-island-section="Принципы" aria-labelledby="ab-principles">
    <h2 id="ab-principles" class="head">Принципы</h2>
    <ul class="rows">
      {
        principles.map((p) => (
          <li>
            <h3 class="rows__k">{p.t}</h3>
            <p class="rows__v">{p.d}</p>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="section split" data-island-section="Портфолио" aria-labelledby="ab-honest">
    <h2 id="ab-honest" class="head">Чего здесь пока нет</h2>
    <div class="ab-prose">
      <p>
        Отзывов, логотипов клиентов и больших цифр. Я не стану их выдумывать: каждый новый проект появится
        с разбором и ссылкой на живой сайт.
      </p>
      <p>А пока судите по этому сайту — он сделан так же, как будет сделан ваш.</p>
      <a class="ab-link" href={url('/portfolio/maltsev-digital/')}>
        Как сделан этот сайт <span class="arrow" aria-hidden="true"><Icon name="arrow" /></span>
      </a>
    </div>
  </section>

  <section class="section split" data-island-section="Инструменты" aria-labelledby="ab-tools">
    <h2 id="ab-tools" class="head">Инструменты</h2>
    <dl class="rows">
      {
        tools.map((t) => (
          <div>
            <dt class="rows__k">{t.name}</dt>
            <dd class="rows__v">{t.list}</dd>
          </div>
        ))
      }
    </dl>
  </section>

  <CtaBand
    id="ab-cta-title"
    title="Теперь — о вашем проекте"
    text="Расскажите о бизнесе и о том, какой сайт нужен. Начнём с разговора — он ни к чему не обязывает."
    action={{ href: url('/contacts/'), label: 'Обсудить проект' }}
    more={{ href: url('/services/'), label: 'Пакеты и сроки' }}
  />
</Base>

<style>
  .ab-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  /* На телефоне две кнопки одной ширины, друг под другом. */
  @media (max-width: 767px) {
    .ab-actions :global(.btn) {
      flex: 1 1 100%;
    }
  }

  .ab-photo {
    width: 100%;
    max-width: 440px;
    height: auto;
    aspect-ratio: 4 / 5;
    justify-self: end;
    border-radius: calc(var(--radius-lg) - 8px);
    object-fit: cover;
    object-position: 50% 30%;
  }

  .ab-prose {
    display: grid;
    gap: 1em;
    justify-items: start;
    max-width: 60ch;
    color: var(--ink-2);
  }

  .ab-prose__lead {
    font-size: var(--fs-2);
    line-height: 1.25;
    letter-spacing: -0.025em;
    color: var(--ink);
  }

  /* Ссылка — как ссылки разделов: текст со стрелкой, при наведении синеет. */
  .ab-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    font-weight: 500;
    color: var(--ink);
    text-decoration: none;
    transition: color var(--dur-fast) var(--ease-out);
  }

  .ab-link:is(:hover, :focus-visible) {
    color: var(--accent-text);
  }

  @media (max-width: 1023px) {
    .ab-photo {
      justify-self: start;
      max-width: 520px;
      aspect-ratio: 4 / 3;
    }
  }
</style>
