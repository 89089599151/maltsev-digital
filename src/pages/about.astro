---
/**
 * «Обо мне»: кто делает сайт и почему один, как устроена работа с ИИ, принципы,
 * честная оговорка о портфолио и инструменты. Те же блоки и поверхности, что на остальных страницах.
 */
import { Image } from 'astro:assets';
import Base from '@/layouts/Base.astro';
import PageHero from '@/components/PageHero.astro';
import ManifestSplit from '@/components/ManifestSplit.astro';
import CtaBand from '@/components/CtaBand.astro';
import Icon from '@/components/Icon.astro';
import { site } from '@/config/site';
import { url } from '@/lib/url';
import owner from '@/assets/photos/owner.webp';

const principles = [
  { t: 'Честность вместо витрины', d: 'Только то, что можно проверить. Без выдуманных отзывов, логотипов и цифр.' },
  { t: 'Цена до старта', d: 'Состав работ и сумма фиксируются письменно до начала.' },
  { t: 'Сайт ваш', d: 'Код, домен и доступы передаются вам. Без привязки к конструктору.' },
  { t: 'Скорость — часть дизайна', d: 'Проверяю скорость на каждом этапе: пользоваться сайтом должно быть удобно.' },
  { t: 'Понятный язык', d: 'Объясняю решения без жаргона, чтобы вы понимали, за что платите.' },
];

const tools = [
  { name: 'Основа сайта', list: 'Astro, TypeScript, HTML и современный CSS' },
  { name: 'Проверка и запуск', list: 'Playwright, GitHub и автоматическая публикация' },
  { name: 'Рабочие задачи', list: 'ИИ-ассистенты, Яндекс Метрика' },
];
---

<Base
  title="Обо мне — независимый веб-разработчик"
  description={`Меня зовут ${site.brand.owner.value}. Я дизайнер по образованию и независимый веб-разработчик: лично веду проект от первого разговора до запуска.`}
>
  <PageHero
    id="ab-title"
    title={site.brand.owner.value}
    lead="Дизайнер по образованию. Делаю сайты целиком: разговариваю с вами, проектирую, рисую, пишу код и запускаю."
  >
    <Fragment slot="actions">
      <div class="ab-actions">
        <a class="btn btn--ink" href={url('/contacts/')}>
          Обсудить проект <span class="arrow" aria-hidden="true"><Icon name="arrow" /></span>
        </a>
        <a class="btn btn--ghost" href={url('/portfolio/')}>Смотреть кейс</a>
      </div>
    </Fragment>
    <Image
      class="ab-photo"
      src={owner}
      alt={`${site.brand.owner.value} смотрит вверх на свет фонаря, вокруг идёт снег`}
      widths={[480, 800, 1200]}
      sizes="(max-width: 1023px) calc(100vw - 72px), 36vw"
      loading="eager"
      fetchpriority="high"
    />
  </PageHero>

  <section class="section split" data-island-section="Почему один" aria-labelledby="ab-why">
    <h2 id="ab-why" class="head" data-split>Почему один</h2>
    <div class="ab-prose" data-stagger>
      <p class="ab-prose__lead">Один человек помнит всю историю проекта.</p>
      <p>
        В агентстве между вами и тем, кто делает сайт, стоят менеджер, дизайнер, верстальщик и тестировщик.
        Каждый передаёт задачу следующему, и часть смысла теряется по дороге.
      </p>
      <p>
        Я веду проект сам и могу объяснить, почему каждое решение выглядит и работает именно так. Рутину
        берут на себя ИИ-инструменты — поэтому индивидуальный сайт занимает недели, а не месяцы.
      </p>
    </div>
  </section>

  <ManifestSplit />

  <section class="section split" data-island-section="Принципы" aria-labelledby="ab-principles">
    <h2 id="ab-principles" class="head" data-split>Принципы</h2>
    <ul class="rows" data-stagger>
      {
        principles.map((p) => (
          <li>
            <h3 class="rows__k">{p.t}</h3>
            <p class="rows__v">{p.d}</p>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="section ab-pair" aria-label="О портфолио и инструментах">
    <article class="ab-card" aria-labelledby="ab-honest" data-reveal>
      <h2 id="ab-honest" class="ab-card__title">Чего здесь пока нет</h2>
      <p>
        Отзывов, логотипов клиентов и больших цифр. Я не стану их выдумывать: каждый новый проект появится
        с разбором и ссылкой на живой сайт.
      </p>
      <p>А пока судите по этому сайту — он сделан так же, как будет сделан ваш.</p>
      <a class="ab-card__link" href={url('/portfolio/maltsev-digital/')}>
        Как сделан этот сайт <span class="arrow" aria-hidden="true"><Icon name="arrow" /></span>
      </a>
    </article>

    <article class="ab-card" aria-labelledby="ab-tools" data-reveal style="--i:1">
      <h2 id="ab-tools" class="ab-card__title">Инструменты</h2>
      <dl class="ab-tools">
        {
          tools.map((t) => (
            <div>
              <dt>{t.name}</dt>
              <dd>{t.list}</dd>
            </div>
          ))
        }
      </dl>
    </article>
  </section>

  <CtaBand
    id="ab-cta-title"
    title="Теперь — о вашем проекте"
    text="Расскажите о бизнесе и о том, какой сайт нужен. Начнём с разговора — он ни к чему не обязывает."
    action={{ href: url('/contacts/'), label: 'Обсудить проект' }}
    more={{ href: url('/services/'), label: 'Пакеты и сроки' }}
  />
</Base>

<style>
  .ab-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .ab-photo {
    width: 100%;
    max-width: 440px;
    height: auto;
    aspect-ratio: 4 / 5;
    justify-self: end;
    border-radius: calc(var(--radius-lg) - 8px);
    object-fit: cover;
    object-position: 50% 30%;
  }

  .ab-prose {
    display: grid;
    gap: 1em;
    max-width: 60ch;
    color: var(--ink-2);
  }

  .ab-prose__lead {
    font-size: var(--fs-2);
    line-height: 1.25;
    letter-spacing: -0.025em;
    color: var(--ink);
  }

  .ab-pair {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: var(--gap);
  }

  .ab-card {
    display: grid;
    gap: 16px;
    align-content: start;
    justify-items: start;
    padding: clamp(24px, 3vw, 44px);
    border-radius: var(--radius-lg);
    background: var(--paper);
  }

  .ab-card__title {
    margin-bottom: 8px;
    font-size: var(--fs-4);
    line-height: 1.02;
    letter-spacing: -0.045em;
  }

  .ab-card p {
    max-width: 52ch;
    color: var(--ink-2);
  }

  .ab-card__link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    margin-top: 4px;
    font-family: var(--font-display);
    font-weight: 550;
    text-decoration: none;
    border-bottom: 1.5px solid var(--accent);
  }

  .ab-card__link .arrow {
    transition: transform var(--dur-fast) var(--ease-out);
  }

  .ab-tools {
    width: 100%;
    border-top: 1px solid var(--line);
  }

  .ab-tools div {
    display: grid;
    gap: 2px;
    padding-block: 14px;
    border-bottom: 1px solid var(--line);
  }

  .ab-tools dt {
    font-size: var(--fs-xs);
    color: var(--muted);
  }

  .ab-tools dd {
    font-family: var(--font-display);
    font-weight: 500;
    line-height: 1.35;
  }

  @media (max-width: 1023px) {
    .ab-pair {
      grid-template-columns: 1fr;
    }

    .ab-photo {
      justify-self: start;
      max-width: 520px;
      aspect-ratio: 4 / 3;
    }
  }

  @media (max-width: 767px) {
    .ab-card {
      border-radius: 24px;
    }
  }
</style>
