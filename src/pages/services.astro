---
import Base from '@/layouts/Base.astro';
import Estimator from '@/components/Estimator.astro';
import ProcessSteps from '@/components/ProcessSteps.astro';
import PageHero from '@/components/PageHero.astro';
import { plans, addons, extraPagePrice, paymentTerms, formatPrice, pricingConfirmed } from '@/config/pricing';
import { url } from '@/lib/url';

const looks = ['raised', 'deep', 'raised'];

// Таблица сравнения: строка — возможность, значения по тарифам.
const compare: { label: string; values: [string, string, string] }[] = [
  { label: 'Страниц', values: ['1', 'до 8', 'до 15'] },
  { label: 'Дизайн', values: ['По стилю или с нуля', 'Индивидуальный', 'Авторская концепция'] },
  { label: 'Адаптив под все экраны', values: ['Да', 'Да', 'Да'] },
  { label: 'Форма заявки', values: ['Да', 'Да', 'Да'] },
  { label: 'Анимации', values: ['Базовые', 'Появление, интерактив', 'Сложные, 3D, WebGL'] },
  { label: 'Портфолио, блог, каталог', values: ['—', 'Да', 'Да'] },
  { label: 'SEO', values: ['Базовое', 'SEO-структура', 'SEO-структура'] },
  { label: 'Яндекс Метрика и цели', values: ['—', 'Да', 'Да'] },
  { label: 'Интеграции: CRM, оплата', values: ['—', '—', 'Да'] },
  { label: 'Поддержка после запуска', values: ['—', '—', '1 месяц'] },
  { label: 'Срок', values: [plans[0].timeline, plans[1].timeline, plans[2].timeline] },
];

const schema = {
  '@context': 'https://schema.org',
  '@type': 'OfferCatalog',
  name: 'Разработка сайтов',
  itemListElement: plans.map((p) => ({
    '@type': 'Offer',
    name: `Тариф ${p.name}`,
    description: p.forWhom,
    price: p.price,
    priceCurrency: 'RUB',
  })),
};
---

<Base
  title="Услуги и цены на разработку сайтов"
  description="Три пакета с фиксированной ценой: START, BUSINESS и PREMIUM. Что входит и не входит, сроки, правки, калькулятор стоимости и этапы работы."
  schema={pricingConfirmed ? schema : undefined}
>
  <PageHero
    id="sv-title"
    title="Услуги и цены"
    pixel="ЦЕНА"
    lead="Делаю сайты под ключ: от структуры и текстов до запуска на вашем домене. Три пакета с понятным составом и фиксированной стоимостью."
  >
    <div class="sv-fact">
      <p class="sv-fact__k">Оплата</p>
      <p class="sv-fact__v">{paymentTerms}</p>
    </div>
    <div class="sv-fact sv-fact--accent">
      <p class="sv-fact__k">Цена не растёт</p>
      <p class="sv-fact__v">
        Сумма фиксируется в предложении и меняется, только если меняется задача.
        {!pricingConfirmed && ' Цены на сайте — предварительные.'}
      </p>
    </div>
  </PageHero>

  <!-- Подробно о каждом тарифе -->
  <section class="section" aria-labelledby="detail-title">
    <h2 id="detail-title" class="head sv-h2">Что входит в тарифы</h2>
    <div class="cols">
      {
        plans.map((p, i) => (
          <article class={`col tile tile--${looks[i]}`} id={`plan-${p.id}`} aria-labelledby={`col-${p.id}`} data-reveal style={`--i:${i}`}>
            <header class="col__head">
              <h3 id={`col-${p.id}`} class="col__name">{p.name}</h3>
              <p class="col__price">{formatPrice(p.price)}</p>
              <p class="col__for">{p.forWhom}</p>
            </header>

            <div class="col__block">
              <h4 class="col__h">Входит</h4>
              <ul class="col__list col__list--yes">
                {p.includes.map((x) => <li>{x}</li>)}
              </ul>
            </div>
            <div class="col__block">
              <h4 class="col__h">Не входит</h4>
              <ul class="col__list col__list--no">
                {p.excludes.map((x) => <li>{x}</li>)}
              </ul>
            </div>
            <dl class="col__terms">
              <div><dt>Срок</dt><dd>{p.timeline}</dd></div>
              <div><dt>Правки</dt><dd>{p.revisions}</dd></div>
              <div><dt>Результат</dt><dd>{p.result}</dd></div>
            </dl>
            <a class={`btn ${i === 1 ? 'btn--accent' : 'btn--ink'} col__btn`} href={url(`/contacts/?plan=${p.id}`)}>
              Заказать {p.name} <span class="arrow" aria-hidden="true">→</span>
            </a>
          </article>
        ))
      }
    </div>
  </section>

  <!-- Сравнение -->
  <section class="section cmp" aria-labelledby="cmp-title">
    <div class="cmp__side">
      <h2 id="cmp-title" class="head">Сравнение</h2>
      <p>Если сомневаетесь между двумя тарифами, опишите задачу — подскажу, какой подойдёт, и не стану продавать лишнее.</p>
    </div>
    <div class="cmp__wrap" tabindex="0" role="region" aria-labelledby="cmp-title">
      <table class="cmp__table">
        <thead>
          <tr>
            <th scope="col"><span class="sr-only">Возможность</span></th>
            {plans.map((p) => <th scope="col">{p.name}</th>)}
          </tr>
        </thead>
        <tbody>
          {
            compare.map((row) => (
              <tr>
                <th scope="row">{row.label}</th>
                {row.values.map((v) => (
                  <td class:list={{ 'is-none': v === '—' }}>{v === '—' ? <span aria-label="Нет">—</span> : v}</td>
                ))}
              </tr>
            ))
          }
          <tr class="cmp__price">
            <th scope="row">Стоимость</th>
            {plans.map((p) => <td>{formatPrice(p.price)}</td>)}
          </tr>
        </tbody>
      </table>
    </div>
  </section>

  <Estimator />

  <!-- Дополнительные работы -->
  <section class="section extras" aria-labelledby="extras-title">
    <div class="extras__head tile tile--raised">
      <h2 id="extras-title" class="head">Дополнительно</h2>
      <p>Можно добавить к любому тарифу. Каждая страница сверх лимита — {formatPrice(extraPagePrice)}.</p>
    </div>
    <ul class="extras__list" data-stagger>
      {
        addons.map((a) => (
          <li class="extras__item tile">
            <span class="extras__name">{a.name}</span>
            <span class="extras__note">{a.note}</span>
            <span class="extras__price">{formatPrice(a.price)}</span>
          </li>
        ))
      }
    </ul>
  </section>

  <ProcessSteps />

  <section class="section sv-cta tile tile--accent" aria-labelledby="sv-cta-title">
    <h2 id="sv-cta-title" class="head">Не уверены, какой тариф нужен?</h2>
    <p class="lead">Опишите задачу в двух словах — предложу подходящий вариант и назову точную сумму.</p>
    <a class="btn btn--ink" href={url('/contacts/')}>Описать задачу <span class="arrow" aria-hidden="true">→</span></a>
  </section>
</Base>

<style>
  .sv-fact {
    display: grid;
    gap: 10px;
    padding: 20px 22px;
    border-radius: var(--radius);
    background: rgba(255, 255, 255, 0.7);
  }

  .sv-fact--accent {
    background: var(--accent);
  }

  .sv-fact__k {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.875rem;
    text-transform: uppercase;
    letter-spacing: 0.02em;
  }

  .sv-fact__v {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 1.0625rem;
    line-height: 1.35;
  }

  .sv-h2 {
    margin-bottom: 40px;
    max-width: 16ch;
  }

  /* Колонки тарифов */
  .cols {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--gap);
    align-items: stretch;
  }

  .col {
    display: flex;
    flex-direction: column;
    gap: 28px;
    padding: 28px;
  }

  .col__name {
    font-size: 1.75rem;
    letter-spacing: -0.02em;
  }

  .col__price {
    margin-top: 10px;
    font-family: var(--font-head);
    font-weight: 700;
    font-size: clamp(2.25rem, 1.6rem + 1.6vw, 3.25rem);
    line-height: 1;
    letter-spacing: -0.04em;
  }

  .col__for {
    margin-top: 14px;
  }

  .col__h {
    margin-bottom: 12px;
    font-size: 1.125rem;
    letter-spacing: -0.01em;
  }

  .col__list {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 8px;
    font-size: 1rem;
  }

  .col__list li {
    display: grid;
    grid-template-columns: 18px 1fr;
    gap: 8px;
  }

  .col__list--yes li::before {
    content: '+';
    font-family: var(--font-display);
    font-weight: 700;
  }

  .col__list--no li::before {
    content: '–';
    font-family: var(--font-display);
    font-weight: 700;
  }

  .col__list--no li {
    opacity: 0.85;
  }

  .col__terms {
    display: grid;
    gap: 14px;
    margin-top: auto;
  }

  .col__terms dt {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.9375rem;
  }

  .col__terms dd {
    font-size: 1rem;
  }

  .col__btn {
    width: 100%;
  }

  .tile--raised .col__btn {
    background: var(--accent);
    color: var(--accent-ink);
  }

  /* Сравнение */
  .cmp {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: var(--gap);
    align-items: start;
  }

  .cmp__side {
    grid-column: 1 / 4;
    display: grid;
    gap: 20px;
    position: sticky;
    top: calc(var(--header-h) + 36px);
  }

  .cmp__wrap {
    grid-column: 4 / 13;
    overflow-x: auto;
    border-radius: var(--radius);
    background: var(--surface-2);
    -webkit-backdrop-filter: var(--glass-blur);
    backdrop-filter: var(--glass-blur);
    box-shadow: inset 0 0 0 1px var(--glass-edge), var(--glass-shadow);
  }

  .cmp__table {
    width: 100%;
    min-width: 640px;
    border-collapse: collapse;
    font-size: 1rem;
  }

  .cmp__table th,
  .cmp__table td {
    padding: 16px 20px;
    text-align: left;
    vertical-align: top;
    border-bottom: 1px solid rgba(21, 21, 21, 0.1);
  }

  .cmp__table thead th {
    font-family: var(--font-head);
    font-weight: 700;
    font-size: 1.25rem;
    letter-spacing: -0.02em;
  }

  .cmp__table thead th:last-child,
  .cmp__table td:last-child {
    background: rgba(255, 103, 0, 0.08);
  }

  .cmp__table tbody th {
    font-family: var(--font-display);
    font-weight: 500;
    color: var(--muted);
    width: 26%;
  }

  .cmp__table td.is-none {
    color: var(--muted);
  }

  .cmp__price th,
  .cmp__price td {
    border-bottom: 0;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.125rem;
    color: var(--ink);
  }

  /* Дополнительно */
  .extras {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: var(--gap);
  }

  .extras__head {
    grid-column: 1 / 5;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 24px;
    min-height: 320px;
  }

  .extras__head .head {
    font-size: clamp(1.75rem, 1rem + 1.8vw, 2.75rem);
    overflow-wrap: anywhere;
  }

  .extras__list {
    grid-column: 5 / 13;
    list-style: none;
    padding: 0;
    display: grid;
    gap: var(--gap);
  }

  .extras__item {
    display: grid;
    grid-template-columns: 1fr 1fr auto;
    gap: 16px;
    align-items: center;
    padding-block: 20px;
  }

  .extras__name {
    font-family: var(--font-display);
    font-weight: 650;
    font-size: 1.125rem;
  }

  .extras__note {
    color: var(--muted);
    font-size: 1rem;
  }

  .extras__price {
    font-family: var(--font-head);
    font-weight: 700;
    font-size: 1.125rem;
    white-space: nowrap;
  }

  .sv-cta {
    display: grid;
    gap: 24px;
    padding: clamp(28px, 4vw, 56px);
  }

  .sv-cta .lead {
    max-width: 46ch;
  }

  .sv-cta .btn {
    justify-self: start;
  }

  @media (max-width: 1023px) {
    .cols {
      grid-template-columns: 1fr;
    }

    .cmp__side,
    .cmp__wrap {
      grid-column: 1 / -1;
      position: static;
    }

    .cmp__side {
      margin-bottom: 24px;
    }

    .extras__head,
    .extras__list {
      grid-column: 1 / -1;
    }

    .extras__head {
      min-height: 0;
    }
  }

  @media (max-width: 767px) {
    .cmp,
    .extras {
      grid-template-columns: 1fr;
    }

    .col {
      padding: 22px;
    }

    .extras__item {
      grid-template-columns: 1fr auto;
    }

    .extras__note {
      grid-column: 1 / -1;
      grid-row: 2;
    }
  }
</style>
