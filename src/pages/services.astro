---
import Base from '@/layouts/Base.astro';
import Estimator from '@/components/Estimator.astro';
import ProcessSteps from '@/components/ProcessSteps.astro';
import PageHero from '@/components/PageHero.astro';
import CtaBand from '@/components/CtaBand.astro';
import { Image } from 'astro:assets';
import { genImage } from '@/lib/gen';
import PricingCards from '@/components/PricingCards.astro';
import { plans, addons, extraPagePrice, formatPrice, pricingConfirmed } from '@/config/pricing';

const sculpture = genImage('services-assembly');
import { url } from '@/lib/url';
import Icon from '@/components/Icon.astro';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'OfferCatalog',
  name: 'Разработка сайтов',
  itemListElement: plans.map((p) => ({
    '@type': 'Offer',
    name: `Пакет ${p.name}`,
    description: p.forWhom,
    price: p.price,
    priceCurrency: 'RUB',
  })),
};
---

<Base
  title="Услуги и цены на разработку сайтов"
  description="Три пакета с фиксированной ценой: START, BUSINESS и PREMIUM. Что входит и не входит, сроки, правки, калькулятор стоимости и этапы работы."
  schema={pricingConfirmed ? schema : undefined}
>
  <PageHero
    id="sv-title"
    title="Услуги и цены"
    lead="Делаю сайты под ключ: от структуры и дизайна до запуска на вашем домене. Три пакета с понятным составом и фиксированной ценой."
  >
    <Fragment slot="actions">
      <div class="sv-actions">
        <a class="btn btn--ink" href="#plans">Выбрать пакет <span class="arrow" aria-hidden="true"><Icon name="arrow" /></span></a>
        <a class="btn btn--ghost" href="#calculator">Рассчитать стоимость</a>
      </div>
    </Fragment>
    {sculpture && (
      <Image class="sv-object" src={sculpture.src} alt="" widths={[420, 640, 900]} sizes="(max-width: 1023px) 70vw, 36vw" quality={80} loading="eager" fetchpriority="high" />
    )}
  </PageHero>
  <PricingCards />

  <Estimator />

  <!-- Дополнительные работы -->
  <section class="section extras" aria-labelledby="extras-title">
    <div class="extras__head">
      <h2 id="extras-title" class="head">Дополнительно</h2>
      <p>Можно добавить к любому пакету. Нажмите «+», и работа попадёт в расчёт выше. Каждая страница сверх лимита — {formatPrice(extraPagePrice)}.</p>
      <p class="extras__mirror" data-out-mirror hidden aria-live="polite">
        В расчёте: <strong data-out-mirror-sum></strong>
      </p>
    </div>
    <ul class="extras__list" data-stagger>
      {
        addons.map((a) => (
          <li class="extras__item" data-addon-row={a.id}>
            <span class="extras__name">{a.name}</span>
            <span class="extras__note">{a.note}</span>
            <span class="extras__price" data-addon-price>{formatPrice(a.price)}</span>
            <button class="extras__toggle" type="button" data-addon={a.id} aria-pressed="false" aria-label={`Добавить в расчёт: ${a.name}`} hidden>
              <span data-icon-plus><Icon name="plus" /></span>
              <span data-icon-minus hidden><Icon name="minus" /></span>
              <span data-icon-check hidden><Icon name="check" /></span>
            </button>
          </li>
        ))
      }
    </ul>
  </section>

  <ProcessSteps />

  <CtaBand
    id="sv-cta-title"
    title="Не уверены, какой пакет нужен?"
    text="Опишите задачу в двух словах — предложу подходящий вариант и назову точную сумму."
    action={{ href: url('/contacts/'), label: 'Описать задачу' }}
  />
</Base>

<style>
  /* Дополнительно */
  .extras {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: var(--gap);
  }

  .extras__head {
    grid-column: 1 / 5;
    display: grid;
    gap: 20px;
    align-content: start;
    padding-right: clamp(0px, 2vw, 32px);
  }

  .extras__head p {
    max-width: 36ch;
    color: var(--ink-2);
  }

  .extras__head .head {
    font-size: var(--fs-4);
  }

  .extras__list {
    grid-column: 5 / 13;
    list-style: none;
    display: grid;
    padding: 8px clamp(22px, 2.6vw, 36px);
    border-radius: var(--radius-lg);
    background: var(--paper);
  }

  /* Один лист со строками вместо стопки плиток. */
  .extras__item {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr) auto auto;
    gap: 24px;
    align-items: center;
    padding-block: 20px;
    transition: color var(--dur-fast) var(--ease-out);
  }

  /* Добавленная работа: цена акцентом, кнопка становится «минусом». */
  .extras__item.is-on .extras__price {
    color: var(--accent-deep);
  }

  .extras__item.is-included .extras__price {
    font-family: var(--font-text);
    font-weight: 400;
    font-size: var(--step-small);
    color: var(--muted);
  }

  .extras__toggle {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--ink);
    color: var(--bg);
    font-size: var(--fs-1);
    transition:
      background-color var(--dur-fast) var(--ease-out),
      color var(--dur-fast) var(--ease-out),
      scale var(--dur-fast) var(--ease-out);
  }

  .extras__toggle > span {
    display: grid;
  }

  .extras__toggle:hover:not(:disabled) {
    background: var(--accent);
    color: var(--accent-ink);
  }

  .extras__toggle:active:not(:disabled) {
    scale: 0.92;
  }

  .extras__toggle[aria-pressed='true'] {
    background: var(--accent);
    color: var(--accent-ink);
  }

  .extras__toggle[aria-pressed='true']:hover {
    background: var(--ink);
    color: var(--bg);
  }

  .extras__toggle:disabled {
    background: transparent;
    color: var(--muted);
    box-shadow: inset 0 0 0 1px var(--line);
    cursor: default;
  }

  .extras__mirror {
    justify-self: start;
    padding: 10px 14px;
    border-radius: 999px;
    background: var(--paper);
    font-size: var(--step-small);
  }

  .extras__mirror strong {
    font-family: var(--font-display);
    font-weight: 600;
    white-space: nowrap;
  }

  .extras__item + .extras__item {
    border-top: 1px solid var(--line);
  }

  .extras__name {
    font-family: var(--font-display);
    font-weight: 560;
    font-size: var(--step-body);
  }

  .extras__note {
    color: var(--muted);
    font-size: var(--fs-0);
  }

  .extras__price {
    font-family: var(--font-head);
    font-weight: 600;
    font-size: var(--step-body);
    white-space: nowrap;
  }

  .sv-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  /* Объект справа в первом экране: стеклянные окна, собранные в сайт. */
  .sv-object {
    width: min(100%, 520px);
    height: auto;
    justify-self: center;
    filter: drop-shadow(0 36px 36px rgba(26, 47, 251, 0.2));
  }

  @media (max-width: 1023px) {
    .extras__head,
    .extras__list {
      grid-column: 1 / -1;
    }

    .extras__head {
      min-height: 0;
    }
  }

  @media (max-width: 767px) {
    .extras {
      grid-template-columns: 1fr;
    }

    .extras__item {
      grid-template-columns: minmax(0, 1fr) auto auto;
      gap: 6px 16px;
    }

    .extras__note {
      grid-column: 1 / 3;
      grid-row: 2;
    }

    .extras__toggle {
      grid-row: 1 / 3;
      grid-column: 3;
    }
  }
</style>
