---
import Base from '@/layouts/Base.astro';
import Estimator from '@/components/Estimator.astro';
import ProcessSteps from '@/components/ProcessSteps.astro';
import PageHero from '@/components/PageHero.astro';
import CtaBand from '@/components/CtaBand.astro';
import { Image } from 'astro:assets';
import { genImage } from '@/lib/gen';
import PricingCards from '@/components/PricingCards.astro';
import { plans, addons, formatPrice, paymentTerms, pricingConfirmed } from '@/config/pricing';
import { terms } from '@/data/content';

// Стеклянный осьминог: много дел в одних руках.
const sculpture = genImage('services-octopus');

// Условия работы: текст — в src/data/content.ts, суммы подставляются из цен.
const fill = (v: string) =>
  v
    .replace('{payment}', paymentTerms)
    .replace('{copy}', formatPrice(addons.find((a) => a.id === 'copy')!.price))
    .replace('{premium}', formatPrice(plans.find((p) => p.id === 'premium')!.price));
import { url } from '@/lib/url';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'OfferCatalog',
  name: 'Разработка сайтов',
  itemListElement: plans.map((p) => ({
    '@type': 'Offer',
    name: `Пакет ${p.name}`,
    description: p.forWhom,
    price: p.price,
    priceCurrency: 'RUB',
  })),
};
---

<Base
  title="Услуги и цены на разработку сайтов"
  description="Три пакета с фиксированной ценой: START, BUSINESS и PREMIUM. Что входит и не входит, сроки, правки, калькулятор стоимости и этапы работы."
  schema={pricingConfirmed ? schema : undefined}
>
  <PageHero
    id="sv-title"
    title="Услуги и цены"
    lead="Делаю сайты под ключ: от структуры и дизайна до запуска на вашем домене. Три пакета с понятным составом и фиксированной ценой."
  >
    <Fragment slot="actions">
      <div class="sv-actions">
        <a class="btn btn--ink" href="#plans">Выбрать пакет</a>
        <a class="btn btn--ghost" href="#calculator">Рассчитать стоимость</a>
      </div>
    </Fragment>
    {sculpture && (
      <Image class="sv-object" src={sculpture.src} alt="" widths={[260, 420, 640, 900]} sizes="(max-width: 371px) 70vw, (max-width: 767px) 260px, (max-width: 1023px) 70vw, 36vw" quality={80} loading="eager" fetchpriority="high" />
    )}
  </PageHero>
  <PricingCards />

  <Estimator />

  <ProcessSteps />

  <section class="section split" id="terms" data-island-section="Условия" aria-labelledby="terms-title">
    <h2 id="terms-title" class="head">Условия</h2>
    <dl class="rows">
      {
        terms.map((t) => (
          <div>
            <dt class="rows__k">{t.k}</dt>
            <dd class="rows__v">{fill(t.v)}</dd>
          </div>
        ))
      }
    </dl>
  </section>

  <CtaBand
    id="sv-cta-title"
    title="Подберу пакет под задачу"
    text="Опишите задачу в двух словах — предложу подходящий вариант и назову точную сумму."
    action={{ href: url('/contacts/'), label: 'Обсудить проект' }}
  />
</Base>

<style>
  .sv-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  /* На телефоне две кнопки одной ширины, друг под другом. */
  @media (max-width: 767px) {
    .sv-actions :global(.btn) {
      flex: 1 1 100%;
    }
  }

  /* Объект справа в первом экране — из той же серии, что медуза на главной. */
  .sv-object {
    width: min(100%, 560px);
    height: auto;
    justify-self: center;
    filter: var(--object-shadow);
  }

  @media (max-width: 767px) {
    .sv-object {
      width: min(70vw, 260px);
    }
  }
</style>
