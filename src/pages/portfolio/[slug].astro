---
/**
 * Страница кейса. Сверху вниз: заголовок и факты, главный экран в окне браузера, задача,
 * результаты, решения, остальные экраны, рассказ о ходе работы и призыв.
 * Раскладки те же, что на остальных страницах: «заголовок слева — содержание справа» и строки под линиями.
 */
import { Image } from 'astro:assets';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Base from '@/layouts/Base.astro';
import PageHero from '@/components/PageHero.astro';
import BrowserShot from '@/components/BrowserShot.astro';
import CtaBand from '@/components/CtaBand.astro';
import { categoryLabel } from '@/config/portfolio';
import { url } from '@/lib/url';
import Icon from '@/components/Icon.astro';

export async function getStaticPaths() {
  const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
  return projects.map((project, i) => ({
    params: { slug: project.id },
    props: { project, next: projects[(i + 1) % projects.length] },
  }));
}

interface Props {
  project: CollectionEntry<'projects'>;
  next: CollectionEntry<'projects'>;
}

const { project, next } = Astro.props;
const d = project.data;
const { Content } = await render(project);
const hasNext = next.id !== project.id;
/** Кейс этого сайта: живая версия — то, что открыто сейчас. */
const isSelf = project.id === 'maltsev-digital';
// Десктопная версия уже показана обложкой — в ряду устройств остаются планшет и телефон.
const devices = [
  { key: 'tablet', label: 'Планшет', img: d.responsive.tablet },
  { key: 'mobile', label: 'Телефон', img: d.responsive.mobile },
].filter((x) => x.img);

const schema = {
  '@context': 'https://schema.org',
  '@type': 'CreativeWork',
  name: d.title,
  description: d.summary,
  dateCreated: String(d.year),
  ...(d.liveUrl ? { url: d.liveUrl } : {}),
};
---

<Base title={isSelf ? 'Кейс: этот сайт, сделанный с ИИ' : `${d.title} — ${d.isConcept ? 'концепт' : 'проект'}`} description={d.summary} schema={schema}>
  <article>
    <PageHero
      id="pj-title"
      title={d.title}
      lead={d.summary}
      crumbs={[{ href: url('/portfolio/'), label: 'Работы' }]}
      compact
    >
      <dl class="pj-facts">
        <div><dt>Тип</dt><dd>{d.isConcept ? 'Концепт' : categoryLabel(d.category)}</dd></div>
        <div><dt>Год</dt><dd>{d.year}</dd></div>
        <div><dt>Технологии</dt><dd>{d.stack.join(', ')}</dd></div>
      </dl>
      {
        d.liveUrl ? (
          <a class="btn btn--accent pj-live" href={d.liveUrl} target="_blank" rel="noopener">
            Открыть сайт <span class="arrow" aria-hidden="true"><Icon name="arrow-ne" /></span>
          </a>
        ) : isSelf ? (
          <a class="btn btn--ink pj-live" href={url('/')}>
            Открыть главную <span class="arrow" aria-hidden="true"><Icon name="arrow" /></span>
          </a>
        ) : (
          <p class="pj-live pj-live--off">Живая версия недоступна</p>
        )
      }
    </PageHero>

    <figure class="pj-cover section section--tight">
      <BrowserShot src={d.cover} alt={d.coverAlt} widths={[640, 1000, 1600, 2000]} sizes="(max-width: 1023px) 92vw, 78vw" loading="eager" />
    </figure>

    <section class="section split" data-island-section="Задача" aria-labelledby="task-title">
      <h2 id="task-title" class="head" data-split>Задача</h2>
      <p class="pj-lead" data-reveal>{d.task}</p>
    </section>

    {
      d.results.length > 0 && (
        <section class="section split" data-island-section="Результат" aria-labelledby="res-title">
          <h2 id="res-title" class="head" data-split>Результат</h2>
          <dl class="rows" data-stagger>
            {d.results.map((r) => (
              <div>
                <dd class="rows__k pj-res">{r.value}</dd>
                <dt class="rows__v">{r.label}</dt>
              </div>
            ))}
          </dl>
        </section>
      )
    }

    {
      d.designNotes.length > 0 && (
        <section class="section split" data-island-section="Решения" aria-labelledby="design-title">
          <h2 id="design-title" class="head" data-split>Решения</h2>
          <ul class="pj-notes" data-stagger>
            {d.designNotes.map((n) => <li>{n}</li>)}
          </ul>
        </section>
      )
    }

    {
      (d.gallery.length > 0 || devices.length > 0) && (
        <section class="section" data-island-section="Экраны" aria-labelledby="gal-title">
          <h2 id="gal-title" class="head pj-screens-title" data-split>Экраны</h2>
          {d.gallery.length > 0 && (
            <div class="pj-gallery" data-stagger>
              {d.gallery.map((g) => (
                <figure class="pj-shot">
                  <BrowserShot src={g.src} alt={g.alt} widths={[600, 1000, 1600]} sizes="(max-width: 767px) 86vw, 42vw" />
                  {g.caption && <figcaption>{g.caption}</figcaption>}
                </figure>
              ))}
            </div>
          )}
          {devices.length > 0 && (
            <div class="pj-devices" data-stagger>
              {devices.map((dv) => (
                <figure class={`pj-device pj-device--${dv.key}`}>
                  <div class="pj-device__frame">
                    <Image src={dv.img!} alt={`${d.title}: ${dv.label.toLowerCase()}`} widths={[300, 600, 900]} sizes="(max-width: 767px) 60vw, 28vw" loading="lazy" />
                  </div>
                  <figcaption>{dv.label}</figcaption>
                </figure>
              ))}
            </div>
          )}
        </section>
      )
    }

    <section class="section split pj-story" data-island-section="Как сделано" aria-labelledby="story-title">
      <h2 id="story-title" class="head" data-split>Как это сделано</h2>
      <div class="prose" data-reveal>
        <Content />
      </div>
    </section>

    {
      hasNext && (
        <a class="section pj-next lift" href={url(`/portfolio/${next.id}/`)}>
          <span class="pj-next__k">Следующий проект</span>
          <span class="pj-next__t">{next.data.title}</span>
          <span class="pj-next__arrow" aria-hidden="true"><Icon name="arrow" /></span>
        </a>
      )
    }

    <CtaBand
      id="pj-cta-title"
      title="Хотите похожий сайт?"
      text="Расскажите о задаче — предложу формат, срок и цену до начала работы."
      action={{ href: url('/contacts/'), label: 'Обсудить проект' }}
      more={{ href: url('/portfolio/'), label: 'Все работы' }}
    />
  </article>
</Base>

<style>
  /* Факты в первом экране: строки под линиями, как на других страницах. */
  .pj-facts {
    border-top: 1px solid var(--line);
  }

  .pj-facts div {
    display: grid;
    grid-template-columns: 7.5em minmax(0, 1fr);
    gap: 12px;
    align-items: baseline;
    padding-block: 12px;
    border-bottom: 1px solid var(--line);
  }

  .pj-facts dt {
    font-size: var(--fs-xs);
    color: var(--muted);
  }

  .pj-facts dd {
    font-family: var(--font-display);
    font-weight: 500;
    line-height: 1.35;
  }

  .pj-live {
    justify-self: start;
    margin-top: 12px;
  }

  .pj-live--off {
    font-size: var(--step-small);
    color: var(--muted);
  }

  /* Обложка: окно браузера на светлой подложке во всю ширину. */
  .pj-cover {
    padding: clamp(20px, 5vw, 72px) clamp(16px, 9vw, 150px);
    border-radius: var(--radius-lg);
    background:
      radial-gradient(60% 70% at 70% 40%, var(--stage-glow) 0%, rgba(255, 255, 255, 0) 70%),
      linear-gradient(180deg, var(--stage-1), var(--stage-2));
  }

  .pj-lead {
    max-width: 56ch;
    font-size: var(--fs-2);
    line-height: 1.35;
    letter-spacing: -0.02em;
  }

  .pj-res {
    font-weight: 400;
    font-size: var(--fs-3);
    letter-spacing: -0.04em;
    color: var(--accent-text);
  }

  .pj-notes {
    list-style: none;
    padding: 0;
    border-top: 1px solid var(--line);
  }

  .pj-notes li {
    padding-block: clamp(16px, 1.6vw, 22px);
    border-bottom: 1px solid var(--line);
    font-size: var(--step-body);
    line-height: 1.45;
  }

  .pj-screens-title {
    margin-bottom: clamp(24px, 3vw, 40px);
  }

  .pj-gallery {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--gap);
  }

  .pj-shot {
    display: grid;
    gap: 16px;
    align-content: start;
    padding: clamp(16px, 3vw, 44px);
    padding-bottom: clamp(14px, 1.6vw, 22px);
    border-radius: var(--radius-lg);
    background: linear-gradient(180deg, var(--stage-1), var(--stage-2));
  }

  .pj-shot figcaption,
  .pj-device figcaption {
    font-size: var(--step-small);
    color: var(--ink-2);
  }

  /* Планшет и телефон — рядом, на белой карточке. */
  .pj-devices {
    display: flex;
    justify-content: center;
    align-items: flex-end;
    gap: clamp(20px, 5vw, 72px);
    margin-top: var(--gap);
    padding: clamp(24px, 4vw, 56px);
    border-radius: var(--radius-lg);
    background: var(--paper);
  }

  .pj-device {
    display: grid;
    gap: 12px;
    justify-items: center;
  }

  .pj-device--tablet {
    width: min(46%, 420px);
  }

  .pj-device--mobile {
    width: min(24%, 210px);
  }

  .pj-device__frame {
    width: 100%;
    border-radius: 14px;
    background: var(--paper);
    box-shadow:
      0 0 0 1px rgba(10, 11, 20, 0.08),
      0 40px 70px -40px rgba(16, 32, 200, 0.45);
    overflow: hidden;
  }

  .pj-device__frame img {
    width: 100%;
    height: auto;
    object-fit: cover;
    object-position: top;
  }

  .pj-device--tablet img {
    aspect-ratio: 3 / 4;
  }

  .pj-device--mobile img {
    aspect-ratio: 376 / 814;
  }

  .pj-story .prose {
    color: var(--ink-2);
  }

  .pj-story .prose :global(h2) {
    margin-top: 1.6em;
    font-weight: 500;
    font-size: var(--fs-1);
    letter-spacing: -0.03em;
    color: var(--ink);
  }

  .pj-story .prose :global(h2:first-child) {
    margin-top: 0;
  }

  /* Следующий проект: белая строка-ссылка во всю ширину. */
  .pj-next {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 4px 24px;
    align-items: center;
    padding: clamp(22px, 2.6vw, 36px) clamp(24px, 4vw, 64px);
    border-radius: var(--radius-lg);
    background: var(--paper);
    text-decoration: none;
  }

  .pj-next__k {
    font-size: var(--step-small);
    color: var(--muted);
  }

  .pj-next__t {
    grid-column: 1;
    font-family: var(--font-head);
    font-weight: 300;
    font-size: var(--fs-4);
    line-height: 1.05;
    letter-spacing: -0.045em;
  }

  .pj-next__arrow {
    grid-column: 2;
    grid-row: 1 / 3;
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    border-radius: 50%;
    background: var(--accent);
    color: var(--accent-ink);
    font-size: var(--fs-1);
  }

  @media (max-width: 767px) {
    .pj-gallery {
      grid-template-columns: 1fr;
    }

    .pj-cover,
    .pj-shot,
    .pj-devices,
    .pj-next {
      border-radius: var(--radius);
    }

    .pj-device--tablet {
      width: 58%;
    }

    .pj-device--mobile {
      width: 30%;
    }

    .pj-device__frame {
      border-radius: 10px;
    }
  }
</style>
