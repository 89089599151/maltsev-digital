---
/**
 * «Работы». Тот же каркас, что у остальных страниц: первый экран PageHero (заголовок, текст, кнопки,
 * стеклянный объект справа — раковина наутилуса), ниже — карточка проекта, как в разделе «Работы»
 * на главной (WorkFeature: суть, факты, скриншоты на компьютере и телефоне), затем синий призыв.
 * Когда проектов станет больше, под карточкой появится сетка «Ещё проекты» с фильтром.
 */
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '@/layouts/Base.astro';
import PageHero from '@/components/PageHero.astro';
import WorkFeature from '@/components/WorkFeature.astro';
import ProjectCard from '@/components/ProjectCard.astro';
import CtaBand from '@/components/CtaBand.astro';
import Icon from '@/components/Icon.astro';
import { categories } from '@/config/portfolio';
import { genImage } from '@/lib/gen';
import { url } from '@/lib/url';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const [featured, ...rest] = projects;
const used = categories.filter((c) => rest.some((p) => p.data.category === c.id));
const pattern = ['wide', 'normal', 'tall', 'normal', 'normal', 'wide', 'normal'] as const;
// Раковина наутилуса: камеры — проекты, спираль — рост.
const nautilus = genImage('works-nautilus');
---

<Base
  title="Работы — портфолио веб-разработчика"
  description="Проекты Maltsev Digital на компьютере и телефоне. Дизайн, разработка и решения — в подробном разборе."
>
  <PageHero
    id="pw-title"
    title="Работы"
    lead={featured
      ? 'Первый проект — этот сайт: открытые цены, калькулятор и короткая заявка. В разборе — как он сделан и что получилось.'
      : 'Готовлю проекты к публикации. Здесь будут их история и результат.'}
  >
    <Fragment slot="actions">
      {featured && (
        <div class="pw-actions">
          <a class="btn btn--ink" href={url(`/portfolio/${featured.id}/`)}>
            Смотреть кейс <span class="arrow" aria-hidden="true"><Icon name="arrow" /></span>
          </a>
          <a class="btn btn--ghost" href={url('/contacts/')}>Обсудить проект</a>
        </div>
      )}
    </Fragment>
    {nautilus && (
      <Image
        class="pw-object"
        src={nautilus.src}
        alt=""
        widths={[260, 420, 640, 900]}
        sizes="(max-width: 767px) 70vw, (max-width: 1023px) 60vw, 34vw"
        quality={80}
        loading="eager"
        fetchpriority="high"
      />
    )}
  </PageHero>

  {featured && <WorkFeature project={featured} head={false} />}

  {rest.length > 0 && (
    <section class="section pw-more" aria-labelledby="pw-more-title">
      <h2 id="pw-more-title" class="head" data-split>Ещё проекты</h2>
      {used.length > 1 && (
        <div class="filters" role="group" aria-label="Фильтр по категориям" data-filters>
          <button type="button" aria-pressed="true" data-filter="all">Все</button>
          {used.map((c) => <button type="button" aria-pressed="false" data-filter={c.id}>{c.label}</button>)}
        </div>
      )}
      <div class="pw-grid" data-grid>{rest.map((p, i) => <ProjectCard project={p} size={pattern[i % pattern.length]} />)}</div>
      <p data-filter-empty hidden>В этой категории пока нет проектов.</p>
    </section>
  )}

  <CtaBand
    id="pw-cta-title"
    title="Следующий кейс — ваш проект"
    text="Каждая новая работа появится здесь с разбором и ссылкой на живой сайт. Начнём с разговора — он ни к чему не обязывает."
    action={{ href: url('/contacts/'), label: 'Обсудить проект' }}
    more={{ href: url('/services/'), label: 'Пакеты и цены' }}
  />
</Base>

<script>
  const filters = document.querySelector<HTMLElement>('[data-filters]');
  const grid = document.querySelector<HTMLElement>('[data-grid]');
  const empty = document.querySelector<HTMLElement>('[data-filter-empty]');
  if (filters && grid) {
    const buttons = Array.from(filters.querySelectorAll<HTMLButtonElement>('[data-filter]'));
    for (const button of buttons) button.addEventListener('click', () => {
      for (const other of buttons) other.setAttribute('aria-pressed', String(other === button));
      let shown = 0;
      for (const card of grid.querySelectorAll<HTMLElement>('[data-category]')) {
        card.hidden = button.dataset.filter !== 'all' && card.dataset.category !== button.dataset.filter;
        if (!card.hidden) shown++;
      }
      if (empty) empty.hidden = shown > 0;
    });
  }
</script>

<style>
  .pw-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  /* Объект справа в первом экране — из той же серии, что осьминог на «Услугах» и медуза на главной. */
  .pw-object {
    width: min(100%, 520px);
    height: auto;
    justify-self: center;
    filter: drop-shadow(0 36px 36px rgba(26, 47, 251, 0.2));
  }

  /* --- Остальные проекты -------------------------------------------------- */

  .pw-more .head {
    margin-bottom: clamp(24px, 3vw, 40px);
  }

  .pw-grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: var(--gap);
  }

  .pw-grid > :global(.pc:only-child) {
    grid-column: 1 / -1;
  }

  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 24px;
  }

  .filters button {
    min-height: 44px;
    padding: 10px 18px;
    border-radius: 999px;
    background: var(--paper);
    color: var(--ink);
  }

  .filters button[aria-pressed='true'] {
    background: var(--ink);
    color: var(--paper);
  }

  @media (max-width: 767px) {
    /* На телефоне две кнопки одной ширины, друг под другом. */
    .pw-actions :global(.btn) {
      flex: 1 1 100%;
    }

    .pw-object {
      width: min(70vw, 280px);
    }

    .pw-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
