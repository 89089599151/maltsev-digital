---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '@/layouts/Base.astro';
import PageHero from '@/components/PageHero.astro';
import ProjectCard from '@/components/ProjectCard.astro';
import WorkFeature from '@/components/WorkFeature.astro';
import CtaBand from '@/components/CtaBand.astro';
import { categories } from '@/config/portfolio';
import { url } from '@/lib/url';
import { genImage } from '@/lib/gen';

// Стеклянная раковина наутилуса в разрезе: камеры — как проекты.
const sculpture = genImage('works-nautilus');
const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const [featured, ...rest] = projects;
const used = categories.filter((c) => rest.some((p) => p.data.category === c.id));
const pattern = ['wide', 'normal', 'tall', 'normal', 'normal', 'wide', 'normal'] as const;
---

<Base
  title="Работы — портфолио веб-разработчика"
  description="Портфолио Maltsev Digital: реальные сайты с разбором задачи, дизайна и разработки. Первый кейс — этот сайт, от идеи до запуска."
>
  <PageHero
    id="pf-title"
    title="Работы"
    lead={featured
      ? 'Каждый проект — с задачей, решениями и ссылкой на живой сайт. Первый кейс — этот сайт: он сделан так же, как будет сделан ваш.'
      : 'Готовлю проекты к публикации. Каждый появится с разбором задачи, дизайна и разработки.'}
    compact
  >
    {sculpture && (
      <Image
        class="pf-object"
        src={sculpture.src}
        alt=""
        widths={[320, 480, 640, 960]}
        sizes="(max-width: 767px) 62vw, (max-width: 1023px) 320px, (min-width: 1440px) 480px, 34vw"
        quality={80}
        loading="eager"
        fetchpriority="high"
        draggable="false"
      />
    )}
  </PageHero>

  {featured && <WorkFeature project={featured} head={false} />}

  {rest.length > 0 && (
    <section class="section pf-list" aria-labelledby="pf-list-title">
      <h2 id="pf-list-title" class="head pf-list__title" data-split>Ещё проекты</h2>
      {used.length > 1 && (
        <div class="filters" role="group" aria-label="Фильтр по категориям" data-filters>
          <button type="button" class="filter" aria-pressed="true" data-filter="all">Все</button>
          {used.map((c) => (
            <button type="button" class="filter" aria-pressed="false" data-filter={c.id}>{c.label}</button>
          ))}
        </div>
      )}
      <div class="grid" data-grid>
        {rest.map((p, i) => <ProjectCard project={p} size={pattern[i % pattern.length]} />)}
      </div>
      <p class="filters__empty" data-filter-empty hidden>В этой категории пока нет проектов.</p>
    </section>
  )}

  <CtaBand
    id="pf-next-title"
    title="Следующий кейс — ваш"
    text="Расскажите об идее — предложу формат, стоимость и план работы."
    action={{ href: url('/contacts/'), label: 'Обсудить проект' }}
    more={{ href: url('/services/'), label: 'Пакеты и цены' }}
  />
</Base>

<script>
  const wrap = document.querySelector<HTMLElement>('[data-filters]');
  const grid = document.querySelector<HTMLElement>('[data-grid]');
  const empty = document.querySelector<HTMLElement>('[data-filter-empty]');
  if (wrap && grid) {
    const buttons = Array.from(wrap.querySelectorAll<HTMLButtonElement>('[data-filter]'));
    buttons.forEach((btn) =>
      btn.addEventListener('click', () => {
        const f = btn.dataset.filter;
        buttons.forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
        let shown = 0;
        grid.querySelectorAll<HTMLElement>('[data-category]').forEach((card) => {
          const on = f === 'all' || card.dataset.category === f;
          card.hidden = !on;
          if (on) shown++;
        });
        if (empty) empty.hidden = shown > 0;
      }),
    );
  }
</script>

<style>
  .pf-object {
    width: min(100%, 480px);
    height: auto;
    justify-self: center;
    filter: drop-shadow(0 24px 30px rgba(26, 47, 251, 0.13));
  }

  @media (prefers-reduced-motion: no-preference) {
    .pf-object {
      animation: pf-float 8s ease-in-out infinite;
    }
  }

  @keyframes pf-float {
    0%, 100% { transform: translateY(5px) rotate(-0.6deg); }
    50% { transform: translateY(-5px) rotate(0.6deg); }
  }

  @media (max-width: 1023px) {
    .pf-object {
      width: min(62vw, 320px);
    }
  }

  .pf-list__title {
    margin-bottom: clamp(24px, 3vw, 40px);
  }

  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-bottom: 24px;
  }

  .filter {
    min-height: 48px;
    padding: 12px 18px;
    border-radius: 999px;
    background: var(--paper);
    font-size: var(--fs-0);
    font-weight: 550;
    transition:
      background-color var(--dur-fast) var(--ease-out),
      color var(--dur-fast) var(--ease-out);
  }

  .filter:hover {
    background: var(--surface-2);
  }

  .filter[aria-pressed='true'] {
    background: var(--ink);
    color: var(--bg);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: var(--gap);
    grid-auto-flow: dense;
  }

  .grid > :global(.pc:only-child) {
    grid-column: 1 / -1;
  }

  .filters__empty {
    padding: 40px 0;
    color: var(--muted);
  }
</style>
