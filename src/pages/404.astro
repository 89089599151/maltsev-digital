---
import Base from '@/layouts/Base.astro';
import PageHero from '@/components/PageHero.astro';
import { url } from '@/lib/url';
import Icon from '@/components/Icon.astro';

const links = [
  { href: '/', label: 'Главная' },
  { href: '/services/', label: 'Услуги и цены' },
  { href: '/portfolio/', label: 'Работы' },
  { href: '/contacts/', label: 'Контакты' },
];
---

<Base title="Страница не найдена" description="Такой страницы нет. Перейдите на главную или в другой раздел." noindex>
  <PageHero id="nf-title" title="Такой страницы нет" pixel="404" lead="Возможно, адрес изменился или в нём опечатка. Вот куда можно перейти:">
    <Fragment slot="actions">
      <ul class="nf__links">
        {
          links.map((l) => (
            <li>
              <a class="nf__link" href={url(l.href)}>
                {l.label} <span aria-hidden="true"><Icon name="arrow" /></span>
              </a>
            </li>
          ))
        }
      </ul>
    </Fragment>
  </PageHero>
</Base>

<style>
  .nf__links {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .nf__link {
    display: inline-flex;
    gap: 10px;
    align-items: center;
    min-height: 52px;
    padding: 12px 18px;
    border-radius: var(--radius-sm);
    background: rgba(255, 255, 255, 0.75);
    font-family: var(--font-display);
    font-weight: 650;
    text-decoration: none;
    transition: background-color var(--dur-fast) var(--ease-out);
  }

  .nf__link:hover {
    background: var(--accent);
  }
</style>
