---
import Base from '@/layouts/Base.astro';
import PageHero from '@/components/PageHero.astro';
import { url } from '@/lib/url';
import Icon from '@/components/Icon.astro';

const links = [
  { href: '/', label: 'Главная' },
  { href: '/services/', label: 'Услуги и цены' },
  { href: '/portfolio/', label: 'Работы' },
  { href: '/contacts/', label: 'Контакты' },
];
---

<Base title="Страница не найдена" description="Такой страницы нет. Перейдите на главную или в другой раздел." noindex>
  <PageHero id="nf-title" title="Такой страницы нет" lead="Возможно, адрес изменился или в нём опечатка. Вот куда можно перейти.">
    <Fragment slot="actions">
      <ul class="nf__links">
        {
          links.map((l) => (
            <li>
              <a class="btn btn--ghost" href={url(l.href)}>
                {l.label} <span class="arrow" aria-hidden="true"><Icon name="arrow" /></span>
              </a>
            </li>
          ))
        }
      </ul>
    </Fragment>
    <p class="nf__code" aria-hidden="true">404</p>
  </PageHero>
</Base>

<style>
  /* Код ошибки — крупными тонкими цифрами справа, вместо картинки. */
  .nf__code {
    justify-self: end;
    font-family: var(--font-head);
    font-weight: 250;
    font-size: clamp(6rem, 3rem + 13vw, 15rem);
    line-height: 0.9;
    letter-spacing: -0.07em;
    color: var(--accent);
  }

  .nf__links {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  @media (max-width: 1023px) {
    .nf__code {
      justify-self: start;
      order: -1;
    }
  }
</style>
