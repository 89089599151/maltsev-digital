---
import Base from '@/layouts/Base.astro';
import PageHero from '@/components/PageHero.astro';
import { Image } from 'astro:assets';
import { genImage } from '@/lib/gen';
import { url } from '@/lib/url';
import Icon from '@/components/Icon.astro';

// Стеклянный спасательный круг: заблудились — вот выход.
const buoy = genImage('notfound-buoy');

const links = [
  { href: '/', label: 'Главная' },
  { href: '/services/', label: 'Услуги и цены' },
  { href: '/portfolio/', label: 'Работы' },
  { href: '/contacts/', label: 'Контакты' },
];
---

<Base title="Страница не найдена" description="Такой страницы нет. Перейдите на главную или в другой раздел." noindex>
  <PageHero id="nf-title" title="Такой страницы нет" lead="Ошибка 404: адрес изменился или в нём опечатка. Вот куда можно перейти.">
    <Fragment slot="actions">
      <ul class="nf__links">
        {
          links.map((l) => (
            <li>
              <a class="btn btn--ghost" href={url(l.href)}>
                {l.label} <span class="arrow" aria-hidden="true"><Icon name="arrow" /></span>
              </a>
            </li>
          ))
        }
      </ul>
    </Fragment>
    {buoy && <Image class="nf-object" src={buoy.src} alt="" widths={[320, 480, 640, 900]} sizes="(max-width: 1023px) 60vw, 34vw" quality={80} loading="eager" />}
  </PageHero>
</Base>

<style>
  .nf-object {
    width: min(100%, 460px);
    height: auto;
    justify-self: center;
    filter: drop-shadow(0 30px 32px rgba(26, 47, 251, 0.18));
  }

  .nf__links {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  @media (max-width: 1023px) {
    .nf-object {
      width: min(70vw, 300px);
    }
  }
</style>
