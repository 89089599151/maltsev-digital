---
import Base from '@/layouts/Base.astro';
import PageHero from '@/components/PageHero.astro';
import FaqList from '@/components/FaqList.astro';
import { faq } from '@/data/content';
import { url } from '@/lib/url';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<Base
  title="Вопросы и ответы о разработке сайта"
  description="Сколько стоит и сколько длится разработка сайта, что нужно для старта, кому принадлежит сайт, как используется ИИ и что будет после запуска."
  schema={schema}
>
  <PageHero
    id="fq-title"
    title="Вопросы и ответы"
    pixel="???"
    lead="О цене, сроках, правах на сайт и о том, как в работе используется ИИ."
  >
    <Fragment slot="actions">
      <a class="btn btn--ink" href={url('/contacts/')}>Задать свой вопрос <span class="arrow" aria-hidden="true">→</span></a>
    </Fragment>
  </PageHero>

  <div class="section">
    <FaqList items={faq} heading="Всё, что спрашивают" headingId="fq-list-title" group="faq-page">
      <Fragment slot="side">
        <p>Если ответа нет — напишите. Отвечаю сам, без шаблонов и ботов.</p>
        <a class="btn btn--ghost" href={url('/services/')} style="justify-self:start">
          Тарифы и калькулятор <span class="arrow" aria-hidden="true">→</span>
        </a>
      </Fragment>
    </FaqList>
  </div>
</Base>
