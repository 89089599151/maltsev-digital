---
import Base from '@/layouts/Base.astro';
import { Image } from 'astro:assets';
import PageHero from '@/components/PageHero.astro';
import FaqList from '@/components/FaqList.astro';
import { faq } from '@/data/content';
import { url } from '@/lib/url';
import Icon from '@/components/Icon.astro';
import { genImage } from '@/lib/gen';

// Стеклянный морской конёк: силуэт сам напоминает знак вопроса.
const sculpture = genImage('faq-seahorse');
const schema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<Base
  title="Вопросы и ответы о разработке сайта"
  description="Сколько стоит и сколько длится разработка сайта, что нужно для старта, кому принадлежит сайт, как используется ИИ и что будет после запуска."
  schema={schema}
>
  <PageHero
    id="fq-title"
    title="Вопросы и ответы"
    lead="О цене, сроках, договоре и правах на сайт."
  >
    <Fragment slot="actions">
      <a class="btn btn--ink" href={url('/contacts/')}>Задать свой вопрос <span class="arrow" aria-hidden="true"><Icon name="arrow" /></span></a>
    </Fragment>
    {sculpture && (
      <Image
        class="fq-object"
        src={sculpture.src}
        alt=""
        widths={[180, 260, 360, 520]}
        sizes="(max-width: 394px) 38vw, (max-width: 1023px) 150px, 240px"
        quality={80}
        loading="eager"
        fetchpriority="high"
        draggable="false"
      />
    )}
  </PageHero>

  <div class="section">
    <FaqList items={faq} heading="Список вопросов" headingId="fq-list-title" group="faq-page" headingHidden>
      <Fragment slot="side">
        <p>Если ответа нет — напишите. Отвечаю сам, без шаблонов и ботов.</p>
        <a class="btn btn--ghost" href={url('/services/')} style="justify-self:start">
          Пакеты и калькулятор <span class="arrow" aria-hidden="true"><Icon name="arrow" /></span>
        </a>
      </Fragment>
    </FaqList>
  </div>
</Base>

<style>
  /* Объект вертикальный: ширина небольшая, чтобы высота не раздувала первый экран. */
  .fq-object {
    width: min(100%, 240px);
    height: auto;
    justify-self: center;
    filter: drop-shadow(0 24px 30px rgba(26, 47, 251, 0.13));
  }

  @media (prefers-reduced-motion: no-preference) {
    .fq-object {
      animation: fq-float 9s ease-in-out infinite;
    }
  }

  @keyframes fq-float {
    0%, 100% { transform: translateY(-5px) rotate(0.6deg); }
    50% { transform: translateY(5px) rotate(-0.6deg); }
  }

  @media (max-width: 1023px) {
    .fq-object {
      width: min(38vw, 150px);
    }
  }
</style>
